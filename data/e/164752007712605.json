loyd que dejaban las versiones de R&B. En febrero Barry Miles y John Dunbar abrieron la librería Indica (ESP-Disk, Burroughs, Leary, Artaud, Crowley, Gurdjieff, Blavatsky), con la ayuda de Paul McCartney. En abril Miles y Hopkins repartieron en la marcha de la CND THE Global moon-edition Long Hair TIMES.","color":"#c084fc","family":"Psicodelia, LSD y raga rock","link":"https://volteret4.github.io/1966/#underground-londres"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":187342366536484,"type":"album","name":"The Great Learning","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":4,"year":1971,"note":null,"yt":"txlZL8vgQak","scaruffi":null},{"id":16433270272884,"type":"album","name":"Piano Music 1959-70","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":135,"year":1996,"note":null,"yt":"x8TTSL6B2fc","scaruffi":null},{"id":169635769653352,"type":"album","name":"Treatise","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":7,"year":1999,"note":null,"yt":"Bh0K_0WzIRw","scaruffi":null},{"id":142205117552298,"type":"album","name":"Chamber Music 1955-64","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":102,"year":2001,"note":null,"yt":null,"scaruffi":null},{"id":145766374109220,"type":"album","name":"Cornelius Cardew","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":130,"year":2003,"note":null,"yt":"p14vELJIYUo","scaruffi":null},{"id":47326338389974,"type":"album","name":"Material","list_id":236867844600881,"list":"RYM Top — Experimental — Indeterminacy","src":"musthear","rank":103,"year":2004,"note":null,"yt":"ZgWppvXJrKU","scaruffi":null},{"id":260835217996462,"type":"album","name":"The Great Learning\n大學","list_id":150848509715573,"list":"RYM Top — Experimental","src":"musthear","rank":1