{"id":135657147309498,"type":"album","name":"Vikingligr Veldi","artist":"Enslaved","year":1994,"weight":12,"info":{"cover":"https://dn710907.ca.archive.org/0/items/mbid-22322913-4e1b-4243-9a27-4d1810708ab4/mbid-22322913-4e1b-4243-9a27-4d1810708ab4-4618745625.jpg","scaruffi":7.0,"sputnik":4.02,"yt":"coJ_O3YYcNY","links":{"spotify":"https://open.spotify.com/album/57OaCjNI4k5JrnKuJW2J2h","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_mwPCR61GuytSM2d99ODDLOZ1vmtRr9zT4","sputnikmusic":"https://www.sputnikmusic.com/album/18502/Enslaved-Vikingligr-Veldi/"},"desc":"Vikingligr Veldi (Icelandic meaning roughly Glorious Viking Square) is the debut studio album by Norwegian metal band Enslaved. It was released on February 22, 1994 through Deathlike Silence Productions, the record label run by Euronymous, who was killed before the album's release. The album is dedicated to him. Despite Enslaved's nationality, the lyrics on this album are mainly in Icelandic, perhaps due to its resemblance to Old Norse. The lyrics of \"Heimdallr\" are in ancient Norwegian. The distinct cover features the grave-good helm uncovered at the Sutton Hoo site in England, ostensibly belonging to the 7th century bretwalda, Raedwald of ."},"artist_ref":{"id":93952972504916,"name":"Enslaved","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Enslaved_2026.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"musthear"},{"id":170438788671559,"type":"genre","name":"Black Metal","artist":null,"year":null,"weight":313,"yt":null,"src":"musthear,rym"},{"id":181618155644956,"type":"genre","name":"Viking Metal","artist":null,"year":null,"weight":203,"yt":null,"src":"musthear"}],"lists":[{"id":31538438098055,"name":"RYM Top — Rock — Black Metal","src":"musthear","grp":"rateyourmu