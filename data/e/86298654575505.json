cs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1789030"}]},{"kind":"award","title":"Officer of the Legion of Honour","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q10855195"}]},{"kind":"award","title":"Primetime Emmy Award","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1044427"}]},{"kind":"award","title":"honorary doctor of Brandeis University","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q86241109"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[{"kind":"concert","title":"George McGovern Benefit Concert (1972)","body":"On April 5th, 1972, Barbra Streisand performed at the Los Angeles Forum as part of Warren Beatty's \"rock and rhetoric rallies\" to benefit George McGovern's presidential campaign. Despite not doing live performances at the time due to her movie career, she was persuaded by Beatty to participate and was backed by Quincy Jones and his orchestra. The concert also featured Carol King and James Taylor, with tickets ranging from $4 to $400. \"And then around 11 o'clock, outcomes Barbara Streisand.\"","year":1972,"extra":null,"srcs":[]}],"xref":[{"kind":"xref","title":"Musical Proficiency and Collaboration with Barbra Streisand","body":"The members of Fanny were highly skilled musicians, capable of working as studio musicians. In 1971, their talent was recognized when none other than Barbra Streisand hired them to appear on one of her albums, a testament to their professional caliber. \"In 1971, no one less than Barbara Streisand hired them to appear on one of her albums.\"","year":null,"extra":{"from":"Fanny","from_id":77466649184535,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Hidden Figures","url":"https://www.youtube.com/watch?v=vV1APhjBt9M"}]},{"kind":"xref","title":"Session Work with Barbra Streisand","body":"Proving their musical prowess, Fanny's members were skilled enough to work as studio musicians, even being hired by Barbra Streisand in 1971 to appear on one of her albums. \"In 1971, no one less than Barbara Streisand hired them to appear on one of her albums.\"","year":null,"extra":{"from":"Fanny","from_id":77466649184535,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Hidden Figures","url":"https://www.youtube.com/watch?v=XjQiZqpmQlE"}]},{"kind":"xref","title":"Veteran Tour Manager for Major Artists","body":"Marty Hom, who is Asian, is a seasoned veteran tour manager. His extensive experience includes being hired by prominent acts such as Fleetwood Mac and Barbra Streisand. \"Marty Haum is Asian. He's a veteran tour manager, has been hired by Fleetwood Back at Barber Strysend.\"","year":null,"extra":{"from":"Marty Hom","from_id":89985320355994,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"We Are The Road Crew - A History of Roadies","url":"https://www.youtube.com/watch?v=ZVGnSVfed9s"}]}],"charts":[{"id":188392957727651,"type":"album","name":"The Barbra Streisand Album","list_id":37273800199734,"list":"RYM Top — Pop — Standards","src":"musthear","rank":141,"year":1963,"note":null,"yt":"qkIx0b-xXCs","scaruffi":null},{"id":140550856460173,"type":"album","name":"The Second Barbra Streisand Album","list_id":37273800199734,"list":"RYM Top — Pop — Standards","src":"musthear","rank":153,"year":1963,"note":null,"yt":"py2lqRrJKY8","scaruffi":null},{"id":188392957727651,"type":"album","name":"The Barbra Streisand Album","list_id":135407159101775,"list":"RYM Top — Pop — Traditional Pop","src":"musthear","rank":200,"year":1963,"note":null,"yt":"qkIx0b-xXCs","scaruffi":null},{"id":280004031526057,"t