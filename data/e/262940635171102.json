{"id":262940635171102,"type":"album","name":"Deep Purple in Rock","artist":"Deep Purple","year":1970,"weight":16,"info":{"cover":"https://dn711100.ca.archive.org/0/items/mbid-5156ea9f-eb54-4258-bbf0-e3af9219de1f/mbid-5156ea9f-eb54-4258-bbf0-e3af9219de1f-31715408459.jpg","kind":"Album","tracks":7,"country":"XW","aoty":83,"aoty_user":80,"yt":"W_jfHvcAXRY","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/deep-purple/deep-purple-in-rock","aoty":"https://www.albumoftheyear.org/album/15391-deep-purple-deep-purple-in-rock.php"},"desc":"Deep Purple in Rock (also known as In Rock) is an album by English rock band Deep Purple, released in June 1970. It was their fourth studio album, and the first with the classic Mk II lineup. Deep Purple in Rock was their breakthrough album in Europe and would peak at #4 in the UK, remaining in the charts for months. Album was supported by the hugely successful In Rock World Tour which lasted 15 months. Although this was the first studio album to feature the MK II lineup of the band, it was this lineup that had earlier recorded ."},"artist_ref":{"id":6303702998770,"name":"Deep Purple","info":{"img":"https://cdn-images.dzcdn.net/images/artist/7e0f1ed0bd551dd9d8941bd9f21271b2/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"musthear,rym"},{"id":174164112458259,"type":"genre","name":"Heavy Metal","artist":null,"year":null,"weight":782,"yt":null,"src":"musthear,rym"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"musthear,rym"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"}],"lists":[{"id":263887018784608,"name":"RYM Top — Rock — Heavy Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":13,"year":null,"note":null,"total":200,"scaruffi":null},{"id":14576308360