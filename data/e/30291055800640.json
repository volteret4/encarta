scenes":[{"id":4419681145361,"name":"Cantautores lo-fi de los noventa","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2003,"desc":"Los noventa son la década del cantautor: la tecnología y las redes informales del post-punk favorecen la carrera en solitario, con Joni Mitchell y Leonard Cohen (no Dylan ni Springsteen) como maestros. El folk sombrío inaugurado por Chris Isaak, Smog y American Music Club se convierte casi en un género: Vic Chesnutt, Mark Lanegan, Mountain Goats, Elliott Smith, Jeff Buckley, Ron Sexsmith, Mike Johnson, Simon Joyner, Songs:Ohia. El neo-pop de Stephen Merritt (Magnetic Fields: Holiday, The Charm Of The Highway Strip, 69 Love Songs), Chris Connelly, Frank Black, Mike Gira (Body Lovers, Angels Of Light), Richard Davies y Eric Matthews (Cardinal), David Gray. El neo-folk de Beck (folk para la era del hip hop), John Frusciante, Sparklehorse, Bright Eyes, Rufus Wainwright, Grandaddy, Bobby Conn; el neo-country de Richard Buckner y Freedy Johnston; Steve Wynn, Mike Watt, Paul Westerberg, Ben Harper.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#songwriters-90s"}],"book_tracks":[{"id":43989083545550,"artist":"Vic Chesnutt","artist_id":30291055800640,"title":"West Of Rome","year":1992,"ess":0,"yt":"6wzefMoPGYs","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cantautores lo-fi de los noventa","scene_id":4419681145361,"scene_link":"https://volteret4.github.io/scaruffi/#songwriters-90s","chapters":["Sección 6.6"],"pages":[[1,247,null]]},{"id":232615275710380,"artist":"Vic Chesnutt","artist_id":30291055800640,"title":"Drunk","year":1994,"ess":0,"yt":"o7vAo2nEyzc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cantautores lo-fi de los noventa","scene_id":4419