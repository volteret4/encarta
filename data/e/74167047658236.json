{"id":74167047658236,"type":"album","name":"SWAG","artist":"Justin Bieber","year":2025,"weight":10,"info":{"cover":"https://dn710002.ca.archive.org/0/items/mbid-7dc5a184-d78f-4c1a-a99e-d41932d96115/mbid-7dc5a184-d78f-4c1a-a99e-d41932d96115-42709801599.png","yt":"9lhBlTdvd3U","desc":"“SWAG” is the seventh studio album by Canadian singer Justin Bieber. It was released through Def Jam Recordings on July 11, 2025. The album contains guest appearances from Gunna, Druski, Dijon, Lil B, Sexyy Red, Cash Cobain, Eddie Benjamin, and Marvin Winans. Production was handled by Bieber, Dijon, and Benjamin themselves, alongside Carter Lang, Dylan Wiggins, Daniel Chetrit, Mk.gee, Eli Teplin, Knox Fortune, Daniel Caesar, and Harv. Swag serves as the follow-up to Bieber's previous album, Justice, and his second extended play, Freedom, both of which were released in the spring of 2021. ."},"artist_ref":{"id":103038387250175,"name":"Justin Bieber","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Justin_Bieber_in_2015.jpg?width=500"}},"labels":[],"genres":[{"id":126030611694007,"type":"genre","name":"Art Pop","artist":null,"year":null,"weight":310,"yt":null,"src":"musthear"},{"id":7285728261839,"type":"genre","name":"Bedroom Pop","artist":null,"year":null,"weight":260,"yt":null,"src":"musthear"},{"id":242048506390872,"type":"genre","name":"Pop Soul","artist":null,"year":null,"weight":250,"yt":null,"src":"musthear"},{"id":266557216269112,"type":"genre","name":"Alternative R&B","artist":null,"year":null,"weight":241,"yt":null,"src":"musthear"},{"id":234622321273601,"type":"genre","name":"alternative pop","artist":null,"year":null,"weight":49,"yt":null,"src":"musthear"},{"id":217858086851026,"type":"genre","name":"Interview","artist":null,"year":null,"weight":42,"yt":null,"src":"musthear"}],"lists":[{"id":85122334056025,"name":"Grammy Award: Album of the Year nominees","src":"musthear","grp":"musicbrainz","list_year":null,"rank":2026,"year":null,"note":null,"total":279,"sc