":[],"lists":[{"id":167954413065108,"name":"UK Singles Chart","rank":2,"scaruffi":null}],"n_lists":1}},{"id":142375823497423,"type":"song","name":"Calypso Blues","artist":"Nat King Cole","year":null,"weight":7,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":2}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":210371797177790,"type":"artist","name":"Natalie Cole","artist":null,"year":null,"weight":37,"yt":null,"src":"ensayos"},{"id":124751551358491,"type":"artist","name":"Nat King Cole Trio","artist":null,"year":null,"weight":23,"yt":null,"src":"ensayos"}],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"}],"album_genres":[{"id":163536058891268,"type":"genre","name":"Traditional Pop","n":5},{"id":56173113450769,"type":"genre","name":"Swing","n":4},{"id":9877689544171,"type":"genre","name":"Standards","n":4},{"id":200032669956396,"type":"genre","name":"Bolero","n":2},{"id":196857370812297,"type":"genre","name":"Vocal Jazz","n":2},{"id":209801428912435,"type":"genre","name":"Chachachá","n":1},{"id":116162141578082,"type":"genre","name":"Latin Pop","n":1},{"id":73462906774042,"type":"genre","name":"Mambo","n":1},{"id":43371867581873,"type":"genre","name":"Cuban Music","n":1},{"id":19367291077356,"type":"genre","name":"Exotica","n":1}],"labels":[{"id":113269546575082,"type":"label","name":"Capitol Records","artist":null,"year":null,"weight":185,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[{"id":265361061813785,"name":"Hawkins, Lester Young y los saxos tenor","book":"Historia del jazz","author":"Ted Gioia","start":1929,"end":1969,"desc":"Dos modelos del saxo tenor. Coleman Hawkins, sonido amplio y vibrato, arpegios y acordes de paso, inventa la balada de jazz en tempo lento («One Hour», 1929) y la culmina con «Body and Soul» (1939), el solo de saxo más famoso de la historia, que gusta «a los carcas y a la gente del jazz»; pasa cinco años en Europa, donde es recibido como un héroe, y a la vuelta apoya el bebop (graba con Gillespie en 1944 y contrata a Monk) sin dejar de ser un músico del swing. Lester Young, tímido y excéntrico, sonido diáfano y líneas que flotan sobre las barras de compás, es rechazado en la banda de Henderson pero triunfa con Basie («Lester Leaps In») y con Billie Holiday: insinúa los acordes con notas de tensión, regulariza las corcheas y abre a la vez el camino al bebop de Parker y al cool. El ejército lo destroza en 1945. Ben Webster, Chu Berry y Herschel Evans completan la escuela.","color":"#fb923c","family":"Swing, Harlem y big bands","link":"https://volteret4.github.io/jazz/#tenores-swing"},{"id":138287060444582,"name":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","book":"Historia del jazz","author":"Ted Gioia","start":1943,"end":1990,"desc":"Mientras Powell, Monk y Tristano no encajan en el mercado de los cincuenta, otros seis pianistas llevan el piano moderno al gran público sin traicionar el jazz, pese al recelo de una crítica que identifica éxito con haberse «vendido». Oscar Peterson, descubierto por Norman Granz, heredero técnico de Tatum pero más deudor de Nat Cole, es «la voluntad de swing». Nat King Cole, pianista entre Hines y el bop en su trío sin batería, acaba como gran cantante popular. George Shearing populariza un suave sonido de quinteto («Lullaby of Birdland»). Erroll Garner, autodidacta que no leía música, hace sonar el piano como guitarra, batería o arpa (Concert by the Sea, «Misty»). Ahmad Jamal, con su uso del espacio, influye en Miles Davis y anticipa a Bill Evans (But Not for Me). Dave Brubeck, alumno de Milhaud, con Paul Desmond y Time Out legitima los compases inusuales con «Take Five».","color":"#f472b6","family":"Piano y voces: stride, boogie y cantantes","link":"https://volteret4.github.io/jazz/#piano-popular"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Stage Attack by White Supremacists (April 1956)","body":"In April 1956, Nat King Cole was assaulted on stage by a mob of white supremacists, resulting in his injury. This incident, despite Cole being a politically understated black entertainer performing for an all-white audience with a white backing band, underscored the violent racial tensions of the era. \"In April 1956, Nat King Cole was injured on stage when a mob of white supremacists attacked him.\"","year":1956,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 45: \"Blueberry Hill\", by Fats Domino","url":"https://www.youtube.com/watch?v=VqIwZGJHgBg"}]},{"kind":"podcast","title":"Capitol Records Era","body":"Nat King Cole was a significant artist, referred to as a \"crew member,\" at Capitol Records during the 1940s. The label in this period was largely dedicated to traditional music forms and standards, predating its significant involvement with rock and roll. \"Capital at the time was the home of crew members like Frank Sinatra and Nat King Cole...\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 41: \"Be-Bop-A-Lula\" by Gene Vincent and the Bluecaps","url":"https://www.youtube.com/watch?v=tYBQ5F7O3G0"}]},{"kind":"podcast","title":"Influence on Chuck Berry","body":"Nat King Cole was the musician whom Chuck Berry most liked to listen to, despite Berry primarily playing Louis Jordan's music for a living. This personal preference influenced groups like the Chuck Berry Trio, which clearly attempted to emulate Cole's style. \"Barry would often say that while Louis Jordan music was the music he would play to try to make a living, Nat King Cold was the musician he most liked to listen to, and the Chuck Barvitrio was clearly an attempt to emulate this style.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 32: \"I Got A Woman\" by Ray Charles","url":"https://www.youtube.com/watch?v=0oeI9f2x_fo"}]},{"kind":"podcast","title":"Musical Parent","body":"Nat King Cole is noted as the father of Natalie Cole. \"Natalie Cole, daughter of Nat King.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Musical Offspring","url":"https://www.youtube.com/watch?v=MmXDbXI6Sqk"}]},{"kind":"podcast","title":"Piano Collaborations","body":"Nat King Cole was known to play piano with other prominent musicians such as Les Paul and Illinois Jacquet, highlighting his versatility and presence in various musical contexts beyond his trio. \"We've heard Nat King Cold before, playing piano with Les Paul and Illinois Jocquette...\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 32: \"I Got A Woman\" by Ray Charles","url":"https://www.youtube.com/watch?v=0oeI9f2x_fo"}]},{"kind":"podcast","title":"Posthumous Duet with Daughter","body":"The late Nat King Cole's voice was featured in a posthumous duet with his daughter Natalie Cole on the song \"Unforgettable\" for her 1991 album \"Unforgettable with Love.\" This \"eerie recording feat\" contributed to the song winning both Record of the Year and Song of the Year at the 1992 Grammys. \"The CD culminated in a duet version of the song Unforgettable, sung by Natalie and the ghostly voice of the deceased Nat.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"And the Grammy Goes to… Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"And the Grammy Goes to… Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4eef154465cd600c4ddc"}]},{"kind":"podcast","title":"Songs Written by Rose Marie McCoy","body":"Rose Marie McCoy, co-writer of \"It's Gonna Work Out Fine,\" also wrote songs for Nat King Cole. \"who had written for Elvis, Nat King Cole, Nappy Brown, and many others.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 49: \"Love is Strange\" by Mickey and Sylvia","url":"https://www.youtube.com/watch?v=FkyLPVvPbcI"}]}],"awards":[{"kind":"award","title":"Grammy Lifetime Achievement Award (1990)","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q935843"}]},{"kind":"award","title":"Rock and Roll Hall of Fame (2000)","body":"Won.","year":2000,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q179191"}]},{"kind":"award","title":"Latin Grammy Hall of Fame (2007) — Cole Español","body":"Won.","year":2007,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q18345362"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Musical Offspring","body":"Natalie Cole is noted as the daughter of Nat King Cole. \"Natalie Cole, daughter of Nat King.\"","year":null,"extra":{"from":"Natalie Cole","from_id":210371797177790,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Musical Offspring","url":"https://www.youtube.com/watch?v=MmXDbXI6Sqk"}]}],"charts":[{"id":209090682773658,"type":"song","name":"Mona Lisa","work_year":1950,"list_id":71668837178901,"list":"Billboard Year-End 1950","src":"singles","rank":2,"year":1950,"note":"","yt":"G2vgJ0MGOlg","scaruffi":null},{"id":73947471708443,"type":"album","name":"Penthouse Serenade: Nat 'King' Cole at the Piano","list_id":37273800199734,"list":"RYM Top — Pop — Standards","src":"musthear","rank":86,"year":1952,"note":null,"yt":"QdUJUdOdeH8","scaruffi":null},{"id":73947471708443,"type":"album","name":"Penthouse Serenade: Nat 'King' Cole at the Piano","list_id":135407159101775,"list":"RYM Top — Pop — Traditional Pop","src":"musthear","rank":118,"yea