{"id":110615580763819,"type":"song","name":"The Thrill Is Gone","artist":"B.B. King","year":1970,"weight":11,"info":{"cover":"https://cdn-images.dzcdn.net/images/cover/66df5ad59d62ebc6abeaf2ccf3d2fbfb/250x250-000000-80-0-0.jpg","album":"The Thrill Is Gone","yt":"SgXSomPE_FY"},"artist_ref":{"id":233676165019879,"name":"B.B. King","info":{"img":null}},"labels":[],"genres":[],"lists":[{"id":49981520711315,"name":"Billboard Year-End 1970","src":"singles","grp":"billboard_year_end","list_year":1970,"rank":98,"year":1970,"note":"","total":100,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","src":"charts","grp":"chart","list_year":null,"rank":98,"year":1970,"note":null,"total":6841,"scaruffi":null}],"podcast":[{"kind":"podcast","title":null,"body":"This song, the last track on his 1969 album \"Completely Well,\" became B.B. King's breakthrough pop hit at the age of 45, reaching number 15 on the Billboard Hot 100 in 1970. Instantly recognizable by its opening notes from his guitar, Lucille, it earned him a Grammy for Best R&B Male Vocal in 1970 and was inducted into the Grammy Hall of Fame in 1998. It was a highlight of his eight-song set at Zaire 74, captivating the crowd including Muhammad Ali. \"The thrill is gone made it to number 15 on the Billboard Hot 100 in 1970.\"","year":1970,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":"https://seventies.libsyn.com/ep-33-zaire-74-muhammad-ali-and-the-rumble-in-the-jungle"},{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":null}]}],"book_tracks":[],"others":[{"id":245463983038369,"type":"album","name":"Completely Well","year":1969,"weight":16},{"id":80443418583329,"type":"album","name":"Live at the Regal","year":1965,"weight":10},{"id":156404354288877,"type":"album","name":"Easy Listening Blues","year":1962,"weight":7},{"id":88697448038098,"type