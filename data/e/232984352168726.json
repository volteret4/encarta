{"id":232984352168726,"type":"artist","name":"Extreme","artist":null,"year":null,"weight":11,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/33202a7677d7344fb51dd4317ade9cd7/1000x1000-000000-80-0-0.jpg","bio":"Extreme es una banda estadounidense de hard rock formada por el vocalista Gary Cherone, el guitarrista Nuno Bettencourt, el bajista Pat Badger y el batería Paul Geary (posteriormente reemplazado por Mike Mangini ex-baterista de Steve Vai y actualmente por Kevin Figueiredo ex-Baterista de Dramagods banda de Nuno Bettencourt). \n\nSus cinco discos de estudio hasta aquì (Extreme, Pornograffitti, III Sides To Every Story, Waiting For The PunchLine y Saudades De Rock) demuestran la gran calidad de este grupo que mezcla el funk con el metal.","tags":["hard rock","rock","funk metal","hair metal","metal"]},"works":[{"id":49246155457924,"type":"album","name":"Extreme II: Pornograffitti","artist":"Extreme","year":1990,"weight":5,"yt":"P5ThltAAnRM","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":90391435651867,"name":"Sputnikmusic Best Albums 1990","rank":104,"scaruffi":null}],"n_lists":1}},{"id":135277695687524,"type":"album","name":"II Pornograffitti","artist":"Extreme","year":1990,"weight":7,"yt":"OVwEKr38MzQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":53255468861993,"name":"RYM Top — Rock — Glam Metal","rank":78,"scaruffi":null},{"id":200600589539543,"name":"RYM Top — Rock — Funk Rock","rank":96,"scaruffi":null},{"id":221108802372907,"name":"RYM Top — Rock — Funk Metal","rank":18,"scaruffi":null}],"n_lists":3}},{"id":243240975567338,"type":"album","name":"Pornograffiti","artist":"Extreme","year":1990,"weight":6,"yt":"OVwEKr38MzQ","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":267672368734669,"type":"song","name":"Hole Hearted","artist":"Extreme","year":1991,"weight":4,"yt":"I-h4A7bF8wQ","src":"charts,si