ist":"Sly & Robbie","title":"Rhythm Killers","year":1987,"kind":null,"ess":1,"yt":"MnPpQAeSbQg","type":"album"},{"id":63897794802657,"artist_id":18253670684326,"artist":"Gettovetts","title":"Missionaries Moving","year":1988,"kind":null,"ess":1,"yt":"TMwYQ7bmpRM","type":"album"}],"labels":[{"name":"Celluloid","id":193355946257199},{"name":"On-U Sound","id":93078670616012},{"name":"Tommy Boy","id":136874388842894},{"name":"Def Jam","id":null},{"name":"Island","id":141752752205360},{"name":"Rough Trade","id":223829938655925}],"link":"https://volteret4.github.io/Funk/#funk-industrial"}],"similar_scenes":[],"aka":[{"id":237523793898150,"type":"genre","name":"Bill Laswell","artist":null,"year":null,"weight":1,"yt":null,"src":"books"},{"id":190831659788236,"type":"genre","name":"Tackhead","artist":null,"year":null,"weight":1,"yt":null,"src":"books"},{"id":119901768874190,"type":"genre","name":"industrial funk","artist":null,"year":null,"weight":1,"yt":null,"src":"books"},{"id":79770195656259,"type":"genre","name":"Rockit","artist":null,"year":null,"weight":1,"yt":null,"src":"books"},{"id":27210830364649,"type":"genre","name":"On-U Sound","artist":null,"year":null,"weight":1,"yt":null,"src":"books"}],"rym":[],"artists":[],"works":[],"podcast":[]}