:"folk","n":1},{"id":138260924917913,"type":"genre","name":"Ancient Music","n":1},{"id":12523345227983,"type":"genre","name":"Central Asian Music","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":137813001008935,"name":"Música espiritual alemana","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1971,"end":1989,"desc":"Deuter y Popol Vuh convierten el misticismo hippy en un nuevo género. Deuter, pionero de la world music, une vanguardia occidental y espiritualidad oriental (Aum, la primera misa indo-occidental). Popol Vuh de Florian Fricke pasa del Moog de Affenstunde a la humildad acústica de In Den Gaerten Pharaos y Hosianna Mantra, que eliminan el ritmo (el Tiempo) de la pintura sonora espiritual. Eberhard Schoener, y en el encuentro con la vanguardia Peter Michael Hamel, Stephan Micus y Michael Hoenig, que anticipa el ambient house.","color":"#2dd4bf","family":"Vanguardia, electrónica y ambient","link":"https://volteret4.github.io/scaruffi/#spiritual"}],"book_tracks":[{"id":89591348145687,"artist":"Stephan Micus","artist_id":260014255554670,"title":"Implosions","year":1977,"ess":1,"yt":"2lt8khOvvAk","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Música espiritual alemana","scene_id":137813001008935,"scene_link":"https://volteret4.github.io/scaruffi/#spiritual","chapters":["Sección 3.7"],"pages":[[1,71,null]]},{"id":98556445565156,"artist":"Stephan Micus","artist_id":260014255554670,"title":"Koan","year":1981,"ess":0,"yt":"v2PBSMCmgYw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Música espiritual alemana","scene_id":137813001008935,"scene_link":"https://volteret4.github.io/scaruffi/#spiritual","chapters":["Sección 3.7"],"pages":[[1,71,null]]},{"id":78445465523886,"artist":"Stephan Micus","artist_id":2600142