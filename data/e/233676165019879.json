":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":9996096414698,"name":"RYM Top — Blues — Electric Blues","rank":191,"scaruffi":null}],"n_lists":1}},{"id":43870144876355,"type":"album","name":"Blues on the Bayou","artist":"B.B. King","year":1998,"weight":4,"yt":"kVecGL2vOmI","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":9996096414698,"name":"RYM Top — Blues — Electric Blues","rank":91,"scaruffi":null},{"id":178815374306279,"name":"RYM Top — Blues","rank":148,"scaruffi":null}],"n_lists":2}},{"id":29484612219380,"type":"album","name":"One Kind Favor","artist":"B.B. King","year":2008,"weight":7,"yt":"uVCZI6s3jCI","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":200867050536406,"name":"Sputnikmusic Best Albums 2008","rank":147,"scaruffi":null},{"id":9996096414698,"name":"RYM Top — Blues — Electric Blues","rank":169,"scaruffi":null}],"n_lists":2}},{"id":70778078022202,"type":"song","name":"How Blue Can You Get","artist":"B.B. King","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":1}],"lists":[],"n_lists":0}},{"id":245112317427242,"type":"song","name":"How Blue Can You Get (Undated)","artist":"B.B. King","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"ensayos"},{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"ensayos"},{"id":202159817309393,"type":"genre","name":"blues","artist":null,"year":null,"weight":444,"yt":null,"src":"ensayos"}],"album_genres":[{"id":152058655173795,"type":"genre","name":"Soul Blues","n":19},{"id":61825535078474,"type":"genre","name":"Electric Blues","n":12},{"id":244607077933175,"type":"genre","name":"Electric Texas Blues","n":2},{"id":165053196394606,"type":"genre","name":"Texan Music","n":2},{"id":27872059790879,"type":"genre","name":"Rhythm & Blues","n":2},{"id":202159817309393,"type":"genre","name":"blues","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":184147216768547,"type":"genre","name":"Traditional Black Gospel","n":1},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":1},{"id":23813778789982,"type":"genre","name":"Chicago Blues","n":1},{"id":3840451882928,"type":"genre","name":"Spiritual","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":130667883582105,"name":"Rock gitano, rumba y nuevo flamenco","book":"El flamenco contado con sencillez","author":"Carlos Arbelos","start":1965,"end":2002,"desc":"La fusión con el pop, el rock y la rumba. Bambino llevó la rumba jonda a Madrid en los sesenta y Peret creó la rumba catalana, más urbana y comercial. Lole y Manuel, dúo desde 1972, renovaron las letras de los palos tradicionales con un compás más lento. Raimundo Amador, de Veneno y Pata Negra, es el creador del rock flamenco gitano y ha tocado con B. B. King y Max Roach; su hermano menor el Churri sigue sus pasos. Manzanita, de la dinastía de Caracol, triunfó en los setenta con poemas de Lorca y cierra con Ketama la película Flamenco de Saura. Gipsy Kings, gitanos del sur de Francia, difundieron la rumba por el mundo con diez millones de copias de un solo disco y tanto marketing que confundieron a muchos sobre lo que es el flamenco. Después vinieron La Barbería del Sur (Nuevos Medios), Navajita Plateá (flamenco festivo con blues y rock), Maíta Vende Cá («mi madre es gitana»), el Barrio y José el Francés, al que convocó el Festival de las Minas en 2000.","color":"#38bdf8","family":"Encuentro con otras músicas: nuevo flamenco y fusión","link":"https://volteret4.github.io/Flamenco/#rock-flamenco"},{"id":200776639222208,"name":"Black rock","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1966,"end":1995,"desc":"«El funk es blues acelerado» (Clinton). Pese a Chuck Berry, Little Richard o Bo Diddley, el rock se volvió una forma blanca y la invasión británica reforzó el mito, aunque sus grupos venían del blues negro. Hendrix y Sly lo desmontaron a finales de los sesenta, pero la industria resegregó el rock en pocos años, hasta Prince. El blues eléctrico (Muddy Waters, con su «gran caída tras el golpe del tambor») tuvo su revival ante el público blanco. En la Costa Oeste, multirracial y lejos de los problemas del Norte y del Sur, florecieron bandas mestizas (Sly, Tower of Power, Santana): la influencia del rock psicodélico convirtió el funk de un R&B salvaje en algo universal. A mediados de los setenta el black rock se convirtió en funk, porque la radio obligó a quitar los solos de guitarra; solo algunos resistieron («Who Says a Funk Band Can’t Play Rock?!» de Funkadelic, Slave, Mother’s Finest, los Isley) hasta Prince y la Black Rock Coalition de Vernon Reid (1985), y en los noventa Living Colour, Body Count, Bad Brains o Fishbone.","color":"#c084fc","family":"Funk psicodélico y black rock: Sly, Hendrix","link":"https://volteret4.github.io/Funk/#black-rock"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Career Decline & Crossover (Late 1960s)","body":"In the late 1960s, B.B. King's career stalled as younger black music fans gravitated towards soul music, viewing the blues as outdated. His career revived dramatically when he played to a predominantly white, \"hippie\" audience at the Fillmore West in San Francisco in 1967, receiving a standing ovation before even playing. This resurgence was further aided by rock stars like Eric Clapton publicly acknowledging his profound influence on rock music. \"By the late 1960s, BB King's career was grinding to a halt.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":null},{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":"https://seventies.libsyn.com/ep-33-zaire-74-muhammad-ali-and-the-rumble-in-the-jungle"}]},{"kind":"podcast","title":"Influence on Electric Guitar","body":"Music journalist Ralph J. Gleason, in his liner notes for B.B. King's 1969 album \"Completely Well,\" attributed King with effectively inventing the electric guitar for practical purposes, underscoring his widespread and foundational impact on rhythm and blues and rock and roll music. \"He is truly the man who for all practical purposes invented the electric guitar.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":null},{"source":"For the Record - The 70s","episode":"Ep. 33 - Zaire '74, Muhammad Ali, and The Rumble in the Jungle","url":"https://seventies.libsyn.com/ep-33-zaire-74-muhammad-ali-and-the-rumble-in-the-jungle"}]},{"kind":"podcast","title":"Performer at Alan Freed Show","body":"B.B. King was one of the R&B stars Carole King saw perform at an Alan Freed show at the Paramount in Brooklyn, which was a pivotal experience for King in deciding her career path. \"Zwick took her to an Alan Fried show at the Paramount in Brooklyn, where she saw Le Verne Baker, BB King, Mickey Baker, The Moon Glows, and several other R&B stars of the period.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 89: \"Will You Love Me Tomorrow?\" by the Shirelles","url":"https://www.youtube.com/watch?v=7Kns2HGcuSg"}]}],"awards":[{"kind":"award","title":"Grammy Lifetime Achievement Award (1987)","body":"Won.","year":1987,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q935843"}]},{"kind":"award","title":"Rock and Roll Hall of Fame (1987)","body":"Won.","year":1987,"extra":null,"srcs":[{"source":"Wikidata","episode":nul