:2004,"weight":3,"yt":"YYIXKwGjifQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":259341068170065,"name":"RYM Top — Pop — Boy Band","rank":93,"scaruffi":null}],"n_lists":1}},{"id":20945449753988,"type":"song","name":"Earth Angel (Later)","artist":"New Edition","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}}],"members":[{"id":88263068881365,"type":"artist","name":"Bobby Brown","artist":null,"year":null,"weight":26,"yt":null,"src":"ensayos"},{"id":199428731043573,"type":"artist","name":"Bell Biv DeVoe","artist":null,"year":null,"weight":13,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"ensayos"},{"id":128244196016287,"type":"genre","name":"New Jack Swing","artist":null,"year":null,"weight":241,"yt":null,"src":"ensayos"},{"id":169807971765475,"type":"genre","name":"80s Black Boy Band","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":64401182886525,"type":"genre","name":"Boy Band","n":5},{"id":100106212412601,"type":"genre","name":"Teen Pop","n":2},{"id":196214580808384,"type":"genre","name":"Hip Hop Soul","n":1},{"id":176578125596945,"type":"genre","name":"Contemporary R&B","n":1},{"id":128244196016287,"type":"genre","name":"New Jack Swing","n":1},{"id":10860579169619,"type":"genre","name":"Doo-Wop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":245333387691429,"name":"Greg Mack y KDAY 1580","book":"The Come Up: An Oral History of the Rise of Hip-Hop","author":"Jonathan Abrams","start":1983,"end":1991,"desc":"Greg Mack llegó de Houston en 1983 para salvar KDAY 1580-AM, la última de las cinco emisoras negras de la ciudad; abrió la ventana de su casa en South Central, oyó Run-DMC y Kurtis Blow en todos los coches y puso rap: en el primer sondeo pasaron a segundos. Rodger Clayton le despreció («¿parece que necesito la radio?») y se alió con Alonzo Williams: sus «Mack Attack Mixmasters» y el «Traffic Jam» pusieron en antena las mezclas de cuatro pistas de Dr. Dre y Yella, que se vendían en el Roadium Swap Meet. Sin payola y con las puertas abiertas, rompió casi todos los grupos de la Costa Oeste (Yo-Yo, Sir Jinx, N.W.A) y también el freestyle; organizaba bailes en las pistas de patinaje, baratas y con buen sonido, rotando territorios: Skateland (Bloods, en Compton), World on Wheels (Crips), Sherman Square (bandas latinas), la Casa Camino Real como terreno neutral y el 321 Club para los chicos blancos. Las bandas lo respetaban y hasta le llamaban para explicar sus tiroteos. «Sin KDAY no sería quien soy» (Murs).","color":"#22d3ee","family":"Industria, medios y negocio","link":"https://volteret4.github.io/ComeUp/#kday"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Homage in 24K Magic","body":"Bruno Mars's album \"24K Magic\" was broadly considered \"one long homage\" to the 80s black boy band New Edition. Specific singles from the album echoed the distinctive New Jack Swing sound of Bobby Brown and the \"slamming hip-hop club sound\" of the spin-off group Bell Biv DeVoe. \"In fact, you might say 24-karat magic was one long homage to 80s black boy band new addition.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Lenny on Mars Edition Part 2","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":11751275739920,"type":"album","name":"Candy Girl","list_id":259341068170065,"list":"RYM Top — Pop — Boy Band","src":"musthear","rank":11,"year":1983,"note":null,"yt":"YtbFPLK-JWI","scaruffi":null},{"id":11751275739920,"type":"album","name":"Candy Girl","list_id":137828800833770,"list":"RYM Top — Pop — Teen Pop","src":"musthear","rank":59,"year":1983,"note":null,"yt":"YtbFPLK-JWI","scaruffi":null},{"id":45203432771470,"type":"song","name":"Candy Girl","wor