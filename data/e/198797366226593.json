aruffi":null}],"n_lists":1}},{"id":40172350552600,"type":"album","name":"High As Fuck II","artist":"Ghostface Playa","year":2021,"weight":3,"yt":"GDwVhprOowU","src":"rym","from":{"books":[],"podcasts":[],"lists":[{"id":35705813434597,"name":"RYM Top — Electronic — Drift Phonk","rank":8,"scaruffi":null}],"n_lists":1}},{"id":34938267299973,"type":"album","name":"Beat Tape 2","artist":"Kordhell","year":2021,"weight":3,"yt":"v5GdxmuEH4U","src":"rym","from":{"books":[],"podcasts":[],"lists":[{"id":35705813434597,"name":"RYM Top — Electronic — Drift Phonk","rank":6,"scaruffi":null}],"n_lists":1}},{"id":10964054883746,"type":"album","name":"Phucked Up","artist":"Adlin\nАдлин","year":2008,"weight":3,"yt":"7fgObsN1ods","src":"rym","from":{"books":[],"podcasts":[],"lists":[{"id":35705813434597,"name":"RYM Top — Electronic — Drift Phonk","rank":25,"scaruffi":null}],"n_lists":1}},{"id":8169009025558,"type":"album","name":"Ad Mortem Et Tenebrae","artist":"Phonk Killer","year":2025,"weight":3,"yt":"Oc5KUbNyz1g","src":"rym","from":{"books":[],"podcasts":[],"lists":[{"id":35705813434597,"name":"RYM Top — Electronic — Drift Phonk","rank":65,"scaruffi":null}],"n_lists":1}},{"id":31831749633550,"type":"album","name":"pasajero","artist":"⦻","year":2019,"weight":2,"yt":null,"src":"rym","from":{"books":[],"podcasts":[],"lists":[{"id":35705813434597,"name":"RYM Top — Electronic — Drift Phonk","rank":59,"scaruffi":null}],"n_lists":1}}],"podcast":[{"kind":"podcast","title":"Explosion via TikTok Algorithm (2019)","body":"The popularity of Drift Phonk exploded in 2019, especially through the TikTok algorithm. Its short, explosive sounds proved to be the \"perfect complement\" for the platform, quickly becoming ubiquitous as background music for content aiming to appear tough, stoic, or \"internet-based.\" \"en el algoritmo de Tik Tok, ambidento de sonidos cortos y explosivos en control del dirifunk, el complemento perfecto.\"","year":2019,"extra":null,"srcs":[{"source":"Central Sonora","episode":"¿Qué pasó con el PHONK? (La historia real)","url":"https://www.youtube.com/watch?v=ehfWyUHFFT8"}]},{"kind":"podcast","title":"Connection to Street Racing Culture","body":"Drift Phonk found its ideal audience in Russia's strong street car racing culture. The aggressive sound of its cowbells perfectly complemented visuals of Japanese cars drifting sideways, creating an \"indivisible visual and sonic aesthetic\" for the asphalt. \"En Rusia existía una cultura de carreras callejeras de coches muy potente, y estos productores encontraron en esos ritmos la mandas son la perfecta para las faltó.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"¿Qué pasó con el PHONK? (La historia real)","url":"https://www.youtube.com/watch?v=ehfWyUHFFT8"}]},{"kind":"podcast","title":"Devouring the Original Phonk","body":"Drift Phonk grew so rapidly that it \"devoured its father\" – the original Phonk. For the vast majority of new audiences, Drift Phonk *was* Phonk, completely overshadowing the SoundCloud scene that had emerged just 10 years prior. \"El dirifunk creció tanto que devoró a su padre. Para la inmensa mayoría del público nuevo, eso era fonc, y punto.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"¿Qué pasó con el PHONK? (La historia real)","url":"https://www.youtube.com/watch?v=ehfWyUHFFT8"}]},{"kind":"podcast","title":"Russian/Eastern European Origins (Late 2010s)","body":"Drift Phonk emerged in the late 2010s, primarily from producers in Russia and Eastern Europe. These artists were drawn to the aggressive elements of Memphis sound, focusing on \"metallic cowbells,\" \"distorted sub-basses,\" and \"primitive electronic production,\" rather than the slow aspects. They intensified these elements, speeding them up, and added a \"saturated kick drum\" with a tempo close to house music. \"La finales de la década de 2010, productores de Rusia y Europa del este empezaron a posicionarse con ese sonido de Memphis. Pero no les interesaba la parte lenta, sino lo más agresivo.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"¿Qué pasó con el PHONK? (La historia real)","url":"https://www.youtube.com/watch?v=ehfWyUHFFT8"}]}]}