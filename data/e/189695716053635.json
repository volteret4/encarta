{"id":189695716053635,"type":"album","name":"LCD Soundsystem","artist":"LCD Soundsystem","year":2005,"weight":20,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/480-lcd-soundsystem_223819.jpg","aoty":83,"aoty_user":81,"yt":"htRjU_oyX8Q","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/lcd-soundsystem/lcd-soundsystem","aoty":"https://www.albumoftheyear.org/album/480-lcd-soundsystem-lcd-soundsystem.php"},"desc":"LCD Soundsystem is the debut studio album by American rock band LCD Soundsystem. It was released on January 24, 2005, jointly through DFA and Capitol Records in the United States and EMI elsewhere. The album encompasses genres that range from dance-punk to electronica to indie rock to dance music. The album was critically acclaimed upon release and was nominated for the 2006 Grammy Award for Best Electronic/Dance Album. Many singles were released to promote the album, including the band's breakout \"Daft Punk Is Playing at My House\", which reached number one on the UK Dance Chart in March, 2005. Online ."},"artist_ref":{"id":197621594636405,"name":"LCD Soundsystem","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Route_du_Rock_2007%2C_LCD_Soundsystem_2.jpg?width=500"}},"labels":[],"genres":[{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"rym"},{"id":40264566616896,"type":"genre","name":"Post-Punk Revival","artist":null,"year":null,"weight":230,"yt":null,"src":"rym"},{"id":55143051280122,"type":"genre","name":"Indietronica","artist":null,"year":null,"weight":225,"yt":null,"src":"rym"},{"id":157907771528458,"type":"genre","name":"Dance-Punk","artist":null,"year":null,"weight":220,"yt":null,"src":"rym"},{"id":158601647791242,"type":"genre","name":"Dance-Punk Revival","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"}],"lists":[{"id":110790259452399,"name":"RYM Top — Rock — Dance-Punk Revival","src":"musthear","grp":"rateyourmusic","list_year