":184225487175112,"name":"Billboard Hot 100 nº1 · 2020s","rank":1178,"scaruffi":null}],"n_lists":1}}],"members":[{"id":27619598393117,"type":"artist","name":"M.I.A.","artist":null,"year":1975,"weight":124,"yt":null,"src":"ensayos"},{"id":14652754440736,"type":"artist","name":"Young Thug","artist":null,"year":1991,"weight":15,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[],"album_genres":[{"id":76750303293721,"type":"genre","name":"Southern Hip Hop","n":3},{"id":31593727518281,"type":"genre","name":"Trap","n":3},{"id":249056050558872,"type":"genre","name":"Pop Rap","n":1},{"id":107037851142420,"type":"genre","name":"Experimental Hip Hop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Astroworld Festival Deaths (November 5, 2021)","body":"During Travis Scott's performance at the Astroworld Festival in Houston on November 5, 2021, ten people died—eight on-site and two later in the hospital—all from compressive asphyxiation, with victims aged 14 to 27. At least 300 additional people were injured in a severe crowd-crush incident attributed to a gross failure of crowd control, crowd safety, and security. \"Ten people died during Travis Scott's sad during the Asterole Festival on November 5th, 2021.\"","year":2021,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock's Greatest Disasters","url":"https://www.youtube.com/watch?v=Pgchw2h87aw"}]},{"kind":"podcast","title":"Extensive Legal Actions and Industry Impact","body":"The Astroworld disaster has initiated a protracted investigation and over 3,000 lawsuits that will take a considerable amount of time to resolve. The incident has prompted promoters globally to re-evaluate and modify their festival policing and security protocols, underscoring the substantial financial consequences for entities like Live Nation and Travis Scott. \"The investigation into this one will take a very long time and it'll take forever to sort out the more than 3,000 lawsuits that have been filed.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock's Greatest Disasters","url":"https://www.youtube.com/watch?v=Pgchw2h87aw"}]},{"kind":"podcast","title":"FOMO-Promoted Single Releases","body":"Travis Scott's \"loopy single releases\" are promoted like \"FOMO events,\" which contribute to his ability to launch at the top of the charts in the streaming era. This promotional strategy leverages fan excitement and urgency for digital consumption. \"rapper Travis Scott whose loopy single releases are promoted like FOMO events.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4ef60c30a1408dc29358"}]},{"kind":"podcast","title":"Performance Continued Amidst Tragedy","body":"Despite the unfolding fatal crowd-crush situation and significant injuries during his Astroworld Festival set, Travis Scott continued his performance for over an hour. \"And while this was happening, Travis Scott continued with his set for over an hour.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock's Greatest Disasters","url":"https://www.youtube.com/watch?v=Pgchw2h87aw"}]},{"kind":"podcast","title":"Pioneer of Exaggerated Auto-Tune Use","body":"Travis Scott is listed among the artists who \"really went to town with auto-tune,\" leveraging the technology to create highly exaggerated and unique vocal sounds. His work exemplifies the trend of using Auto-Tune as a creative effect rather than solely for pitch correction, shaping its perception in contemporary music. \"Kanye, T-Pain, Travis Scott, and many others really went to town with auto-tune.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 100 Greatest Rock Moments of the Millennium So Far - Part 5: (60-51)","url":"https://www.youtube.com/watch?v=uEe_HLUay5M"}]}],"awards":[{"kind":"award","title":"Latin Grammy Award for Best Short Form Music Video (2020) — TKN","body":"Won.","year":2020,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q6496387"}]},{"kind":"award","title":"MTV Video Music Award for Best Hip-Hop Video (2021) — FRANCHISE","body":"Won.","year":2021,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q263702"}]}],"concerts":[{"kind":"concert","title":"Astroworld Festival","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[{"kind":"xref","title":"Pioneer of Exaggerated Auto-Tune Use","body":"Kanye is recognized as one of the artists who \"really went to town with auto-tune,\" utilizing the technology not just for subtle pitch correction but for highly exaggerated and distinct vocal effects. His influential work contributed significantly to the trend of Auto-Tune being used as a deliberate stylistic choice in popular music. \"Kanye, T-Pain, Travis Scott, and many others really went to town with auto-tune.\"","year":null,"extra":{"from":"Kanye","from_id":157724492264592,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The 100 Greatest Rock Moments of the Millennium So Far - Part 5: (60-51)","url":"https://www.youtube.com/watch?v=uEe_HLUay5M"}]},{"kind":"xref","title":"Pioneer of Exaggerated Auto-Tune Use","body":"T-Pain is cited as an artist who \"really went to town with auto-tune,\" employing the software for pronounced, stylistic vocal effects that extended beyond simple pitch correction. His widespread and distinctive use of Auto-Tune played a crucial role in popularizing its exaggerated application in mainstream music. \"Kanye, T-Pain, Travis Scott, and many others really went to town with auto-tune.\"","year":null,"extra":{"from":"T-Pain","from_id":15147334268173,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The 100 Greatest Rock Moments of the Millennium So Far - Part 5: (60-51)","url":"https://www.youtube.com/watch?v=uEe_HLUay5M"}]}],"charts":[{"id":94299610304358,"type":"album","name":"Rodeo","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":477,"year":2015,"note":null,"yt":"pQZqRFYwBMY","scaruffi":null},{"id":13254642758765,"type":"album","name":"Rodeo (Expanded Edition)","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":479,"year":2015,"note":null,"yt":"8nC20JOz4CE","scaruffi":null},{"id":94299610304358,"type":"album","name":"Rodeo","list_id":43654442755664,"list":"RYM Top — Hip Hop","src":"musthear","rank":50,"year":2015,"note":null,"yt":"pQZqRFYwBMY","scaruffi":null},{"id":94299610304358,"type":"album","name":"Rodeo","list_id":30975222555123,"list":"RYM Top — Hip Hop — Trap","src":"musthear","rank":1,"year":2015,"note":null,"yt":"pQZqRFYwBMY","scaruffi":null},{"id":94299610304358,"type":"album","name":"Rodeo","list_id":255227989163511,"list":"RYM Top — Scenes & Movements","src":"musthear","rank":82,"year":2015,"note":null,"yt":"pQZqRFYwBMY","scaruffi":null},{"id":94299610304358,"type":"album","name":"Rodeo","list_id":218288666034832,"list":"RYM Top — Scenes & Movements — Southern Hip Hop","src":"musthear","rank":7,"year":2015,"note":null,"yt":"pQZqRFYwBMY","scaruffi":null},{"id":37019935820631,"type":"song","name":"Antidote","work_year":2016,"list_id":18536206246500,"list":"Billboard Year-End 2016","src":"singles","rank":75,"year":2016,"note":"","yt":"KnZ8h3MRuYg","scaruffi":null},{"id":37019935820631,"type":"song","name":"Antidote","work_year":2016,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":75,"year":2016,"note":null,"yt":"KnZ8h3MRuYg","scaruffi":null},{"id":163993763720080,"type":"song","name":"Goosebumps","w