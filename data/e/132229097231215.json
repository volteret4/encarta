{"id":132229097231215,"type":"album","name":"Mental Vortex","artist":"Coroner","year":1991,"weight":12,"info":{"cover":"https://i.discogs.com/I1Z8is0jx_ww7rSKDwVSPZO7H3lONYY0Ckz-WkuYlzg/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTE3MzQ1/ODgtMTcxOTI2MTUx/OS05NDg2LmpwZWc.jpeg","sputnik":4.38,"yt":"HpHEnveEeCc","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/coroner/mental-vortex/","sputnikmusic":"https://www.sputnikmusic.com/album/10177/Coroner-Mental-Vortex/"},"desc":"Mental Vortex is the fourth album by the Swiss thrash metal band Coroner, released on 12 August 1991. Mental Vortex continues Coroner's experimental approach established in its predecessor, No More Color (1989), blending thrash metal with progressive, jazz fusion, and avant-garde influences. About the album's direction, Eduardo Rivadavia of AllMusic claims, \"Unbridled speed and aggression were replaced by highly technical and unconventional songwriting.\" Ron Broder (as Ron Royce) – vocals, bass Tommy Vetterli (as Tommy T. Baron) – guitars Marky Edelmann (as Marquis Marky) – drums, cover concept and design ."},"artist_ref":{"id":280551793395304,"name":"Coroner","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Coroner_%28cropped%29.jpg?width=500"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"musthear,rym"},{"id":171871969725315,"type":"genre","name":"Thrash Metal","artist":null,"year":null,"weight":278,"yt":null,"src":"rym"},{"id":180481316821856,"type":"genre","name":"Technical Thrash Metal","artist":null,"year":null,"weight":205,"yt":null,"src":"rym"}],"lists":[{"id":198714299897696,"name":"RYM Top — Rock — Technical Thrash Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":2,"year":null,"note":null,"total":200,"scaruffi":null},{"id":222945056519976,"name":"Sputnikmusic Best Albums 1991","src":"charts","grp":"sputnikmusic","list_year