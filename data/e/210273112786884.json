he Stray Cats, but then it just kind of went away.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 4: The Revivals","url":"https://www.youtube.com/watch?v=HSvgRyGiOpE"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best New Artist (1983)","body":"Nominated.","year":1983,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1453643"}]}],"concerts":[],"xref":[],"charts":[{"id":141366298580747,"type":"album","name":"Stray Cats","list_id":240735758437916,"list":"RYM Top — Rock — Rock & Roll","src":"musthear","rank":21,"year":1981,"note":null,"yt":"0lAq6mPoAZw","scaruffi":7.0},{"id":152720561734950,"type":"album","name":"Gonna Ball","list_id":240735758437916,"list":"RYM Top — Rock — Rock & Roll","src":"musthear","rank":102,"year":1981,"note":null,"yt":"Vqc4u-B1x1A","scaruffi":null},{"id":141366298580747,"type":"album","name":"Stray Cats","list_id":26210831213670,"list":"RYM Top — Rock — Rockabilly","src":"musthear","rank":13,"year":1981,"note":null,"yt":"0lAq6mPoAZw","scaruffi":7.0},{"id":152720561734950,"type":"album","name":"Gonna Ball","list_id":26210831213670,"list":"RYM Top — Rock — Rockabilly","src":"musthear","rank":47,"year":1981,"note":null,"yt":"Vqc4u-B1x1A","scaruffi":null},{"id":141366298580747,"type":"album","name":"Stray Cats","list_id":52032266791182,"list":"Scaruffi 1980s","src":"musthear","rank":734,"year":1981,"note":null,"yt":"0lAq6mPoAZw","scaruffi":7.0},{"id":246024612362079,"type":"song","name":"\"Runaway Boys\" ‡","work_year":1981,"list_id":167954413065108,"list":"UK Singles Chart","src":"charts","rank":4,"year":1981,"note":null,"yt":null,"scaruffi":null},{"id":101054117083182,"type":"song","name":"Stray Cat Strut","work_year":1983,"list_id":120682792121633,"list":"Billboard Year-End 1983","src":"singles","rank":42,"year":1983,"note":"","yt":"mbAyj1h9vI0","scaruffi":null},{"id":114987948135484,"type":"song","name":"(She's) Sex