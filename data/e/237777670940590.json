{"id":237777670940590,"type":"album","name":"Dopesmoker","artist":"Sleep","year":2003,"weight":13,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/17581-dopesmoker.jpg","aoty":90,"aoty_user":81,"yt":"Br3-VcGi4a8","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/sleep/dopesmoker-11/","aoty":"https://www.albumoftheyear.org/album/17581-sleep-dopesmoker.php"},"desc":"Dopesmoker is an album by the stoner/doom metal band Sleep. Consisting of a single song an hour and three minutes long, it was originally recorded in 1996, but due to legal issues the album was trimmed down about ten mintutes. It was then released in 1999 as Jerusalem after being separated into six separate tracks. The full 63:31 track was not released until 2003, along with a live version of the song \"Sonic Titan.\" In 2012, record label Southern Lord remastered and re-released the album with new artwork, as well as adding a live version of the song \"Holy Mountain\" ."},"artist_ref":{"id":218609080648544,"name":"Sleep","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Sleep_at_the_Filmore_Detroit%2C_March_31%2C_2018.jpg?width=500"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"rym"},{"id":64491050809040,"type":"genre","name":"Doom Metal","artist":null,"year":null,"weight":376,"yt":null,"src":"rym"},{"id":77376330613218,"type":"genre","name":"Stoner Metal","artist":null,"year":null,"weight":213,"yt":null,"src":"rym"}],"lists":[{"id":64803615322804,"name":"RYM Top — Rock — Stoner Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":68519467142167,"name":"RYM Top — Rock — Doom Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":6,"year":null,"note":null,"total":200,"scaruffi":null},{"id":136877365715781,"name":"Albums as Described by Spongebob Squarepants quotes","src":"musthear","gr