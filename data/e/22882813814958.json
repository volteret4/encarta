p","rank":159,"scaruffi":7.0}],"n_lists":2}},{"id":65418281435572,"type":"song","name":"Morning Has Broken","artist":"Cat Stevens","year":1972,"weight":14,"yt":"DmAOBosGlHY","src":"charts,ensayos,singles","from":{"books":[],"podcasts":[{"name":"For the Record - The 70s","n":3}],"lists":[{"id":68619710521645,"name":"Billboard Year-End 1972","rank":44,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":44,"scaruffi":null}],"n_lists":2}},{"id":230505166541537,"type":"song","name":"Foreigner","artist":"Cat Stevens","year":1973,"weight":6,"yt":"OsWvMFITbGE","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":135043236574537,"type":"song","name":"Oh Very Young","artist":"Cat Stevens","year":1974,"weight":4,"yt":"bP6B9HttRI8","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":206350144726225,"name":"Billboard Year-End 1974","rank":70,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":70,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":190318565344926,"type":"genre","name":"Folk Pop","n":7},{"id":194427380844280,"type":"genre","name":"Folk Rock","n":5},{"id":223327500886715,"type":"genre","name":"Contemporary Folk","n":3},{"id":156823753286980,"type":"genre","name":"folk","n":2},{"id":156493887492965,"type":"genre","name":"Second British Folk Revival","n":2},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":2},{"id":153170436375,"type":"genre","name":"Chamber Folk","n":2},{"id":251671925246370,"type":"genre","name":"Soft Rock","n":1},{"id":202159817309393,"type":"genre","name":"blues","n":1},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":151122137144650,"name":"Beat, R&B y mod pop británico","book":"1966: The Year the Decade Exploded","author":"Jon Savage","start":1963,"end":1967,"desc":"Tras el éxito de los Beatles, las cuatro grandes discográficas (EMI, Decca, Pye y Philips) saquearon metódicamente las provincias: firmaban barato y esperaban a ver qué pegaba. Pye, del veterano Louis Benjamin, tenía a los Kinks y a los Searchers y fama de contratos miserables. Los Ugly’s de Birmingham, nacidos del skiffle y curtidos en los clubes alemanes, se distinguían por su conciencia social; la cara B de su tercer single, «A Quiet Explosion» (21 de enero de 1966), con órgano Vox Continental, un riff con eco a lo Delia Derbyshire y un bajo descendente que es la bomba cayendo, desapareció en la sobreproducción del momento, pero es un disco extraño y auténtico que se acerca a la psicodelia. A principios de 1966 las bases del beat y del R&B se llevaron al límite, como bajo una enorme presión: «Keep on Running» de Spencer Davis casa soul y mod pop, los Wheels de Belfast aceleran sin freno en «Bad Little Woman» y los Poets de Glasgow, de Andrew Loog Oldham, desquician el «Baby Don’t You Do It» de Marvin Gaye.","color":"#ef4444","family":"Beat británico, mod y freakbeat","link":"https://volteret4.github.io/1966/#beat-britanico"},{"id":243962098886055,"name":"Carreras en solitario: cantautores de finales de los sesenta","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1967,"end":1972,"desc":"Los excéntricos de Los Ángeles (David Axelrod, cuyos breakbeats orquestales anticipan el trip-hop; Van Dyke Parks y su música de cámara pop; David Ackles, Kim Fowley, Wild Man Fischer) y los herederos del Greenwich (Laura Nyro, Eric Andersen, David Peel, Angus MacLise y Nico, cuyas letanías fúnebres inventan el rock gótico casi por accidente: Marble Index, Desert Shore). Canadá aporta a Leonard Cohen, Gordon Lightfoot, Joni Mitchell (Blue, Hejira) y Neil Young, que con Dylan y Springsteen forma la gran tríada «moral» de la música americana e inventa la guitarra distorsionada que influirá en el grunge. En Texas, Townes Van Zandt; en Gran Bretaña, Scott Walker, Nick Drake (Pink Moon), Roy Harper, John Martyn, Cat Stevens, Rod Stewart, Eric Burdon y Jack Bruce.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#solo-60s"}],"book_tracks":[{"id":220950390657762,"artist":"Cat Stevens","artist_id":22882813814958,"title":"I Love My Dog","year":1966,"ess":1,"yt":"ET5drt_utUY","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Beat, R&B y mod pop británico","scene_id":151122137144650,"scene_link":"https://volteret4.github.io/1966/#beat-britanico","chapters":["Discografía: Los singles de cada mes de 1966"],"pages":[[1,398]]},{"id":240432716731220,"artist":"Cat Stevens","artist_id":22882813814958,"title":"Portobello Road","year":1966,"ess":1,"yt":"sZUbi8serW8","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Beat, R&B y mod pop británico","scene_id":151122137144650,"scene_link":"https://volteret4.github.io/1966/#beat-britanico","chapters":["Discografía: Los singles de cada mes de 1966"],"pages":[[1,398]]},{"id":47859959385244,"artist":"Cat Stevens","artist_id":22882813814958,"title":"Tea For The Tillerman","year":1970,"ess":1,"yt":"Q6rGG8UBkvY","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Carreras en solitario: cantautores de finales de los sesenta","scene_id":243962098886055,"scene_link":"https://volteret4.github.io/scaruffi/#solo-60s","chapters":["Sección 3.3"],"pages":[[1,55,null]]},{"id":107912000265889,"artist":"Cat Stevens","artist_id":22882813814958,"title":"Teaser And The Firecat","year":1971,"ess":1,"yt":"VN7hCTF9454","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scar