{"id":94937981388481,"type":"artist","name":"The Smithereens","artist":null,"year":null,"weight":28,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Smithereens4235.jpg?width=500","bio":"The Smithereens  son una banda de rock de Carteret, Nueva Jersey, Estados Unidos. El grupo, fundado en 1980, lo formaron inicialmente Pat DiNizio (voz y guitarra),  Jim Babjak (guitarra y voz) , Dennis Diken (batería y percusión) y Mike Mesaros (bajo y voces) hasta el 2006, cuando Mike salió del banda. Severo The Thrilla Jornacion (bajo) que actualmente ocupa su lugar.\n\nBabjak, Diken y Mesaros son de Carteret, Nueva Jersey y se graduaron en 1975 de Carteret High School.","tags":["power pop","rock","80s","alternative","college rock"]},"works":[{"id":256652949532422,"type":"album","name":"Especially For You","artist":"Smithereens","year":1986,"weight":12,"yt":"gWX3-96H3C0","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":716,"scaruffi":7.0},{"id":22099031234954,"name":"RYM Top — Rock — Power Pop","rank":190,"scaruffi":7.0}],"n_lists":2}},{"id":81333316541399,"type":"album","name":"Green Thoughts","artist":"Smithereens","year":1988,"weight":12,"yt":"ZOkna9IwH8k","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":197,"scaruffi":7.5}],"n_lists":1}},{"id":159578974706550,"type":"song","name":"A Girl Like You","artist":"Smithereens","year":1989,"weight":6,"yt":"OwvEYtzV23k","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":169091910736036,"type":"song","name":"Top Of The Pops","artist":"Smithereens","year":1991,"weight":6,"yt":"RF-ezZ1wPOw","src":"books","from":