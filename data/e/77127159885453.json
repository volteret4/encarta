ull}],"n_lists":2}},{"id":67732491158796,"type":"album","name":"Twentyfour","artist":"Al Di Meola","year":2024,"weight":5,"yt":"znArzQHXJYw","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":208328740729479,"name":"RYM Top — Jazz — Flamenco Jazz","rank":14,"scaruffi":null},{"id":29919886649658,"name":"RYM Top — Regional Music — Flamenco","rank":120,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":103739021328537,"type":"genre","name":"Flamenco","n":6},{"id":91814632853217,"type":"genre","name":"Flamenco Jazz","n":5},{"id":89886331015150,"type":"genre","name":"Jazz Fusion","n":3},{"id":195956823575179,"type":"genre","name":"Rioplatense Music","n":2},{"id":171816200013994,"type":"genre","name":"Iberian Music","n":2},{"id":143166622644617,"type":"genre","name":"Tango","n":2},{"id":56600568254045,"type":"genre","name":"Spanish Music","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":252985387046118,"name":"Paco de Lucía","book":"El flamenco contado con sencillez","author":"Carlos Arbelos","start":1958,"end":2002,"desc":"El músico flamenco más popular del mundo y el gran responsable de que hoy la guitarra y el toque en solitario tengan el valor que tienen: hace cincuenta años un concierto de guitarra era una rareza. Aprendió de su padre y de su hermano Ramón; a los doce años formó con su hermano Pepe Los Chiquitos de Algeciras (premio en Jerez en 1962) y Sabicas le aconsejó dejar de imitar al Niño Ricardo. En los sesenta y primeros setenta acompañó a bailaores y cantaores como Fosforito y formó con Camarón el mejor dúo del momento. Fuente y caudal (1973) y su rumba «Entre dos aguas» fueron su primer gran éxito. Ya en 1967 tocó con el saxofonista Pedro Iturralde y en Berlín conoció a Monk y Miles Davis; a finales de los setenta giró con Santana, Al Di Meola, John McLaughlin, Larry Coryell o Chick Corea. De ahí salieron su sexteto (Pepe y Ramón de Lucía, Carles Benavent al bajo, Jorge Pardo al saxo, Rubén Dantas a la percusión) y el trío de guitarras, cuyo Friday Night in San Francisco vendió más de un millón de copias. Donn E. Pohren temía que perdiera su identidad; Zyryab, con Chick Corea al piano, es una vuelta a los orígenes con el nombre del músico de la Córdoba califal.","color":"#d6a35c","family":"El toque: la guitarra flamenca","link":"https://volteret4.github.io/Flamenco/#paco-de-lucia"},{"id":70279236005425,"name":"Fusión jazz-rock","book":"Historia del jazz","author":"Ted Gioia","start":1967,"end":1995,"desc":"El jazz siempre fue fusión («nada de lo que venga de Nueva Orleans es puro»), pero desde Bitches Brew (400.000 copias el primer año) la palabra significa jazz con rock, y amplía la base económica de todo el jazz en los setenta. Miles sigue con discos crudos montados por Teo Macero (Jack Johnson, Live-Evil, On the Corner) y acaba de telonero de los Headhunters de Herbie Hancock. Sus antiguos músicos fundan los grupos clave: Return to Forever de Chick Corea (sabor latino, «Spain»), la Mahavishnu Orchestra de John McLaughlin (rock a lo Hendrix, música india) y Weather Report de Zawinul y Shorter, una estética de Ellington aplicada al pop electrónico, con el bajo de Jaco Pastorius («Birdland»). Del lado del rock: Blood, Sweat & Tears, Chase, Hendrix, Sly Stone y Frank Zappa. Luego llegan el jazz pulido para la radio, Spyro Gyra y Kenny G, el M-Base de Steve Coleman y Cassandra Wilson, el acid jazz de Londres y US3, y el último Miles con el hip hop de doo-bop. Pat Metheny es el guitarrista más visionario del estilo.","color":"#a3e635","family":"Fusión: jazz-rock, ECM y músicas del mundo","link":"https://volteret4.github.io/jazz/#fusion-jazz-rock"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":17636678439756,"type":"album","name":"Land of the Midnight Sun","list_id":235110983059095,"list":"RYM Top — Jazz — Jazz Fusion","src":"musthear","rank":157,"year":1976,"note":null,"yt":"G3wmODNPHAk","sca