odcasts":[{"name":"Music Radar Clan","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[{"id":170438788671559,"type":"genre","name":"Black Metal","artist":null,"year":null,"weight":313,"yt":null,"src":"ensayos"},{"id":181618155644956,"type":"genre","name":"Viking Metal","artist":null,"year":null,"weight":203,"yt":null,"src":"ensayos"}],"album_genres":[{"id":255263121494129,"type":"genre","name":"Metal","n":9},{"id":185670346256268,"type":"genre","name":"rock","n":9},{"id":170438788671559,"type":"genre","name":"Black Metal","n":6},{"id":190704175116840,"type":"genre","name":"Progressive Metal","n":5},{"id":181618155644956,"type":"genre","name":"Viking Metal","n":3}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":1220976824039,"name":"Metal de los noventa: progresivo, death y black metal","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2000,"desc":"Si los ochenta fueron la edad de oro del heavy metal, los noventa lo fragmentan en estilos que amplían ideas anteriores. El pop-metal (Warrant, Extreme, Live) es lo menos significativo; Marilyn Manson casa el scum-rock de Alice Cooper con el industrial de Nine Inch Nails. El metal progresivo (Warrior Soul, Dream Theater, Royal Hunt, Opeth, los suizos Alboth!). El death metal muta en algo más terrible y más musical gracias a Brutal Truth, Cannibal Corpse y, sobre todo, la tríada de Type O Negative (Slow Deep And Hard, misas negras wagnerianas), Today Is The Day y Fear Factory; Biohazard, Coalesce, Dillinger Escape Plan. El nuevo black metal escandinavo: Entombed, Darkthrone, Immortal, Mayhem, Enslaved, Emperor, Satyricon, Cradle Of Filth.","color":"#f87171","family":"Hard rock, metal y grunge","link":"https://volteret4.github.io/scaruffi/#metal-90s"}],"book_tracks":[{"id":150514683033031,"artist":"Enslaved","artist_id":93952972504916,"title":"Eld","year":1997,"ess":0,"yt":"Ceds_1ep4Fg","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Metal de los noventa: progresivo, death y black metal","scene_id":1220976824039,"scene_link":"https://volteret4.github.io/scaruffi/#metal-90s","chapters":["Sección 6.16"],"pages":[[1,288,null]]}],"mentions":[],"podcast":[{"kind":"podcast","title":"Return After Hiatus","body":"This group, from the Nordic countries and considered one of the most consolidated and mythical acts in black metal and Viking metal, is releasing a new album after a period of releasing very little material in recent years. \"es un grupo de black metal o de beking metal porque es de black metal de la zona de los países nórdicos, posiblemente uno de los grupos más consolidados, inmíticos de este movimiento, creí que le había perdido la pista pero no, es que habían estado sacando muy poco material y muy pocas cosas en los últimos años y sacan ahora nuevo disco bastante tiempo más adelante.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Lanzamientos de Octubre 2017","url":"https://www.youtube.com/watch?v=q1_bxi16osQ"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":62458170624061,"type":"album","name":"Hordanes Land","work_year":1993,"list_id":59251635065665,"list":"Sputnikmusic Best Albums 1993","src":"charts","rank":113,"year":1993,"note":null,"yt":"3vjUjL-r6zg","scaruffi":null},{"id":135657147309498,"type":"album","name":"Vikingligr Veldi","list_id":31538438098055,"list":"RYM Top — Rock — Black Metal","src":"musthear","rank":57,"year":1994,"note":null,"yt":"coJ_O3YYcNY","scaruffi":7.0},{"id":103933242936959,"type":"album","name":"Frost","list_id":31538438098055,"list":"RYM Top — Rock — Black Metal","src":"musthear","rank":173,"year":1994,"note":null,"yt":"nfY9y8LTvJI","scaruffi":null},{"id":135657147309498,"type":"album","name":"Vikingligr Veldi","work_year":1994,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":654,"year":1994,"note":null,"yt":"coJ_O3Y