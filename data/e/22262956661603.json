{"id":22262956661603,"type":"album","name":"L'Esprit","artist":"In The Nursery","year":1990,"weight":12,"info":{"cover":"https://dn710907.ca.archive.org/0/items/mbid-0093f2f9-3c5c-4d5c-9782-82b99dab707d/mbid-0093f2f9-3c5c-4d5c-9782-82b99dab707d-11176647303.jpg","kind":"Album","tracks":15,"country":"BE","scaruffi":7.0,"yt":"LevwwkmKty8","links":{"spotify":"https://open.spotify.com/album/6dAvQuIPY6w9Bmr8gx85Jq","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_kKEjTXFBQPspbImiwmLSB8-XjSCM6BRqk","bandcamp":"https://inthenursery.bandcamp.com/album/lesprit"},"desc":"L'esprit was initially intended as a double album project. It was also to be on Sweatbox Records, but the label went bust which left the band looking for a suitable company to pick up the new album. One phone call clinched the deal and saw ITN entering into a special working relationship with Gary Levermore at Third Mind Records. The album was also the first complete album featuring the engineering skills of Steve Harris. Steve has become an essential player in the ITN sound and has continued working with the band on all following releases. Meat Beat Manifesto, Sweatbox label ."},"artist_ref":{"id":178235193956102,"name":"In The Nursery","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/In_the_Nursery.jpg?width=500"}},"labels":[],"genres":[{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"musthear"},{"id":109586473279154,"type":"genre","name":"Modern Classical","artist":null,"year":null,"weight":136,"yt":null,"src":"musthear"}],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","src":"charts","grp":"Scaruffi","list_year":null,"rank":780,"year":1990,"note":null,"total":1406,"scaruffi":7.0}],"podcast":[],"book_tracks":[{"id":22262956661603,"artist":"In The Nursery","artist_id":178235193956102,"title":"L'Esprit","year":1990,"ess":0,"yt":"eo8c15eB8WY","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","a