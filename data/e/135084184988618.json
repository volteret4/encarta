{"id":135084184988618,"type":"album","name":"Sleeper Catcher","artist":"Little River Band","year":1978,"weight":10,"info":{"img":null},"artist_ref":{"id":197699434902957,"name":"Little River Band","info":{"img":null}},"labels":[],"genres":[],"lists":[],"podcast":[{"kind":"podcast","title":null,"body":"Released in June 1978, this was the band's fourth studio album. The Australian pressing of the album featured a \"much more prog rock type of opening,\" described as \"creative and complex,\" which differed significantly from the US issue. Despite containing future hits like \"Reminiscing,\" the US record label initially received it with skepticism, asking \"where are the singles.\" \"That is from Little River bands fourth studio album sleeper catcher released in June 1978.\"","year":1978,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 51 - The Softer Side of 70s Rock","url":"https://seventies.libsyn.com/ep-51-the-softer-side-of-70s-rock"},{"source":"For the Record - The 70s","episode":"Ep. 51 - The Softer Side of 70s Rock","url":null}]}],"book_tracks":[],"others":[{"id":116492426557517,"type":"song","name":"Reminiscing","year":1978,"weight":14},{"id":251644209490498,"type":"song","name":"Lonesome Loser","year":1979,"weight":4},{"id":247177360010771,"type":"song","name":"Take It Easy on Me","year":1982,"weight":4},{"id":244097287520371,"type":"song","name":"Cool Change","year":1980,"weight":4},{"id":234515851218861,"type":"song","name":"Lady","year":1979,"weight":4},{"id":162617612381349,"type":"song","name":"Man on Your Mind","year":1982,"weight":4},{"id":96647596269102,"type":"song","name":"The Other Guy","year":1983,"weight":4},{"id":176106082691705,"type":"album","name":"Time Exposure","year":1981,"weight":3},{"id":7494004907167,"type":"album","name":"After Hours","year":1976,"weight":3},{"id":5635959393423,"type":"album","name":"Diamantina Cocktail","year":1977,"weight":3}]}