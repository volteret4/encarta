{"id":73748845330201,"type":"album","name":"White Ladder","artist":"David Gray","year":1998,"weight":15,"info":{"cover":"https://dn710708.ca.archive.org/0/items/mbid-8ef2dfc4-4ac5-43a3-b824-be1de3fb3092/mbid-8ef2dfc4-4ac5-43a3-b824-be1de3fb3092-17513904521.jpg","yt":"VsDMjet0fyo","desc":"White Ladder is the fourth studio album by English singer-songwriter David Gray. It was first released in November 1998 through Gray's own record label, IHT Records, but failed to chart. On 24 April 2000, the album was re-released by Dave Matthews' label ATO Records and debuted at number 69 on the UK Albums Chart, before climbing to number one on 5 August 2001, more than a year later. White Ladder produced five singles, including the hit \"Babylon\", which ignited interest in the album and shot Gray to worldwide fame. Other singles released from the album were \"This Year's Love\", \"Please ."},"artist_ref":{"id":105445785433454,"name":"David Gray","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/David_Gray_%28227236934%29.jpg?width=500"}},"labels":[],"genres":[{"id":8412226417108,"type":"genre","name":"Indie Rock","artist":null,"year":null,"weight":1139,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":156823753286980,"type":"genre","name":"folk","artist":null,"year":null,"weight":510,"yt":null,"src":"musthear"},{"id":251671925246370,"type":"genre","name":"Soft Rock","artist":null,"year":null,"weight":418,"yt":null,"src":"musthear"},{"id":223327500886715,"type":"genre","name":"Contemporary Folk","artist":null,"year":null,"weight":247,"yt":null,"src":"musthear"}],"lists":[{"id":192934750972716,"name":"1001 Albums You Must Hear Before You Die","src":"charts","grp":"1001 Albums","list_year":null,"rank":865,"year":1998,"note":null,"total":999,"scaruffi":null}],"podcast":[],"book_tracks":[{"id":73748845330201,"artist":"David Gray","artist_id":105445785433454,"titl