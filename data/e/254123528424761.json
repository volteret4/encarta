,{"source":"Hit Parade Music History and Music Trivia","episode":"Material Girl in an Imperial World Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4f03154465cd600c5379"}]}],"awards":[{"kind":"award","title":"Time 100 (2018)","body":"Won.","year":2018,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q604370"}]},{"kind":"award","title":"Genesis Award","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q135498"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Hetty Fwins (2012)","body":null,"year":2012,"extra":{"from":"The Flaming Lips","from_id":63485606757536,"type":"album"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock And Roll Myths","url":"https://www.youtube.com/watch?v=sQrbNUDZuOQ"}]},{"kind":"xref","title":"Blood-Infused Vinyl Edition","body":"For their 2012 Record Store Day release, \"Hetty Fwins,\" The Flaming Lips created a special clear vinyl edition that visibly contained traces of the band's blood. They also extended this practice to their collaborators, demanding that artists like Chris Martin of Coldplay, Kesha, and Yoko Ono contribute their own blood for ten ultra-rare special editions of the record. \"Not only did the clear vinyl vividly show traces of flaming lips blood, but the band also demanded that any of the collaborators on this record also contribute their precious bodily fluid for 10 special editions of the record.\"","year":null,"extra":{"from":"The Flaming Lips","from_id":63485606757536,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock And Roll Myths","url":"https://www.youtube.com/watch?v=sQrbNUDZuOQ"}]},{"kind":"xref","title":"Contribution to Flaming Lips Blood-Infused Vinyl","body":"Chris Martin, along with other collaborators like Kesha and Yoko Ono, contributed his \"precious bodily fluid\" for ten special editions of The Flaming Lips' 2012 Record Store Day vinyl, \"Hetty Fwins,\" which featured traces of blood in the clear vinyl. \"Chris Martin of Coldplay.\"","year":null,"extra":{"from":"Coldplay","from_id":253536955654314,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock And Roll Myths","url":"https://www.youtube.com/watch?v=sQrbNUDZuOQ"}]},{"kind":"xref","title":"Contribution to Flaming Lips Blood-Infused Vinyl","body":"Yoko Ono was among the collaborators, including Chris Martin and Kesha, who were asked to contribute their \"precious bodily fluid\" for ten special editions of The Flaming Lips' 2012 Record Store Day vinyl, \"Hetty Fwins,\" which featured traces of blood in its clear vinyl. \"Yoko Ono?\"","year":null,"extra":{"from":"Yoko Ono","from_id":178585470723880,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock And Roll Myths","url":"https://www.youtube.com/watch?v=sQrbNUDZuOQ"}]}],"charts":[{"id":106827045707232,"type":"song","name":"Tik Tok","work_year":2010,"list_id":2277430950002,"list":"Billboard Hot 100 nº1 · 2010s","src":"singles","rank":980,"year":2010,"note":"9 semanas","yt":"iP6XpLQM2Cs","scaruffi":null},{"id":61541272316956,"type":"song","name":"We R Who We R","work_year":2011,"list_id":2277430950002,"list":"Billboard Hot 100 nº1 · 2010s","src":"singles","rank":992,"year":2010,"note":"1 semanas","yt":"mXvmSaE0JXA","scaruffi":null},{"id":106827045707232,"type":"song","name":"Tik Tok","work_year":2010,"list_id":240548470678298,"list":"Billboard Year-End 2010","src":"singles","rank":1,"year":2010,"note":"","yt":"iP6XpLQM2Cs","scaruffi":null},{"id":233964824050478,"type":"song","name":"Your Love Is My Drug","work_year":2010,"list_id":240548470678298,"list":"Billboard Year-End 2010","src":"singles","rank":28,"year":2010,"note":"","yt":"QR_qa3Ohwls","scaruffi":null},{"id":229623397106253,"type":"song","name":"Take It Off","work_year":2010,"list_id":240548470678298,"list":"Billboard Year-End 2010","src":"si