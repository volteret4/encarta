{"id":104459948954263,"type":"album","name":"In the Flat Field","artist":"Bauhaus","year":1980,"weight":22,"info":{"cover":"https://lastfm.freetls.fastly.net/i/u/300x300/125ce21f5d1c47eb9b96071faf806c41.png","aoty":83,"aoty_user":81,"yt":"CTYntCRHpUM","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/bauhaus/in-the-flat-field/","aoty":"https://www.albumoftheyear.org/album/15923-bauhaus-in-the-flat-field.php"},"desc":"In The Flat Field is the debut studio album by English gothic rock band Bauhaus. It was recorded on 4 December 1979 at BBC Maida Vale Studios, London and in June–July 1980 at Southern Studios, London, England. In The Flat Field was released on 1 October 1980 by record label 4AD. It is considered one of the first gothic rock records. Following a 30-date tour, Bauhaus set out to Southern Studios in London to record their first album. As the band had a clear conception of what they wanted the record to sound like, they opted to produce it themselves. ."},"artist_ref":{"id":211486827717247,"name":"Bauhaus","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bauhaus_concert.jpg?width=500"}},"labels":[],"genres":[{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"rym"},{"id":93579530230421,"type":"genre","name":"Gothic Rock","artist":null,"year":null,"weight":272,"yt":null,"src":"rym"}],"lists":[{"id":242669898096444,"name":"RYM Top — Rock — Gothic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":15,"year":null,"note":null,"total":200,"scaruffi":null},{"id":172950565318915,"name":"Holy Trinities @LadoB","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":26,"year":null,"note":null,"total":84,"scaruffi":null},{"id":182218712006755,"name":"RYM Top — Rock — Post-Punk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":