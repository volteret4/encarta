{"id":203684030429690,"type":"album","name":"Amor Prohibido","artist":"Selena","year":1994,"weight":22,"info":{"cover":"https://ia800305.us.archive.org/22/items/mbid-3a602a84-c2a7-48c3-9103-d708885ce870/mbid-3a602a84-c2a7-48c3-9103-d708885ce870-38627889680.jpg","kind":"Album","tracks":10,"country":"MX","aoty":79,"aoty_user":82,"sputnik":3.95,"yt":"TqgxucQP6MA","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/selena/amor-prohibido-4","aoty":"https://www.albumoftheyear.org/album/34287-selena-amor-prohibido.php","sputnikmusic":"https://www.sputnikmusic.com/album/68358/Selena-Amor-Prohibido/"},"desc":"Amor Prohibido (English: Forbidden Love) is the name of an album by Latin superstar Selena. The album remains as the biggest selling Latin album of all time, being certified 20x Platinum (Latin type) by the RIAA for selling over 2 million copies. The album produced four number-one singles (one posthumous) on the Billboard Hot Latin Tracks chart, the only Spanish album by a female to achieve this feat. Album history Continuing the formula of previous albums, A.B. Quintanilla III teamed up with Pete Astudillo and Ricky Vela to come up with what they hoped would be a successful Selena album. ."},"artist_ref":{"id":230686297891003,"name":"Selena","info":{"img":null}},"labels":[],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":118063844428750,"type":"genre","name":"Cumbia","artist":null,"year":null,"weight":208,"yt":null,"src":"musthear,rym"},{"id":7100032433351,"type":"genre","name":"latin","artist":null,"year":null,"weight":122,"yt":null,"src":"musthear"},{"id":70368059943077,"type":"genre","name":"Tejano Music","artist":null,"year":null,"weight":82,"yt":null,"src":"musthear"},{"id":116162141578082,"type":"genre","name":"Latin Pop","artist":null,"year":null,"weight":217,"yt":null,"src":"rym"},{"id":259591533889179,"type":"genre","name":"Mexican Music","artist":null,"year":nul