8,"name":"Billboard Year-End Hot 100","rank":47,"scaruffi":null}],"n_lists":3}},{"id":133426482444865,"type":"album","name":"Waiting to Exhale","artist":"Whitney Houston","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}},{"id":108268666623582,"type":"album","name":"Waiting to Exhale (Soundtrack)","artist":"Whitney Houston","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":251558849995760,"type":"artist","name":"Aretha Franklin","artist":null,"year":1942,"weight":712,"yt":null,"src":"ensayos"},{"id":78214745953114,"type":"artist","name":"Sparkle (actress)","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"},{"id":162775555406296,"type":"artist","name":"Aretha Franklin's backup singer (early career)","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"},{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"ensayos"}],"album_genres":[{"id":264824775713421,"type":"genre","name":"club","n":2},{"id":223122507869858,"type":"genre","name":"Dance-Pop","n":2},{"id":176578125596945,"type":"genre","name":"Contemporary R&B","n":2},{"id":111306765148197,"type":"genre","name":"dance","n":2},{"id":269705969260495,"type":"genre","name":"Disco","n":1},{"id":180142577009784,"type":"genre","name":"ballad","n":1},{"id":124577172288689,"type":"genre","name":"Freestyle","n":1},{"id":44294165522841,"type":"genre","name":"r&b","n":1},{"id":9343125461845,"type":"genre","name":"Adult Contemporary","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":266579790140761,"name":"Naked funk: la era Reagan","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1980,"end":1990,"desc":"La era del naked funk abarca las cimas de Prince, Michael Jackson y los dos mandatos de Reagan: recortes, desindustrialización, millones de sin techo, la «guerra contra las drogas» en lugar de contra la pobreza y, desde 1982, el crack. La música negra se volvió narcisista y escapista, del «yo primero»; las bandas, demasiado caras para la ciudad. La industria ofrecía estereotipos (banda pop, crooner, banda funk guarra, según Jon Pareles), MTV no ponía vídeos negros hasta Thriller y Jackson y Prince marcaron las cuotas del crossover. En 1975 trece números 1 R&B eran funk; en 1985 diecisiete de veinte eran baladas. Warner echó a Clinton y CBS sepultó «Pumpin’ It Up»; murieron o se convirtieron Hathaway, Joe Tex, Marvin Gaye, Al Green, Larry Graham. Las máquinas sustituyeron vientos, órgano (el Yamaha DX7), batería y bajo: solo sobrevivió la guitarra rítmica sobre el bajo sintetizado y la palmada electrónica. La insinuación dejó paso al sexo explícito sin cerebro («Do Me Baby», «Beep a Freak»), y llegaron el bass de Miami (2 Live Crew), Egyptian Lover, el New Jack Swing de Teddy Riley y la farsa de Milli Vanilli. Los funkers de verdad abandonaron la radio: el underground (hip hop, go-go) llevó el funk adelante.","color":"#22d3ee","family":"Funk de los ochenta: Prince, Rick James, electro","link":"https://volteret4.github.io/Funk/#naked-funk"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Breaking on Charts (1985-1986)","body":"Whitney Houston was just breaking on the charts in 1985 and 1986, coinciding with Aretha Franklin's pop explosion, leading to a mutual boosting effect where Houston \"returned gospel-trained R&B vocals to the center of the hit parade.\" \"Whitney was just breaking on the charts herself in 1985 and 86, as Franklin's pop explosion was happening.\"","year":1985,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4eec154465cd600c4d67"}]},{"kind":"podcast","title":"Lack of Appeal to Generation X (1990)","body":"By 1990, the generation that had aged out of pop music from artists like New Kids on the Block was not interested in moving on to artists like Whitney Houston. \"And they certainly weren't interested in moving on to Whitney Houston and Fleetwood Mac.\"","year":1990,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Amazing Year That Was 1991","url":"https://www.youtube.com/watch?v=Rf1tFWQg51Y"}]},{"kind":"podcast","title":"Final Movie Role in \"Sparkle\" Remake (2012)","body":"Whitney Houston portrayed the character of Emma, the mother, in the 2012 remake of the movie \"Sparkle.\" This role marked her final appearance in a film. \"it featured Whitney Houston as the mother, Emma, in her final movie role.\"","year":2012,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Posthumous Hologram Tour (2020)","body":"Two years after other hologram tours began, a Whitney Houston hologram tour was launched, featuring a live band, dancers, and more. This illustrated the increasing sophistication and production value applied to virtual performances of deceased artists, aiming to recreate a full concert experience. \"Two years later, there was a Whitney Houston hologram tour that came with a live band, dancers, and more.\"","year":2020,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 100 Greatest Rock Moments of the Millennium So Far - Part 1: (100-91)","url":"https://www.youtube.com/watch?v=GYUuTbOvyak"}]},{"kind":"podcast","title":"Biopic (Recent)","body":"A recent biopic about Whitney Houston reminded audiences of her dedication to her work, specifically her soulful pouring into songs like \"I Will Always Love You.\" \"As the recent Houston biopic reminded us, she poured her soul into her work.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Hits of the Year Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Hits of the Year Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4f078e6dd12efb02ce81"}]},{"kind":"podcast","title":"Daughter of Cissy Houston","body":"Whitney Houston is the daughter of Cissy Houston, who had previously sung backup for Aretha Franklin for many years. \"daughter of Sissy Houston, who'd sang backup for Aritha for years.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4eec154465cd600c4d67"}]},{"kind":"podcast","title":"Death at Beverly Hills Hilton (Unknown Date)","body":"Whitney Houston was found dead of a drug overdose in Suite 434 of the Beverly Hills Hilton. She had slipped under the water of her bathtub and drowned. \"Whitney Houston, found dead of a drug overdose in Suite 434 of the Beverly Hills, Hilton.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Infamous Hotels and Hotel Rooms","url":"https://www.youtube.com/watch?v=zM3gu_nbw-k"}]},{"kind":"podcast","title":"Pop Dominance (Mid-1980s)","body":"Alongside Huey Lewis, Whitney Houston was instrumental in propelling pop music to the top of the cycle by mid-1984, leading to a period where rock seemed to have \"blown itself out.\" \"Huey Lewis and Whitney Houston propelled pop to the top of the cycle.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt Rock Chapter: 14","url":"https://www.youtube.com/watch?v=MK7L0eCpDHc"}]},{"kind":"podcast","title":"Re-centering the Primacy of Voice","body":"Whitney Houston's breakthrough chart success in 1985 and 1986, with a string of chart-topping hits featuring \"big American gospel power\" in her voice, contributed to the close of the second British invasion by evolving musical taste and re-centering vocal primacy. \"The Breakthrough Chart Act of 1985 and 86 was Whitney Houston, who re-centered the primacy of the voice with big American gospel power in her string of chart-topping hits.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"The British Are Charting Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"The British Are Charting Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4f7a154465cd600c7ae7"}]},{"kind":"podcast","title":"Return to Hot 100 After Death","body":"A decade after Whitney Houston's death, her recording of \"I Will Always Love You\" returned to the upper reaches of the Hot 100. \"When Whitney Houston died a decade ago, there's a reason this recording returned to the upper reaches of the Hot 100.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Hits of the Year Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Hits of the Year Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4f078e6dd12efb02ce81"}]},{"kind":"podcast","title":"Sampled by The Jams","body":"The Justified Ancients of Mu Mu (The Jams) continued to infringe copyrights by using unauthorized samples from Whitney Houston and other artists. \"Unchastened, they continued to infringe copyrights, the mission and possible theme, material from Whitney Houston and others.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Alt-Rock's Most Mysterious Musicians","url":"https://www.youtube.com/watch?v=oGscVtrdER0"}]},{"kind":"podcast","title":"Vocal Godchild of Aretha Franklin","body":"Aretha Franklin considered Whitney Houston her \"de facto vocal God Child,\" highlighting their close personal and musical connection. \"A Do Wet with Franklin's de facto vocal God Child Whitney Houston\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Say a Little Prayer Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4eec154465cd600c4d67"}]}],"awards":[{"kind":"award","title":"NRJ Music Award for International Album of the Year (2000) — My Love Is Your Love","body":"Won.","year":2000,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q3334521"}]},{"kind":"award","title":"New Jersey Hall of Fame (2013)","body":"Won.","year":2013,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q14705795"}]},{"kind":"award","title":"Rock and Roll Hall of Fame (2020)","body":"Won.","year":2020,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q179191"}]},{"kind":"award","title":"Billboard Millennium Award","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q16879031"}]},{"kind":"award","title":"Grammy Awards","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q41254"}]},{"kind":"award","title":"Primetime Emmy Award","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1044427"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Licensed to Kill (1989) – Co-writer","body":null,"year":1989,"extra":{"from":"Narada Michael Walden","from_id":256081845886904,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Bond...James Bond...Music","url":"https://www.youtube.com/watch?v=K0pgJ7XAlpo"}]},{"kind":"xref","title":"Lack of Appeal to Generation X (1990)","body":"By 1990, the generation that had aged out of pop music from artists like New Kids on the Block was not interested in moving on to artists like Fleetwood Mac. \"And they certainly weren't interested in moving on to Whitney Houston and Fleetwood Mac.\"","year":1990,"extra":{"from":"Fleetwood Mac","from_id":146498497979064,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Amazing Year That Was 1991","url":"https://www.youtube.com/watch?v=Rf1tFWQg51Y"}]},{"kind":"xref","title":"Sierra Tucson Rehab and Relapse (1994-1996)","body":"Gahan underwent a period in the expensive Sierra Tucson rehab center in Arizona, which also attempted to help Ringo Starr, Whitney Houston, and Tiger Woods. Upon returning to Los Angeles, he found his house ransacked. He then overdosed on heroin, checking into the Sunset Marquis Hotel where he attempted suicide by slashing his wrists. After waking in a psych ward, he still only desired to get high and tried to hang himself in the bathroom. \"There was a stint in rehab, the very expensive Sierra Tucson and Arizona.\"","year":1994,"extra":{"from":"Depeche Mode","from_id":211118108990164,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"RocknRoll Rehab","url":"https://www.youtube.com/watch?v=EyagC0T7mR4"}]},{"kind":"xref","title":"Jagged Little Pill (1995)","body":null,"year":1995,"extra":{"from":"Alanis Morissette","from_id":197088027671364,"type":"album"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Tales of Weird Rock’n’Roll Sex","url":"https://www.youtube.com/watch?v=DA2iJsu3GRY"}]},{"kind":"xref","title":"Albert Hammond Jr.'s Background and Role","body":"Albert Hammond Jr. is the son of Albert Hammond Sr., a successful songwriter who wrote songs for artists like Celine Dion, Aretha Franklin, Whitney Houston, Willie Nelson, Chicago, and The Carpenters, and had a writing credit on Radiohead's \"Creep.\" In the early days of The Strokes, Albert was the band's business guy, booking gigs and pitching record companies under the pseudonym \"Paul Spencer\" (from his fake ID). He collected rejection letters by posting them on a wall. Crucially, he had a credit card funded by his father, which paid for essential band expenses like guitar strings, cables, drumsticks, and rehearsal PA. \"Albert was the business guy of the band in the early days. He was the guy who booked gigs and pitch record companies, usually under the pseudonym Paul Spencer, which was the name he used on his old fake ID.\"","year":null,"extra":{"from":"The Strokes","from_id":157754209391560,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Strokes","url":"https://www.youtube.com/watch?v=jEfofyobGiI"}]},{"kind":"xref","title":"Pop Dominance (Mid-1980s)","body":"Alongside Whitney Houston, Huey Lewis was instrumental in propelling pop music to the top of the cycle by mid-1984, leading to a period where rock seemed to have \"blown itself out.\" \"Huey Lewis and Whitney Houston propelled pop to the top of the cycle.\"","year":null,"extra":{"from":"Huey Lewis","from_id":115675430828737,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt Rock Chapter: 14","url":"https://www.youtube.com/watch?v=MK7L0eCpDHc"}]},{"kind":"xref","title":"Prolific Songwriter","body":"Albert Hammond Sr. is a successful songwriter who wrote numerous songs for a wide array of prominent artists. His credits include songs for Celine Dion, Aretha Franklin, Whitney Houston, Willie Nelson, Chicago, and The Carpenters. He also received a writing credit on Radiohead's song \"Creep\" due to its melodic resemblance to \"The Air That I Breathe,\" a song he wrote for The Hollies in the 1970s, as determined by a court case. \"He wrote this song. Dad also wrote songs for Celine Dion, where we at the Franklin Whitney Houston, Willie Nelson, Chicago, the Carpenter, and a ton of others.\"","year":null,"extra":{"from":"Albert Hammond Sr.","from_id":155344234761599,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Strokes","url":"https://www.youtube.com/watch?v=jEfofyobGiI"}]},{"kind":"xref","title":"Unauthorized Sampling Controversies","body":"The Jams immediately caused problems by using unauthorized samples from artists like The Beatles and Abba, leading to legal issues. They traveled to Sweden to negotiate with Abba, and upon failure, burned the remaining offending records in a field and threw others into the North Sea. They continued to infringe copyrights, including Whitney Houston's material, before The Jams ended. \"He immediately started causing problems by using unauthorized samples in their material, including from the Beals and Abba, which created all kinds of legal problems, which led them to travel to Sweden to try to negotiate with Abba. When that didn't work, they burned the remaining offending records in the field and through the rest overboard into the North Sea as they took the ferry home. Unchastened, they continued to infringe copyrights, the mission and possible theme, material from Whitney Houston and others, and after a few more months, the Jams were brought to an end.\"","year":null,"extra":{"from":"The KLF","from_id":175070559046094,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Alt-Rock's Most Mysterious Musicians","url":"https://www.youtube.com/watch?v=oGscVtrdER0"}]}],"charts":[{"id":152232893195252,"type":"song","name":"Saving All My Love for You","work_year":1985,