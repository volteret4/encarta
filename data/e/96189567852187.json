ts":[],"lists":[{"id":9974999473034,"name":"RYM Top — Rock — Vocal Surf","rank":54,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[{"id":231745472285915,"type":"genre","name":"Vocal Surf","artist":null,"year":null,"weight":86,"yt":null,"src":"ensayos"}],"album_genres":[{"id":231745472285915,"type":"genre","name":"Vocal Surf","n":9},{"id":256683591146986,"type":"genre","name":"Hot Rod Music","n":2},{"id":211764729901037,"type":"genre","name":"Bubblegum","n":1},{"id":103433233617001,"type":"genre","name":"Sunshine Pop","n":1},{"id":10860579169619,"type":"genre","name":"Doo-Wop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":270959780819050,"name":"Los rockers de garaje","book":"1966: The Year the Decade Exploded","author":"Jon Savage","start":1963,"end":1967,"desc":"En 1966 no tenían nombre (Billboard los llamaba «rockers»); hoy se les llama grupos de garaje. La respuesta creativa americana a la invasión británica: chicos blancos de suburbio que ensayaban en el garaje familiar y tocaban en gimnasios, iglesias y fiestas, con cortes de pelo de Brian Jones, actitud de Jagger, fuzz, rave-ups a lo Yardbirds, Them y Stones y, casi siempre, un órgano Farfisa o Vox con un regusto siniestro de película de terror de autocine. Recuperaban la línea del rock americano de 1963-1964 (Kingsmen, Trashmen) que los Beatles cortaron en seco: «Hanky Panky» de Tommy James, grabado en 1963, fue número 1 en julio de 1966. Ese septiembre las listas se llenaron de discos duros: «96 Tears» de ? and the Mysterians (mexicanoamericanos de Flint, con un órgano hipnótico de otro disco), «Dirty Water» de los Standells, «You’re Gonna Miss Me» de los 13th Floor Elevators y «Psychotic Reaction» de Count Five, calco del «I’m a Man» de los Yardbirds. Quejas dirigidas a las mujeres, pero también una nueva confianza; quejas pequeñas que empezaban a encontrar un objetivo, como en «One of These Days» de los Roosters.","color":"#f97316","family":"Garage y punk americano","link":"https://volteret4.github.io/1966/#garage-rockers"}],"book_tracks":[{"id":265162252372054,"artist":"Jan and Dean","artist_id":96189567852187,"title":"Drag City","year":1963,"ess":0,"yt":"c2GwDGjiV4k","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Los rockers de garaje","scene_id":270959780819050,"scene_link":"https://volteret4.github.io/1966/#garage-rockers","chapters":["Septiembre: 7 And 7 Is: provocaciones, sombras y un nuevo lenguaje"],"pages":[[1,254],[1,475]]}],"mentions":[{"book":"1966: The Year the Decade Exploded","author":"Jon Savage","page":254,"text":"…record that fused surf, rock ’n’ roll and R&B glossolalia. Drag racing crops up in ‘Hey Little Cobra’ by the Rip Cords (#6) and ‘Drag City’ by Jan and Dean (#10). At #9 was the ominous Twilight Zone-inspired instrumental ‘Out of Limits’ by the Marketts. This American style had been knocked out of the…"},{"book":"1966: The Year the Decade Exploded","author":"Jon Savage","page":475,"text":"…role in Stones, 1; singing, 1, 2; stage manner, 1 James, Dawn, 1, 2 James, Tommy, 1 James Bond films, 1, 2, 3, 4 Jameson, Bobby, 1; ‘Vietnam’, 1, 2 Jan and Dean: ‘Drag City’, 1 Jansch, Bert, 1; ‘Needle of Death’, 1 Jardine, Al, 1 Jason Eddie and the Centermen: ‘Singin’ the Blues’, 1 Jaynetts, the, 1; ‘Sally…"}],"podcast":[{"kind":"podcast","title":"Brian Wilson's Songwriting Collaboration (Early 1960s)","body":"In the early 1960s, Brian Wilson collaborated with several songwriters to pen successful hits specifically for the musical duo Jan and Dean. \"Since then, we've also seen Brian Wilson working with several songwriting collaborators to write hits for Jan and Dean.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 117: \"Don't Worry Baby\" by the Beach Boys","url":"https://www.youtube.com/watch?v=hPv7iS8FsbA"}]},{"kind":"podcast","title":"Influenced by Frankie Lymon's Falsetto","body":"Frankie Lymon's innovative use of falsetto in lead vocals for rock and roll is noted as an influence on subsequent vocal groups, possibly including Jan and Dean. \"or a jam and dean... without Limemon, but I doubt it.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 35: \"Why Do Fools Fall In Love?\" by Frankie Lymon and the Teenagers","url":"https://www.youtube.com/watch?v=AtZf9PJEttM"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":217295466508910,"type":"song","name":"Baby Talk","work_year":1959,"list_id":245563783135764,"list":"Billboard Year-End 1959","src":"singles","rank":95,"year":1959,"note":"","yt":"qG5huXG0-X8","scaruffi":null},{"id":217295466508910,"type":"song","name":"Baby Talk","work_year":1959,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":95,"year":1959,"note":null,"yt":"qG5huXG0-X8","scaruffi":null},{"id":71993212219304,"type":"album","name":"Jan & Dean","list_id":246272631382430,"list":"RYM Top — R&B — Doo-Wop","src":"musthear","rank":62,"year":1960,"note":null,"yt":"bDRIN3E0GHk","scaruffi":null},{"id":54525944540276,"type":"song","name":"Surf City","work_year":1963,"list_id":157497903047680,"list":"Billboard Hot 100 nº1 · 1960s","src":"singles","rank":94,"year":1963,"note":"2 semanas","yt":"ERrwjR4ZlfI","scaruffi":null},{"id":54525944540276,"type":"song","name":"Surf City","work_year":1963,"list_id":271704385319129,"list":"Billboard Year-End 1963","src":"singles","rank":22,"year":1963,"note":"","yt":"ERrwjR4ZlfI","scaruffi":null},{"id":54525944540276,"type":"song","name":"Surf City","work_year":1963,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":22,"year":1963,"note":null,"yt":"ERrwjR4ZlfI","scaruffi":null},{"id":265162252372054,"type":"album","name":"Drag City","list_id":217327910479286,"list":"RYM Top — Rock — Hot Rod Music","src":"musthear","rank":5,"year":1963,"note":null,"yt"