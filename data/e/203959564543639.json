6705849,"name":"Pintores de sonido británicos","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1980,"end":2002,"desc":"Veteranos de la new wave que convierten el rock en pintura sonora: Jah Wobble (de los dub sinfónicos de PiL al «Bedroom Album», precursor del lo-fi, y la fusión étnica y dub), Durutti Column y su guitarra impresionista, Bill Nelson, Ryuichi Sakamoto, David Sylvian (la «balada ambient exótica» de Brilliant Trees y Gone To Earth, con Jon Hassell, Holger Czukay y Mark Isham) y Virginia Astley.","color":"#2dd4bf","family":"Vanguardia, electrónica y ambient","link":"https://volteret4.github.io/scaruffi/#sound-painters"},{"id":138785454098987,"name":"Ambient","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1972,"end":2002,"desc":"Sonidos que ocupan el espacio y envuelven al oyente; música estática que parece que no está pero que se siente. Eno la concibió como el equivalente acústico a un cuadro o una bella decoración.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#ambient"}],"book_tracks":[{"id":71656760403274,"artist":"David Sylvian","artist_id":203959564543639,"title":"Brilliant Trees","year":1984,"ess":0,"yt":"bYB-6pfvWNc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Pintores de sonido británicos","scene_id":8157416705849,"scene_link":"https://volteret4.github.io/scaruffi/#sound-painters","chapters":["Sección 5.12"],"pages":[[1,165,null]]},{"id":275468869749893,"artist":"David Sylvian","artist_id":203959564543639,"title":"Words With The Shaman","year":1985,"ess":0,"yt":"dmJkzyiAJtk","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Pintores de sonido británicos","scene_id":8157416705849,"scene_link":"https://volte