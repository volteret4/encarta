{"id":14852373494372,"type":"album","name":"I Robot","artist":"The Alan Parsons Project","year":1977,"weight":16,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/15264-i-robot.jpg","aoty":90,"aoty_user":81,"yt":"-lgsCe-fLG4","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/the-alan-parsons-project/i-robot","aoty":"https://www.albumoftheyear.org/album/15264-the-alan-parsons-project-i-robot.php"},"desc":"\"I Robot\" is a progressive rock album recorded by \"The Alan Parsons Project\", engineered by Alan Parsons and Eric Woolfson. It was released by Arista Records in 1977 and re-released on CD in 1984 and 2007. It was intended to be based on the \"I, Robot\" stories written by Isaac Asimov, and actually Woolfson spoke with Asimov, who was enthusiastic about it. But the rights had already been granted to a TV/movie company, so the album's title was altered slightly by removing the comma, and the theme and lyrics were made to be more generically about robots rather than specific ."},"artist_ref":{"id":58328493458320,"name":"The Alan Parsons Project","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Alan_Parsons_live.jpg?width=500"}},"labels":[],"genres":[{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"rym"},{"id":138197775829889,"type":"genre","name":"Progressive Rock","artist":null,"year":null,"weight":439,"yt":null,"src":"rym"},{"id":132119653572823,"type":"genre","name":"Progressive Pop","artist":null,"year":null,"weight":225,"yt":null,"src":"rym"}],"lists":[{"id":199737804810861,"name":"RYM Top — Pop — Progressive Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":37,"year":null,"note":null,"total":200,"scaruffi":null},{"id":3080531282495,"name":"AOTY Must Hear 1970s","src":"musthear","grp":null,"list_year":null,"rank":58,"year":null,"note":null,"total":256,"scaruffi":null},{"id":208356503087556,"name":"RYM Top — Rock — Art Rock","src":"musthe