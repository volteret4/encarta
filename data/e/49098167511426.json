cord - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":"https://seventies.libsyn.com/030-bubblegum"}]},{"kind":"podcast","title":"Pop Group Comparison","body":"Critic Charlie Gillette suggested that Dr. Hook, if they were to \"relax and become a straight pop group,\" could \"wipe the Osmonds and the Partridge Family off the board,\" indicating The Partridge Family's status as a popular, clean-cut pop group at the time. \"They would wipe the osmonds and the partridge family off the board.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 44 - Streaking, Werewolves, Sharks, & Drinking - 70s Novelty Songs","url":null},{"source":"For the Record - The 70s","episode":"Ep. 44 - Streaking, Werewolves, Sharks, & Drinking - 70s Novelty Songs","url":"https://traffic.libsyn.com/seventies/334334714-44100-2-e5ed6adac25ea.m4a"}]},{"kind":"podcast","title":"Television Sitcom Origins","body":"*The Partridge Family* was a TV sitcom that debuted on September 25, 1970, and featured David Cassidy playing 16-year-old Keith Partridge alongside his real stepmother, Shirley Jones. The show's producers had previously worked on The Monkees and initially intended to dub in all the music until they discovered David Cassidy could sing. \"The TV sitcom The Partridge Family had the same producers that worked on the monkeys.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":"https://seventies.libsyn.com/030-bubblegum"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best New Artist (1971)","body":"Nominated.","year":1971,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1453643"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Death (November 2017)","body":"David Cassidy, a member of The Partridge Family, died in November 2017. \"then David Cassidy of the Partridge family...\"","year":2017,"extra":{"from":"David Cassidy","from_id":84499408735950,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 2: The Role of Indie Rock","url":"https://www.youtube.com/watch?v=sOU54d8mr5k"}]},{"kind":"xref","title":"Inspiration for The Partridge Family","body":"This 60s pop group from Rhode Island, featuring six siblings and their mother, Barbara, was the direct inspiration for the TV show *The Partridge Family*. \"And before you ask, yes, this arrangement was the inspiration for the TV show, The Partridge Family.\"","year":null,"extra":{"from":"The Cowsills","from_id":120483527923103,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"It's A Family Affair","url":"https://www.youtube.com/watch?v=gxbuajGKbko"}]}],"charts":[{"id":131467736075607,"type":"song","name":"I Think I Love You","work_year":1970,"list_id":219509302503571,"list":"Billboard Hot 100 nº1 · 1970s","src":"singles","rank":245,"year":1970,"note":"3 semanas","yt":"bb4FMn-IWEY","scaruffi":null},{"id":157201351497070,"type":"album","name":"The Partridge Family Album","list_id":122372031256721,"list":"RYM Top — Pop — Bubblegum","src":"musthear","rank":15,"year":1970,"note":null,"yt":"IsyUNt6G7-Q","scaruffi":null},{"id":157201351497070,"type":"album","name":"The Partridge Family Album","list_id":213382009109123,"list":"RYM Top — Pop — Sunshine Pop","src":"musthear","rank":130,"year":1970,"note":null,"yt":"IsyUNt6G7-Q","scaruffi":null},{"id":216525145659612,"type":"song","name":"Doesn't Somebody Want to Be Wanted","work_year":1971,"list_id":114443832640485,"list":"Billboard Year-End 1971","src":"singles","rank":53,"year":1971,"note":"","yt":"jHy58fAk2m8","scaruffi":null},{"id":164739997957154,"type":"song",