{"id":195282824568987,"type":"album","name":"Red Burns","artist":"Standing On The Corner","year":2017,"weight":19,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/91677-red-burns-1.jpg","aoty":80,"aoty_user":83,"yt":"duhdgB0DQPo","links":{"aoty":"https://www.albumoftheyear.org/album/91677-standing-on-the-corner-red-burns.php"},"desc":"Red Burns is the second album by the American experimental collective Standing on the Corner. It was released on September 11, 2017. The album features collaborations with their friends and the local New York creative community including MIKE, sLUms, EMC, Lila Ramani from Crumb. Red Burns received acclaim for its genre-bending freeform music and what it manages to capture in an audio-scrapbook manner. Many critics citing the project's ability to capture their essence of New York City. ."},"artist_ref":{"id":122985574775705,"name":"Standing On The Corner","info":{"img":null}},"labels":[],"genres":[{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"rym"},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","artist":null,"year":null,"weight":266,"yt":null,"src":"rym"},{"id":98720889157055,"type":"genre","name":"Neo-Soul","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"},{"id":195420404905203,"type":"genre","name":"Hypnagogic Pop","artist":null,"year":null,"weight":206,"yt":null,"src":"rym"},{"id":179017056965514,"type":"genre","name":"Sound Collage","artist":null,"year":null,"weight":205,"yt":null,"src":"rym"},{"id":43001458719353,"type":"genre","name":"Afrofuturism","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"}],"lists":[{"id":131223263322211,"name":"RYM Top — Psychedelia — Hypnagogic Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":2,"year":null,"note":null,"total":200,"scaruffi":null},{"id":156212084869216,"name":"RYM Top — Experimental — Sound Collage","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":