décadas.","color":"#38bdf8","family":"Progresivo, krautrock y jazz-rock","link":"https://volteret4.github.io/scaruffi/#kosmische"}],"book_tracks":[{"id":169859656419631,"artist":"Eloy","artist_id":34080599494785,"title":"Ocean","year":1977,"ess":1,"yt":"KI8b6GQ5C80","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Kosmische Musik y krautrock","scene_id":107234531659708,"scene_link":"https://volteret4.github.io/scaruffi/#kosmische","chapters":["Sección 3.7"],"pages":[[1,70,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":70,"text":"…world-music and Canterbury-ian jazz-rock; Passport, whose Looking Thru (1974) acknowledges the Mahavishnu Orchestra and Soft Machine; Eloy (1), whose symphonic arrangements and Pink Floyd-ian vocals would bloom on Ocean (1977). Meet the avantgarde Former Gruppe Between keyboardist Peter…"}],"podcast":[{"kind":"podcast","title":"Prominent German Progressive Rock Band","body":"Eloy was one of the significant progressive rock bands of the 1970s from Germany, highlighting that progressive rock talent extended beyond the more commonly recognized British scene to other parts of Europe. \"una de las grandes bandas del robo progresivo de los 70 alemana que siempre pensamos en el robo progresivo británico pero otros nombres en el resto de Europa incluso fuera de Europa y kaya que eran alemanes eran muy interesantes.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Lanzamientos Enero 2018","url":"https://www.youtube.com/watch?v=m0uzqiwh7Tw"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":268254221275481,"type":"album","name":"Inside","list_id":23428794615065,"list":"RYM Top — Rock — Krautrock","src":"musthear","rank":26,"year":1973,"note":null,"yt":"L4xg8CtKTh4","scaruffi":null},{"id":201461770465376,"type":"album","name":"Floating","list_id":185548171992260,"list"