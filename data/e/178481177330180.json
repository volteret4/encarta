{"id":178481177330180,"type":"album","name":"Satori","artist":"Flower Travellin' Band","year":1971,"weight":19,"info":{"cover":"https://ia800803.us.archive.org/11/items/mbid-ab228bbf-5e8f-4bb0-ab98-e7564f019cbd/mbid-ab228bbf-5e8f-4bb0-ab98-e7564f019cbd-30044814766.jpg","kind":"Album","tracks":5,"country":"GB","scaruffi":7.0,"yt":"mpiM2GILxes","links":{"spotify":"https://open.spotify.com/album/5GAYe1rmblFTLdsX1jGHFa","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_ka8U5AWgbyQdJ-kJmzU0H73jwhL6IlRZs","rateyourmusic":"https://rateyourmusic.com/release/album/flower-travellin-band/satori-11"},"desc":"Satori is the second album by Japanese rock band Flower Travellin' Band, but their first of original material. It was released in Japan by Atlantic Records, and in the US and Canada by GRT Records in 1971. The North American release differed to the Japanese original, as it contained songs off their upcoming album \"Made in Japan\" and the bonus track \"Lullaby\". The original Japanese version was reissued on CD by Warner Music in 1988. It was digitally remastered in 1998. In 2009 it was remastered on the new SHM-CD format. A re-release in 1991 contained the bonus track \"Map\", ."},"artist_ref":{"id":56560410098089,"name":"Flower Travellin' Band","info":{"img":null}},"labels":[],"genres":[{"id":174164112458259,"type":"genre","name":"Heavy Metal","artist":null,"year":null,"weight":782,"yt":null,"src":"musthear,rym"},{"id":147423806094006,"type":"genre","name":"Psychedelic Rock","artist":null,"year":null,"weight":690,"yt":null,"src":"musthear,rym"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"musthear,rym"},{"id":163225726165579,"type":"genre","name":"Blues Rock","artist":null,"year":null,"weight":458,"yt":null,"src":"musthear"},{"id":166279679595706,"type":"genre","name":"Acid Rock","artist":null,"year":null,"weight":248,"yt":null,"src":"musthear"},{"id":236667806013249,"type":"genre","name":"Heavy P