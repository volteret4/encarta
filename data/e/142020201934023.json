{"id":142020201934023,"type":"artist","name":"Michelle Shocked","artist":null,"year":null,"weight":12,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/MichelleShockedCrop.jpg?width=500","bio":"Michelle Shocked (born Dallas, Texas, February, 1962) is the stage name of Michelle Karen Johnston, an American  singer-songwriter.\n\nAs a young feminist, she left Texas to travel, Kerouac-style, and was caught up in Reagan-era grassroots politics. Her musical career was ignited by a bootleg recording  made around a Kerrville Folk Festival campfire on a Sony walkman. Released in England as ‘The Texas Campfire Tapes’ without Shocked’s authority, its success abroad enticed Mercury Records to offer the newcomer a recording contract.","tags":["singer-songwriter","folk","female vocalists","Alt-country","americana"]},"works":[{"id":274299290975452,"type":"album","name":"Texas Campfire Tapes","artist":"Michelle Shocked","year":1986,"weight":6,"yt":"sjCHYxRQQlM","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":167484087173814,"type":"album","name":"Short Sharp Shocked","artist":"Michelle Shocked","year":1988,"weight":17,"yt":"DuYfymCwtFs","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":572,"scaruffi":7.0},{"id":44844465110460,"name":"RYM Top — Rock — Folk Rock","rank":161,"scaruffi":7.0},{"id":118798969175346,"name":"RYM Top — Country — Alt-Country","rank":73,"scaruffi":7.0},{"id":181312163526721,"name":"RYM Top — Country","rank":179,"scaruffi":7.0}],"n_lists":4}},{"id":154646963646546,"type":"album","name":"Captain Swing","artist":"Michelle Shocked","year":1989,"weight":6,"yt":"zRTogbwx-y8","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"po