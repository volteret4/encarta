:[],"concerts":[],"xref":[{"kind":"xref","title":"Genre Blending and Influence","body":"NoMeansNo occupied a unique space by blending elements of hardcore and metal. Their sound contained elements that would later define post-hardcore, influencing bands like At the Drive-In, Rollins Band, Alexisonfire, Billy Talent, Deftones, and Silverstein. \"They ended up occupying a space somewhere between hardcore and metal. If you listen carefully to what they did, you can hear elements of what would become known as post-hardcore, a sound that would later birth groups like at the drive-in, Rollins Band, Alexis on Fire, Billy Talent, The Death Tones and Silverstein.\"","year":null,"extra":{"from":"NoMeansNo","from_id":194784441749150,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Hardcore","url":"https://www.youtube.com/watch?v=0qigzi1j81U"}]},{"kind":"xref","title":"Post-Hardcore Influence","body":"Their distinctive sound, blending hardcore and metal, showcased elements that foreshadowed what would become known as post-hardcore, influencing bands such as At The Drive-In, The Rollins Band, Alexisonfire, Billy Talent, The Deftones, and Silverstein. \"If you listen carefully to what they did, you can hear elements of what would become known as post-hardcore, a sound that would later birth groups like at the drive-in, Rawlins Band, Alexis on Fire, Billy Talent, The Death Tones and Silverstein.\"","year":null,"extra":{"from":"No Means No","from_id":268662677577487,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Hardcore","url":"https://www.youtube.com/watch?v=PEHkKfmmDiI"}]}],"charts":[{"id":8888138690724,"type":"album","name":"When Broken Is Easily Fixed","list_id":82886370697393,"list":"RYM Top — Rock — Emo-Pop","src":"musthear","rank":114,"year":2003,"note":null,"yt":"NhcTWQnddXc","scaruffi":null},{"id":8888138690724,"type":"album","name":"When Broken Is Easily Fixed","list_id"