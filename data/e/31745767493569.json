"genre","name":"Sound Art","n":6},{"id":112444581494903,"type":"genre","name":"Turntable Music","n":2},{"id":54532248910369,"type":"genre","name":"Electroacoustic","n":2},{"id":264202968769511,"type":"genre","name":"Data Sonification","n":1},{"id":179017056965514,"type":"genre","name":"Sound Collage","n":1},{"id":2714067075883,"type":"genre","name":"Tape Music","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":259690605050501,"name":"Lowercase","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1997,"end":2002,"desc":"El audio digital busca la frontera del silencio: sonidos en el límite de la percepción humana.","color":"#8b7cf6","family":"Vanguardia y experimental","link":"https://volteret4.github.io/loops_timeline/#lowercase"}],"book_tracks":[{"id":107062841445424,"artist":"Steve Roden","artist_id":31745767493569,"title":"Forms of Paper","year":2001,"ess":1,"yt":"oO8HrG2h9pA","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Lowercase","scene_id":259690605050501,"scene_link":"https://volteret4.github.io/loops_timeline/#lowercase","chapters":["Cap. 16: Post-rave / post-digital: música experimental en la década de los noventa (1990-2002)"],"pages":[[1,307],[1,452]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":307,"text":"…Miki Yui, Skoltz_Kolgen, el venerado Bernhard Gunther —uno de los padres del minimalismo extremo y gestor de la delicadísima Trente Oiseaux— y Steve Roden. A este último se debe la invención de la lowercase music a raíz de la edición de Forms of Paper (2001) en Line, un álbum compuesto íntegramente de sonidos producidos por la manipulación de hojas de papel fuertemente procesados. Roden explicó que el objetivo de Forms of Paper «no tenía que ver con la composición, sino con la experiencia de escuchar [...]. Quería proporcionar una…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":307,"text":"…más pequeño»— y a un volumen tan bajo que el oyente debía concentrarse como con ninguna otra música para captar algo. Siguiendo con la paradoja, Roden demostró que, en un mundo ruidoso y sobreinformado, eran justamente el silencio y la escasez informativa lo que podía aumentar el umbral de atención. Antes de Roden, la misma tesis fue demostrada por el grupo Wandelweiser, congregación de músicos provenientes del jazz y la música contemporánea reunidos desde…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":307,"text":"…«evaluar e integrar el silencio en lugar de un bombardeo constante de sonidos sin fin». Al otro lado del mundo, la mistura de los procedimientos de Roden y los presupuestos de Wandelweiser llevó por nombre onkyo u onkyokei, movimento gestado a finales de los noventa en la sala Off Site de Tokio, que…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":471,"text":"…la percepción acústica humana, de modo que se pone a prueba la capacidad de recepción y la creatividad allí donde el sonido se disuelve en el vacío. Steve Roden Bernhard Günter Microsonido En la música digital, la posibilidad de representar el sonido en el dibujo de sus frecuencias y poderlas cortar en…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":263009396334256,"type":"album","name":"Translations & Articulations","list_id":163971148733283,"list":"RYM Top — Experimental — Lowercase","src":"musthear","rank":5,"year":1997,"note":null,"yt":"uMHhoji7d6c","scaruffi":null},{"id":263009396334256,"type":"album","name":"Translations & Articulations","list_id":127233650405286,"list":"RYM Top — Experimental — Reductionism","src":"musthear","rank":24,"year":1997,"note":null,"yt":"uMHhoji7d6c","scaruffi":null},{