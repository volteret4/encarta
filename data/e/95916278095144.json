ht":3,"yt":"rEd-GjhuIU8","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":60045461525049,"name":"RYM Top — Experimental — Modern Creative","rank":129,"scaruffi":null}],"n_lists":1}},{"id":64825200305130,"type":"album","name":"Quartet (New Haven) 2014","artist":"Anthony Braxton","year":2014,"weight":3,"yt":"Er5BWwBjasM","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":63979376183344,"name":"RYM Top — Experimental — Free Improvisation","rank":159,"scaruffi":null}],"n_lists":1}},{"id":47816865579521,"type":"album","name":"12 Comp (ZIM) 2017","artist":"Anthony Braxton","year":2017,"weight":3,"yt":"KYgmnZQJK6w","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":60045461525049,"name":"RYM Top — Experimental — Modern Creative","rank":59,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":175947516841285,"type":"genre","name":"Modern Creative","n":29},{"id":187574203759327,"type":"genre","name":"Loft Jazz","n":4},{"id":236863449870361,"type":"genre","name":"Free Improvisation","n":3},{"id":163673912179753,"type":"genre","name":"Experimental Big Band","n":3},{"id":110972509927513,"type":"genre","name":"Free Jazz","n":3},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","n":3},{"id":232030375633059,"type":"genre","name":"Third Stream","n":2},{"id":122365574055536,"type":"genre","name":"Indeterminacy","n":1},{"id":83242304689053,"type":"genre","name":"Bebop","n":1},{"id":57121808568531,"type":"genre","name":"Big Band","n":1},{"id":51806065918814,"type":"genre","name":"Modal Jazz","n":1},{"id":36979271101309,"type":"genre","name":"Reductionism","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":28135018847827,"name":"AACM, Art Ensemble of Chicago y Anthony Braxton","book":"Historia del jazz","author":"Ted Gioia","start":1965,"end":2005,"desc":"Las asociaciones de músicos sostienen la siguiente oleada, y la más influyente es la AACM de Chicago (1965), presidida por Muhal Richard Abrams. Frente al energy jazz neoyorquino, la escuela de Chicago prefiere un sonido abierto y episódico, centrado en el timbre más que en la armonía, con préstamos de todos los géneros, performance, minimalismo, azar y músicas panafricanas: los primeros indicios del jazz posmoderno. El Art Ensemble of Chicago (Roscoe Mitchell, Joseph Jarman, Lester Bowie, Malachi Favors, Don Moye), con caras pintadas y quinientos instrumentos, practica un «jazz de guerrillas» bajo el lema «great black music: ancient to the future» y triunfa en Francia. Anthony Braxton, ajedrecista con pipa que titula con diagramas, derriba todas las barreras (Schönberg y Stockhausen junto a Coltrane, Desmond y Konitz, el saxo solo de For Alto, obras para cuatro orquestas) y se gana una antipatía legendaria. El Black Artists Group de St. Louis (Hemphill, Lake, Bluiett) sigue un camino parecido.","color":"#fb7185","family":"Free jazz y vanguardia","link":"https://volteret4.github.io/jazz/#aacm"}],"book_tracks":[{"id":149258752688039,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"3 Compositions of New Jazz","year":1968,"ess":0,"yt":"fLC0YaI-LF4","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[]},{"id":238450968402478,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"For John Cage","year":1968,"ess":1,"yt":"ceeUhorJ39I","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Discografía recomendada: Discografía recomendada"],"pages":[[1,437]]},{"id":279641494130505,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"For Alto","year":1969,"ess":0,"yt":"Ox9YNFaXsDA","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[[1,393],[1,437]]},{"id":182356988655573,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"In the Tradition","year":1974,"ess":0,"yt":"uCLn9HqDxG8","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[[1,393]]},{"id":30407147872198,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"Creative Orchestra Music 1976","year":1976,"ess":0,"yt":"dBHydXIQySc","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[[1,393]]},{"id":96709905630979,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"Composition 57","year":1976,"ess":1,"yt":"XMaxe540eK4","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Discografía recomendada: Discografía recomendada"],"pages":[]},{"id":278076553321941,"artist":"Anthony Braxton","artist_id":95916278095144,"title":"For Four Orchestras","year":1978,"ess":0,"yt":"I6ss9CtPBDk","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"AACM, Art Ensemble of Chicago y Anthony Braxton","scene_id":28135018847827,"scene_link":"https://volteret4.github.io/jazz/#aacm","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[[1,393]]}],"mentions":[{"book":"Historia del jazz","author":"Ted Gioia","page":92,"text":"…de manera infrecuente en los grupos de jazz de épocas posteriores (si bien algunos músicos con inclinaciones experimentales, como Boyd Raeburn, Anthony Braxton y Roscoe Mitchell, han gustado de su sonido penetrante). Rollini podía emplear instrumentos de viento aún más peculiares, como el goofus, el celeste…"},{"book":"Historia del jazz","author":"Ted Gioia","page":297,"text":"…a distancia lo han hecho a tiempo parcial, y desde cualquier tipo de filiación jazzística: desde las corrientes más centrífugas (Cecil Taylor, Anthony Braxton) hasta las más convencionales (Wynton Marsalis) y las intermedias (Muhal Richard Abrams, David Murray, McCoy Tyner). Sólo un individuo singular como…"},{"book":"Historia del jazz","author":"Ted Gioia","page":388,"text":"…como importantes revelaciones de la visión estética del movimiento. Otros participantes de esta asociación serían Roscoe Mitchell, Joseph Jarman, Anthony Braxton y Lester Bowie. Con el tiempo, su alcance se extendió: el grupo promovió discos, produjo espectáculos de radio, proporcionó formación musical a…"},{"book":"Historia del jazz","author":"Ted Gioia","page":389,"text":"…de Steve Lacy de este período también anticipaba un gran número de corrientes que cristalizarían en la obra de posteriores músicos posmodernos como Anthony Braxton, David Murray y John Zorn, incluida la fusión de una estética progresista con un interés por la conmemoración de los artistas del pasado (en…"},{"book":"Historia del jazz","author":"Ted Gioia","page":392,"text":"…Art Ensemble de toda la época. La oleada posmoderna del jazz de los setenta se vio favorecida por la obra de otro músico de Chicago, el saxofonista Anthony Braxton. Si se contempla a grandes rasgos, la carrera de Braxton guarda un parecido superficial con la del Art Ensemble. Braxton también era un defensor del free jazz y uno de los primeros miembros de la AACM y, al igual que el Art Ensemble, se trasladó a París a finales de…"},{"book":"Historia del jazz","author":"Ted Gioia","page":392,"text":"…estilo posible, incorporar todo sonido distinto, todo bajo la bandera del progresismo. Sólo un vistazo a la instrumentación de la producción de Braxton dice mucho sobre sus eclécticos y excéntricos enfoques. Ha escrito para dos pianos, cinco tubas, e incluso para cuatro palas con amplificador. Se…"},{"book":"Historia del jazz","author":"Ted Gioia","page":392,"text":"…para orquesta, para orquesta y cuatro proyectores de diapositivas, para orquesta y teatro de marionetas, incluso música para cuatro orquestas. Braxton derribó con éxito las barreras artificiales que habían segregado a la comunidad de jazz vanguardista —a menudo provocando polémica con ello—. A diferencia del lema del Art Ensemble acerca de la «gran música negra», Braxton adoptó con arrojo tanto la visión europea como la afroamericana de la música contemporánea, y no dudó en incluir a Schönberg, Webern, Cage y…"},{"book":"Historia del jazz","author":"Ted Gioia","page":392,"text":"…jazz, alabando con frecuencia a Paul Desmond, Lee Konitz y Warne Marsh, y trabajando en conjuntos racialmente mixtos como el cuarteto Circle (con Braxton, Chick Corea, Barry Altschul y Dave Holland) o junto a Dave Brubeck, o bien con diversos músicos europeos. Desdeñó la clasificación que dividía a los músicos de free jazz en defensores del energy jazz neoyorquinos y paisajistas sonoros chicagüenses. Por último, Braxton rechazó la presunta división entre los aspectos emocionales y cerebrales del jazz, invitando incluso al ridículo con su adopción de gestos…"},{"book":"Historia del jazz","author":"Ted Gioia","page":393,"text":"…de títulos convencionales para sus composiciones), una seriedad que también impregnaba su música. Una de las paradojas de la vida profesional de Braxton es que esta destrucción de barreras, esta aceptación de cualquier fuente de inspiración al margen de prejuicios o sesgos, le ganó muy pocos amigos. «No me gusta Braxton», dijo a un periodista una vieja gloria del jazz. «No me gusta ese jersey. No me gusta esa pipa. No me gusta ese pelo». Estudiando la carrera de Braxton, el crítico Greg Tate llega a la siguiente conclusión: «quizá no haya criatura alguna en el mundo del jazz capaz de rivalizar con Braxton en su talento para inspirar antipatía»[170]. La diversidad de Braxton está muy bien representada en su prolífica producción artística. Su trabajo de 1968 For Alto legitimó el papel del saxofón sin acompañamiento en el…"},{"book":"Historia del jazz","author":"Ted Gioia","page":393,"text":"…el tema «Picasso» de Coleman Hawkins (1948). Su grabación Paris Concert con el conjunto «Circle» en 1971 indicaba que la personal abstracción de Braxton podía prosperar en un apasionado combo de jazz, lo que quizás quede especialmente demostrado por la intensa reelaboración en cuarteto del standard «No Greater Love». Los discos de Braxton para el sello Arista durante los años setenta le dieron gran libertad para llevar a cabo algunos de sus proyectos más ambiciosos, incluido su Creative Orchestra Music (1976), que exhibe a Braxton en su faceta de compositor en un trabajo decididamente posmoderno, casi un compendio de la música americana. Aquí Braxton se mueve en medio de la…"},{"book":"Historia del jazz","author":"Ted Gioia","page":393,"text":"…la curiosidad constantemente sagaz e itinerante de esta figura clave del jazz. Los principales héroes del jazz posmoderno han tendido, como Braxton, a ser prodigiosos en su ingente producción y omnívoros en sus gustos. Ningún músico de su generación ha llegado a personificar estos rasgos en…"},{"book":"Historia del jazz","author":"Ted Gioia","page":395,"text":"…como Tim Berne, Wayne Horvitz, Bill Frisell y Bobby Previte—, Zorn llevó el eclecticismo de sus modelos un paso más allá, incluso superando a un Braxton o Murray en la amplitud de sus fuentes. Sus gustos merodeaban mucho más allá del mundo del jazz, y en un proyecto determinado podía incluir el punk,…"},{"book":"Historia del jazz","author":"Ted Gioia","page":419,"text":"…compartiendo un cajón con George Lewis, trombonista vanguardista; Woody Shaw colocado al lado de Artie Shaw; Ruby Braff hombro con hombro de Anthony Braxton; o Sadao Watanable acercándose sigilosamente a Ethel Waters. La extrema diversidad de las tradiciones que ahora eran aclamadas indicaba el tremendo…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":149258752688039,"type":"album","name":"3 Compositions of New Jazz","list_id":60045461525049,"list":"RYM Top — Experimental — Modern Creative","src":"musthear","rank":24,"year":1968,"note":null,"yt":"fLC0YaI-LF4","scaruffi":null},{"id":34436104521134,"type":"album","name":"Anthony Braxton [B-X° / N O I 47ᴬ]","list_id":60045461525049,"list":"RYM Top — Experimental — Modern Creative","src":"musthear","rank":45,"year":1969,"note":null,"yt":"XWyAYDuwYG4","scaruffi":null},{"id":62718451940244,"type":"album","name":"This Time...","list_id":60045461525049,"list":"RYM Top — Experimental — Modern Creative","src":"musthear","rank":79,"year":1970,"note":null,"yt":"cQBwORcXv6Q","scaruffi":null},{"id":279641494130505,"type":"album","name":"For Alto","list_id":150848509715573,"list":"RYM Top — Experimental","src":"musthear","rank":96,"year":1971,"note":null,"yt":"JzjRNKGxaJE","scaruffi":null},{"id":279641494130505,"type":"album","name":"For Alto","list_id":63979376183344,"list":"RYM Top — Experimental — Free Improvisation","src":"musthear","rank":2,"year":1971,"note":null,"yt":"JzjRNKGxaJE","scaruffi":null},{"id":279641494130505,"type":"album","name":"For Alto","list_id":600454615