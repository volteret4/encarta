{"id":276763441750249,"type":"album","name":"Perdition City","artist":"Ulver","year":2000,"weight":18,"info":{"cover":"https://dn710608.ca.archive.org/0/items/mbid-5bbc88d0-ccab-43e7-97fd-1bdb143c6054/mbid-5bbc88d0-ccab-43e7-97fd-1bdb143c6054-23033184531.jpg","kind":"Album","tracks":9,"country":"XW","scaruffi":7.5,"sputnik":4.12,"yt":"AUQpHPPbdCI","links":{"spotify":"https://open.spotify.com/album/34GSeS7UvvKclKHIXohqjP","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lQ9W9SjIW-McYeTDtoy-uIdW4skQO9Y_o","bandcamp":"https://ulver.bandcamp.com/album/perdition-city","rateyourmusic":"https://rateyourmusic.com/release/album/ulver/perdition-city","sputnikmusic":"https://www.sputnikmusic.com/album/1580/Ulver-Perdition-City/"},"desc":"Perdition City (subtitled Music to an Interior Film) is the fifth studio album by Norwegian collective Ulver, issued in March 2000, via Jester Records. The album was recorded and produced by Kristoffer Rygg and Tore Ylwizaker, mixed by Ylwizaker at Beep Jam Studio and mastered by Audun Strype at Strype Audio. Perdition City continues the experimentation heard on Themes from William Blake's The Marriage of Heaven and Hell and Metamorphosis, containing elements of trip hop, jazz, ambient music, spoken word and electronica, the combination being described as \"moody\", \"atmospheric\", and \"cinematic in scope\" ."},"artist_ref":{"id":59322568674557,"name":"Ulver","info":{"img":null}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"musthear"},{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"musthear"},{"id":170438788671559,"type":"genre","name":"Black Metal","artist":null,"year":null,"weight":313,"yt":null,"src":"musthear"},{"id":15318882910861,"type":"genre","name":"Post-Ind