{"id":228260948463388,"type":"artist","name":"Orange Goblin","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Orange_Goblin_-_Wacken_2025-_day_3-12_%2854732315050%29.jpg?width=500","bio":"Orange Goblin es una banda inglesa de Stoner Metal que se formó originalmente en 1995 bajo el nombre de Our Haunted Kingdom.\n\nEl grupo tiene un cierto estatus de culto dentro del underground del Doom Metal inglés, donde se les incluye junto a grupos como Electric Wizard o Iron Monkey.\n\nLos tres primeros álbumes de la banda eran de Stoner/Doom Metal. Con 'Coup de Grace', del 2002, se acercaron a un sonido más agresivo e influenciado por el Punk.","tags":["Stoner Rock","stoner metal","doom metal","stoner","hard rock"]},"works":[{"id":167746229866094,"type":"album","name":"Frequencies From Planet Ten","artist":"Orange Goblin","year":1997,"weight":14,"yt":"gY-471UjsYI","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":14239102054361,"name":"Sputnikmusic Best Albums 1997","rank":168,"scaruffi":null},{"id":64803615322804,"name":"RYM Top — Rock — Stoner Metal","rank":67,"scaruffi":null}],"n_lists":2}},{"id":211624760191349,"type":"album","name":"Time Travelling Blues","artist":"Orange Goblin","year":1998,"weight":3,"yt":"ZNpDmKHAjeE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":64803615322804,"name":"RYM Top — Rock — Stoner Metal","rank":49,"scaruffi":null}],"n_lists":1}},{"id":64025722768681,"type":"album","name":"The Big Black","artist":"Orange Goblin","year":2000,"weight":5,"yt":"1__R9O1-vOw","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":11394370101650,"name":"RYM Top — Rock — Stoner Rock","rank":49,"scaruffi":null},{"id":64803615322804,"name":"RYM Top — Rock — Stoner Metal","rank":46,"scaruffi":null}],"n_lists":2}},{"id":45515725691351,"type":"album","name":"Coup de grace","artist"