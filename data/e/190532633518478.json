members":[{"id":142129504665107,"type":"artist","name":"Gary Lightbody","artist":null,"year":null,"weight":7,"yt":null,"src":"ensayos"}],"member_of":[{"id":101720880475259,"type":"artist","name":"Q Prime (Cliff Bernstein and Peter Mensch's company)","artist":null,"year":null,"weight":18,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":31750776616510,"type":"genre","name":"Post-Britpop","n":7}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Box Set Collection","body":"A box set from Snow Patrol is present in a collection, serving as an example of artists who release these extensive packages for fans. \"looking here at the shelf, I have boxes from Snow Patrol.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Music Industry Glossary: Part 1","url":"https://www.youtube.com/watch?v=5kPmqmbFfkY"}]},{"kind":"podcast","title":"Featured in Apple Commercials","body":"Snow Patrol's music has been featured in Apple's TV commercials, aligning them with other popular artists chosen to soundtrack the company's advertising campaigns for products like the iPod and iPhone.","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Concept of Selling Out: Part 2","url":"https://www.youtube.com/watch?v=sfie4YYncxk"}]},{"kind":"podcast","title":"Interest in Astronomy and Quantum Physics","body":"Gary Lightbody is described as a \"science and astronomy geek,\" with his passion evident in the titles of Snow Patrol's albums and songs. He expresses keen interest in the quantum experiments conducted at the Large Hadron Collider in Europe, although he admits his understanding is limited by his lack of formal scientific grounding. \"Gary Lightbody of Stop patrol is also a science in astronomy geek.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Eggheads and Geeks","url":"https://www.youtube.com/watch?v=QfiRRtsZoYU"}]},{"kind":"podcast","title":"Observations on the Large Hadron Collider","body":"Gary Lightbody finds the Large Hadron Collider intriguing despite his limited scientific grounding, noting how easy it is to get \"lost in the minutia\" of complex scientific details. He also commented on the public's exaggerated fears surrounding the project, such as being \"sucked into your vortex.\" \"I'm absolutely and I'm not really intrigued by it. But my grasp is limited because I don't have a grounding in science.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Eggheads and Geeks","url":"https://www.youtube.com/watch?v=QfiRRtsZoYU"}]}],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Alan Rankine Death (January 2, 2023) – Heart Disease, Age 64; Launched Snow Patrol, Belle & Sebastian, Biffy Clyro via Electric Honey Records","body":"Alan Rankine co-founded the Associates with Billy MacKenzie in Dundee, Scotland in 1979 — evolving out of post-punk bands and following a Bowie-like direction. A former competitive tennis player (too short at 5'8\" to go professional), Rankine also worked as a production collaborator with the Cocteau Twins. After the Associates broke up, he became a lecturer at Stow College in Glasgow teaching music production, and helped students set up a record label called Electric Honey, which launched Snow Patrol, Belle & Sebastian, and Biffy Clyro. He was diagnosed with heart disease in the 2020s and died at home with family on January 2, 2023, at age 64. \"He helped him set up a record label called Electric Honey, and that label launched the careers of bands like Snow Patrol, Bell and Sebastian, and Biffy Clyro.\"","year":2023,"extra":{"from":"The Associates","from_id":139277991378580,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"2023 In Memoriam","url":"https://www.youtube.com/watch?v=-JPLLJyOid8"}]}],"charts":[{"id":45415397032165,"typ