{"id":265726262159506,"type":"song","name":"Cucur Lane","artist":"Cruachan","year":1995,"weight":10,"info":{"img":null},"artist_ref":{"id":217602899496575,"name":"Cruachan","info":{"img":null}},"labels":[],"genres":[],"lists":[],"podcast":[{"kind":"podcast","title":null,"body":"This song, released in 1995, is presented as an example of Celtic metal. The recording context was described with some garbled words in the transcript. \"This is from 1995. I'm the only one. This is from the grahamadazz, far-dedictive artel. This make was only after me. For the earth to talk about, like the amapina, please, just like the far-dedict. Huracai with Cucur Lane, an example of Celtic metal.\"","year":1995,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Celtic Rock - A History","url":"https://www.youtube.com/watch?v=cuUF4MByxyo"}]}],"book_tracks":[],"others":[{"id":232625282460793,"type":"album","name":"Tuatha na Gael","year":1995,"weight":5},{"id":275684723760924,"type":"album","name":"Blood on the Black Robe","year":2011,"weight":3},{"id":244854346231387,"type":"album","name":"Nine Years of Blood","year":2018,"weight":3},{"id":176665230253407,"type":"album","name":"The Middle Kingdom","year":2000,"weight":3},{"id":156259458868743,"type":"album","name":"Pagan","year":2004,"weight":3},{"id":107540151962926,"type":"album","name":"Blood for the Blood God","year":2014,"weight":3},{"id":83258639284355,"type":"album","name":"The Morrigan's Call","year":2006,"weight":3},{"id":59396953292772,"type":"album","name":"The Living and the Dead","year":2023,"weight":3},{"id":28737967730420,"type":"album","name":"Folk-Lore","year":2002,"weight":3}]}