245282,"type":"album","name":"Oceans Apart","artist":"The Go-Betweens","year":2005,"weight":3,"yt":"2xwjK1HXpHU","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":161051722508702,"name":"RYM Top — Rock — Jangle Pop","rank":59,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":15906669628272,"type":"genre","name":"Jangle Pop","n":9},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":6},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":3},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":2},{"id":194427380844280,"type":"genre","name":"Folk Rock","n":1},{"id":8412226417108,"type":"genre","name":"Indie Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":272166932570574,"name":"Postcard Records y Orange Juice","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1979,"end":1982,"desc":"Frente a la muerte y la melancolía del postpunk, el regreso de la canción de amor sin tapujos: Orange Juice, cuatro chicos de clase media de Bearsden («una banda neoyorquina oriunda de Bearsden»), con la voz de colegial enamorado de Edwyn Collins heredada de Pete Shelley, las guitarras Gretsch rasgueadas al doble de tempo (Velvet Underground de Live 1969 más Nile Rodgers de Chic) y una debilidad camp contra el machismo blusero de Glasgow. Alan Horne, «Señor Postcard», maquiavélico y provocador, funda el sello con «Falling and Laughing» (1980) y lo concibe como un Motown escocés: Josef K, Aztec Camera, los australianos Go-Betweens. Un «nuevo puritanismo» sin drogas ni alcohol. Enseñaron a la gente refinada a rechazar la lúgubre seriedad del postpunk, pero su pop erudito y retro sonó débil cuando llegaron los sintetizadores y la gran producción.","color":"#a3e635","family":"DIY, sellos independientes e indie","link":"https://volteret4.github.io/Postpunk/#postcard"},{"id":128062745971935,"name":"Pop de Australia y Nueva Zelanda","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1978,"end":1998,"desc":"Australia aporta las elegías neorrománticas de los Go-Betweens, las microsinfonías de The Church, Hunters And Collectors, Midnight Oil, Men At Work, Triffids e INXS. Nueva Zelanda cría una generación de antihéroes que no tiene nada que ver con la ola británica comercial y crea el género de los noventa: el «lo-fi pop». The Clean (como si los Buzzcocks versionaran a Syd Barrett y a la Velvet), Tall Dwarfs, Chills, Bats, This Kind Of Punishment, Jean Paul Sartre Experience, Scorched Earth Policy, Able Tasmans, Verlaines y la figura de Peter Jefferies.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#antipodes-pop"}],"book_tracks":[{"id":40272964853922,"artist":"The Go-Betweens","artist_id":155613939965328,"title":"I Need Two Heads","year":1980,"ess":0,"yt":"I8j6N_7o6Uk","kind":null,"book":{"id":7,"title":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","url":"https://volteret4.github.io/Postpunk/"},"scene":"Postcard Records y Orange Juice","scene_id":272166932570574,"scene_link":"https://volteret4.github.io/Postpunk/#postcard","chapters":["Cap. 17: Diversión y frenesí: Postcard Records y el sonido de la joven Escocia"],"pages":[]},{"id":49616366595217,"artist":"Go-Betweens","artist_id":155613939965328,"title":"Before Hollywood","year":1983,"ess":0,"yt":"96yltGqcyVI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Pop de Australia y Nueva Zelanda","scene_id":128062745971935,"scene_link":"https://volteret4.github.io/scaruffi/#antipodes-pop","chapters":["Sección 5.11"],"pages":[[1,158,null]]}],"mentions":[{"book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","page":399,"text":"…Postcard, Home empezó a ampliar el catálogo del sello con otras bandas escocesas como Aztec Camera, de Glasgow, y Jos