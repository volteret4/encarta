d":226395167427913,"name":"RYM Top — Folk — Country Gospel","rank":170,"scaruffi":null}],"n_lists":1}},{"id":165995728616108,"type":"album","name":"Meet Glen Campbell","artist":"Glen Campbell","year":2008,"weight":3,"yt":"PyJ82QT8tzQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":167105581234386,"name":"RYM Top — Country — Country Pop","rank":191,"scaruffi":null}],"n_lists":1}},{"id":121131034872685,"type":"album","name":"Ghost on the Canvas","artist":"Glen Campbell","year":2011,"weight":3,"yt":"A7kw5zXVFVQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":167105581234386,"name":"RYM Top — Country — Country Pop","rank":142,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[{"id":250434572201079,"type":"artist","name":"The Beach Boys","artist":null,"year":1961,"weight":447,"yt":null,"src":"ensayos"}],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"},{"id":7374429919951,"type":"genre","name":"country","artist":null,"year":null,"weight":632,"yt":null,"src":"ensayos"}],"album_genres":[{"id":179554264188962,"type":"genre","name":"Countrypolitan","n":12},{"id":42147038712068,"type":"genre","name":"Country Pop","n":9},{"id":251493998428178,"type":"genre","name":"Urban Cowboy","n":7},{"id":50154868873855,"type":"genre","name":"Nashville Sound","n":7},{"id":207318544393773,"type":"genre","name":"Country Gospel","n":2},{"id":258906480523511,"type":"genre","name":"Baroque Pop","n":1},{"id":251671925246370,"type":"genre","name":"Soft Rock","n":1},{"id":190318565344926,"type":"genre","name":"Folk Pop","n":1}],"labels":[{"id":74796195029624,"type":"label","name":"CBS Records (Canada)","artist":null,"year":null,"weight":140,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Received Beach Boys Track (1964)","body":"Glenn Campbell was given what was possibly Brian Wilson's greatest track composed in 1964, a song that The Beach Boys ultimately did not use themselves. This was offered as a significant favor, acknowledging Campbell's invaluable service as a temporary touring replacement for Brian Wilson after his breakdown. \"Possibly the greatest track he created in 1964 ended up not being used by The Beach Boys, though, but was given to Glenn Campbell.\"","year":1964,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 117: \"Don't Worry Baby\" by the Beach Boys","url":"https://www.youtube.com/watch?v=hPv7iS8FsbA"}]},{"kind":"podcast","title":"Temporary Replacement for Brian Wilson (December 1964 - Five Months)","body":"Glenn Campbell, an accomplished session guitarist who had contributed to several Beach Boys recordings and had a nascent singing career, swiftly stepped in to replace Brian Wilson on stage for five months following Wilson's mental breakdown in December 1964. Campbell performed most of the group's live shows during this period. \"Campbell, who was a session guitarist who had played on a number of The Beach Boys recordings, had had a minor career as a singer at this point, had flown out at almost no notice, and for the next five months he replaced Brian on stage for most of their shows, before the group got a permanent replacement in.\"","year":1964,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 117: \"Don't Worry Baby\" by the Beach Boys","url":"https://www.youtube.com/watch?v=hPv7iS8FsbA"}]},{"kind":"podcast","title":"Host of Smothers Brothers Summer Show (1968)","body":"Glenn Campbell hosted the \"Smothers Brothers Summer Show\" in 1968, a role that proved successful enough to lead to his own variety series. \"The host of their summer show was Glenn Campbell.\"","year":1968,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 27 - That's Entertainment! TV Variety Shows of the 70s","url":"https://seventies.libsyn.com/027-variety-shows-12920-5-16-pm"}]},{"kind":"podcast","title":"Duet with Stevie Wonder (1969)","body":"On a 1969 episode of \"The Glenn Campbell Goodtime Hour,\" Campbell performed a soulful rendition of Bob Dylan's \"Blowin' in the Wind\" with Stevie Wonder, a pairing he later cited as one of the highlights of his show. The dialogue preceding the song shows their friendly exchange. \"Here they are in a 1969 episode of the Glenn Campbell Good Time Hour, they're covering the Bob Dylan classic, Blown in the Wind.\"","year":1969,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 27 - That's Entertainment! TV Variety Shows of the 70s","url":"https://seventies.libsyn.com/027-variety-shows-12920-5-16-pm"}]},{"kind":"podcast","title":"The Glenn Campbell Goodtime Hour (1969-1971)","body":"Debuting on January 29, 1969, this show replaced the canceled Smothers Brothers Show. While it featured some comedy that hasn't aged well, its music was its distinguishing factor. The show, with Nelson Riddle as music director, showcased Campbell's country-pop blend and hosted a wide array of artists from various genres. It was eventually canceled in 1971 after four seasons, despite its success, surviving the \"rural purge\" for about a year. \"The show did well enough that the Glenn Campbell Good Time Arrow was born debuting on January 29, 1969 and you guessed it, it became the replacement for the canceled Smothers Brothers Show.\"","year":1969,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 27 - That's Entertainment! TV Variety Shows of the 70s","url":"https://seventies.libsyn.com/027-variety-shows-12920-5-16-pm"}]},{"kind":"podcast","title":"\"Rhinestone Cowboy\" as Biography","body":"Glenn Campbell stated that the song \"Rhinestone Cowboy\" felt like his own biography, resonating with his experiences of compromise on the road to success. \"Glenn Campbell... records Rhyne Stone cowboy, and he said that it felt like his own biography.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Ability to Cover Other Artists' Hits","body":"Campbell possessed a rare talent for covering other singers' hits without drawing criticism or alienating the original artists' fans. He could seamlessly transition between songs like Jerry Reed's \"Today Is Mine,\" The Beatles' \"Yesterday,\" and Andy Williams' \"Moon River,\" demonstrating his versatility and appeal. \"Campbell had the rare ability to cover other singer's hits and not draw the eye of the original artist's fans.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 27 - That's Entertainment! TV Variety Shows of the 70s","url":"https://seventies.libsyn.com/027-variety-shows-12920-5-16-pm"}]},{"kind":"podcast","title":"Brian Wilson Replacement in The Beach Boys","body":"Glenn Campbell served as a replacement for Brian Wilson in The Beach Boys at one point in his career. \"Glenn Campbell, former Brian Wilson replacement for the Beach Boys...\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Crossover Success in the 70s","body":"Already a talented musician, Glenn Campbell became a major star in the 1970s with his own TV show, largely benefiting from the country-pop sound and the blurring lines between country and pop, which created more exposure. \"It's the very thing that made Glenn Campbell, already a wonderful musician, a star with his own TV show in the 70s.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Non-Traditional Country Artist Perception","body":"Glenn Campbell would have had difficulty claiming to be a traditional country artist, even with hits like \"Rhinestone Cowboy\" and \"Country Boy,\" neither of which he wrote, but which made him famous to non-country fans. \"Glenn would have had a hard time ever making a claim to being a traditional country artist with hits like Rhyne Stone cowboy and Country Boy.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Perfected the \"Concert Spot\" on TV","body":"Steve Beverly, a professor and broadcast journalism veteran, observed that Glenn Campbell perfected the \"concert spot\" on television variety. Campbell would join John Hartford (composer of \"Gentle On My Mind\") and Nelson Riddle's Orchestra for a \"middle of the road accompaniment\" segment, offering a free mini-concert that captivated home audiences. \"Glenn perfected what became the concert spot on television variety.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 27 - That's Entertainment! TV Variety Shows of the 70s","url":"https://seventies.libsyn.com/027-variety-shows-12920-5-16-pm"}]},{"kind":"podcast","title":"Session Musician Background","body":"Prior to his solo fame, Glenn Campbell had a background as a session musician. \"Glenn Campbell, former Brian Wilson replacement for the Beach Boys, and a session musician...\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":"https://www.ftr70.com/"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":203888568260417,"type":"album","name":"Gentle on My Mind","list_id":167105581234386,"list":"RYM Top — Country — Country Pop","src":"musthear","rank":55,"year":1967,"note":null,"yt":"mfMnNqn-hKg","scaruffi":null},{"id":280270615309338,"type":"album","name":"By the Time I Get to Phoenix","list_id":167105581234386,"l