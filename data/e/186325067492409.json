ame":"Nu-Disco","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":240087846213534,"name":"Outsider house / techno mutante","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":2008,"end":2017,"desc":"Una región imprecisa del underground online que difumina las fronteras entre techno, house, ambient, dub, ruido y hasta rap: autoediciones, casetes y Bandcamp. Giegling (Traumprinz / Prince of Denmark), Diagonal (Powell), Opal Tapes (Huerco S.), Northern Electronics, L.I.E.S. de Ron Morelli, Lobster Theremin, Actress (Hazyville), Laurel Halo, Nicolas Jaar, Floating Points, Dean Blunt, patten.","color":"#22d3ee","family":"Techno y derivados","link":"https://volteret4.github.io/loops_timeline/#outsider-house"}],"book_tracks":[{"id":223060570966720,"artist":"Nicolas Jaar","artist_id":186325067492409,"title":"Space Is Only Noise","year":2011,"ess":0,"yt":"V-_c0o8LAaM","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Outsider house / techno mutante","scene_id":240087846213534,"scene_link":"https://volteret4.github.io/loops_timeline/#outsider-house","chapters":["Loops 2 · Cap. 12: El underground es enorme: últimos movimientos en el techno, el noise y otras corrientes abstractas"],"pages":[[2,408]]},{"id":144308453227679,"artist":"Nicolas Jaar","artist_id":186325067492409,"title":"Sirens","year":2016,"ess":1,"yt":"R23fgunj1qc","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Outsider house / techno mutante","scene_id":240087846213534,"scene_link":"https://volteret4.github.io/loops_timeline/#outsider-house","chapters":["Loops 2 · Cap. 12: El underground es enorme: últimos movimientos en el techno, el noise y otras corrientes abstractas"],"pages":[[2,408],[2,432]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":408,"text":"…es algo cada vez más habitual: es el camino emprendido por talentos mayores de la última etapa, y al mismo tiempo difícilmente clasificables, como Nicolas Jaar —que ha pasado de publicar house elegante a filtrar su obsesión por Pink Floyd en álbumes de trazo tan tenue y densidad ambiental como Sirens…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":408,"text":"…lo más útil es citar la letra de «Words», el viejo éxito italodisco de F.R. David: «No resulta fácil decirlo con palabras». Productores como Nicolas Jaar, Dean Blunt o Laurel Halo —y también otro anónimo exquisito, patten, un proyecto de IDM como disuelta en purpurina, un líquido sonoro de extraña…"}],"podcast":[{"kind":"podcast","title":"Collaborated with James Blake","body":"Nicolas Jaar has collaborated with James Blake. \"Ha colaborado con Nicolás Yar.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"JAMES BLAKE. El mago del sonido.","url":"https://www.youtube.com/watch?v=dLsLxcMVZFM"}]},{"kind":"podcast","title":"Influenced by James Blake","body":"Nicolas Jaar is cited as an artist of the same generation who has been significantly influenced by James Blake's slow and intimate electronic style. \"Esa ha sido una influencia importante para gente como Nicolayar.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"JAMES BLAKE. El mago del sonido.","url":"https://www.youtube.com/watch?v=dLsLxcMVZFM"}]}],"awards":[],"concerts":[{"kind":"concert","title":"(Not mentioned)","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":19465275338556,"type":"album","name":"Edits LP","list_id":159270824686753,"list":"RYM Top — Dance — Deep House","src":"musthear","rank":139,"year":2010,"note":null,"yt":"PQ_hP3A0WXE","scaruffi":null},{"id":19465275338556,"