{"id":215493143269863,"type":"album","name":"Damaged","artist":"Black Flag","year":1981,"weight":33,"info":{"cover":"https://dn710000.ca.archive.org/0/items/mbid-d718298d-3b67-4538-8067-657058f4cfd0/mbid-d718298d-3b67-4538-8067-657058f4cfd0-29280679750.jpg","kind":"Album","tracks":15,"country":"US","scaruffi":8.0,"yt":"wDUYCyajDcs","links":{"spotify":"https://open.spotify.com/album/34aFnrFRBlErcbU6moRZR3","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_luF4g-Dnf0lQg9iX5QGWavQklfZunnO7I","rateyourmusic":"https://rateyourmusic.com/release/album/black-flag/damaged"},"desc":"Damaged is the first full-length LP release by the American hardcore punk band Black Flag. Released in December 1981 on SST Records. It is widely considered both a classic of the era and the peak of Black Flag's career. The album cover, shot by punk photographer Ed Colver, features Rollins putting his fist through a mirror. The effect was made by cracking the mirror with a hammer, while the \"blood\" on Rollins' wrist is a mixture of red ink and coffee. Side One A1. \"Rise Above\" – 2:26 A2. \"Spray Paint (The Walls)\" (Dukowski, Ginn) – 0:33 A3. \"Six Pack\" ."},"artist_ref":{"id":201604988654894,"name":"Black Flag","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Black_Flag_-_2019.jpg?width=500"}},"labels":[],"genres":[{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"musthear"},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","artist":null,"year":null,"weight":714,"yt":null,"src":"musthear,rym"},{"id":274490571464652,"type":"genre","name":"Noise Rock","artist":null,"year":null,"weight":360,"yt":null,"src":"musthear"},{"id":129644386263637,"type":"genre","name":"Punk Rock","artist":null,"year":null,"weight":1272,"yt":null,"src":"rym"}],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","src":"musthear","grp":null,"list_year":null,"rank":26,"year":null,"note":null,"total":877,"scaruffi":8.0},{"id":