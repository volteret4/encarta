le","link":"https://volteret4.github.io/scaruffi/#techno-90s"}],"book_tracks":[{"id":234035781233683,"artist":"Ace Of Base","artist_id":196702386472624,"title":"All That She Wants","year":1992,"ess":0,"yt":"d73tiBBzvFM","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Techno y trance de los noventa","scene_id":132218155550361,"scene_link":"https://volteret4.github.io/scaruffi/#techno-90s","chapters":["Sección 6.9"],"pages":[[1,261,null]]},{"id":236899036392703,"artist":"Ace Of Base","artist_id":196702386472624,"title":"Beautiful Life","year":1995,"ess":0,"yt":"wh-07BzfgYY","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Techno y trance de los noventa","scene_id":132218155550361,"scene_link":"https://volteret4.github.io/scaruffi/#techno-90s","chapters":["Sección 6.9"],"pages":[[1,261,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":261,"text":"…from soul to glam. Sweden seemed to specialize in Abba-like melodies sung to the techno beat, whether in a clearly Abba-derived fashion, as Ace Of Base did with All That She Wants (1992) and Beautiful Life (1995), or in an ironic synth-pop style, as Aqua (1) did on the exuberant Aquarium (1997).…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":234035781233683,"type":"song","name":"All That She Wants","work_year":1993,"list_id":55625790664966,"list":"Billboard Year-End 1993","src":"singles","rank":51,"year":1993,"note":"","yt":"d73tiBBzvFM","scaruffi":null},{"id":234035781233683,"type":"song","name":"All That She Wants","work_year":1993,"list_id":182185249222410,"list":"Los 40 nº1 · 1993","src":"singles","rank":27,"year":1993,"note":"","yt":"d73tiBBzvFM","scaruffi":null},{"id":230153476583457,"type":"album","name":"Happy Nation","list_id":165348317223825,"l