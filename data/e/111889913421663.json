{"id":111889913421663,"type":"artist","name":"Hocico","artist":null,"year":null,"weight":12,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Hocico_Live_At_Lunario_Mexico_DF.JPG?width=500","bio":"Hocico es la banda mexicana con mayor proyección internacional no solo dentro de la escena oscura sino del underground en general. Un grupo que nos muestra la parte más bronca y oscura no solo de México sino del ser humano en general.\n\nHocico nace en México D.F. fruto de las inquietudes musicales de Erk Aicrag y Racso Agroyam, que además de ser primos coincidían en su gusto por la electrónica atípica y los sonidos industriales, de los cuales Skinny Puppy fue el que influencia ejerció en su música, según ellos mismos confiesan.","tags":["dark electro","ebm","industrial","darkwave","electronic"]},"works":[{"id":113172391304221,"type":"album","name":"Odio bajo el alma","artist":"Hocico","year":1997,"weight":9,"yt":"CrLh0JUHHho","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":123649763811663,"name":"RYM Top — Electronic — EBM","rank":114,"scaruffi":null},{"id":218535985973721,"name":"RYM Top — Electronic — Dark Electro","rank":21,"scaruffi":null},{"id":235879004384475,"name":"RYM Top — Electronic — Electro-Industrial","rank":154,"scaruffi":null},{"id":246783722732004,"name":"RYM Top — Dance — Aggrotech","rank":10,"scaruffi":null}],"n_lists":4}},{"id":160624969132095,"type":"album","name":"El Dia De La Ira","artist":"Hocico","year":1998,"weight":6,"yt":"GcALdmopXP4","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":195523767565997,"type":"album","name":"Sangre hirviente","artist":"Hocico","year":1999,"weight":9,"yt":"CrLh0JUHHho","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":123649763811663,"name":"RYM Top — Electronic — EBM","rank":73,"scaruffi":null},{"id":218535985973721,"name":"RYM Top — Electronic — Dark Electro"