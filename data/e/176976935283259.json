fi":null}],"n_lists":1}},{"id":39126576846797,"type":"song","name":"Bad Blood","artist":"Neil Sedaka","year":1975,"weight":5,"yt":"_8B5S0j2jTQ","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":7520871391222,"name":"Billboard Year-End 1975","rank":93,"scaruffi":null},{"id":219509302503571,"name":"Billboard Hot 100 nº1 · 1970s","rank":379,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":93,"scaruffi":null}],"n_lists":3}},{"id":141995574978879,"type":"song","name":"Laughter in the Rain","artist":"Neil Sedaka","year":1975,"weight":5,"yt":"MtIibcNDQ6o","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":7520871391222,"name":"Billboard Year-End 1975","rank":9,"scaruffi":null},{"id":219509302503571,"name":"Billboard Hot 100 nº1 · 1970s","rank":352,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":9,"scaruffi":null}],"n_lists":3}},{"id":62043574213970,"type":"album","name":"Brighton Beach Memories: Neil Sedaka Sings Yiddish","artist":"Neil Sedaka","year":2003,"weight":3,"yt":"RzaznfB2h_o","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":155834525797892,"name":"RYM Top — Folk — Yiddish Folksong","rank":69,"scaruffi":null}],"n_lists":1}},{"id":7933581125774,"type":"song","name":"Ushala-la","artist":"Neil Sedaka","year":null,"weight":7,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":2}],"lists":[],"n_lists":0}},{"id":226235204434309,"type":"song","name":"While I Dream","artist":"Neil Sedaka","year":null,"weight":7,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":2}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":132787149532015,"type":"artist","name":"The Tokens","artist":null,"year":null,"weight":55,"yt":null,"src":"ensayos"},{"id":200695822345373,"type":"artist","name":"The Linktones","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"},{"id":223816169258617,"type":"artist","name":"The Linc-Tones","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":160338280079466,"type":"genre","name":"Yiddish Folksong","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Early Songwriting and Performing Career","body":"Neil Sedaka briefly dated Carole King and, with Howard Greenfield, co-wrote \"While I Dream,\" which his group, The Tokens, recorded after securing a deal. Sedaka and Greenfield later became successful staff songwriters, and Sedaka also became a successful performer, with his first hit, \"Oh! Carol,\" being written about Carole King. \"Siddak had briefly dated her and had co-written that song himself with Howard Greenfield, and his group got a record deal under the name The Tokens.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 89: \"Will You Love Me Tomorrow?\" by the Shirelles","url":"https://www.youtube.com/watch?v=7Kns2HGcuSg"}]},{"kind":"podcast","title":"Introducing Carole King to Aldon Music","body":"King bumped into Sedaka at 1650 Broadway, and he told her she should meet Al Nevins and Don Kirshner, the owners of Aldon Music, leading to Goffin and King's significant songwriting contract. \"But then, when she was on one of her visits to 1650 Broadway to sell songs, King bumped into Sedaka, who told her she should come and meet Al Nevin's and Don Kirschner, the owners of Aldon Music.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 89: \"Will You Love Me Tomorrow?\" by the Shirelles","url":"https://www.youtube.com/watch?v=7Kns2HGcuSg"}]},{"kind":"podcast","title":"Scopatone Involvement","body":"Neil Sedaka was among the artists who produced films for the Scopatone machines. These machines were a form of video jukebox popular in the mid-1960s, offering short, often color, musical films in public venues. \"The Sedacca, Bobby V, Dion Warwick, and a few others got into the Scopatone business.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Future of the Music Video - Part 1","url":"https://www.youtube.com/watch?v=lqd6IbUJ7tg"}]},{"kind":"podcast","title":"Signed to Aldon Music","body":"Neil Sedaka and Howard Greenfield were among the talented new songwriters signed by Don Kirshner and Al Nevins for their publishing company, Aldon Music. \"Kirschner and Nevin's were looking for talented new songwriters, and they had signed up Siddhaka in Greenfield, and also signed Paul Simon around this time, as well as another couple, Barry Manor and Cynthia Wilde.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 89: \"Will You Love Me Tomorrow?\" by the Shirelles","url":"https://www.youtube.com/watch?v=7Kns2HGcuSg"}]},{"kind":"podcast","title":"Twist Record (Year?)","body":"Neil Sedaka was among the many artists who recorded a twist record during the craze. Most of these cash-in records were generally considered to be of poor quality. \"There were twist records by Bill Haley, Neil Sedarka, Dwayne Eddie, almost all of these were terrible records.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 91: \"The Twist\" by Chubby Checker","url":"https://www.youtube.com/watch?v=LzsS8EXdsm8"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best Contemporary Song (1959) — Rock with Sedaka","body":"Nominated.","year":1959,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q5593779"}]},{"kind":"award","title":"Grammy Award for Best Contemporary Song (1963) — Breaking Up Is Hard to Do","body":"Nominated.","year":1963,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q5593779"}]},{"kind":"award","title":"Grammy Award for Best Male Pop Vocal Performance (1976) — Bad Blood","body":"Nominated.","year":1976,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q947090"}]},{"kind":"award","title":"Grammy Award for Song of the Year (1976) — Love Will Keep Us Together","body":"Nominated.","year":1976,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1027904"}]},{"kind":"award","title":"Grammy Award for Song of the Year (1977) — Breaking Up Is Hard to Do","body":"Nominated.","year":1977,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1027904"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[],"charts":[{"id":263180188341943,"type":"song","name":"Stairway to Heaven","work_year":1960,"list_id":132782249584307,"list":"Billboard Year-End 1960","src":"singles","rank":76,"year":1960,"note":"","yt":"EmmICSOtUuk","scaruffi":null},{"id":263180188341943,"type":"song","name":"Stairway to Heaven","work_year":1960,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":76,"year":1960,"note":null,"yt":"EmmICSOtUuk","scaruffi":null},{"id":266837489482724,"type":"song","name":"\"Oh! Carol\" ‡","work_year":1960,"list_id":167954413065108,"list":"UK Singles Chart","src":"charts","rank":12,"year":1960,"note":null,"yt":null,"scaruffi":null},{"id":141028401125594,"type":"song","name":"Calendar Girl","work_year":1961,"list_id":235736466885428,"list":"Billboard Year-End 1961","src":"singles","rank":33,"year":1961,"note":"","yt":"BpH1PjG55WU","scaruffi":null},{"id":141028401125594,"type":"song","name":"Calendar Girl","work_year":1961,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":33,"year":1961,"note"