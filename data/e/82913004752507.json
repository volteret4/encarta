asts":[{"name":"A History of Rock Music in 500 Songs","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"ensayos"}],"album_genres":[{"id":242278090641465,"type":"genre","name":"Show Tunes","n":1},{"id":187212753338240,"type":"genre","name":"Twist","n":1},{"id":163536058891268,"type":"genre","name":"Traditional Pop","n":1},{"id":9877689544171,"type":"genre","name":"Standards","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":238731155621345,"name":"Alicia, la locura y el regreso a la infancia","book":"1966: The Year the Decade Exploded","author":"Jon Savage","start":1966,"end":1967,"desc":"Al final de 1966 el LSD llevó al pop de vuelta a la infancia y a la locura. Los Beatles empezaron el 24 de noviembre «Strawberry Fields Forever», un viaje de Lennon hacia abajo, no hacia atrás, al orfanato junto a su casa, «psicoanálisis con música», unida por Geoff Emerick a partir de dos tomas; luego «When I’m Sixty-Four» y «Penny Lane». En Navidad la BBC aplazó el Alice in Wonderland de Jonathan Miller, sin cabezas de animal, con el sitar de Ravi Shankar y rodado en un hospital militar de víctimas de neurosis de guerra: un catálogo de psicosis. Grace Slick llevó «White Rabbit» a Jefferson Airplane; Syd Barrett escribía sobre el mundo de Lewis Carroll. Proliferaban los discos sobre la locura («They’re Coming to Take Me Away, Ha-Haaa!», «Pandora’s Golden Heebie Jeebies» de los Association), y en el corazón secreto del año, la tristeza frágil de «How Can We Hang On to a Dream» de Tim Hardin.","color":"#c084fc","family":"Psicodelia, LSD y raga rock","link":"https://volteret4.github.io/1966/#regreso-infancia"}],"book_tracks":[{"id":246764869563598,"artist":"Bobby Darin","artist_id":82913004752507,"title":"If I Were a Carpenter","year":1966,"ess":0,"yt":"btWobQsGcS4","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Alicia, la locura y el regreso a la infancia","scene_id":238731155621345,"scene_link":"https://volteret4.github.io/1966/#regreso-infancia","chapters":["Diciembre: My Mind’s Eye: sueños de libertad, una minoría profética y el regreso a la infancia"],"pages":[]},{"id":161270745796349,"artist":"Bobby Darin","artist_id":82913004752507,"title":"If I Was a Carpenter","year":1966,"ess":1,"yt":"bjFRLOktHXo","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Alicia, la locura y el regreso a la infancia","scene_id":238731155621345,"scene_link":"https://volteret4.github.io/1966/#regreso-infancia","chapters":["Discografía: Los singles de cada mes de 1966"],"pages":[[1,386],[1,398],[1,461]]}],"mentions":[{"book":"1966: The Year the Decade Exploded","author":"Jon Savage","page":386,"text":"…Hang on to a Dream’. ‘How can it, will it be, the way it seems / How can we hang on to a dream?’ Hardin sang. He was in the news that autumn, after Bobby Darin’s version of Hardin’s ‘If I Was a Carpenter’ became a major hit on both sides of the Atlantic. A troubled, difficult man, labouring with a heroin…"},{"book":"1966: The Year the Decade Exploded","author":"Jon Savage","page":398,"text":"…HBR Euphoria, ‘No Me Tomorrow’, Mainstream The Beau Brummels, ‘Here We Are Again’, Warner Bros. Johnny Rivers, ‘Poor Side of Town’, Imperial Bobby Darin, ‘If I Was a Carpenter’, Atlantic Dusty Springfield, ‘All I See Is You’, Philips Janis Ian, ‘Society’s Child’, Verve Herman’s Hermits, ‘No Milk…"}],"podcast":[{"kind":"podcast","title":"Pioneering Apollo Performance (Pre-1957)","body":"Bobby Darin played the Harlem Apollo before The Crickets, disproving the claim that The Crickets were the first white act to perform there. \"Bobby Daring had played there before them, and I think so had the jazz drummer Buddy Rich and maybe one or two others.\"","year":1957,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 74: \"It Doesn't Matter Any More\" by Buddy Holly","url":"https://www.youtube.com/watch?v=6unib5T2mDQ"}]},{"kind":"podcast","title":"Co-Writer of \"I Want Elvis for Christmas\" (as Walden Kosoto)","body":"Bobby Darin, then known as Walden Kosoto, co-wrote the novelty song \"I Want Elvis for Christmas.\" He later changed his name and became a significant figure in music. \"a young man named Walden Kosoto, who would soon change his name to Bobby DARREN.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 40: \"Drugstore Rock 'n' Roll\" by Janis Martin","url":"https://www.youtube.com/watch?v=l0i2p9TelN0"}]},{"kind":"podcast","title":"Early Best New Artist Winner","body":"Bobby Darin was an early recipient of the Best New Artist prize, which was launched in the early 1960s as a way for the Academy to acknowledge young performers whose music aligned with voters' preferences. \"Early winners of the prize included Bobby Darren, Robert Goulet and Tom Jones.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"And the Grammy Goes to… Edition Part 1","url":null}]}],"awards":[],"concerts":[{"kind":"concert","title":"Harlem Apollo","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":145320181707693,"type":"song","name":"Splish Splash","work_year":1958,"list_id":158051727660304,"list":"Billboard Year-End 1958","src":"singles","rank":38,"year":1958,"note":"","yt":"QSA-yHzkvP8","scaruffi":null},{"id":145320181707693,"type":"song","name":"Splish Splash","work_year":1958,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":38,"year":1958,"note":null,"yt":"QSA-yHzkvP8","scaruffi":null},{"id":178115797871773,"type":"song","name":"Mack the Knife","work_year":1959,"list_id":157497903047680,"list":"Billboard Hot 100 nº1 · 1960s","s