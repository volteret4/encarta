"scenes":[{"id":107821463590177,"name":"Cubop: el jazz afrocubano","book":"Historia del jazz","author":"Ted Gioia","start":1938,"end":1960,"desc":"El «tinte español» de Jelly Roll Morton, la habanera de Joplin y de Handy y las modas del tango y la rumba anunciaban la fusión, pero la perspectiva afrocubana llega con los músicos cubanos de Nueva York: Mario Bauza (1930) y Machito con sus Afro-Cubans, que funden armonías de jazz y ritmos cubanos y abren camino a la salsa. En 1947 Gillespie incorpora a su big band al conguero Chano Pozo, que no lee música; las claves cubanas chocan con el pulso del jazz y hay que negociar: «Manteca», «Cubana Be, Cubana Bop» (con George Russell) en el Carnegie Hall. Pozo, pendenciero con una bala en la columna, muere tiroteado en 1948.","color":"#a3e635","family":"Fusión: jazz-rock, ECM y músicas del mundo","link":"https://volteret4.github.io/jazz/#cubop"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":218807537223909,"type":"album","name":"Afro-Cuban Jazz","list_id":201996500458547,"list":"RYM Top — Jazz — Afro-Cuban Jazz","src":"musthear","rank":26,"year":1951,"note":null,"yt":"6qgF5Vd1mi4","scaruffi":null},{"id":218807537223909,"type":"album","name":"Afro-Cuban Jazz","list_id":169801062769736,"list":"RYM Top — Jazz — Big Band","src":"musthear","rank":164,"year":1951,"note":null,"yt":"6qgF5Vd1mi4","scaruffi":null},{"id":218807537223909,"type":"album","name":"Afro-Cuban Jazz","list_id":45090916084136,"list":"RYM Top — Jazz — Latin Jazz","src":"musthear","rank":135,"year":1951,"note":null,"yt":"6qgF5Vd1mi4","scaruffi":null},{"id":218807537223909,"type":"album","name":"Afro-Cuban Jazz","list_id":120285993197847,"list":"RYM Top — Regional Music — Rhumba","src":"musthear","rank":2,"year":1951,"note":null,"yt":"6qgF5Vd1mi4","scaruffi":null},{"id":223834692649128,"type":"album","name":"Jazz With Flip and Bird","list_id":201996500458547,"list":"RYM Top — Jazz — Afro-Cuban Jazz","src":"musthear"