{"id":129089399818757,"type":"album","name":"A Piece of Strange","artist":"CunninLynguists","year":2006,"weight":12,"info":{"cover":"https://i.discogs.com/leucJc4b-6yZqycpr8f4npKLFRR-uBGEj3D8WdtqBX8/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTY0MzEy/Ny0xMzQ3OTg2NDQ0/LTQ3MzYuanBlZw.jpeg","aoty":80,"aoty_user":87,"yt":"QO53tTmU42k","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/cunninlynguists/a-piece-of-strange/","aoty":"https://www.albumoftheyear.org/album/15410-cunninlynguists-a-piece-of-strange.php"},"desc":"A Piece of Strange is the third studio album by CunninLynguists. It was released January 24, 2006, by The LA Underground, a record label based in New Mexico. The “high-concept record” tells the \"tale of the pathway to and from sin\". The album was produced entirely by Kno, and vocals are by Kno, Deacon the Villain and Natti, who joined the group prior to the recording of the album. Featured guest vocalists include Cee-Lo Green, Immortal Technique, and Tonedeff. Deacon and Kno have both cited the album's importance to their careers in interviews, with Kno calling it a \"turning point\" ."},"artist_ref":{"id":140554395480557,"name":"CunninLynguists","info":{"img":null}},"labels":[],"genres":[{"id":26869950655266,"type":"genre","name":"Conscious Hip Hop","artist":null,"year":null,"weight":252,"yt":null,"src":"rym"},{"id":76750303293721,"type":"genre","name":"Southern Hip Hop","artist":null,"year":null,"weight":210,"yt":null,"src":"rym"}],"lists":[{"id":71331885159676,"name":"Sputnikmusic Best Albums 2006","src":"charts","grp":"sputnikmusic","list_year":null,"rank":12,"year":2006,"note":null,"total":200,"scaruffi":null},{"id":218288666034832,"name":"RYM Top — Scenes & Movements — Southern Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":25,"year":null,"note":null,"total":200,"scaruffi":null},{"id":16699661381161,"name":"RYM Top — Hip Hop — Conscious Hip Hop","src":"musthear","grp":"rateyourmus