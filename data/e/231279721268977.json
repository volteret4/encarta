276494,"type":"genre","name":"Britpop","n":1},{"id":191826593279813,"type":"genre","name":"Art Rock","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":173341470623130,"type":"genre","name":"avant-garde","n":1},{"id":166905196183001,"type":"genre","name":"psychedelic","n":1},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":1},{"id":87625349211221,"type":"genre","name":"electronic","n":1},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","n":1},{"id":30277598324326,"type":"genre","name":"pop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":193634530822272,"name":"Brit-pop y post-pop","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2001,"desc":"Como tantas veces, el fenómeno más publicitado es el menos interesante: un «brit-pop» de grupos terriblemente parecidos y tediosos, sin apenas imaginación. Lo anticipan Lightning Seeds, La's, Teenage Fanclub y Heavenly; estalla con Boo Radleys, Blur (Parklife) y Oasis (el «farol» que mejor personifica la moda). Suede y el glam-pop (Super Furry Animals, Placebo), las excepciones de High Llamas (Hawaii) y Supergrass, el revival mod (Ocean Colour Scene, Wildhearts), Elastica, Sleeper, las Spice Girls; Trembling Blue Stars, Tindersticks, Delgados. El post-pop de Radiohead, «la banda más publicitada y sobrevalorada de la década», cuyo OK Computer es una obra maestra del falso vanguardismo; Coldplay, Travis.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#britpop"}],"book_tracks":[{"id":192702477776715,"artist":"Super Furry Animals","artist_id":231279721268977,"title":"Fuzzy Logic","year":1996,"ess":0,"yt":"8tV0UdH9fuw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Brit-pop y post-pop","scene_id":193634530822272,"scene_link":"https://volteret4.github.io/scaruffi/#britpop","chapters":["Sección 6.11"],"pages":[[1,271,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":271,"text":"…guitarist Bernard Butler and vocalist Brett Anderson, offered an original take on glam-pop on Suede (1993), one that inspired bands such as the Super Furry Animals, with Fuzzy Logic (1996), and Placebo , with Placebo (1996). The Smiths were a strong influence on the Sundays, Echobelly, Gene. The exceptions to…"}],"podcast":[],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Celery Contribution to Super Furry Animals Album (2001)","body":"Paul McCartney provided a unique audio contribution to the Welsh band Super Furry Animals' 2001 album \"Rings Around the World.\" When asked to appear on their record, he sent a tape solely containing a recording of himself munching on celery, which the band subsequently used in their song \"Receptacle for the Respectable.\" \"When they arrived, it was a recording of Paul munching on some celery.\"","year":2001,"extra":{"from":"Paul McCartney","from_id":119088674770166,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"60 Mind-Blowing Things About Music: 2021 Edition","url":"https://www.youtube.com/watch?v=-N6IM5Nm5iw"}]}],"charts":[{"id":192702477776715,"type":"album","name":"Fuzzy Logic","work_year":1996,"list_id":192934750972716,"list":"1001 Albums You Must Hear Before You Die","src":"charts","rank":808,"year":1996,"note":null,"yt":"Sol7-jZNdmQ","scaruffi":null},{"id":192702477776715,"type":"album","name":"Fuzzy Logic","list_id":238350566072075,"list":"Pitchfork: The 50 Best Britpop Albums","src":"musthear","rank":27,"year":1996,"note":null,"yt":"Sol7-jZNdmQ","scaruffi":null},{"id":100380232078870,"type":"album","name":"Radiator","list_id":238350566072075,"list":"Pitchfork: The 50 Best Britpop Albums","src":"musthear","rank":39,"year":1997,"note":null,"yt":"ydl8CwwdPDo","scaruffi":null},{"id":100380232078870,"type":"album","name":"Radiat