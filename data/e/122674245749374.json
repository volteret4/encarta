:2}},{"id":118494266581563,"type":"album","name":"Sad and Beautiful World","artist":"Mavis Staples","year":2025,"weight":5,"yt":"OShmKRJSo-I","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":63534269289112,"name":"RYM Top — R&B — Country Soul","rank":12,"scaruffi":null},{"id":244033470729643,"name":"RYM Top — Blues — Soul Blues","rank":26,"scaruffi":null}],"n_lists":2}},{"id":208459931686106,"type":"album","name":"If Fireworks Black (XXXX)","artist":"Mavis Staples","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Music Radar Clan","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":49047535212782,"type":"artist","name":"The Staple Singers","artist":null,"year":null,"weight":59,"yt":null,"src":"ensayos"},{"id":51824383398004,"type":"artist","name":"The Staples Singers","artist":null,"year":null,"weight":21,"yt":null,"src":"ensayos"},{"id":82021389671505,"type":"artist","name":"Wilco (Jeff Tweedy is leader)","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"genres":[{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"ensayos"}],"album_genres":[{"id":256632372789084,"type":"genre","name":"Southern Soul","n":7},{"id":224919310739583,"type":"genre","name":"Deep Soul","n":6},{"id":242270330474188,"type":"genre","name":"Country Soul","n":2},{"id":90654382831690,"type":"genre","name":"Minneapolis Sound","n":2},{"id":152058655173795,"type":"genre","name":"Soul Blues","n":1},{"id":30122583811636,"type":"genre","name":"Soul","n":1},{"id":27872059790879,"type":"genre","name":"Rhythm & Blues","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":234795621419355,"name":"Prince y el sonido Mineápolis","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1978,"end":1995,"desc":"Prince Rogers Nelson, hijo de músicos de Mineápolis, obtuvo de Warner el control creativo total a los diecisiete años y cambió la música del país como nadie desde James Brown. Arreglos desnudos como los de Rick James, voz de gospel, todos los instrumentos y un erotismo descarado («ningún negro jugaba así con la sensibilidad heterosexual desde Little Richard»): «Soft and Wet», «I Wanna Be Your Lover», «Head» de Dirty Mind (1980), «Erotic City». Warner lo vendió con Zapp como «New Black Funk». Controversy, 1999 («Let’s Work», «D.M.S.R.») y Purple Rain (1984), película y plataforma de satélites (Vanity, Apollonia, Sheila E., The Family). The Time de Morris Day («Cool», «777-9311», «Jungle Love») fijaron el listón de precisión del naked funk, y de ellos salieron Jesse Johnson y Jimmy Jam y Terry Lewis, productores de Janet Jackson, New Edition o S.O.S. Band. Luego vinieron mundos fantásticos al nivel de P-Funk o los Beatles (Around the World in a Day, Parade, Sign o’ the Times, Lovesexy). El psicólogo Alvin Poussaint lo llamó «flautista de Hamelín de una generación obsesionada por el sexo», quizá preparada así para el gangsta rap.","color":"#22d3ee","family":"Funk de los ochenta: Prince, Rick James, electro","link":"https://volteret4.github.io/Funk/#prince"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Composed by Jeff Tweedy","body":"All of the songs on Mavis Staples' new album, \"If Fireworks Black,\" were specially composed for her by Jeff Tweedy, who is the leader of the band Wilco, potentially giving it a fresh sound. \"lo ha compuesto para ella por encargo Jeff Twiddy el líder de la banda Wilco.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Lanzamientos Noviembre 2017","url":"https://www.youtube.com/watch?v=kA9T4DfQ0j8"}]},{"kind":"podcast","title":"Enduring Career and Critical Success","body":"Despite being active for approximately 50 years, Mavis Staples continues to release albums with regularity, and her recent works from 2010, 2012, and 2016 have consistently garnered very good reviews. \"ella en los últimos discos que ha sacado en el 2010, 2012, 2016, ha tenido bastantes buenas críticas a pesar de ser una persona que lleva como 50 años en activo.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Lanzamientos Noviembre 2017","url":"https://www.youtube.com/watch?v=kA9T4DfQ0j8"}]},{"kind":"podcast","title":"Humans Album Collaboration","body":"Mavis Staples contributed to the Gorillaz album \"Humans.\" \"On the record, Dela Soel, Grace Jones, Pusha T, Mavis Staples, those who declined to participate included Morrissey, and Dion Warwick, who had some kind of religion.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Gorillaz - A History","url":"https://www.youtube.com/watch?v=iVdTCqpd798"}]},{"kind":"podcast","title":"Songwriting Credit Dispute","body":"Mavis Staples was reportedly displeased that Al Bell took the soul songwriting credits for \"I'll Take You There,\" despite her having mostly ad-libbed the lyrics during the recording session at Muscle Shoals. \"she was not too pleased that Al Bell took the soul songwriting credits, but that's another conversation for another time.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 32 - Take Me to Church - Religion in 70s Popular Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 32 - Take Me to Church - Religion in 70s Popular Music","url":"https://seventies.libsyn.com/ep-32-take-me-to-church-religion-in-70s-popular-music"}]}],"awards":[{"kind":"award","title":"\"Spirit of Americana\" Free Speech Award (2007)","body":"Won.","year":2007,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q96586004"}]},{"kind":"award","title":"Kennedy Center Honors (2016)","body":"Won.","year":2016,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1738793"}]},{"kind":"award","title":"\"Spirit of Americana\" Free Speech Award (2019)","b