{"id":130073154060169,"type":"album","name":"Quebec","artist":"Ween","year":2003,"weight":14,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/quebec-1.jpg","aoty":67,"aoty_user":86,"yt":"hkX2QATlgbo","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/ween/quebec","aoty":"https://www.albumoftheyear.org/album/1566-ween-quebec.php"},"desc":"Quebec is the eighth album by American alternative rock band Ween, released on August 5, 2003 on Sanctuary Records. It was the first album released after the band's contract with Elektra expired, and marked its return to independent labels. The album on a whole is comparable to Chocolate and Cheese or their first album GodWeenSatan: The Oneness in that not one single mood or theme can describe it, unlike their \"country record\" 12 Golden Country Greats, their \"nautically-themed\" The Mollusk, their Beatle-esque \"pop\" album White Pepper, the dark and murky The Pod and the cheerful and druggy Pure Guava ."},"artist_ref":{"id":92029095903601,"name":"Ween","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Ween_in_Edmonton_Alberta.jpg?width=500"}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"rym"},{"id":147423806094006,"type":"genre","name":"Psychedelic Rock","artist":null,"year":null,"weight":690,"yt":null,"src":"rym"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"rym"},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","artist":null,"year":null,"weight":266,"yt":null,"src":"rym"}],"lists":[{"id":185548171992260,"name":"RYM Top — Rock — Psychedelic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":114554236241704,"name":"RYM Top — Psychedelia — Neo-Psychedelia","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":11,"year":null,"not