:"ensayos","from":{"books":[],"podcasts":[{"name":"For the Record - The 70s","n":2}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":106115726467187,"type":"artist","name":"The Eagles","artist":null,"year":1971,"weight":323,"yt":null,"src":"ensayos"},{"id":183049288466234,"type":"artist","name":"Linda Ronstadt","artist":null,"year":1946,"weight":196,"yt":null,"src":"ensayos"},{"id":198093734085221,"type":"artist","name":"Linda Ronstadt's band (formerly)","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"},{"id":44213057566414,"type":"artist","name":"Linda Ronstadt's band (before forming The Eagles)","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":164529051065355,"type":"genre","name":"Contemporary Country","n":1},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":77707013048741,"name":"Los autores (1975-1990)","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1975,"end":1990,"desc":"La emancipación definitiva de la mujer en el rock (Terry Garthwaite, Joan Armatrading, Nanci Griffith y, sobre todo, Rickie Lee Jones, protegida de Tom Waits); la escuela tejana de cantautores herederos de Townes Van Zandt (Guy Clark, Butch Hancock, Joe Ely, Terry Allen, Rodney Crowell, T-Bone Burnett); el populismo melancólico de la posguerra de Vietnam (Warren Zevon, Rick Danko, Steve Forbert, John Hiatt, John Mellencamp, Don Henley, Donald Fagen, Robbie Robertson); y el puente de 1977 hacia la new wave: Peter Gabriel, poeta atormentado de las neurosis postindustriales, Marianne Faithfull y Kate Bush.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#auteurs"}],"book_tracks":[{"id":158775441174608,"artist":"Don Henley","artist_id":102207721832796,"title":"The End Of Innocence","year":1989,"ess":0,"yt":"giZ2tSSojxo","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Los autores (1975-1990)","scene_id":77707013048741,"scene_link":"https://volteret4.github.io/scaruffi/#auteurs","chapters":["Sección 4.6"],"pages":[[1,97,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":79,"text":"mediocre country-rockers such as such as Poco and Loggins & Messina, until the Eagles (2), a super-group of sort, featuring songwriters Don Henley and Glenn Frey, originally inspired by Crosby Stills & Nash, gave country-rock a more personal and universal meaning, from the melancholy western…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":97,"text":"…Scarecrow (1985), the album featuring Rain On The Scarecrow and R.O.C.K. In The USA, and with Paper In Fire (1987). Former Eagles singer-songwriter Don Henley (1) perfected an art of mournful Dylan-esque sermons until he delivered one of the most gripping social frescoes of the 1980s, The End Of Innocence…"}],"podcast":[{"kind":"podcast","title":"Attempting to Place Songs with Linda Ronstadt","body":"As a newcomer in Los Angeles, Don Henley wrote songs with the hope that Linda Ronstadt would record them, indicating an early effort to break into the music scene. \"After The Stone Pony's broke up and Linda went solo, she was given some songs that a newcomer in town, Don Henley, had written and he had hoped that she would record.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Formation of The Eagles","body":"Don Henley, along with Glen Frey, was a member of Linda Ronstadt's band before they went on to form the hugely successful band The Eagles. \"We know now just how huge Glen Fry and Don Henley who were in her band would become when they formed the Eagles.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Meeting at The Troubadour","body":"Don Henley met Linda Ronstadt and Glenn Frey at The Troubadour bar, a key meeting that eventually led to the formation of The Eagles. \"I met Bernie Leiden and G. Glenn Fry and Don Henley. I met them at the troubadour bar.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]}],"awards":[{"kind":"award","title":"National Humanities Medal (1997)","body":"Won.","year":1997,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1571938"}]},{"kind":"award","title":"MusiCares Person of the Year (2007)","body":"Won.","year":2007,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q326482"}]},{"kind":"award","title":"Americana Trailblazer Award (2015)","body":"Won.","year":2015,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q96542500"}]},{"kind":"award","title":"Kennedy Center Honors (2016)","body":"Won.","year":2016,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1738793"}]}],"concerts":[],"xref":[],"charts":[{"id":265301572862899,"type":"song","name":"Dirty Laundry"