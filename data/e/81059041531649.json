ame":"RYM Top — Dance — Psytrance","rank":82,"scaruffi":null}],"n_lists":3}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":162907557391510,"type":"genre","name":"Progressive House","n":7},{"id":198176882370097,"type":"genre","name":"Techno","n":2},{"id":140333798282585,"type":"genre","name":"House","n":2},{"id":48431972897055,"type":"genre","name":"Ambient House","n":2},{"id":187945729780266,"type":"genre","name":"Psytrance","n":1},{"id":157770834631767,"type":"genre","name":"Progressive Psytrance","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":119686161909791,"name":"Escuela de Canterbury","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1968,"end":1984,"desc":"Uno de los movimientos más importantes de la historia del rock nace en 1962 con los Wilde Flowers, de los que salen Soft Machine y Caravan. Soft Machine pasan del dadaísmo psicodélico al jazz-rock (3, con la «Moon In June» de Wyatt); Caravan hacen un jazz-rock más ligero y melódico; Nucleus, Keith Tippett, Egg; Gong de Daevid Allen, psicodelia cósmica y demente (Flying Teapot); Kevin Ayers, dandi decadente; Robert Wyatt y Rock Bottom, «una de las obras maestras supremas del rock»; Hatfield & The North, National Health; Mike Oldfield, que con Tubular Bells vuelve obsoleto el término «progresivo»; y la segunda generación de Henry Cow (Rock In Opposition), Slapp Happy y Art Bears.","color":"#38bdf8","family":"Progresivo, krautrock y jazz-rock","link":"https://volteret4.github.io/scaruffi/#canterbury"},{"id":227144109920067,"name":"Chill out","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1989,"end":2002,"desc":"Las salas de descanso de las raves dieron paso a una cultura y un sonido inspirados en el relax y la escucha horizontal.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#chill-out"}],"book_tracks":[{"id":246006543149564,"artist":"System 7","artist_id":81059041531649,"title":"System 7","year":1991,"ess":0,"yt":"f-BV3X2i4Xs","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Escuela de Canterbury","scene_id":119686161909791,"scene_link":"https://volteret4.github.io/scaruffi/#canterbury","chapters":["Sección 3.6"],"pages":[[1,64,null]]},{"id":274290261074361,"artist":"System 7","artist_id":81059041531649,"title":"Interstate (Power of Seven)","year":1995,"ess":0,"yt":"9Fe080BkoRU","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Chill out","scene_id":227144109920067,"scene_link":"https://volteret4.github.io/loops_timeline/#chill-out","chapters":["Cap. 2: Rock around the click: la electrónica de los setenta, de Hallogallo al ambient en la era del Moog (1968-1982)"],"pages":[[1,54]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":64,"text":"…(1979). Other notable works by Canterbury veterans include L (1976) by Steve Hillage (2), who would later bridge hippy culture and rave culture on System 7 (1991), and Tim Blake's New Jerusalem (1978). The Henry Cow alumni were the most prolific, especially after the new wave (1976) rediscovered them.…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":43,"text":"…la caja de ritmos o el teclado digital. Steve Hillage, por ejemplo, pasó de ser guitarrista de Gong a estar al frente del grupo ambient-house System 7 con Miquette Giraudy; Jaki Liebezeit, batería de Can, fusionó en su última etapa percusión acústica con ritmos programados en Club Off Chaos; Irmin…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":54,"text":"…concepción electrónica basada en la música de baile, y tras frecuentar a finales de los ochenta el club Heaven de Londres, Hillage ideó un proyecto, System 7, en el que involucró a músicos como Alex Paterson, Derrick May o Youth y llegó a samplear —en el tema «Interstate», perteneciente al disco Power of…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":223,"text":"…los noventa había estado profundamente denostada por la vanguardia de la música de baile —que prefería el ambient house de artistas como The Orb o System 7, o las recopilaciones Artificial Intelligence de Warp, para sus momentos de relax tras el esfuerzo físico y el exceso químico del club—, de repente…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":246006543149564,"type":"album","name":"System 7","list_id":269268589795827,"list":"90s Chillout Session. @ASpiritualMoon","src":"musthear","rank":239,"year":1991,"note":null,"yt":"vUdsd1nvHGA","scaruffi":7.0},{"id":246006543149564,"type":"album","name":"System 7","list_id":45970711167107,"list":"RYM Top — Electronic — Ambient House","src":"musthear","rank":89,"year":1991,"note":null,"yt":"vUdsd1nvHGA","scaruffi":7.0},{"id":246006543149564,"type":"album","name":"System 7","work_year":1991,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":1228,"year":1991,"note":null,"yt":"vUdsd1nvHGA","scaruffi":7.0},{"id":105348749470090,"type":"album","name":"777","list_id":66644525313414,"list":"RYM Top — Dance — Progressive House","src":"musthear","rank":41,"year":1993,"note":null,"yt":"bQTdXjpfoUQ","scaruffi":null},{"id":44428130236743,"type":"album","name":"Point 3 (Fire Album)","list_id":66644525313414,"list":"RYM Top — Dance — Progressive House","src":"musthear","rank":116,"year":1994,"note":null,"yt":"ssfMp_WlLkI","scaruffi":null},{"id":5241695300483,"type":"album","name":"Point 3 (Water Album)","list_id":45970711167107,"list":"RYM Top — Electronic — Ambient House","src":"musthear","rank":108,"year":1994,"note":null,"yt":"bR82HNQ7bGg","scaru