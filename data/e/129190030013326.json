labels":[],"own_scenes":[],"scenes":[{"id":98599911480017,"name":"Space-pop","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1986,"end":2000,"desc":"Tras la orgía de distorsión del dream-pop y el shoegazing, en EE UU se busca disciplina: Mark Kramer (Shockabilly, B.A.L.L., Bongwater, el coloso The Guilt Trip); los Flaming Lips, los discípulos más locos de Pink Floyd, entre la ética punk y el burlesque hippy (Oh My Gawd, Zaireeka); Red Temple Spirits, Viv Akauldren. Galaxie 500 y Yo La Tengo, los grupos que más influirán en la década siguiente: la psicodelia como estupor exangüe (Today, On Fire) y las baladas abstractas de texturas (May I Sing With Me). Y Phish, indiferentes a la estética punk, recuperan el directo, el solo de guitarra y la improvisación colectiva.","color":"#c084fc","family":"Psicodelia, garage y shoegaze","link":"https://volteret4.github.io/scaruffi/#space-pop"}],"book_tracks":[{"id":199584887911761,"artist":"Phish","artist_id":129190030013326,"title":"Junta","year":1988,"ess":0,"yt":"yURww4cEK30","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Space-pop","scene_id":98599911480017,"scene_link":"https://volteret4.github.io/scaruffi/#space-pop","chapters":["Sección 5.20"],"pages":[[1,208,null]]},{"id":130230693028890,"artist":"Phish","artist_id":129190030013326,"title":"Lawn Boy","year":1990,"ess":0,"yt":"ILK-02_1i40","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Space-pop","scene_id":98599911480017,"scene_link":"https://volteret4.github.io/scaruffi/#space-pop","chapters":["Sección 5.20"],"pages":[[1,208,null]]},{"id":89192659376772,"artist":"Phish","artist_id":129190030013326,"title":"A Picture Of Nectar","year":1992,"ess":1,"yt":"459K8w2-QWY","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Space-pop","scene_id":98599911480017,"scene_link":"https://volteret4.github.io/scaruffi/#space-pop","chapters":["Sección 5.20"],"pages":[[1,208,null]]},{"id":57697550721017,"artist":"Phish","artist_id":129190030013326,"title":"Hoist","year":1994,"ess":0,"yt":"MjPT6OXNEDI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Space-pop","scene_id":98599911480017,"scene_link":"https://volteret4.github.io/scaruffi/#space-pop","chapters":["Sección 5.20"],"pages":[[1,208,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":207,"text":"…elements, led to the pure abstraction of And Then Nothing Turned Itself Inside Out (2000). In the age of hardcore punk-rock, the aesthetics of Phish (22), a quintet based in Vermont, bordered on the suicidal. 207"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":208,"text":"Nonetheless, the band became one of the most significant phenomena of the decade. Phish focused on the live concert, a concept that had been anathema during the 1980s, and rediscovered the guitar solo, the ornate keyboard arrangements,…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":208,"text":"…closed the epic phase and opened the commercial one in the lighter vein of the Band, the Doobie Brothers, Little Feat and the Allman Brothers. Phish, the first creative group to be completely indifferent to the punk aesthetics, had just changed the world. 5.21 USA & Australia: Extreme hardcore…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":230,"text":"6.2 Progressive sounds East Coast 1990-96 At the beginning of the 1990s, Phish, more than anyone else, established alternative rock on mainstream radio. Phish were more than just a surrogate of the Grateful Dead for the 1990s. They legitimized a return to the aesthetics of progressive-rock, particularly on the East Coast. Blues Traveler were a simpler, domestic, rootsy version of Phish. Blues Traveler (1990) offered a judicious mixture of ballads and jams, and the band would eventually match and surpass Phish's commercial success.…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":300,"text":"…Thirteen Masks (Sky) 26. Black Tape For A Blue Girl: Remnants Of A Deeper Purity (Projekt) 27. Pain Teens: Destroy Me Lover (Trance Syndicate) 28. Phish: A Picture Of Nectar (Elektra, 1992) 29. Dirty Three: Ocean Songs (Touch & Go) 30. Ed Hall: Love Poke Here (Boner) 31. Orb: U.F.Orb (Big Life) 32.…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":199584887911761,"type":"album","name":"Junta","list_id":28712889142764,"list":"RYM Top — Rock — Jam Band","src":"musthear","rank":24,"year":1988,"note":null,"yt":"yURww4cEK30","scaruffi":7.0},{"id":199584887911761,"type":"album","name":"Junta","list_id":145636818792428,"list":"RYM Top — Rock — Jazz-Rock","src":"musthear","rank":167,"year":1988,"note":null,"yt":"yURww4cEK30","scaruffi":7.0},{"id":199584887911761,"type":"album","name":"Junta","list_id":52032266791182,"list":"Scaruffi 1980s","src":"musthear","rank":639,"year":1988,"note":null,"yt":"yURww4cEK30","scaruffi":7.0},{"id":130230693028890,"type":"album","name":"Lawn Boy","list_id":28712889142764,"list":"RYM Top — Rock — Jam Band","src":"musthear","rank":34,"year":1990,"note":null,"yt":"ILK-02_1i40","scaruffi":8.0},{"id":130230693028890,"type":"album","name":"Lawn Boy","work_year":1990,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":110,"year":1990,"note":null,"yt":"ILK-02_1i40","scaruffi":8.0},{"id":89192659376772,"type":"album","name":"A Picture Of Nectar","list_id":28712889142764,"list":"RYM Top — Rock — Jam Band","src":"musthear","rank":67,"year":1992,"note":null,"yt":"GY23yUKNPUs","scaruffi":8.5},{"id":89192659376772,"