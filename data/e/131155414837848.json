":"https://volteret4.github.io/scaruffi/#madchester"},{"id":109992201133964,"name":"Madchester","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1988,"end":1992,"desc":"El rock descubre el house, la rave y el éxtasis: psicodelia sesentera abierta a texturas eufóricas; estrellas del rock y DJs hablan el mismo idioma.","color":"#f472b6","family":"Rock, synth-pop y canción","link":"https://volteret4.github.io/loops_timeline/#madchester"}],"book_tracks":[{"id":123625462982135,"artist":"Pop Will Eat Itself","artist_id":131155414837848,"title":"This Is The Day","year":1989,"ess":0,"yt":"dWpgmZxRAV8","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Madchester y ambient house","scene_id":32771111921756,"scene_link":"https://volteret4.github.io/scaruffi/#madchester","chapters":["Sección 5.18"],"pages":[[1,200,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":200,"text":"…Nitzer Ebb's That Total Age (1987), the Weathermen's Black Album (1988) Renegade Soundwave's In Dub (1990), the Shamen's Boss Drum (1992); whereas Pop Will Eat Itself's This Is The Day (1989) and Jesus Jones' Liquidizer (1989) exported to the rave scene the fusion of dance beats and rock guitars already pioneered…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":89354409467627,"type":"album","name":"Box Frenzy","list_id":24650553437622,"list":"RYM Top — Dance — Grebo","src":"musthear","rank":16,"year":1987,"note":null,"yt":"k2jzNd_pm8U","scaruffi":null},{"id":89354409467627,"type":"album","name":"Box Frenzy","list_id":270317289072266,"list":"RYM Top — Rock — Rap Rock","src":"musthear","rank":103,"year":1987,"note":null,"yt":"k2jzNd_pm8U","scaruffi":null},{"id":279388395211297,"type":"album","name":"This Is the Day...This Is the Hour...This Is This!","list_id":190868782470316,"list":"RYM Top