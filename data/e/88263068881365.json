null}],"n_lists":3}},{"id":84531629285722,"type":"song","name":"Good Enough","artist":"Bobby Brown","year":1993,"weight":4,"yt":"oh4wgGIN_qE","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":55625790664966,"name":"Billboard Year-End 1993","rank":49,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":49,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[{"id":139585934188111,"type":"artist","name":"New Edition","artist":null,"year":null,"weight":26,"yt":null,"src":"ensayos"}],"genres":[{"id":128244196016287,"type":"genre","name":"New Jack Swing","artist":null,"year":null,"weight":241,"yt":null,"src":"ensayos"}],"album_genres":[{"id":128244196016287,"type":"genre","name":"New Jack Swing","n":4}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":266579790140761,"name":"Naked funk: la era Reagan","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1980,"end":1990,"desc":"La era del naked funk abarca las cimas de Prince, Michael Jackson y los dos mandatos de Reagan: recortes, desindustrialización, millones de sin techo, la «guerra contra las drogas» en lugar de contra la pobreza y, desde 1982, el crack. La música negra se volvió narcisista y escapista, del «yo primero»; las bandas, demasiado caras para la ciudad. La industria ofrecía estereotipos (banda pop, crooner, banda funk guarra, según Jon Pareles), MTV no ponía vídeos negros hasta Thriller y Jackson y Prince marcaron las cuotas del crossover. En 1975 trece números 1 R&B eran funk; en 1985 diecisiete de veinte eran baladas. Warner echó a Clinton y CBS sepultó «Pumpin’ It Up»; murieron o se convirtieron Hathaway, Joe Tex, Marvin Gaye, Al Green, Larry Graham. Las máquinas sustituyeron vientos, órgano (el Yamaha DX7), batería y bajo: solo sobrevivió la guitarra rítmica sobre el bajo sintetizado y la palmada electrónica. La insinuación dejó paso al sexo explícito sin cerebro («Do Me Baby», «Beep a Freak»), y llegaron el bass de Miami (2 Live Crew), Egyptian Lover, el New Jack Swing de Teddy Riley y la farsa de Milli Vanilli. Los funkers de verdad abandonaron la radio: el underground (hip hop, go-go) llevó el funk adelante.","color":"#22d3ee","family":"Funk de los ochenta: Prince, Rick James, electro","link":"https://volteret4.github.io/Funk/#naked-funk"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Influence on Bruno Mars","body":"Bruno Mars's single \"That's What I Like\" from his \"24K Magic\" album was explicitly noted for echoing the New Jack Swing sound pioneered by New Edition vocalist turned soloist Bobby Brown, as part of the album's broader homage to 80s R&B. \"Echoed, the new Jack swing sound of new addition vocalist turned soloist Bobby Brown.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Lenny on Mars Edition Part 2","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":179864574407108,"type":"album","name":"King of Stage","list_id":124306219306929,"list":"RYM Top — R&B — New Jack Swing","src":"musthear","rank":82,"year":1986,"note":null,"yt":"E0tWGB57t48","scaruffi":null},{"id":179364932523539,"type":"song","name":"Don't Be Cruel","work_year":1988,"list_id":162518251001675,"list":"Billboard Year-End 1988","src":"singles","rank":79,"year":1988,"note":"","yt":"pd7dCbEfTs4","scaruffi":null},{"id":179364932523539,"type":"song","name":"Don't Be Cruel","work_year":1988,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":79,"year":1988,"note":null,"yt":"pd7dCbEfTs4","scaruffi":null},{"id":269673066158929,"type":"album","name":"Don't Be Cruel","list_id":124306219306929,"list":"RYM Top — R&B — New Jack Swing","src":"musthear","rank":11,"year":1988,"note":null,"yt":"pd7dCbEfTs4","scaruffi":null},{"id":202513901135425,"type":"song","name":"My Prerogative","work_year":1989,"list_id":65108459179863,"list":"Billboard Hot 100 nº1 · 1980s","src