{"id":114602065065062,"type":"album","name":"12 Bar Blues","artist":"Scott Weiland","year":1998,"weight":21,"info":{"cover":"https://dn710108.ca.archive.org/0/items/mbid-99d9c6a4-32d2-4405-a831-446234eeb533/mbid-99d9c6a4-32d2-4405-a831-446234eeb533-43538383714.jpg","scaruffi":7.0,"yt":"jhLxwZG4q1g","links":{"spotify":"https://open.spotify.com/album/2oDxaTUqJPFQSabDxVfgjI","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_ngA_OwupiysZPT49Xxr-REeYNEdm48Ges"}},"artist_ref":{"id":900011635688,"name":"Scott Weiland","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Scott_Weiland_onstage_with_a_mic--2009-07.jpg?width=500"}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"}],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","src":"charts","grp":"Scaruffi","list_year":null,"rank":1137,"year":1998,"note":null,"total":1406,"scaruffi":7.0}],"podcast":[{"kind":"podcast","title":null,"body":"Released in May 1998, this album was recorded with the help of Daniel Lanois, and Scott Wyland played all the instruments himself. He described it as \"artistic time away from STP\" and while it wasn't a major hit, it garnered kind reviews and showcased a side of Wyland few knew existed, featuring Cheryl Crowe on guitar for one track. \"Scott played everything himself.\"","year":1998,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Scott Weiland: Part 2","url":"https://www.youtube.com/watch?v=TDwagoyMvck"}]},{"kind":"podcast","title":null,"body":"Released on May 17, 1998, this album was produced by Canadian Daniel Lanois. It showcased Weiland's diverse command of sounds, textures, and instruments beyond just the electric guitar, allowing for musical directions that would not have been possible within Stone Temple Pilots. The record featured various guest musicians, notably Sheryl Crow playing the accordion. \"Wyland solo album was called 12 Bar Blues. It was released on May 17, 1998 and producing it was Canadian Daniel Landwine.\"","year":1998,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Going Solo","url":"https://www.youtube.com/watch?v=-f9jhqAHkQo"}]}],"book_tracks":[{"id":114602065065062,"artist":"Scott Weiland","artist_id":900011635688,"title":"12 Bar Blues","year":1998,"ess":0,"yt":"jhLxwZG4q1g","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cantautores lo-fi de los noventa","scene_id":4419681145361,"scene_link":"https://volteret4.github.io/scaruffi/#songwriters-90s","chapters":["Sección 6.6"],"pages":[[1,250,null]]}],"others":[{"id":104007648431807,"type":"song","name":"Dead and Bloated","year":1992,"weight":16},{"id":280294897726712,"type":"song","name":"Slither","year":2004,"weight":7},{"id":269995514759803,"type":"song","name":"Coma","year":2001,"weight":7},{"id":267365430542139,"type":"song","name":"Fall To Pieces","year":2004,"weight":7},{"id":255630668808904,"type":"album","name":"Number Four","year":1999,"weight":7},{"id":254592561580827,"type":"album","name":"Not Dead Yet and Not for Sale","year":null,"weight":7},{"id":241427343716011,"type":"album","name":"A Compilation of Scott Weiland Cover Songs","year":2009,"weight":7},{"id":211751808180178,"type":"album","name":"Stone Temple Pilots","year":2010,"weight":7},{"id":206578927779954,"type":"album","name":"Libertad","year":2007,"weight":7},{"id":142274053649491,"type":"album","name":"Contraband","year":2004,"weight":7},{"id":142209789207435,"type":"album","name":"Christmas Standards Album","year":null,"weight":7},{"id":140476801690573,"type":"song","name":"Let Me Free","year":2003,"weight":7}]}