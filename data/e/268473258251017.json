{"id":268473258251017,"type":"artist","name":"Naked City","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/John_Zorn_M%C3%BCnster_1990.jpg?width=500","bio":"Naked City fue un grupo de música avant-garde liderado por el saxofonista y compositor John Zorn. Activa principalmente en la ciudad de Nueva York desde 1988 hasta 1993, Naked City fué iniciado por Zorn como un \"taller de composición\" para poner a prueba los límites de la composición (e improvisación) en una formación de la banda de rock tradicional. De sus elementos se destacan del jazz, el surf, heavy metal clásico, grindcore, country, punk rock, y otros géneros incorporados.","tags":["Avant-Garde","jazz","experimental","grindcore","noise"]},"works":[{"id":2667487209268,"type":"album","name":"Naked City","artist":"Naked City","year":1990,"weight":13,"yt":"7LLiZ_0-mLo","src":"books,charts,musthear","from":{"books":[{"name":"Historia del jazz","title":"Historia del jazz (Ted Gioia)"}],"podcasts":[],"lists":[{"id":90391435651867,"name":"Sputnikmusic Best Albums 1990","rank":9,"scaruffi":null},{"id":118267099057662,"name":"AOTY Must Hear 1990s","rank":428,"scaruffi":null}],"n_lists":2}},{"id":32020575322406,"type":"album","name":"Torture Garden","artist":"Naked City","year":1990,"weight":15,"yt":"yDlQj04GE8s","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":11393629798029,"name":"RYM Top — Rock — Progressive Rock","rank":168,"scaruffi":null},{"id":22478217896300,"name":"RYM Top — Rock — Experimental Rock","rank":106,"scaruffi":null},{"id":52260166018782,"name":"RYM Top — Rock — Brutal Prog","rank":3,"scaruffi":null},{"id":79201857171461,"name":"RYM Top — Rock — Hardcore [Punk]","rank":162,"scaruffi":null}],"n_lists":7}},{"id":95811771307911,"type":"album","name":"Grand Guignol","artist":"Naked City","year":1992,"weight":5,"yt":"NmEb7CMXgyc","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":55316938071026,"name":"Sputnik