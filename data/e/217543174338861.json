genre","name":"Free Improvisation","n":3},{"id":179017056965514,"type":"genre","name":"Sound Collage","n":2},{"id":50244142277993,"type":"genre","name":"Musique concrète","n":2},{"id":2714067075883,"type":"genre","name":"Tape Music","n":2},{"id":255263121494129,"type":"genre","name":"Metal","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":145647343892302,"name":"Música industrial","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1979,"end":1990,"desc":"La progenie de Throbbing Gristle: espíritus afines (Cabaret Voltaire, Non, SPK, Z'ev) y una segunda ola innumerable de paisajes de ruido o metrónomo teutónico (Lustmord, Nocturnal Emissions, Death in June, Laibach, Skinny Puppy, Front 242, Merzbow). Whitehouse lleva el género al deleite descarado en el mal con la «power electronics»; Nurse with Wound (Steve Stapleton) prefiere el collage surrealista a lo Lautréamont y el krautrock. Excepciones rítmicas: Clock DVA (Thirst) y 23 Skidoo (Seven Songs, «Porno Bass»), que dejan entrar el funk negro, Fela Kuti y la world music.","color":"#94a3b8","family":"Industrial y electrónica","link":"https://volteret4.github.io/Postpunk/#industrial"},{"id":67562832338084,"name":"Japanoise","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1985,"end":2002,"desc":"La rama más extrema del noise: distorsión brutal y decibelios insoportables para generar placer a partir del dolor.","color":"#94a3b8","family":"Industrial y ruido","link":"https://volteret4.github.io/loops_timeline/#japanoise"}],"book_tracks":[{"id":75321875600029,"artist":"Merzbow","artist_id":217543174338861,"title":"Venereology","year":1994,"ess":1,"yt":"PramoKY7yUg","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Japanoise","scene_id":67562832338084,"scene_link":"https://volteret4.github.io/loops_timeline/#japanoise","chapters":["Cap. 16: Post-rave / post-digital: música experimental en la década de los noventa (1990-2002)"],"pages":[[1,315],[1,317]]},{"id":7143679399265,"artist":"Merzbow","artist_id":217543174338861,"title":"Noisembryo","year":1994,"ess":0,"yt":"J5iZFfqUfGA","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Japanoise","scene_id":67562832338084,"scene_link":"https://volteret4.github.io/loops_timeline/#japanoise","chapters":["Cap. 16: Post-rave / post-digital: música experimental en la década de los noventa (1990-2002)"],"pages":[[1,315]]},{"id":70002754728873,"artist":"Merzbow","artist_id":217543174338861,"title":"Merzbox","year":2000,"ess":0,"yt":null,"kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Japanoise","scene_id":67562832338084,"scene_link":"https://volteret4.github.io/loops_timeline/#japanoise","chapters":["Cap. 16: Post-rave / post-digital: música experimental en la década de los noventa (1990-2002)"],"pages":[[1,315]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":245,"text":"…Incluso la música más indomesticable, cuando nos acostumbramos a ella —sea el caso del ruido a volúmenes demenciales en «escultores noise» como Merzbow o Zbigniew Karkowski—, deja de parecernos extraña, y la metabolizamos como posible (a veces incluso bella). Es cierto que si comparamos a Aphex Twin…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":315,"text":"…secreto solo accesible para connaisseurs del submundo de los casetes autoeditados: el japanoise. Venereology era el septuagésimo noveno trabajo de Merzbow, el primero que se publicaba en Estados Unidos y uno de los más brutales según los estudiosos de su inabarcable discografía —sobre las quinientas…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":315,"text":"…Benz 230 cuyo lector de CDs reproducía el álbum Noisembryo en bucle mientras el automóvil estaba en marcha—. Masami Akita, el hombre detrás de Merzbow, decía haberse inspirado en el death metal para crearlo. Pero Venereology no sonaba a nada remotamente parecido al metal. Ni al rock. Lo que…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":315,"text":"…de la barbarie sónica. Después de Venereology no podía haber sino silencio, pues excedía todos los límites habidos y por haber. Pero el disco de Merzbow solo era la punta del"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":316,"text":"…—Hiroshige recurrió al formato rock de guitarra, bajo y batería; Akita a las grabaciones de campo y el collage en cinta magnética—, Hijokaidan y Merzbow sentaron las bases del noizu. Pronto se les sumarían otros: Incapacitants, Masonna, The Gerogerigegege, Government Alpha, Hanatarash, K2, C.C.C.C,…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":317,"text":"…la del metal y el punk extremos, que lo recibió con los brazos abiertos. Habiéndose labrado un nombre a un lado y otro del espectro alternativo, Merzbow devino lo más parecido a una estrella que alumbró el ruidismo, un proyecto mundialmente conocido y respetado por públicos de todo pelaje. El alcance…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":317,"text":"…a Thurston Moore (Sonic Youth), Jim O’Rourke y Pan Sonic a reventar amplificadores con Gore Beyond Necropsy, Jazzkammer y Wolf Eyes. El «éxito» de Merzbow y la tenacidad internacionalista de Alchemy Records —plataforma gestionada por Hiroshige que, además de publicar los discos de Hijokaidan, apadrinó…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":47202105806479,"type":"album","name":"1930","list_id":244450377816369,"list":"RYM Top — Experimental — Noise","src":"musthear","rank":184,"year":1930,"note":null,"yt":"KVIR1jM0YGo","scaruffi":null},{"id":169075391361193,"type":"album","name":"Material Action for 2 Microphone","list_id":196140923370937,"list":"RYM Top — Experimental — Tape Music","src":"musthear","rank":158,"year":1984,"note":null,"yt":"NMPoHujp8xA","scaruffi":null},{"id":33144066328621,"type":"album","name":"Antimonument","list_id":4389278164509,"list":"Music Genre Tree","src":"musthear","rank":59,"year":1986,"note":null,"yt":"85F3FRIccWg","scaruffi":null},{"id":33144066328621,"type":"album","name":"Antimonument","list_id":244450377816369,"list":"RYM Top — Experimental — Noise","src":"musthear","rank":101,"year":1986,"note":null,"yt":"85F3FRIccWg","scaruffi":null},{"id":215461366145484,"type":"album","name":"Batztoutai With Material Gadgets\n抜刀隊 With Memorial Gadgets","list_id":244450377816369,"list":"RYM Top — Experimental — Noise","src":"musthear","rank":132,"year":1986,"note":null,"yt":"ZpP1aK6K6BA","scaruffi":null},{"id":215461366145484,"type":"album","name":"Batztoutai With Material Gadgets\n抜刀隊 With Memorial Gadgets","list_id":156212084869216,"list":"RYM Top — Experimental — Sound Collage","src":"musthear","rank":110,"year":1986,"note":null,"yt":"ZpP1aK6K6BA","scaruffi":null},{"id":214995340378040,"type":"album","name":"Ecobondage","list_id":114943012715183,"list":"RYM Top — Electronic — Musique concrète","src":"musthear","rank":112,"year":1987,"note":null,"yt":"gN0LcBKS7zA","scaruffi":null},{"id":214995340378040,"type":"album","name":"Ecobondage","list_id":196140923370937,"list":"RYM Top — Experimental — Tape Music","src":"musthear","rank":118,"year":1987,"note":null,"yt":"gN0LcBKS7zA","scaruffi":null},{"id":78799445918769,"type":"album","name":"Rainbow Electronics","list