ype":"genre","name":"Hardcore","n":1},{"id":200651337068219,"type":"genre","name":"Canzone d'autore","n":1},{"id":191043281221162,"type":"genre","name":"Brutal Prog","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":181296768148316,"type":"genre","name":"Digital Hardcore","n":1},{"id":176574029521759,"type":"genre","name":"alternative punk","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":204583008336748,"name":"Slo-core","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2002,"desc":"Una de las innovaciones más importantes de los noventa: versión lenta, onírica y melancólica del dream-pop, descendiente de Galaxie 500 y Yo La Tengo, con composiciones largas y contenidas. Codeine la consagran (Frigid Stars); Seam, Red House Painters de Mark Kozelek (Down Colorful Hill), Low (I Could Live In Hope, Trust: el haiku del rock) y Bedhead. La balada etérea femenina: Mazzy Star, His Name Is Alive, Moon Seven Times, Congo Norvell, Helium, Elysian Fields. La balada atmosférica: Idaho, Acetone, Low Road, American Analog Set, Calla, y el «rock textural» del Noroeste: Built To Spill (Perfect From Now On), Silkworm, Red Stars Theory, Death Cab For Cutie. En Inglaterra, Drugstore, Mojave 3, Movietone.","color":"#c084fc","family":"Psicodelia, garage y shoegaze","link":"https://volteret4.github.io/scaruffi/#slo-core"}],"book_tracks":[{"id":134309029896305,"artist":"Built To Spill","artist_id":237764272115141,"title":"Ultimate Alternative Wavers","year":1993,"ess":0,"yt":"6YXje6f-r9s","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Slo-core","scene_id":204583008336748,"scene_link":"https://volteret4.github.io/scaruffi/#slo-core","chapters":["Sección 6.8"],"pages":[[1,259,null]]},{"id":272770647301335,"artist":"Built To Spill","artist_id":237764272115141,"title":"There's Nothing Wrong With Love","year":1994,"ess":0,"yt":"MuXUCC0M7Vo","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Slo-core","scene_id":204583008336748,"scene_link":"https://volteret4.github.io/scaruffi/#slo-core","chapters":["Sección 6.8"],"pages":[[1,259,null]]},{"id":229900155707282,"artist":"Built To Spill","artist_id":237764272115141,"title":"Perfect From Now On","year":1997,"ess":1,"yt":"FsTl-lZo_50","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Slo-core","scene_id":204583008336748,"scene_link":"https://volteret4.github.io/scaruffi/#slo-core","chapters":["Sección 6.8"],"pages":[[1,259,null]]},{"id":215680401725229,"artist":"Built To Spill","artist_id":237764272115141,"title":"Keep It Like A Secret","year":1998,"ess":0,"yt":"qFZSXc6wH0A","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Slo-core","scene_id":204583008336748,"scene_link":"https://volteret4.github.io/scaruffi/#slo-core","chapters":["Sección 6.8"],"pages":[[1,260,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":151,"text":"…Johnson launched more musical ventures. He recorded Halo Benders' God Don't Make No Junk (1994) with Pell Mell's keyboardist Steve Fisk and and Built To Spill's guitarist Doug Martsch. And Dub Narcotic Sound System, inaugurated with the instrumental album Echoes From The Scene Control Room (1995), was…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":259,"text":"…form of \"textural rock\" that hanged somewhere between the extremes of roots-rock and post-rock, and emphasized non-linear guitar-based soundscapes. Built To Spill (12) were the reigning champions of the genre throughout the decade. Formed in Idaho by guitarist Doug Martsch, with Caustic Resin's guitarist Brett…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":260,"text":"…and bassist Tim Midgett. Developer (1997) was another subtle essay of musical imagery, and perhaps even more arduous. Red Stars Theory (2) turned Built To Spill's brainy trance upside down, emphasizing the trance, on their mostly-instrumental albums But Sleep Came Slowly (1997) and especially Life In A…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":260,"text":"…the psychological studies of Past Worn Searching (1998) by Rainer Maria (1), fronted by Caithlin DeMarrais' austere phrasing, in Wisconsin; etc. Built To Spill's best pupils were Seattle's Death Cab For Cutie (1), whose painstakingly detailed stories of alienation and defeat on Something About Airplanes…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":301,"text":"…(Mammoth) 58. Cobra Verde: Viva La Muerte (Scat) 59. Nirvana: Nevermind (Geffen) 60. Girls Against Boys: Venus Luxure No 1 Baby (Touch & Go) 61. Built To Spill: Perfect From Now On (Warner) 62. Pram: Helium (Too Pure, 1994) 63. Doldrums: Acupuncture (Kranky) 64. Vidna Obmana: Spiritual Bonding (Extreme) 65.…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":329,"text":"？ Nusrat Fateh Ali dies ？ Other significant albums of the year: Hash Jar Tempo's Well Oiled, Built To Spill's Perfect From Now On, Gravitar's Now The Road Of Knives, Dissolve's Third Album For The Sun, Amon Tobin's Bricolage ？ Townes VanZandt dies at 52 ？…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":134309029896305,"type":"album","name":"Ultimate Alternative Wavers","work_year":1993,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":504,"year":1993,"note":null,"yt":"6YXje6f-r9s","scaruffi":7.0},{"id":272770647301335,"type":"album","name":"There's Nothing Wrong with Love","list_id":118267099057662,"list":"AOTY Must Hear 