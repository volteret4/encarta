{"id":260069269504249,"type":"album","name":"Sound & Color","artist":"Alabama Shakes","year":2015,"weight":12,"info":{"cover":"https://ia600402.us.archive.org/10/items/mbid-0d8034c4-98e5-4f94-83fc-ef0bd5aa1151/mbid-0d8034c4-98e5-4f94-83fc-ef0bd5aa1151-10605933668.jpg","yt":"faG8RiaANek","desc":"Sound & Color is the second studio album by American band Alabama Shakes, released on April 17, 2015, by ATO Records. The album debuted at number one on the Billboard 200 in the U.S., giving the band their first chart-topper; globally, the album hit the top ten in Australia, the Netherlands, Switzerland, and the United Kingdom. It was also a critical success and was nominated six Grammy Awards, winning four for Best Alternative Music Album, Best Engineered Album, Non-Classical, as well as Best Rock Performance and Best Rock Song for \"Don't Wanna Fight\". It spawned four singles; \"Don't Wanna Fight\" ."},"artist_ref":{"id":131894262344338,"name":"Alabama Shakes","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":8412226417108,"type":"genre","name":"Indie Rock","artist":null,"year":null,"weight":1139,"yt":null,"src":"musthear"},{"id":207419651019004,"type":"genre","name":"Garage Rock","artist":null,"year":null,"weight":556,"yt":null,"src":"musthear"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"musthear"},{"id":163225726165579,"type":"genre","name":"Blues Rock","artist":null,"year":null,"weight":458,"yt":null,"src":"musthear"},{"id":151685778897301,"type":"genre","name":"Southern Rock","artist":null,"year":null,"weight":368,"yt":null,"src":"musthear"}],"lists":[{"id":50254398381317,"name":"Pitchfork: The 200 Best Albums of the 2010s","src":"musthear","grp":"musicbrainz","list_year":null,"rank":138,"year":null,"note":null,"total":200,"scaruffi":null},{"id":85122334056025,"name":"Grammy