11927654,"type":"genre","name":"Country Rock","n":9},{"id":166173220937290,"type":"genre","name":"Americana","n":6},{"id":267868162516031,"type":"genre","name":"Alt-Country","n":5},{"id":239718708636602,"type":"genre","name":"Bluegrass","n":1},{"id":214188970482661,"type":"genre","name":"Country Folk","n":1},{"id":211270792239401,"type":"genre","name":"Roots Rock","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":164529051065355,"type":"genre","name":"Contemporary Country","n":1},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":1},{"id":106381401668595,"type":"genre","name":"Heartland Rock","n":1},{"id":71802306984225,"type":"genre","name":"Neo-Traditionalist Country","n":1},{"id":7374429919951,"type":"genre","name":"country","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":227407993671548,"name":"Roots-rock de los ochenta y cow-punk","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1984,"end":1995,"desc":"Como en 1970 tras 1966, la new wave de 1976 va seguida de un revival del roots-rock, esta vez gradual y disfrazado: punks que desfiguran los estilos tradicionales (X, Dream Syndicate, Gun Club) y los «cow-punks» que tocan country ambientado entre inadaptados: Long Ryders, Jason & The Scorchers, Fetchin Bones, Lone Justice, Beat Farmers. El populismo de Los Lobos, Del Fuegos, Del-Lords y Walkabouts; en la Costa Oeste, los dementes Camper Van Beethoven, Donner Party, Catheads, Thin White Rope y los American Music Club de Mark Eitzel; en Texas, Wild Seeds, Poi Dog Pondering, Glass Eye; en los Grandes Lagos, BoDeans, Soul Asylum, Afghan Whigs, Shrimp Boat y los canadienses Cowboy Junkies. Nashville se renueva con los neotradicionalistas (George Strait, Randy Travis, Garth Brooks, Lyle Lovett, Steve Earle, Dwight Yoakam) y el surf instrumental vuelve con Shadowy Men On A Shadowy Planet.","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#roots-80s"}],"book_tracks":[{"id":108966284659694,"artist":"Steve Earle","artist_id":180342617358900,"title":"Guitar Town","year":1986,"ess":0,"yt":"AINUPFbFpqg","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Roots-rock de los ochenta y cow-punk","scene_id":227407993671548,"scene_link":"https://volteret4.github.io/scaruffi/#roots-80s","chapters":["Sección 5.17"],"pages":[[1,195,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":195,"text":"…balance of atmosphere, tunesmith, rhythm and melody. Lovett even embraced big-band jazz with His Large Band (1989). Guitar Town (1986), by Steve Earle (1), shocked the scene with its loud and frantic sound that mixed rockabilly, honky-tonk and blues, and borrowed the emphasis from Bruce…"}],"podcast":[{"kind":"podcast","title":"AKG 414 B-ULS Microphone Use","body":"Steve Earle is mentioned as one of the artists who sang into Chris Berkett's preferred AKG 414 B-ULS microphone. \"I've used it on Steve Earle, Chanel, O'Connor, Buffy St. Marie, Alison Moyer, they've all sung in that, that mic, it sounds great.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Studio Stories with Chris Birkett","url":"https://www.youtube.com/watch?v=mjQBaX_3oL4"}]},{"kind":"podcast","title":"Work on \"Copperhead Road\"","body":"Chris Berkett did some work on Steve Earle's \"Copperhead Road.\" \"Steve, all I did some work on Copperhead Road.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Studio Stories with Chris Birkett","url":"https://www.youtube.com/watch?v=mjQBaX_3oL4"}]}],"awards":[{"kind":"award","title":"\"Spirit of Americana\" Free Speech Award (2004)","body":"Won.","year":2004,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q96586004"}]},{"kind":"award",