{"id":42015324504704,"type":"artist","name":"Leon Redbone","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Leon_Redbone_in_Toronto.jpg?width=500","bio":"Leon Redbone (born Dickran Gobalian on 26 August 1949; died 30 May 2019) was a \nCyprus-born (of Armenian ancestry) Canadian-American songwriter, singer, guitarist, actor, and voice actor specializing in jazz, blues, and Tin Pan Alley classics. Recognized by his Panama hat, dark sunglasses, and black tie, he first appeared on stage in Toronto, Canada, in the early 1970s. As well as music, he also appeared on film and television in acting and voice-over roles.","tags":["jazz","blues","ragtime","Retro","old school"]},"works":[{"id":267278115894656,"type":"album","name":"On the Track","artist":"Leon Redbone","year":1975,"weight":14,"yt":"HZDP42dZHA0","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":72780663088705,"name":"RYM Top — Musical Theatre and Entertainment — Vaudeville","rank":4,"scaruffi":null},{"id":42506770247937,"name":"RYM Top — Jazz — Dixieland","rank":7,"scaruffi":null},{"id":162167649040794,"name":"RYM Top — Musical Theatre and Entertainment","rank":22,"scaruffi":null},{"id":280702155250789,"name":"RYM Top — Regional Music — Ragtime","rank":9,"scaruffi":null}],"n_lists":4}},{"id":216322737060593,"type":"album","name":"Double Time","artist":"Leon Redbone","year":1977,"weight":5,"yt":"o_JaKbKi9jg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":42506770247937,"name":"RYM Top — Jazz — Dixieland","rank":6,"scaruffi":null},{"id":112872897412121,"name":"RYM Top — Blues — Acoustic Blues","rank":48,"scaruffi":null}],"n_lists":2}},{"id":281198785596930,"type":"album","name":"Champagne Charlie","artist":"Leon Redbone","year":1978,"weight":8,"yt":"pnNEXcLNUxo","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":269741307382606,"