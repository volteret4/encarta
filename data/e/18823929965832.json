 roots","link":"https://volteret4.github.io/scaruffi/#rocknroll"}],"book_tracks":[{"id":217129031546744,"artist":"Esquivel","artist_id":18823929965832,"title":"Other Worlds Other Sounds","year":1958,"ess":0,"yt":"PXo8LfOfptw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Rock'n'roll","scene_id":133200493093823,"scene_link":"https://volteret4.github.io/scaruffi/#rocknroll","chapters":["Sección 2.2"],"pages":[[1,14,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":14,"text":"…first album of African music by a white musician, Bantu Choral Folk Songs, and in 1956 Martin Denny's Exotica created a new genre. Mexican composer Esquivel concocted super-kitschy lounge music, scoring odd melodies and counterpoints for exotic instruments and just about anything that had an unusual…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":144676309583530,"type":"album","name":"Amar de Nuevo","list_id":64340113915893,"list":"RYM Top — Easy Listening — Exotica","src":"musthear","rank":144,"year":1957,"note":null,"yt":"gpoXy6K1Oeo","scaruffi":null},{"id":144676309583530,"type":"album","name":"Amar de Nuevo","list_id":34001800990688,"list":"RYM Top — Easy Listening — Lounge","src":"musthear","rank":186,"year":1957,"note":null,"yt":"gpoXy6K1Oeo","scaruffi":null},{"id":144676309583530,"type":"album","name":"Amar de Nuevo","list_id":262066744546123,"list":"RYM Top — Easy Listening — Space Age Pop","src":"musthear","rank":118,"year":1957,"note":null,"yt":"gpoXy6K1Oeo","scaruffi":null},{"id":12528898736399,"type":"album","name":"Exploring New Sounds in Hi-Fi","list_id":66701177312920,"list":"RYM Top — Easy Listening","src":"musthear","rank":89,"year":1959,"note":null,"yt":"_fTvqMGdNxE","scaruffi":null},{"id":12528898736399,"type":"album","name":"Exploring New Sounds in Hi-Fi","list_id":34001800990688,"list":"RYM Top — Easy Li