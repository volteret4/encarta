{"id":18823929965832,"type":"artist","name":"Esquivel","artist":null,"year":null,"weight":11,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/94255cbd8ec77e96d67d4448ec29cedf/1000x1000-000000-80-0-0.jpg","bio":"Juan García Esquivel, conocido como Esquivel, (Tampico, 20 de enero de 1918 — Jiutepec, Morelos, 3 de enero del 2002), fue un arreglista, pianista y compositor mexicano formado en la UNAM. Es conocido por crear un estilo de música único en su genero, ocasionalmente llamado \"Space Age Pop\", también llamado \"Exotica\", un estilo de latin jazz precursor del \"Lounge\". \n\nEn México también se le recuerda por haber compuesto la música del programa infantil Odisea Burbujas.","tags":["lounge","exotica","space age pop","easy listening","latin"]},"works":[{"id":144676309583530,"type":"album","name":"Amar de Nuevo","artist":"Esquivel","year":1957,"weight":7,"yt":"gpoXy6K1Oeo","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":34001800990688,"name":"RYM Top — Easy Listening — Lounge","rank":186,"scaruffi":null},{"id":64340113915893,"name":"RYM Top — Easy Listening — Exotica","rank":144,"scaruffi":null},{"id":262066744546123,"name":"RYM Top — Easy Listening — Space Age Pop","rank":118,"scaruffi":null}],"n_lists":3}},{"id":217129031546744,"type":"album","name":"Other Worlds Other Sounds","artist":"Esquivel","year":1958,"weight":6,"yt":"PXo8LfOfptw","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":12528898736399,"type":"album","name":"Exploring New Sounds in Hi-Fi","artist":"Esquivel","year":1959,"weight":6,"yt":"_fTvqMGdNxE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":34001800990688,"name":"RYM Top — Easy Listening — Lounge","rank":27,"scaruffi":null},{"id":66701177312920,"name":"RYM Top — Easy Listening","rank":89,"scaruffi":null},{"id":262066744546123,"name":"RYM Top — Easy Listening — Space Age Pop","rank":21,"sca