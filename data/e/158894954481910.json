{"id":158894954481910,"type":"album","name":"Realm Of Chaos","artist":"Bolt Thrower","year":1989,"weight":15,"info":{"cover":"https://dn720608.ca.archive.org/0/items/mbid-cbdf764a-3689-431f-9b17-5c33e4dda297/mbid-cbdf764a-3689-431f-9b17-5c33e4dda297-4605161110.jpg","kind":"Album","tracks":11,"country":"GB","scaruffi":7.0,"yt":"3uSM-ihNGHs","links":{"spotify":"https://open.spotify.com/album/7czYIT2adKSBYFfmAbyAVm","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lhnCrGl4nVGemAOV_gqhcn8WOwmkh9pXE","bandcamp":"https://bolt-thrower.bandcamp.com/album/realm-of-chaos-full-dynamic-range-edition"},"desc":"Realm of Chaos, subtitled \"Slaves to Darkness\", is the 2nd Bolt Thrower album, recorded at Loco studios in April 1989, engineered by Tim Lewis. It was mixed at Slaughterhouse Studios in July 1989 and engineered by Colin Richardson. It is produced by Bolt Thrower and Digby Pearson. The cover art work is produced by Games Workshop. The whole album is closely tied to Games Workshop's \"Warhammer 40,000\" game background and \"Realm of Chaos: Slaves to Darkness\" was the title of a gaming book by Games Workshop released in 1988. The album was released on Earache Records: Mosh 13 in 1989. ."},"artist_ref":{"id":108059906834811,"name":"Bolt Thrower","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Boltthrower_foto.jpg?width=500"}},"labels":[],"genres":[{"id":62217299479553,"type":"genre","name":"Death Metal","artist":null,"year":null,"weight":311,"yt":null,"src":"musthear,rym"},{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"rym"}],"lists":[{"id":251396937181996,"name":"RYM Top — Rock — Death Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":40,"year":null,"note":null,"total":200,"scaruffi":7.0},{"id":175315787363075,"name":"RYM Top — Rock — Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":158,"year":null,"note":null,"total":200,"scaruffi":7.0},{"id