{"id":240044602525227,"type":"artist","name":"The Shocking Blue","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Popgroep_Shocking_Blue_gaf_persconferentie_in_verband_met_succes_van_plaat_Ve%2C_Bestanddeelnr_923-1956.jpg?width=500","bio":"Shocking Blue fue una banda holandesa de rock, formada en 1967 en La Haya. Fundada por Robbie Van Leeuwen, Fred de Wilde, Klassje Van der Wal y Cornelious Van der Beek, después Fred de Wilde sería reemplazado por la cantante Mariska Veres, la cual fue comparada con Grace Slick (Jefferson Airplane), por su potente voz.\n\nEn 1967 grabaron su primer sencillo \"Love is in the Air\", tema compuesto por Robbie Van Leeuwen quien había pertenecido al grupo \"The Motions\".","tags":["classic rock","rock","60s","70s","dutch"]},"works":[{"id":78455549431516,"type":"album","name":"Shocking Blue","artist":"Shocking Blue","year":1967,"weight":5,"yt":"a2C0RTkNSFA","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":80098091123205,"name":"RYM Top — Rock — Nederbeat","rank":16,"scaruffi":null},{"id":107432201760054,"name":"RYM Top — Rock — Beat","rank":148,"scaruffi":null}],"n_lists":2}},{"id":168572680798913,"type":"album","name":"At Home","artist":"Shocking Blue","year":1969,"weight":7,"yt":"olk3iaMwYqo","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":80098091123205,"name":"RYM Top — Rock — Nederbeat","rank":2,"scaruffi":null},{"id":107432201760054,"name":"RYM Top — Rock — Beat","rank":5,"scaruffi":null},{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","rank":96,"scaruffi":null}],"n_lists":3}},{"id":268145081282723,"type":"album","name":"Scorpio's Dance","artist":"Shocking Blue","year":1970,"weight":5,"yt":"sH7tmuN8PhM","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":80098091123205,"name":"RYM Top — Rock — Nederbeat","rank":5,"scaruffi":null},{"id":107432201760054,"name":"RYM Top — Rock — Beat","rank":27,"scaruffi":null}]