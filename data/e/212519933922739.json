{"id":212519933922739,"type":"artist","name":"Placebo","artist":null,"year":null,"weight":87,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Placebo_coachella.jpg?width=500","bio":"Placebo es un grupo musical de rock alternativo creado en 1994 en Londres, Inglaterra.\n\nPlacebo fue formado cuando Brian Molko ,después de intentar entrar en la carrera de teatro, se encontró casualmente con Stefan Olsdal en la estación South Kensington del metro de Londres en 1994. Molko y Olsdal habían ido a la misma escuela, pero curiosamente nunca se cruzaron una palabra hasta ese encuentro en el que se dieron cuenta de que compartían gustos musicales. Fue entonces cuando decidieron formar una banda.","tags":["alternative rock","alternative","rock","indie","britpop"]},"works":[{"id":209403886092852,"type":"album","name":"1973","artist":"Placebo","year":1973,"weight":3,"yt":"YWTdVCTSXOg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":145636818792428,"name":"RYM Top — Rock — Jazz-Rock","rank":200,"scaruffi":null}],"n_lists":1}},{"id":13065386424228,"type":"album","name":"Placebo","artist":"Placebo","year":1996,"weight":6,"yt":"MUGG0AF5IJM","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":163408122640474,"type":"song","name":"Pure Morning","artist":"Placebo","year":1998,"weight":2,"yt":"a4JhtoR39M0","src":"singles","from":{"books":[],"podcasts":[],"lists":[{"id":47661976793658,"name":"Triple J Hottest 100 · 1998","rank":41,"scaruffi":null}],"n_lists":1}},{"id":251501956670544,"type":"album","name":"Without You I’m Nothing","artist":"Placebo","year":1998,"weight":10,"yt":"ezPrccnUnYc","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":238350566072075,"name":"Pitchfork: The 50 Best Britpop Albums","rank":47,"scaruffi":null},{"id":199353246998089,"name":"Sputnikmusic Best Albums 1998","rank":188,"scaruffi":null}],"n_lists":2