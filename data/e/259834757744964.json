{"id":259834757744964,"type":"album","name":"Jordan: The Comeback","artist":"Prefab Sprout","year":1990,"weight":14,"info":{"cover":"https://dn721601.ca.archive.org/0/items/mbid-43f87b31-88ab-4ce2-b43b-ef00c845240b/mbid-43f87b31-88ab-4ce2-b43b-ef00c845240b-27014615934.jpg","sputnik":4.22,"yt":"QPbaYJpK_sw","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/prefab-sprout/jordan-the-comeback","sputnikmusic":"https://www.sputnikmusic.com/album/31726/Prefab-Sprout-Jordan-The-Comeback/"},"desc":"Jordan: The Comeback is the fifth album by Prefab Sprout, released in August 1990. The album showed Prefab Sprout continuing their musical evolution from the prickly jangle guitars of Swoon, their debut. The use of synths is more prominent, lending the album a poppier feel, and Paddy McAloon explores other genres on some songs, from samba to doo-wop. The album was critically acclaimed: it was nominated for Best Album at the BRIT Awards, and reached #7 on the charts in the UK. It was - by Prefab Sprout's admittedly modest standards - a commercial success. Their next album, 1997's Andromeda ."},"artist_ref":{"id":5041318730831,"name":"Prefab Sprout","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":260819262438325,"type":"genre","name":"synth-pop","artist":null,"year":null,"weight":325,"yt":null,"src":"musthear"},{"id":126030611694007,"type":"genre","name":"Art Pop","artist":null,"year":null,"weight":310,"yt":null,"src":"rym"},{"id":204877716424121,"type":"genre","name":"Sophisti-Pop","artist":null,"year":null,"weight":223,"yt":null,"src":"rym"}],"lists":[{"id":212407470817145,"name":"RYM Top — Pop — Sophi