"name":"The Ongoing History of New Music","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":268792820583907,"type":"artist","name":"Creedence Clearwater Revival","artist":null,"year":1959,"weight":96,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":157953610416146,"type":"genre","name":"Swamp Rock","n":6},{"id":106381401668595,"type":"genre","name":"Heartland Rock","n":5},{"id":211270792239401,"type":"genre","name":"Roots Rock","n":4}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Plagiarism Lawsuit for Self-Plagiarism (1985)","body":"John Fogarty, founder and chief songwriter for Credence Clearwater Revival, was sued for plagiarism in 1985 after releasing his solo album \"Center Field.\" The lawsuit alleged that songs on his solo album, specifically \"Old Man Down the Road,\" stole melodies from old CCR songs like \"Run Through the Jungle,\" the copyrights of which were owned by Saul Zaentz of Fantasy Records, not Fogarty himself. \"Then, in 1985, John released a solo record called Center Field and it too did very, very well. But then John was served with a lawsuit alleging plagiarism.\"","year":1985,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Sonic Coincidences in Alt-Rock Part 2","url":"https://www.youtube.com/watch?v=wYD_dIvYY5o"}]},{"kind":"podcast","title":"Anti-Government Metaphor","body":"In a 2012 interview with Buds Kappa, Fogarty explained that he used rain as a metaphor for the pervasive government policies around 1969-1970, which he perceived as \"baloney\" from figures like Richard Nixon regarding the Vietnam War. He described a dichotomy where older generations and the government held one view, and younger people felt quite differently, leading to distrust. \"In an interview with Buds Kappa in 2012, Fogarty said, there was the dichotomy of old people saying one thing, and young people feeling quite another thing. And therefore not trusting old people starting with the government, Richard Nixon, in his position on the war.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 55 - Heartland Rock is about More than the Heartland","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Contract Dispute and Copyright Transfer","body":"John Fogarty had given ownership of his Credence Clearwater Revival songs to Saul Zaentz, who ran CCR's record label, Fantasy Records, in order to get out of his contract, indicating a strong animosity between them. \"Although John had written the songs for Credence, the copyrights, the ownership of the songs he had written, had been given over to a guy named Saul Zance.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Sonic Coincidences in Alt-Rock Part 2","url":"https://www.youtube.com/watch?v=wYD_dIvYY5o"}]},{"kind":"podcast","title":"Courtroom Guitar Demonstration","body":"In his self-plagiarism lawsuit, John Fogarty brought his guitar to court and demonstrated to the judge and jury the differences between his solo song \"Old Man Down the Road\" and the CCR song \"Run Through the Jungle.\" This demonstration was a key factor in the judge's decision to dismiss the case. \"Fortunately, the judge in the case decided not to set a precedent and threw things out, largely because John brought his guitar to court and sat on the stand showing the judge and the jury the differences between the songs.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Sonic Coincidences in Alt-Rock Part 2","url":"https://www.youtube.com/watch?v=wYD_dIvYY5o"}]}],"awards":[{"kind":"award","title":"Americana Lifetime Achievement Award for Songwriting (2009)","body":"Won.","year":2009,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q96587125"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[],"charts":[{"id":257434289681656,"type":"album","name":"John Fogerty","list_id":115932688871073,"list":"RYM Top — Rock — Heartland Rock","src":"musthear","rank":36,"year":1975,"note":null,"yt":"EMo7IsXnCS8","scaruffi":null},{"id":257434289681656,"type":"album","name":"John Fogerty","list_id":215436743643591,"list":"RYM Top — Rock — Roots Rock","src":"musthear","rank":106,"year":1975,"note":null,"yt":"EMo7IsXnCS8","scaruffi":null},{"id":148230220060388,"type":"album","name":"Centerfield","list_id":115932688871073,"list":"RYM Top — Rock — Heartland Rock","src":"musthear","rank":30,"year":1985,"note":null,"yt":"zmOHKH8U058","scaruffi":null},{"id":148230220060388,"type":"album","name":"Centerfield","list_id":215436743643591,"list":"RYM Top — Rock — Roots Rock","src":"musthear","rank":88,"year":1985,"note":null,"yt":"zmOHKH8U058","scaruffi":null},{"id":95980408779272,"type":"album","name":"Eye of the Zombie","list_id":274700704885747,"list":"RYM Top — Rock — Swamp Rock","src":"musthear","rank":37,"year":1986,"note":null,"yt":"hHgCmW_x6jU","scaruffi":null},{"id":49851592406621,"type":"album","name":"Blue Moon Swamp","list_id":115932688871073,"list":"RYM Top — Rock — Heartland Rock","src":"musthear","rank":49,"year":1997,"note":null,"yt":"S4vc2rPy5QI","scaruffi":null},{"id":49851592406621,"type":"album","name":"Blue Moon Swamp","list_id":215436743643591,"list":"RYM Top — Rock — Roots Rock","src":"musthear","rank":120,"year":1997,"note":null,"yt":"S4vc2rPy5QI","scaruffi":null},{"id":49851592406621,"type":"album","name":"Blue Moon Swamp","list_id":274700704885747,"list":"RYM Top — Rock — Swamp Rock","src":"musthear","rank":15,"year":1997,"note":null,"yt":"S4vc2rPy5QI","scaruffi":null},{"id":8440853984222,"type":"album","name":"Deja Vu All Over Again","list_id":115932688871073,"list":"RYM Top — Rock — Heartland Rock","src":"m