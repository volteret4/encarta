{"id":63858890531193,"type":"album","name":"Naked City","artist":"John Zorn","year":1990,"weight":13,"info":{"cover":"https://i.discogs.com/BMcrCu9PuRT0mvBsN3W9hblJe8HVYKEbYP4Qi9MWluk/rs:fit/g:sm/q:90/h:600/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTY1MDc1/My0xNTY0NjU0ODk4/LTkxMTcuanBlZw.jpeg","yt":"7LLiZ_0-mLo","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/john-zorn/naked-city/"},"desc":"Naked City is an album by John Zorn, originally released on Nonesuch Records in 1990. The band which would become known under the same name included Zorn on alto saxophone with Bill Frisell on guitar, Wayne Horvitz on keyboards, Fred Frith on bass and Joey Baron on drums, and was established in 1988 as a \"compositional workshop\" to test the limitations of a rock band format. The album was rereleased as part of the box set Naked City: The Complete Studio Recordings on Zorn's Tzadik label in 2005. The Allmusic review by Scott Yanow awarded the album 5 stars stating ."},"artist_ref":{"id":153395651168943,"name":"John Zorn","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/John_Zorn%2C_Newport_Jazz_Festival_2014.jpg?width=500"}},"labels":[],"genres":[{"id":138197775829889,"type":"genre","name":"Progressive Rock","artist":null,"year":null,"weight":439,"yt":null,"src":"rym"},{"id":55893123468232,"type":"genre","name":"Experimental Rock","artist":null,"year":null,"weight":373,"yt":null,"src":"rym"},{"id":117363531556446,"type":"genre","name":"Jazz-Rock","artist":null,"year":null,"weight":263,"yt":null,"src":"rym"},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","artist":null,"year":null,"weight":235,"yt":null,"src":"rym"},{"id":3321080584815,"type":"genre","name":"Avant-Prog","artist":null,"year":null,"weight":214,"yt":null,"src":"rym"}],"lists":[{"id":256647743890097,"name":"RYM Top — Rock — Avant-Prog","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":145