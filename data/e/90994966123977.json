{"id":90994966123977,"type":"album","name":"Life Is But a Dream…","artist":"Avenged Sevenfold","year":2023,"weight":10,"info":{"cover":"https://ia800908.us.archive.org/16/items/mbid-fa9e9b61-80fd-4236-9ae6-f68d56d585eb/mbid-fa9e9b61-80fd-4236-9ae6-f68d56d585eb-35818630480.jpg","yt":"l9nW9_I8x7o","desc":"Life Is But a Dream… is the eighth studio album by American heavy metal band Avenged Sevenfold, released on June 2, 2023, through Warner Records. Its release follows nearly seven years after its predecessor, The Stage (2016), marking the band's longest gap between studio albums to date. It is also the first album to feature contributions from their late drummer Jimmy \"The Rev\" Sullivan since Nightmare (2010). Similar to The Stage, Life Is But a Dream... was produced by the band with Joe Barresi. It marks the band's return to Warner following a legal dispute between the band and Warner ."},"artist_ref":{"id":280963756514089,"name":"Avenged Sevenfold","info":{"img":null}},"labels":[],"genres":[{"id":174164112458259,"type":"genre","name":"Heavy Metal","artist":null,"year":null,"weight":782,"yt":null,"src":"musthear"},{"id":237890000566646,"type":"genre","name":"Post-Hardcore","artist":null,"year":null,"weight":341,"yt":null,"src":"musthear"},{"id":270478598006331,"type":"genre","name":"Alternative Metal","artist":null,"year":null,"weight":293,"yt":null,"src":"musthear"},{"id":190704175116840,"type":"genre","name":"Progressive Metal","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"},{"id":169159335096911,"type":"genre","name":"Avant-Garde Metal","artist":null,"year":null,"weight":228,"yt":null,"src":"musthear"},{"id":228129554093267,"type":"genre","name":"Crossover Thrash","artist":null,"year":null,"weight":210,"yt":null,"src":"musthear"}],"lists":[{"id":77862205276901,"name":"Kerrang! The 50 Best Albums of 2023","src":"musthear","grp":"musicbrainz","list_year":null,"rank":6,"year":null,"note":null,"total":50,"scaruffi":null}],"podcast":[],"book_tracks