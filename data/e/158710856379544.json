6937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"ensayos"},{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"ensayos"}],"album_genres":[{"id":196214580808384,"type":"genre","name":"Hip Hop Soul","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":171127338698013,"name":"Atlanta: del bass a So So Def","book":"The Come Up: An Oral History of the Rise of Hip-Hop","author":"Jonathan Abrams","start":1982,"end":2000,"desc":"Fuera de los centros mediáticos el Sur creció con su propio ecosistema de sellos, artistas y oyentes. En Atlanta el bass de Miami fue el primer sonido: «Let Mojo Handle It» (1982), el primer single de la ciudad; MC Shy D, llegado del Bronx con las enseñanzas de Bambaataa, grabó con 808 y DJ Toomp para el sello de Luke; las J-Tapes de King Edward J iniciaron la tradición de las mixtapes; Raheem the Dream, Success-n-Effect, Kilo Ali o Hitman Sammy Sam fueron el prototipo del trap. A principios de los noventa la ciudad exportó: los DARP Studios de Dallas Austin, Arrested Development (dos Grammys), «Whoomp! (There It Is)» de Tag Team y, sobre todo, Kris Kross, dos niños que Jermaine Dupri, exbailarín de Whodini, descubrió en el centro comercial de Greenbriar y vistió con la ropa del revés: Totally Krossed Out (1992) y «Jump» fueron número 1 y le permitieron fundar So So Def (Da Brat, Xscape, Jagged Edge).","color":"#f472b6","family":"El Sur: Miami, Atlanta, Houston, Memphis, Nueva Orleans","link":"https://volteret4.github.io/ComeUp/#atlanta"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":278673816568783,"type":"song","name":"Just Kickin' It","work_year":1993,"list_id":55625790664966,"list":"Billboard Year-End 1993","src":"singles","rank":55,"year":1993,"note":"","yt":"w_BTEFAVwjU","scaruffi":null},{"id":99764182540534,"type":"album","name":"Hummin' Comin' at 'Cha","list_id":8072892