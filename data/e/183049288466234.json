41578082,"type":"genre","name":"Latin Pop","artist":null,"year":null,"weight":217,"yt":null,"src":"ensayos"},{"id":93595733263669,"type":"genre","name":"Traditional Mexican","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":90510611927654,"type":"genre","name":"Country Rock","n":7},{"id":133646791193319,"type":"genre","name":"Laurel Canyon Scene","n":5},{"id":251671925246370,"type":"genre","name":"Soft Rock","n":3},{"id":259591533889179,"type":"genre","name":"Mexican Music","n":2},{"id":42147038712068,"type":"genre","name":"Country Pop","n":2},{"id":9877689544171,"type":"genre","name":"Standards","n":2},{"id":163536058891268,"type":"genre","name":"Traditional Pop","n":1},{"id":116162141578082,"type":"genre","name":"Latin Pop","n":1},{"id":9343125461845,"type":"genre","name":"Adult Contemporary","n":1}],"labels":[{"id":113269546575082,"type":"label","name":"Capitol Records","artist":null,"year":null,"weight":185,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Meeting Emmylou Harris (1973)","body":"Linda Ronstadt met Emmylou Harris at a boisterous honky-tonk called the Liberty Bar in Houston in 1973. Ronstadt vividly recalls how the rowdy venue would fall silent when Harris sang, leading her to quickly befriend Harris and collaborate musically. \"Linda Ronstadt and Emileu met at this honky-tonk in Houston called the Liberty Bar in 1973 and the way Linda describes it it was this loud, rowdy place which would get really quiet when Emileu sang because she is just that good.\"","year":1973,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Rock and Roll Hall of Fame Induction (2014)","body":"Linda Ronstadt was inducted into the Rock and Roll Hall of Fame in 2014, with Glenn Fry of The Eagles delivering her induction speech. Fry noted that he and Don Henley had been members of her band before they formed The Eagles. \"Linda Ronstadt was an inducted into the rock and roll hall of fame in 2014.\"","year":2014,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Challenges as a Woman in 1970s Rock","body":"Linda Ronstadt found it difficult to establish her place in rock music during the 1970s as a woman. She struggled with a lack of confidence, resorting to cocaine and speed, and sensed resentment from fans while opening for Neil Young. She also felt societal pressure to act sexy and utilized a male crew member as a \"pseudo interpreter\" when communicating with other men. \"It was not easy for her to find her place in rock music as a woman in the 70s.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Collaboration Attempt with Dolly Parton and Emmylou Harris (Mid-1970s)","body":"Following an impressive performance on Dolly Parton's TV show with Dolly and Emmylou Harris, the trio attempted to record an album together shortly after. However, it \"didn't sound right\" and faced contractual issues, delaying their successful \"Trio\" album until 1987. \"No Dolly and Emmy Lou and Linda were as impressed as anyone with how they sounded and tried to make a record not long after that. It didn't sound right and I think there were some contractual issues.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Description of The Troubadour","body":"Linda Ronstadt described The Troubadour as a \"cafe society,\" and as being \"responsible for the entire music scene\" in the area, highlighting its crucial role in fostering musical community and talent. \"Linda Ronstadt described it as a cafe society.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Eagles as Backup Band","body":"The future members of The Eagles initially performed as Linda Ronstadt's backup band. \"pieces of what become the eagles were Linda Ronstadt's backup band and that's true.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 35 - Cosmic American Music - 70s Country Rock","url":null},{"source":"For the Record - The 70s","episode":"Ep. 35 - Cosmic American Music - 70s Country Rock","url":"https://seventies.libsyn.com/ep-35-cosmic-american-music-70s-country-rock"}]},{"kind":"podcast","title":"Embracing New Wave","body":"Even this pop crooner was drawing from the \"New Wave Well\" by covering Elvis Costello. \"Even pop-cruiner Linda Ronstadt was drawing from the New Wave Well by covering Elvis Costello.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Angry Young Men Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Angry Young Men Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4f780c30a1408dc2baf3"}]},{"kind":"podcast","title":"Financial Impact on Post-Punk Forefather","body":"(Implied) Her success with the \"Alison\" cover is the reason why one of the post-punk forefathers (Elvis Costello, the songwriter) \"didn't need to work another day in his life\" after 1992, due to royalties generated by the popular cover. \"She's the reason why after 1992 he didn't need to work another day in his life.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Angry Young Men Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Angry Young Men Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4f780c30a1408dc2baf3"}]},{"kind":"podcast","title":"First Gig and Record Deal","body":"In 1965, Linda Ronstadt and her band, The Stone Poneys, secured a two-week engagement at The Troubadour. Shortly after this gig, they were signed to a record deal with Capitol Records. \"In 1965, she got a two week gig at the Trubidor with her band The Stone Pony's and then they got her record deal with capital records not long after that.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Homage to Mexican Heritage","body":"Linda Ronstadt's album \"Canciones de mi Padre\" was a direct tribute to her Mexican heritage, showcasing her roots and contributing to its historical success as the best-selling non-English album in American history. \"This was an homage to her Mexican heritage and is still the best-selling non-English album in American history.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 25 - The Hispanic Influence on 70s Popular Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 25 - The Hispanic Influence on 70s Popular Music","url":"https://seventies.libsyn.com/ep-25-the-hispanic-influence-on-70s-popular-music"}]},{"kind":"podcast","title":"Impact of Elton John's Debut","body":"Linda Ronstadt was present at The Troubadour during Elton John's American debut. She famously stated that when Elton John played \"Take Me to the Pilot\" that night, the club \"levitated,\" illustrating the powerful and transformative impact of his performance. \"Linda Ronstadt said when Elton John played take me to the pilot at the troubadour that night, the club quote, levitated.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Influence on Genre Blurring","body":"Linda Ronstadt actively contributed to the blurring of boundaries within country music, demonstrating that the genre could be more expansive and diverse than previously imagined. Her work showed that she \"actually helped do the blurring.\" \"It may be unfair to say she benefited from the blurring boundaries of what country music is because I think she actually helped do the blurring.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Meeting Future Eagles Members","body":"After The Stone Poneys disbanded and Ronstadt embarked on a solo career, she received songs from a newcomer, Don Henley, who hoped she would record them. Ronstadt recounted meeting Henley, Glenn Frey, and Bernie Leadon at The Troubadour bar, where they often sang bluegrass songs and white spirituals together in a corner late into the evening. \"I met Bernie Leiden and G. Glenn Fry and Don Henley. I met them at the troubadour bar.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Migration to Los Angeles","body":"Linda Ronstadt migrated to Los Angeles from Tucson, Arizona, in 1965, where she quickly secured her first significant gig. \"Linda Ronstadt migrated to Los Angeles from Tucson and in 1965, she got a two week gig at the Trubidor with her band The Stone Pony's.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":null},{"source":"For the Record - The 70s","episode":"Ep. 41 - The Impact of The Troubadour on 1970s Popular Culture","url":"https://seventies.libsyn.com/ep-41-the-impact-of-the-troubadour-on-1970s-popular-culture"}]},{"kind":"podcast","title":"Purest Vocal Voice","body":"Linda Ronstadt is recognized with the benefit of hindsight as potentially having \"the purest voice of anyone who took the stage in the 70s,\" capable of singing any genre, including Spanish folk songs. \"We know now that Linda Ronstadt may have had the purest voice of anyone who took the stage in the 70s. We know now that she can sing and did sing any genre and that includes singing Spanish folk songs.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]},{"kind":"podcast","title":"Role in Popularizing Country Music for Youth","body":"Linda Ronstadt, perhaps even more than Gram Parsons, is credited with making country music \"cool\" for younger audiences through her voice and unique brand of country rock, which helped expose a broader demographic to the genre. \"We know that she may be even more than Grand Parsons made it cool for younger people to like country music.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":"https://seventies.libsyn.com/023-country-women-72820-2-45-pm"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best Female Pop Vocal Performance (1977) — Hasten Down the Wind","body":"Won.","year":1977,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q935283"}]},{"kind":"award","title":"Tony Award for Best Actress in a Musical (1981)","body":"Nominated.","year":1981,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1537996"}]},{"kind":"award","title":"Primetime Emmy Award for Individual Performance in a Variety or Music Program (1989)","body":"Won.","year":1989,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4377021"}]},{"kind":"award","title":"Grammy Award for Best Tropical Latin Album (1993) — Frenesí","body":"Won.","year":1993,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q5593901"}]},{"kind":"award","title":"honorary doctor of the Berklee College of Music (2009)","body":"Won.","year":2009,"extra":null,"srcs":[