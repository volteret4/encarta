{"id":160512798870596,"type":"album","name":"93 'til Infinity","artist":"Souls of Mischief","year":1993,"weight":15,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/8876-93-til-infinity.jpg","aoty":98,"aoty_user":84,"sputnik":4.26,"yt":"KRLUFEJBTyE","links":{"aoty":"https://www.albumoftheyear.org/album/8876-souls-of-mischief-93-til-infinity.php","sputnikmusic":"https://www.sputnikmusic.com/album/41604/Souls-of-Mischief-93-til-Infinity/"},"desc":"One of hip-hop's great lost masterpieces, 93 'Til Infinity is the best single album to come out of Oakland's Hieroglyphics camp, and ranks as a seminal early classic of the West Coast underground. The Souls of Mischief weren't even out of their teens when they completely redefined the art of lyrical technique for the West Coast, along with fellow standard-bearers Freestyle Fellowship, the Pharcyde, and Hiero founder Del tha Funkee Homosapien. The Souls come off as four brash young MCs who are too smart for their own good, yet they're so full of youthful exuberance that it's impossible to dislike ."},"artist_ref":{"id":238820652771057,"name":"Souls of Mischief","info":{"img":null}},"labels":[],"genres":[{"id":136937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"musthear"},{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":145450397810410,"type":"genre","name":"Jazz Rap","artist":null,"year":null,"weight":238,"yt":null,"src":"rym"},{"id":126011890020151,"type":"genre","name":"Boom Bap","artist":null,"year":null,"weight":237,"yt":null,"src":"rym"},{"id":167455165178139,"type":"genre","name":"West Coast Hip Hop","artist":null,"year":null,"weight":226,"yt":null,"src":"rym"}],"lists":[{"id":59251635065665,"name":"Sputnikmusic Best Albums 1993","src":"charts","grp":"sputnikmusic","list_year":null,"rank":14,"year":1993,"note":null,"total":200,"scaruffi":null},{"id":74398601725713,"name":"RYM Top —