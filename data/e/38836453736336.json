weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[{"id":211104271464702,"type":"genre","name":"Spanish Language Pop","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":147557834756338,"type":"genre","name":"Bilingual Pop","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":207959166713072,"type":"genre","name":"Andalusian Folk Music","n":9},{"id":205492120814235,"type":"genre","name":"Sevillanas","n":9},{"id":30687826424655,"type":"genre","name":"Flamenco Pop","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":112352024959263,"name":"La rumba","book":"El flamenco contado con sencillez","author":"Carlos Arbelos","start":1914,"end":2002,"desc":"El cante de ida y vuelta más estudiado, tan parecido al tango que confunde a los investigadores. Según Papa Wemba su melodía es centroafricana, de Zaire: viajó con la trata de esclavos a Cuba y de allí a España. La aportación más flamenca fue la de Pepe de la Matrona, que vivió en Cuba a mediados de la década de 1910 (Recuerdos de La Habana, 1914). La rumba catalana tiene su estilo propio, con el Pescaílla, marido de Lola Flores, y Peret, y su toque rapidísimo «del ventilador». Poco apreciada por los flamencos, ha crecido con la salsa entre el público joven; Paco de Lucía tuvo su primer gran éxito con la rumba «Entre dos aguas» y la «Macarena» de Los del Río batió todos los récords. Su baile es sensual y provocador.","color":"#2dd4bf","family":"Ida y vuelta y cantes aflamencados","link":"https://volteret4.github.io/Flamenco/#rumba"}],"book_tracks":[{"id":274150449496498,"artist":"Los del Río","artist_id":38836453736336,"title":"Macarena","year":1993,"ess":0,"yt":"zWaymcVmJ-A","kind":null,"book":{"id":3,"title":"El flamenco contado con sencillez","author":"Carlos Arbelos","url":"https://volteret4.github.io/Flamenco/"},"scene":"La rumba","scene_id":112352024959263,"scene_link":"https://volteret4.github.io/Flamenco/#rumba","chapters":["Cap. 4 (III): Las diferentes formas: los ritmos aflamencados"],"pages":[[1,89]]}],"mentions":[{"book":"El flamenco contado con sencillez","author":"Carlos Arbelos","page":89,"text":"…logró su primer gran éxito masivo de ventas con la rumba Entre dos aguas, en los primeros años de la década de 1970, y la rumba Macarena del dúo Los del Río ha sobrepasado en ventas nacionales e internacionales todos los parámetros imaginables. La aportación más flamenca a este palo la hizo el cantaor…"}],"podcast":[{"kind":"podcast","title":"Macarena's Impact on Bilingual Pop (1996)","body":"The \"Macarena (Bayside Boys Remix)\" was a \"key moment for both Spanish language pop and for one hit wonders in general,\" introducing Americans to bilingual pop decades before \"Despacito.\" Despite the \"tacky English lyrics\" of the remix, its overall effect was positive in fostering this cultural shift. \"anything that got Americans embracing bilingual pop decades before despacito is not a bad thing.\"","year":1996,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Hits of the Year Edition Part 2","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":193864611580397,"type":"album","name":"Luces de Sevilla","list_id":21596927198085,"list":"RYM Top — Folk — Andalusian Folk Music","src":"musthear","rank":65,"year":1967,"note":null,"yt":"JZHf0XLId0Y","scaruffi":null},{"id":193864611580397,"type":"album","name":"Luces de Sevilla","list_id":264735744230394,"list":"RYM Top — Folk — Sevillanas","src":"musthear","rank":40,"year":1967,"note":null,"yt":"JZHf0XLId0Y","scaruffi":null},{"id":2393013700691,"type":"album","name":"De Triana al Rocío con Los del Río","list_id":21596927198085,"list":"RYM Top — Folk — Andalusian Folk Music","src":"musthear","rank":49,"year":1971,"note":null,"yt":"0aqoGCO7Zcg","scaruffi":null},{"id":2393013700691,"ty