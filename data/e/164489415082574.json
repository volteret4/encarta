{"id":164489415082574,"type":"album","name":"Power, Corruption & Lies","artist":"New Order","year":1983,"weight":52,"info":{"cover":"https://dn711304.ca.archive.org/0/items/mbid-2cc43c63-46ca-48ae-aeed-74bb06034657/mbid-2cc43c63-46ca-48ae-aeed-74bb06034657-19203523471.jpg","kind":"Album","tracks":8,"country":"GB","aoty":83,"aoty_user":83,"yt":"gG9fEaITgCk","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/new-order/power-corruption-and-lies-25/","aoty":"https://www.albumoftheyear.org/album/5331-new-order-power-corruption-lies.php"},"desc":"Power, Corruption & Lies is the second studio album by English rock band New Order, released on 2 May 1983 by Factory Records. The album features more electronic tracks than their 1981 debut Movement, with heavier use of synthesizers. The album was met with widespread acclaim, and has been included in music industry lists of the greatest albums of the 1980s and of all time. The cover artwork was by Peter Saville, and in 2010 it was one of ten classic album covers from British artists commemorated on a UK postage stamp issued by the Royal Mail. ."},"artist_ref":{"id":80644305471953,"name":"New Order","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/New_Order%2C_Chile_2019_%2839751785423%29.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":220327530487024,"type":"genre","name":"New Wave","artist":null,"year":null,"weight":1514,"yt":null,"src":"musthear,rym"},{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"musthear"},{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"musthear,rym"},{"id":260819262438325,"type":"genre","name":"synth-pop","artist":null,"year":null,"weight":325,"yt":null,"src":"musthear"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null