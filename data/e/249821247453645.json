":[{"name":"For the Record - The 70s","n":1}],"lists":[],"n_lists":0}}],"members":[{"id":280024189546702,"type":"artist","name":"Michael Jackson","artist":null,"year":1958,"weight":691,"yt":null,"src":"ensayos"},{"id":172038754738581,"type":"artist","name":"Jermaine Jackson","artist":null,"year":null,"weight":15,"yt":null,"src":"ensayos"},{"id":103499578881012,"type":"artist","name":"Marlon Jackson","artist":null,"year":null,"weight":3,"yt":null,"src":"ensayos"},{"id":226743898468098,"type":"artist","name":"Randy Jackson","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"},{"id":151227450331744,"type":"artist","name":"Jackie Jackson","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"},{"id":73685872136221,"type":"artist","name":"Tito Jackson","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":101243911240695,"type":"genre","name":"Bubblegum adjacent","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":171532301577530,"type":"genre","name":"Motown Sound","n":3}],"labels":[{"id":208757818138788,"type":"label","name":"Motown","artist":null,"year":null,"weight":281,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[{"id":207921115017447,"name":"Motown, Norman Whitfield y la psicodelia soul","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1959,"end":1976,"desc":"El imperio de Berry Gordy fue un fenómeno de capitalismo negro, pero en los setenta solo sobrevivieron los artistas que escribían su material (Stevie Wonder, Marvin Gaye, Smokey Robinson, Michael Jackson). Norman Whitfield, que pasó de chupatintas a productor, le dio un filo más áspero («I Heard It Through the Grapevine» de Gladys Knight) y, mientras Sly arrasaba en 1968, cambió el sonido de los Temptations: temas largos con guitarras rockeras, efectos espaciales, drogas («Cloud Nine», «Psychedelic Shack», «Ball of Confusion») y orgullo negro, ropa a lo Hendrix y, al final, «Papa Was a Rollin’ Stone» (1972), soul con mensaje. La huella de P-Funk era clara (Eddie Hazel y Billy Nelson tocan en «Shakey Ground»); Whitfield convirtió a los Undisputed Truth en una banda de black rock pintada de plata. Los músicos de sesión, los Funk Brothers, trabajaban en la sombra: el bajista James Jamerson, que sacaba líneas de cómo hablaba o caminaba la gente, influyó a todos. Cuando Motown se mudó a Los Ángeles, la banda se quedó en Detroit y la magia se perdió.","color":"#facc15","family":"Soul y proto-funk: Stax, Nueva Orleans, Motown","link":"https://volteret4.github.io/Funk/#motown"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"First Television Appearances (1969-1970)","body":"The Jackson 5 made their initial television appearance on the Miss Black America pageant in September 1969. This was followed by a performance on the legendary Ed Sullivan Show in December 1969, reaching a much larger audience, and then their American Bandstand debut in February 1970. \"Their first was on the Miss Black America pageant in September 1969 and then they played to a much larger audience on the legendary Ed Sullivan show in December of 69.\"","year":1969,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Admiration for The Beatles (1970)","body":"During their American Bandstand interview, young Michael Jackson and other members of his family expressed their admiration for The Beatles. This sentiment is particularly notable given that the Jackson Five's song \"ABC\" would later unseat The Beatles' \"Let It Be\" from the number one spot on the Billboard Hot 100 in 1970. \"Seven-year-old Michael Jackson and various members of his family, many of whom said that they admired the Beatles.\"","year":1970,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]},{"kind":"podcast","title":"Imperiality Confirmed by Imitators","body":"The Jackson 5's imperiality in 1970-1971, during which they scored a half dozen consecutive number one or number two hits, was affirmed when another family band, The Osmonds, topped the Hot 100 with \"One Bad Apple\"—a song originally rejected by Motown's Berry Gordy for The Jackson 5 and remade as an \"uncanny Jackson 5 facsimile.\" \"That alone indicated their imperiality. But what affirmed it was when another family band topped the Hot 100 in early 71 with this song.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Material Girl in an Imperial World Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Material Girl in an Imperial World Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4f03154465cd600c5379"}]},{"kind":"podcast","title":"Joe Jackson's Abusive Management","body":"The Jackson family's musical endeavors were managed by their father, Joe Jackson, who is described as an \"abusive disaster.\" \"And then everything was run by father Joe Jackson, who is another abuse of disaster.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"It's A Family Affair","url":"https://www.youtube.com/watch?v=gxbuajGKbko"}]},{"kind":"podcast","title":"Lineup Change and Family Involvement","body":"When The Jackson Five left Motown, Jermaine Jackson remained with the label and was replaced in the group by Randy Jackson, making for a total of six members over time. Beyond the core group, sisters Janet, Latoya, and Revy also factor into the family's musical presence, all overseen by their father, Joe Jackson. \"When the group left Motown, Germain stayed behind and was replaced by Randy.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"It's A Family Affair","url":"https://www.youtube.com/watch?v=gxbuajGKbko"}]},{"kind":"podcast","title":"Living with Barry Gordy and Diana Ross","body":"After moving from their hometown of Gary, Indiana, the Jackson family resided in Beverly Hills with Motown president Barry Gordy and Diana Ross, whom Gordy described as the love of his life. This was mentioned during Michael Jackson's interview on American Bandstand. \"This is where the Jackson's were living with Motown president Barry Gordy and the woman he described as the love of his life Diana Ross.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null},{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":"https://www.ftr70.com/"}]}],"awards":[{"kind":"award","title":"Rock and Roll Hall of Fame (1997)","body":"Won.","year":1997,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q179191"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[],"charts":[{"id":54910832652141,"type":"song","name":"I Want You Back","work_year":1970,"list_id":219509302503571,"list":"Billboard Hot 100 nº1 · 1970s","src":"singles","rank":228,"year":1970,"note":"1 semanas","yt":"y2bVIBwpCTA","scaruffi":null},{"id":30768582112880,"type":"song","name":"ABC","work_year":1970,"list_id":219509302503571,"list":"Billboard Hot 100 nº1 · 1970s","src":"singles","rank":233,"year":1970,"note":"2 semanas","yt":"ISqzbbZVIiU","scaruffi":null},{"id":280898872060936,"type":"song","name":"The Love You Save","work_year":1970,"list_id":21950930250357