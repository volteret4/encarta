l,"year":null,"weight":703,"yt":null,"src":"ensayos"}],"album_genres":[{"id":13951889004721,"type":"genre","name":"2 Tone","n":10},{"id":253717746650249,"type":"genre","name":"Ska","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":174025288450713,"name":"2-Tone: The Specials y el ska de los Midlands","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1979,"end":1983,"desc":"El sello de Jerry Dammers llenó en 1979 el hueco de un punk bailable: The Specials, siete músicos blancos y negros de Coventry (Terry Hall y su mirada heredada de Rotten, el rude boy Neville Staple), cruzan el ska de Prince Buster con la energía punk y un realismo social en blanco y negro («Gangsters», «Too Much Too Young», «Concrete Jungle», «Nite Klub»). El damero blanco y negro simboliza la integración racial; The Beat (Handsworth: «Mirror in the Bathroom», «Stand Down Margaret»), The Selecter («On My Radio») y Madness suman cinco hits en cinco singles. El sueño de un «nuevo Motown» se convierte en «un monstruo»: More Specials se refugia en la música ligera y la caja de ritmos, y «Ghost Town» (1981), retrato de la desindustrialización, llega al número uno mientras arden las ciudades. Fun Boy Three, «Nelson Mandela» y el fin. Posmoderno antes del new pop: «Estamos trayendo de vuelta algo que nunca existió».","color":"#f472b6","family":"New pop, synthpop y 2-Tone","link":"https://volteret4.github.io/Postpunk/#two-tone"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"The English Beat – Mirror in the Bathroom (1980); Held Out Against Violence and Racism Through Music; Second Wave Ended ~1985","body":"The English Beat, led by Dave Wakeling, were formed in the late 1970s and had their first hit with \"Mirror in the Bathroom\" (1980), a classic of the great ska revival. The second wave of ska — spanning roughly 1979 to 1985 — was vibrant and carried a hopeful message as a positive alternative to hard economic times and racial riots in Britain. By the mid-1980s, Jerry Dammers was broke and Two-Tone was falling apart under huge debt; despite efforts by the Clash, the Beat, and Bad Manners, the second wave ended around 1985. \"Ska was a positive alternative to the hard economic times and the racial riots that were plaguing Britain in the early 1980s.\"","year":1980,"extra":{"from":"The English Beat","from_id":16199761265652,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"A Not-So Brief History of Ska: Part 1","url":"https://www.youtube.com/watch?v=VxWp7HrT8oE"}]}],"charts":[{"id":24611569421575,"type":"album","name":"Rare & Fatty - Unreleased Recordings 1976-1997","list_id":128692758284321,"list":"RYM Top — Rock — 2 Tone","src":"musthear","rank":74,"year":1976,"note":null,"yt":null,"scaruffi":null},{"id":86523598205594,"type":"album","name":"Ska 'n' B","list_id":50662616142545,"list":"RYM Top — Reggae / Ska / Dancehall — Ska","src":"musthear","rank":56,"year":1980,"note":null,"yt":"v_ANr--LxlU","scaruffi":null},{"id":53901528125863,"type":"album","name":"Loonee Tunes!","list_id":50662616142545,"list":"RYM Top — Reggae / Ska / Dancehall — Ska","src":"musthear","rank":189,"year":1980,"note":null,"yt":"zGCXh6p6aA4","scaruffi":null},{"id":86523598205594,"type":"album","name":"Ska 'n' B","list_id":128692758284321,"list":"RYM Top — Rock — 2 Tone","src":"musthear","rank":12,"year":1980,"note":null,"yt":"v_ANr--LxlU","scaruffi":null},{"id":53901528125863,"type":"album","name":"Loonee Tunes!","list_id":128692758284321,"list":"RYM Top — Rock — 2 Tone","src":"musthear","rank":20,"year":1980,"note":null,"yt":"zGCXh6p6aA4","scaruffi":null},{"id":260835831551073,"type":"album","name":"Gosh It's...Bad Manners","list_id":128692758284321,"list":"RYM Top — Rock — 2 Tone","src":"musthear","rank":23,"year":1981,"note":null,"yt":"A0r2_GAnN6k","scaruffi":null},{"id":159354679756689,"type":"album","name":"Forging Ahead","list_id":12869275828432