{"id":208048282246672,"type":"album","name":"Heart","artist":"Heart","year":1985,"weight":26,"info":{"cover":"https://dn710601.ca.archive.org/0/items/mbid-e497b61c-fd1b-3d4d-93a7-7177fc78c0a8/mbid-e497b61c-fd1b-3d4d-93a7-7177fc78c0a8-1260556159.jpg","kind":"Album","tracks":10,"country":"XE","scaruffi":7.0,"yt":"IzVD3XTEZ7w","links":{"youtube":"https://music.youtube.com/playlist?list=OLAK5uy_njaiZC_tvdFjWbe0_xr5mVEAmWGuA0lrk","rateyourmusic":"https://rateyourmusic.com/release/album/heart/heart"},"desc":"Heart is the self-titled eighth studio album, released by the American rock band Heart. Released in 1985, the album continued the band's transition into mainstream rock, a genre that yielded the band its greatest commercial success. Marking the band's Capitol Records debut, it spent 92 weeks on the U.S. Billboard 200 and became the only Heart album so far to hit number one, reaching quintuple platinum status. It also yielded the first number-one single for the band, \"These Dreams\", along with four other hit singles: \"What About Love\", \"Never\", \"Nothin' at All\" and \"If Looks Could Kill\". The first three ."},"artist_ref":{"id":65545961556779,"name":"Heart","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Heart-07-28-07.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"musthear"},{"id":260819262438325,"type":"genre","name":"synth-pop","artist":null,"year":null,"weight":325,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"},{"id":25930810330885,"type":"genre","name":"AOR","artist":null,"year":null,"weight":23