{"id":90585551219373,"type":"album","name":"Olé Coltrane","artist":"John Coltrane","year":1961,"weight":28,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/53181-ole-coltrane_164534.jpg","aoty":70,"aoty_user":81,"yt":"wr5BotYA3U8","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/john-coltrane/ole-coltrane","aoty":"https://www.albumoftheyear.org/album/53181-john-coltrane-ole-coltrane.php"},"desc":"Olé Coltrane is an album by jazz musician John Coltrane released in November 1961 on Atlantic Records (SD 1373). The album was recorded at A&R Studios in New York (May 1961), and was the last of Coltrane's Atlantic albums to be made under his own supervision. Recording Two days prior to recording Olé Coltrane, John Coltrane had completed Africa/Brass, his first session for Impulse! Records, at Van Gelder Studio in Englewood Cliffs, New Jersey. Still under contract to Atlantic for one remaining album, he returned to the studio with his working quintet and expanded the lineup by adding Art Davis ."},"artist_ref":{"id":135557885934307,"name":"John Coltrane","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/John_Coltrane_1963_cropped_ver2.jpg?width=500"}},"labels":[],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":110972509927513,"type":"genre","name":"Free Jazz","artist":null,"year":null,"weight":251,"yt":null,"src":"musthear"},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","artist":null,"year":null,"weight":235,"yt":null,"src":"musthear"},{"id":90794434709999,"type":"genre","name":"Hard Bop","artist":null,"year":null,"weight":220,"yt":null,"src":"musthear"},{"id":151625601973552,"type":"genre","name":"Cool Jazz","artist":null,"year":null,"weight":217,"yt":null,"src":"musthear"},{"id":51806065918814,"type":"genre","name":"Modal Jazz","artist":null,"year":null,"weight":211,"yt":null,"src":"musthear,rym"}],"lists":[{"id":780159457257