{"id":227878057233997,"type":"artist","name":"Gorky's Zygotic Mynci","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Gorky%27s_Zygotic_Mynci.jpg?width=500","bio":"Gorky's Zygotic Mynci es una banda galesa formada en 1990 y cuya trayectoria de 16 años ha terminado en mayo del 2006. Su suave y melódica mezcla de psicodelia, rock progresivo y pop, colaboraciones poco ortodoxas, estructuras y combinaciones instrumentales les han granjeado seguidores de ambos lados del Atlántico, sin olvidar sus poco convencionales letras. Sus tres primeros álbumes indie son: \"Tatay\", \"Bwyd Time\" y \"Llanfwrog/Patio\", editados originalmente con Ankst, se han reeditado en el 2006.","tags":["welsh","indie","indie pop","folk","indie rock"]},"works":[{"id":9921177427479,"type":"album","name":"Tatay","artist":"Gorky's Zygotic Mynci","year":1994,"weight":13,"yt":"ZgpH4s7NA0M","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":42512826448326,"name":"RYM Top — Psychedelia — Psychedelic Folk","rank":188,"scaruffi":null},{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","rank":158,"scaruffi":null},{"id":250477618424467,"name":"RYM Top — Rock — Slacker Rock","rank":157,"scaruffi":null}],"n_lists":3}},{"id":190057119256611,"type":"album","name":"Bwyd Time","artist":"Gorky's Zygotic Mynci","year":1995,"weight":5,"yt":"S9L0jHolCKI","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":42512826448326,"name":"RYM Top — Psychedelia — Psychedelic Folk","rank":116,"scaruffi":null},{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","rank":97,"scaruffi":null}],"n_lists":2}},{"id":249845537872949,"type":"album","name":"Barafundle","artist":"Gorky's Zygotic Mynci","year":1997,"weight":11,"yt":"bYxLZbcdFIU","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 195