{"id":134671177660864,"type":"song","name":"Mystery Train","artist":"Elvis Presley","year":1955,"weight":13,"info":{"img":null},"artist_ref":{"id":182833516532380,"name":"Elvis Presley","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Elvis_Presley_Publicity_Photo_for_The_Trouble_with_Girls_1968.jpg?width=500"}},"labels":[],"genres":[],"lists":[],"podcast":[{"kind":"podcast","title":null,"body":"Elvis's version of \"Mystery Train\" was the B-side of his fifth single for Sun Records and was described as \"astonishing.\" It was a fusion of elements from both the A-side (\"Love My Baby\") and B-side (\"Mystery Train\") of Junior Parker's original single, with Scotty Moore incorporating the riff from \"Love My Baby.\" This rendition became an \"absolute classic of the Rocket Belly genre.\" \"But the B-side, his version of Mystery Train, was astonishing.\"","year":1955,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 33: \"Mystery Train\", by Elvis Presley","url":"https://www.youtube.com/watch?v=DSHTmHy3Jo0"}]},{"kind":"podcast","title":null,"body":"Released as the B-side to \"I Forgot to Remember to Forget\" when RCA Records reissued the single.","year":1955,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 38: \"Heartbreak Hotel\" by Elvis Presley","url":"https://www.youtube.com/watch?v=ES35PYeAwfs"}]}],"book_tracks":[],"others":[{"id":138240031229065,"type":"song","name":"Don't Be Cruel","year":1956,"weight":39},{"id":9847353165646,"type":"song","name":"Heartbreak Hotel","year":1956,"weight":32},{"id":105556708779181,"type":"album","name":"Elvis Presley","year":1956,"weight":29},{"id":208627001131508,"type":"song","name":"Hound Dog","year":1956,"weight":27},{"id":76944695519233,"type":"song","name":"It's Now or Never","year":1960,"weight":23},{"id":34702512581755,"type":"song","name":"Jailhouse Rock","year":1957,"weight":22},{"id":276529003025889,"type":"album","name":"Fro