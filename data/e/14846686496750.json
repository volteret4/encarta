{"id":14846686496750,"type":"album","name":"Manassas","artist":"Manassas","year":1972,"weight":14,"info":{"cover":"https://ia801202.us.archive.org/19/items/mbid-fbb4ddce-b0e4-4dc4-86e2-def7e7a058c6/mbid-fbb4ddce-b0e4-4dc4-86e2-def7e7a058c6-11382991383.jpg","yt":"UQ01tkS8nhU","desc":"Manassas is the 1972 debut double album by Stephen Stills' band of the same name. \"It Doesn't Matter\" was released as a single and peaked at #61. Bill Wyman of the Rolling Stones plays bass on and co-authored \"The Love Gangster\" and is reported to have said that he would have left the Stones to join Manassas. Manassas marked a critical comeback for Stills, with Allmusic calling it a \"sprawling masterpiece\" and Rolling Stone saying it was \"reassuring to know that Stills has some good music still inside him\". ."},"artist_ref":{"id":20435972726612,"name":"Manassas","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Manassas1972.JPG?width=500"}},"labels":[],"genres":[{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":163225726165579,"type":"genre","name":"Blues Rock","artist":null,"year":null,"weight":458,"yt":null,"src":"musthear"},{"id":90510611927654,"type":"genre","name":"Country Rock","artist":null,"year":null,"weight":425,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"}],"lists":[{"id":192934750972716,"name":"1001 Albums You Must Hear Before You Die","src":"charts","grp":"1001 Albums","list_year":null,"rank":256,"year":1972,"note":null,"total":999,"scaruffi":null}],"podcast":[],"book_tracks":[{"id":14846686496750,"artist":"Manassas","artist_id":20435972726612,"title":"Manassas","year":1972,"ess":0,"yt":"bt9qbiwslqo","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Country-rock y ro