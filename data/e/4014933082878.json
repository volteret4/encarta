{"id":4014933082878,"type":"artist","name":"Los Straitjackets","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/LosStraitjackets.jpg?width=500","bio":"Los Straitjackets son una banda de Nashville (Tennessee), conocidos por sus increibles directos,con go-gos incluidas y sus máscaras de lucha libre, tocan surf-garaje instrumental principalmente,aunque también se hacen acompañar de vocalistas puntualmente. Aparte de su calidad como músicos, que es incuestonable, ofrecen al público magníficas versiones de temas como el de la familia munster o el My heart will go on de Celine Dion.","tags":["Surf","surf rock","instrumental","rockabilly","Rock and Roll"]},"works":[{"id":165639773513461,"type":"album","name":"The Utterly Fantastic and Totally Unbelievable Sound","artist":"Los Straitjackets","year":1995,"weight":6,"yt":"ANzpbq1eoZw","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":190944515190787,"type":"album","name":"The Utterly Fantastic and Totally Unbelievable Sound of Los Straitjackets","artist":"Los Straitjackets","year":1995,"weight":5,"yt":"ANzpbq1eoZw","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":161529817301205,"name":"RYM Top — Rock — Surf Rock","rank":77,"scaruffi":null},{"id":167213801476273,"name":"RYM Top — Rock — Surf Music","rank":177,"scaruffi":null}],"n_lists":2}},{"id":5858815348012,"type":"album","name":"¡Viva!","artist":"Los Straitjackets","year":1996,"weight":3,"yt":"7-1iHBeKXn4","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":161529817301205,"name":"RYM Top — Rock — Surf Rock","rank":95,"scaruffi":null}],"n_lists":1}},{"id":109808643521801,"type":"album","name":"The Velvet Touch of Los Straitjackets","artist":"Los Straitjackets","year":1999,"weight":3,"yt":"Pi8GysIoA7M","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":161529817301205,"