me":"Rencontre","artist":"Maurice Ravel /","year":2019,"weight":3,"yt":"gVnfN1iU6ZQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":40452930987258,"name":"RYM Top — Regional Music — Mélodie","rank":86,"scaruffi":null}],"n_lists":1}},{"id":230649036082056,"type":"album","name":"Ravel: Mélodies","artist":"Maurice Ravel /","year":null,"weight":3,"yt":"gVnfN1iU6ZQ","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":40452930987258,"name":"RYM Top — Regional Music — Mélodie","rank":94,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":116024095069917,"type":"genre","name":"Mélodie","n":14},{"id":111882320876960,"type":"genre","name":"Impressionism","n":9},{"id":169149679937772,"type":"genre","name":"Ballet","n":5},{"id":185542304754589,"type":"genre","name":"Fantasia","n":1},{"id":142450490062732,"type":"genre","name":"Spanish Classical Music","n":1},{"id":132423418324242,"type":"genre","name":"Waltz","n":1},{"id":130798487160546,"type":"genre","name":"Orchestral Song","n":1},{"id":109586473279154,"type":"genre","name":"Modern Classical","n":1},{"id":63437382022643,"type":"genre","name":"Opéra-comique","n":1},{"id":37478308348738,"type":"genre","name":"Concerto","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":260883469106620,"name":"La fusión: del clásico y el jazz a los jóvenes flamencos","book":"El flamenco contado con sencillez","author":"Carlos Arbelos","start":1958,"end":2002,"desc":"El flamenco nació de un crisol y lleva la fusión en su génesis, aunque la corriente ortodoxa la atribuya al comercio. Ravel, Glinka, Rimsky-Korsakov y Debussy, y en España Albéniz, Granados, Turina y Falla, metieron el son flamenco en la música clásica, y Camarón, Morente o Carmen Linares han cantado con orquesta. Desde el jazz, Miles Davis, Gil Evans y John Coltrane le añadieron sonidos flamencos a finales de los cincuenta. Y los propios flamencos ya mezclaban: Enrique el Mellizo hizo su malagueña con música gregoriana, el Chaqueta cantó por bulerías boleros de Antonio Machín en los cuarenta, la Niña de los Peines una zamba argentina, Carmen Amaya una cueca chilena, Caracol cambió la guitarra por el piano y, como Manuel Vallejo, orquestó cantes; Sabicas grabó a finales de los sesenta con un guitarrista de rock. Después vinieron Diego Carrasco (rap, blues y siguiriyas a compás), Peret, que hizo catalana la rumba acelerándola, Jorge Pardo con su saxo por bulerías o el Lebrijano con acordes andalusíes. En el baile, Joaquín Cortés, Antonio Canales o Sara Baras salen ya de academias que enseñan también clásico y jazz.","color":"#38bdf8","family":"Encuentro con otras músicas: nuevo flamenco y fusión","link":"https://volteret4.github.io/Flamenco/#fusion"},{"id":224034518296918,"name":"Impresionismo","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1890,"end":1925,"desc":"La primera vanguardia paralela al ocaso del romanticismo: texturas fugaces y transparentes que transforman el sonido en sustancia poética. Un antecedente del ambient que aspiraba a crear una impresión emocional.","color":"#8b7cf6","family":"Vanguardia y experimental","link":"https://volteret4.github.io/loops_timeline/#impresionismo"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":75713668482532,"type":"album","name":"La valse / Bridal Procession From \"The Golden Cockerel\"","list_id":16552880825634,"list":"RYM Top — Regional Music — Waltz","src":"musthear","rank":111,"year":1941,"note":null,"yt":"2X4JlDC_WOo","scaruffi":null},{"id":269603143027532,"type":"album","name":"Daphnis and Chloe","list_id":159176020779811,"list":"RYM Top — Classical Music — Ballet","src":"musthear","rank":33,"year":1955,"note":null,"yt":null,"scaruffi":null},{"id":198751021966459,"type":"album","name":"Sheherazade / Trois Poemes de Stephane Mallarme / Deux Melodies Hebraiques","list_id":40452930987258,"list":"RYM T