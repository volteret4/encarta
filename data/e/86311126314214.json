{"id":86311126314214,"type":"album","name":"Kaputt","artist":"Destroyer","year":2011,"weight":14,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/2009-kaputt_053314.jpg","aoty":85,"aoty_user":85,"sputnik":4.03,"yt":"qe4sbwI41-E","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/destroyer/kaputt","aoty":"https://www.albumoftheyear.org/album/2009-destroyer-kaputt.php","sputnikmusic":"https://www.sputnikmusic.com/album/67782/Destroyer-Kaputt/"},"desc":"Kaputt is the ninth album by Canadian indie rock band Destroyer. It was released on January 25, 2011 by Merge Records and Dead Oceans Records. The album was leaked towards the end of 2010. The vinyl edition of the album features bonus material on side three written largely by frequent Destroyer collaborator Ted Bois. This material is also included in the European CD version of the album credited as 'The Laziest River'. The album was named as a shortlisted (one of 10) nominee for the 2011 Polaris Music Prize award. Kaputt received widespread acclaim from music critics upon its release. ."},"artist_ref":{"id":98424617780138,"name":"The Destroyer","info":{"img":null}},"labels":[],"genres":[{"id":8412226417108,"type":"genre","name":"Indie Rock","artist":null,"year":null,"weight":1139,"yt":null,"src":"musthear"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"musthear"},{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"musthear"},{"id":204877716424121,"type":"genre","name":"Sophisti-Pop","artist":null,"year":null,"weight":223,"yt":null,"src":"musthear,rym"}],"lists":[{"id":212407470817145,"name":"RYM Top — Pop — Sophisti-Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":7,"year":null,"note":null,"total":200,"scaruffi":null},{"id":50254398381317,"name":"Pitchfork: The 200 Best Albums of the 2010s","src":"musthear","grp":"musicbrainz","list_year":null,"rank":2