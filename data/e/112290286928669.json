{"id":112290286928669,"type":"artist","name":"Bobby Hutcherson","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bh_070701.jpg?width=500","bio":"Robert \"Bobby\" Hutcherson (January 27, 1941 – August 15, 2016) was an American jazz vibraphone and marimba player. \"Little B's Poem\", from the album Components, is one of his best-known compositions.\nHutcherson influenced younger vibraphonists including Steve Nelson, Joe Locke, and Stefon Harris.\n\n\nBobby Hutcherson was born to Eli, a master mason, and Esther, a hairdresser. Hutcherson was exposed to jazz by his brother Teddy, who listened to Art Blakey records in the family home with his friend Dexter Gordon.","tags":["jazz","Vibraphone","Post-Bop","blue note","Hard Bop"]},"works":[{"id":139761625870597,"type":"album","name":"Dialogue","artist":"Bobby Hutcherson","year":1965,"weight":13,"yt":"c1hk9wNGbDQ","src":"books,musthear","from":{"books":[{"name":"Historia del jazz","title":"Historia del jazz (Ted Gioia)"}],"podcasts":[],"lists":[{"id":56169400631168,"name":"RYM Top — Jazz — Post-Bop","rank":70,"scaruffi":null},{"id":78015945725757,"name":"RYM Top — Jazz — Modal Jazz","rank":23,"scaruffi":null},{"id":271813569514477,"name":"RYM Top — Jazz — Avant-Garde Jazz","rank":73,"scaruffi":null}],"n_lists":3}},{"id":185542535739033,"type":"album","name":"Components","artist":"Bobby Hutcherson","year":1966,"weight":3,"yt":"znQmQGi9F1o","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":56169400631168,"name":"RYM Top — Jazz — Post-Bop","rank":117,"scaruffi":null}],"n_lists":1}},{"id":150702420494230,"type":"album","name":"Stick-Up!","artist":"Bobby Hutcherson","year":1968,"weight":5,"yt":"yNRLmPLvjyw","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":56169400631168,"name":"RYM Top — Jazz — Post-Bop","rank":83,"scaruffi":null},{"id":57714771365426,"name":"RYM Top — Jazz — Hard Bop","rank":57,"scaruffi":null}],"n_lists":2}},{"id":22610958634