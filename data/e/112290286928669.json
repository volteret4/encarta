90794434709999,"type":"genre","name":"Hard Bop","n":2},{"id":89886331015150,"type":"genre","name":"Jazz Fusion","n":2},{"id":51806065918814,"type":"genre","name":"Modal Jazz","n":2},{"id":206393460676093,"type":"genre","name":"Latin Jazz","n":1},{"id":196857370812297,"type":"genre","name":"Vocal Jazz","n":1},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","n":1},{"id":17868882409397,"type":"genre","name":"Spiritual Jazz","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":232473938305391,"name":"Hard bop: Clifford Brown, Max Roach, Art Blakey y Horace Silver","book":"Historia del jazz","author":"Ted Gioia","start":1954,"end":1975,"desc":"El bebop con las aristas redondeadas: más composición y arreglo, contrapunto en lugar de unísonos, tempos medios, temas en menor, blues y, pronto, gospel. El quinteto de Clifford Brown, trompetista de técnica clásica y vida limpia, y Max Roach («Joy Spring», «Daahoud») lo fija entre 1954 y 1956, hasta que Brown muere en la carretera. Art Blakey, con sus explosiones de batería, y Horace Silver dan con «The Preacher» (1955) la fórmula funky que imitarán todos; los Jazz Messengers, escuela de estrellas durante treinta años (Lee Morgan, Bobby Timmons y Benny Golson en Moanin'; luego Wayne Shorter, Freddie Hubbard y Cedar Walton), y el quinteto de Silver («Song for My Father», raíces caboverdianas, con Joe Henderson y Woody Shaw) dominan los sesenta. Roach se politiza junto al movimiento por los derechos civiles. El sello Blue Note demuestra que el estilo no está agotado y que puede tocar la vanguardia (Andrew Hill, Bobby Hutcherson, Jackie McLean).","color":"#a78bfa","family":"Hard bop, soul jazz y post-bop","link":"https://volteret4.github.io/jazz/#hard-bop"}],"book_tracks":[{"id":139761625870597,"artist":"Bobby Hutcherson","artist_id":112290286928669,"title":"Dialogue","year":1965,"ess":0,"yt":"fiD5VI6N5h4","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Hard bop: Clifford Brown, Max Roach, Art Blakey y Horace Silver","scene_id":232473938305391,"scene_link":"https://volteret4.github.io/jazz/#hard-bop","chapters":["Cap. 7: La fragmentación de los estilos de jazz"],"pages":[[1,355]]}],"mentions":[{"book":"Historia del jazz","author":"Ted Gioia","page":330,"text":"…no sólo los pianistas sintieron la atracción magnética de este artista singular: su influencia es evidente, por ejemplo, en el vibráfono de Bobby Hutcherson y Gary Burton, o de modo aún más evidente en los magistrales diseños guitarrísticos de Lenny Breau. La carrera de Coltrane tras su etapa con Miles…"},{"book":"Historia del jazz","author":"Ted Gioia","page":355,"text":"…que podía haber un punto de encuentro entre el hard bop y la vanguardia. Importantes proyectos como Point of Departure, de Andrew Hill, Dialogue, de Bobby Hutcherson, y Let Freedom Ring, de Jackie McLean,"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":139761625870597,"type":"album","name":"Dialogue","list_id":271813569514477,"list":"RYM Top — Jazz — Avant-Garde Jazz","src":"musthear","rank":73,"year":1965,"note":null,"yt":"c1hk9wNGbDQ","scaruffi":null},{"id":139761625870597,"type":"album","name":"Dialogue","list_id":78015945725757,"list":"RYM Top — Jazz — Modal Jazz","src":"musthear","rank":23,"year":1965,"note":null,"yt":"c1hk9wNGbDQ","scaruffi":null},{"id":139761625870597,"type":"album","name":"Dialogue","list_id":56169400631168,"list":"RYM Top — Jazz — Post-Bop","src":"musthear","rank":70,"year":1965,"note":null,"yt":"c1hk9wNGbDQ","scaruffi":null},{"id":185542535739033,"type":"album","name":"Components","list_id":56169400631168,"list":"RYM Top — Jazz — Post-Bop","src":"musthear","rank":117,"year":1966,"note":null,"yt":"znQmQGi9F1o","scaruffi":null},{"id":150702420494230,"type":"album","name":"Stick-Up!","list_id":57714771365426,"list":"RYM Top — Jazz — Hard Bop","src":"musthear","rank":57,"year":1968,"note":null,"yt":"yNRLmPLvjyw","sca