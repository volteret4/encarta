oks":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":253659843165461,"type":"song","name":"Me and Bobby McGee (original)","artist":"Roger Miller","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":50154868873855,"type":"genre","name":"Nashville Sound","n":2},{"id":42147038712068,"type":"genre","name":"Country Pop","n":2},{"id":214188970482661,"type":"genre","name":"Country Folk","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":250637715445508,"name":"Mission of Burma","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1979,"end":1983,"desc":"El equivalente norteamericano de Wire, salido del conservatorio y no de la escuela de arte: Roger Miller, Clint Conley y Peter Prescott hacen «música vanguardista para hacer pogo», un huracán a volumen ensordecedor que neutraliza los impulsos del rock, «secretamente una banda de rock progresivo». Martin Swope manipula en directo desde la mesa de mezclas lo que la banda toca. Del EP Signals, Calls and Marches («Academy Fight Song», «That's When I Reach for My Revolver») al álbum Vs. (1982), grabado casi en vivo; se separan en 1983 por los problemas auditivos de Miller y vuelven veinte años después.","color":"#c084fc","family":"Art punk y new wave americana","link":"https://volteret4.github.io/Postpunk/#mission-of-burma"},{"id":150113334913508,"name":"Neo-progresivo","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1977,"end":1997,"desc":"El impulso experimental de la new wave trae de vuelta el progresivo, con más acento jazz y nacido del ambiente no wave. En Nueva York, los Lounge Lizards de John Lurie («fake jazz»), Bill Laswell (Material, Massacre, Praxis, Axiom), los Golden Palominos de Anton Fier, Arto Lindsay y Ambitious Lovers, Scene Is Now, Dr Nerve, Mofungo, Ordinaires, Chuck Vrtacek. En Washington, Happy The Man y los Muffins, los mejores progresivos de su tiempo; en Boston, Birdsongs Of The Mesozoic; en el Oeste, Cartoon, PFS, Thinking Plague, U Totem, Adrian Belew, Michael Shrieve y Djam Karet. En Japón, After Dinner, YBO2, High Rise y Ruins; en Alemania, Caspar Brötzmann Massaker; en Inglaterra, Marillion y Ozric Tentacles; en Quebec, Jean Derome, René Lussier y Miriodor.","color":"#38bdf8","family":"Progresivo, krautrock y jazz-rock","link":"https://volteret4.github.io/scaruffi/#neo-prog"}],"book_tracks":[{"id":65907996568041,"artist":"Roger Miller","artist_id":175934047685945,"title":"No Man Is Hurting Me","year":1986,"ess":0,"yt":"IrGgcaYdUsY","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Neo-progresivo","scene_id":150113334913508,"scene_link":"https://volteret4.github.io/scaruffi/#neo-prog","chapters":["Sección 5.12"],"pages":[[1,163,null]]},{"id":154198657347308,"artist":"Roger Miller","artist_id":175934047685945,"title":"The Big Industry","year":1987,"ess":0,"yt":"t487aZAekl0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Neo-progresivo","scene_id":150113334913508,"scene_link":"https://volteret4.github.io/scaruffi/#neo-prog","chapters":["Sección 5.12"],"pages":[[1,163,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":143,"text":"…mixture of punk-rock, pop, heavy-metal and progressive-rock. The elastic power-pop of the EP Signals, Calls And Marches (1981), driven by guitarist Roger Miller's loud signatures, led to the versatile and erudite crossover of the album VS (1982), one of the most influential albums of punk-rock. Martin…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":162,"text":"…Mesozoic (11), who counted on the eclectic personalities of electronic keyboardist and composer Erik Lindgren, Mission Of Burma's ueber-guitarist Roger Miller (also on treated piano) and Mission Of Burma's tape manipulator Martin Swope. By fusing electronic avantgarde, classical music and jazz, the EP…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":163,"text":"…Faultline (1989), possibly his most classic and mature musical statement, a model of tight playing and sophisticated composition. The solo work of Roger Miller (1) was equally ambitious: No Man Is Hurting Me (1986) collected eccentric disco-pop gags a` la Brian Eno as well as post-modernist instrumental…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":89667689729845,"type":"song","name":"Chug-a-Lug","work_year":1964,"list_id":161507989025637,"list":"Billboard Year-End 1964","src":"singles","rank":62,"year":1964,"note":"","yt":"KsNWlM3fWmI","scaruffi":null},{"id":196932288169586,"type":"song","name":"Dang Me","work_year":1964,"list_id":161507989025637,"list":"Billboard Year-End 1964","src":"singles","rank":83,"year":1964,"note":"","yt":"Lg7DcCI39GY","scaruffi":null},{"id":89667689729845,"type":"song","name":"Chug-a-Lug","work_year":1964,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":62,"year":1964,"note":null,"yt":"KsNWlM3fWmI","scaruffi":null},{"id":196932288169586,"type":"song","name":"Dang Me","work_year":1964,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":83,"year":1964,"note":null,"yt":"Lg7DcCI39GY","scaruffi":null},{"id":203843114243505,"type":"album","name":"Dang Me (Roger and Out)","list_id":143831318859506,"list":"RYM Top — Country — Country Folk","src":"musthear","rank":70,"year":1964,"note":null,"yt":"pg9YGmmPX6w","scaruffi":null},{"id":203843114243505,"type":"album","name":"Dang Me (Roger and Out)","list_id":167105581234386,"list":"RYM Top —