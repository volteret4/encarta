Milagros Menjíbar y María Pagés; Manuela Vargas, «la dama del flamenco»; Tía Juana la del Pipa, que no fue profesional hasta los cuarenta; la Chunga, que bailaba descalza; y Manuela Carrasco, la más importante de su generación, completan el retrato, con las escuelas de Granada (Manolete, Mariquilla) y Córdoba (Concha Calero).","color":"#ec4899","family":"El baile","link":"https://volteret4.github.io/Flamenco/#ballet-flamenco"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":91291413908247,"type":"album","name":"De ley","list_id":211241930806974,"list":"RYM Top — Regional Music — Flamenco Pop","src":"musthear","rank":51,"year":1992,"note":null,"yt":"tn4yvIB0ZCQ","scaruffi":null},{"id":268872423207116,"type":"song","name":"De ley","work_year":1993,"list_id":182185249222410,"list":"Los 40 nº1 · 1993","src":"singles","rank":20,"year":1993,"note":"","yt":"tn4yvIB0ZCQ","scaruffi":null},{"id":275294109658600,"type":"song","name":"Estoy aquí","work_year":1994,"list_id":160928330632751,"list":"Los 40 nº1 · 1994","src":"singles","rank":53,"year":1994,"note":"","yt":"000H0Jav41Q","scaruffi":null},{"id":221869354471528,"type":"song","name":"Qué bonito","work_year":1996,"list_id":181489207415884,"list":"Los 40 nº1 · 1996","src":"singles","rank":50,"year":1996,"note":"","yt":"F1lf6kJzQWM","scaruffi":null},{"id":266589220981918,"type":"song","name":"A tu lado","work_year":1997,"list_id":75028305851756,"list":"Los 40 nº1 · 1997","src":"singles","rank":16,"year":1997,"note":"","yt":"ZWDJMxCbjE8","scaruffi":null},{"id":83126127990661,"type":"song","name":"Cómo quieres que te quiera","work_year":2001,"list_id":35106172424535,"list":"Los 40 nº1 · 2001","src":"singles","rank":43,"year":2001,"note":"","yt":"2gTN1vouWsg","scaruffi":null},{"id":18120016334158,"type":"album","name":"Muchas flores","list_id":211241930806974,"list":"RYM Top — Regional Music — Flamenco Pop","src":"musthear","rank":105,"year":2001,"note":null,"yt":"bvlObKFeW7g","