{"id":590008807955,"type":"album","name":"Phantasmagoria of Jathilan","artist":"Raja Kirik","year":2023,"weight":25,"info":{"cover":"https://dn721606.ca.archive.org/0/items/mbid-26a6f1a6-7759-4cdd-9e56-e5462e62ca0f/mbid-26a6f1a6-7759-4cdd-9e56-e5462e62ca0f-36229467622.jpg","scaruffi":7.0,"yt":"Z4LyjRb8o8w","links":{"spotify":"https://open.spotify.com/album/0YnkfT64x4YlSYpFiUMHjp","bandcamp":"https://yesnowave.bandcamp.com/album/phantasmagoria-of-jathilan","rateyourmusic":"https://rateyourmusic.com/release/album/raja-kirik/phantasmagoria-of-jathilan"},"desc":"“The Phantasmagoria of Jahtilan” is a music performance by Raja Kirik in collaboration with singer Silir Wangi and performer Ari Dwianto. This project investigate the Jathilan horse dance, a folk trance dance popular in Java, Indonesia, as a way of regaining strength despite defeat. Jathilan is an acronym of “Jarane jan tjil-thilan”, which translates to a horse that dances irregularly. The current form of Jathilan developed after the Java War (fought between Javanese rebels and the colonial Dutch empire from 1825 to1830) as a folk practise to grapple with the defeat by the Dutch Empire and the devastation caused by ."},"artist_ref":{"id":166522654054557,"name":"Raja Kirik","info":{"img":null}},"labels":[],"genres":[{"id":15318882910861,"type":"genre","name":"Post-Industrial","artist":null,"year":null,"weight":224,"yt":null,"src":"musthear,rym"},{"id":38712593104069,"type":"genre","name":"kuda lumping","artist":null,"year":null,"weight":2,"yt":null,"src":"musthear"},{"id":260972353689469,"type":"genre","name":"Southeast Asian Folk Music","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"},{"id":215897238681875,"type":"genre","name":"Southeast Asian Music","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"},{"id":146232232837668,"type":"genre","name":"Traditional Folk Music","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"},{"id":139538769946482,"type":"genre","name":"Austronesian M