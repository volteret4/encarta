{"id":181866637469144,"type":"artist","name":"Beat Happening","artist":null,"year":null,"weight":12,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Beat_Happening_%281988_Rough_Trade_publicity_photo%29.jpg?width=500","bio":"Banda formada a mediados de los 80 por Calvin Johnson, Heather Lewis y Bret Lunsford, fueron los principales exponentes de la escena underground de Olympia, WA., cuyo sonido era una mezcla de rock, pop y post-punk. Su música básica y sencilla fue una gran influencia para artistas posteriores tan importantes como Nirvana, Beck, Teenage Fanclub o Bikini Kill. Calvin Johnson es además responsable del sello independiente K Records.","tags":["Lo-Fi","indie pop","twee","indie","indie rock"]},"works":[{"id":119793583247012,"type":"album","name":"Beat Happening","artist":"Beat Happening","year":1985,"weight":22,"yt":"CiWs2VfqPAE","src":"books,charts,ensayos,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[{"name":"The Ongoing History of New Music","n":2}],"lists":[{"id":10053931114450,"name":"Pitchfork: The 200 Best Albums of the 1980s","rank":122,"scaruffi":null},{"id":239568229474880,"name":"The Definitive /mu/ Essentials","rank":37,"scaruffi":null},{"id":251973115798518,"name":"RYM Top — Rock — Twee Pop","rank":118,"scaruffi":null}],"n_lists":3}},{"id":271738707977837,"type":"album","name":"Jamboree","artist":"Beat Happening","year":1988,"weight":11,"yt":"Eaw-zW7RVus","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":198686658475555,"name":"RYM Top — Rock — Cuddlecore","rank":24,"scaruffi":null},{"id":251973115798518,"name":"RYM Top — Rock — Twee Pop","rank":134,"scaruffi":null}],"n_lists":2}},{"id":130766317734910,"type":"album","name":"Black Candy","artist":"Beat Happening","year":1989,"weight":5,"yt":"WauaOcNpjAQ","src":"musthear","from":{"books":[],"podcasts"