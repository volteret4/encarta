{"id":35634437779641,"type":"album","name":"Powerslave","artist":"Iron Maiden","year":1984,"weight":16,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/12159-powerslave_045556.jpg","aoty":80,"aoty_user":86,"yt":"5cpxvDKHtQI","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/iron-maiden/powerslave/","aoty":"https://www.albumoftheyear.org/album/12159-iron-maiden-powerslave.php"},"desc":"Powerslave is the fifth studio album by the British heavy metal band Iron Maiden, released on September 3, 1984 on EMI in Europe and its sister label Capitol Records in the US (it was re-released by Sanctuary/Columbia Records in the US in 2002). It is notable for its Egyptian theme displayed in the album art, as well in the title track's musical style. It contains a musical re-telling of Samuel Taylor Coleridge's \"Rime of the Ancient Mariner\", which uses pieces of the original poem as lyrics, and was, for a long time, the longest Iron Maiden song at a length ."},"artist_ref":{"id":263620615661846,"name":"Iron Maiden","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Iron_Maiden_Irvine_2008.jpg?width=500"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"rym"},{"id":174164112458259,"type":"genre","name":"Heavy Metal","artist":null,"year":null,"weight":782,"yt":null,"src":"rym"}],"lists":[{"id":263887018784608,"name":"RYM Top — Rock — Heavy Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":175315787363075,"name":"RYM Top — Rock — Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":18,"year":null,"note":null,"total":200,"scaruffi":null},{"id":215424088090262,"name":"AOTY Must Hear 1980s","src":"charts","grp":"AOTY","list_year":null,"rank":102,"year":1984,"note":null,"total":196,"scaruffi":null},{"id":257781828529342,"name":"RYM Top — Rock","src":"musthear","grp":"