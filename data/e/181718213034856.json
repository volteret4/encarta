genre","name":"Acid Rock","n":8},{"id":274490571464652,"type":"genre","name":"Noise Rock","n":3},{"id":15604072550254,"type":"genre","name":"Garage Psych","n":3},{"id":236667806013249,"type":"genre","name":"Heavy Psych","n":2},{"id":147423806094006,"type":"genre","name":"Psychedelic Rock","n":2},{"id":207419651019004,"type":"genre","name":"Garage Rock","n":1},{"id":190589917177789,"type":"genre","name":"Jam Band","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":146081465116372,"name":"Space-rock y psicodelia extrema de los noventa","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1991,"end":2002,"desc":"Fundiendo los estilos psicodélicos que preferían la jam libre (acid-rock, space-rock, raga-rock), muchos grupos esculpen empresas sonoras épicas: Fuzzhead, Crawlspace, Pressurehed, Farflung, Fuxa, Gravitar (el Metal Machine Music de Lou Reed con ritmo), Pelt, Primordial Undermind, Escapade y, por encima de todos, Bardo Pond (Bufo Alvarius, Amanita) y Hash Jar Tempo. Texas recupera la supremacía de la locura psicodélica (Ed Hall, Cherubs, ST 37, Mike Gunn, Charalambides, Linus Pauling Quartet, la Vas Deferens Organization de Dallas); San Francisco, la psicodelia ruidosa de Mason Jones (Trance, Subarachnoid Space). En Nueva Zelanda, Roy Montgomery (Dadamah, Dissolve), Dean Roberts, Flies Inside The Sun; en Japón, Kousokuya, Mainliner, Musica Transonic, Acid Mothers Temple, Ghost.","color":"#c084fc","family":"Psicodelia, garage y shoegaze","link":"https://volteret4.github.io/scaruffi/#space-rock-90s"}],"book_tracks":[{"id":220156512276825,"artist":"Mainliner","artist_id":181718213034856,"title":"Mellow Out","year":1996,"ess":0,"yt":"7kvN3z-uq5c","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Space-rock y psicodelia extrema de los noventa","scene_id":146081465116372,"scene_link":"https://volteret4.github.io/scaruffi/#sp