{"id":12429019494452,"type":"album","name":"Diamond Life","artist":"Sade","year":1984,"weight":24,"info":{"cover":"https://dn720701.ca.archive.org/0/items/mbid-98063a3f-563e-3b9e-be19-af33da0fef52/mbid-98063a3f-563e-3b9e-be19-af33da0fef52-8211603614.jpg","kind":"Album","tracks":9,"country":"ES","aoty":92,"aoty_user":88,"yt":"OPgmQc3OkFs","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/sade/diamond-life","aoty":"https://www.albumoftheyear.org/album/20106-sade-diamond-life.php"},"desc":"Diamond Life is the debut studio album by English band Sade, released in the United Kingdom on July 16, 1984 by Epic Records, and in the United States on February 27, 1985 by Portrait Records. After studying fashion design, and later modelling, Sade Adu began backup-singing with British band Pride. During this time Adu and three of the original members of \"Pride\"—Paul Anthony Cook, Paul Denman and Stuart Matthewman—left the group to form their own band called Sade. After various demos and performances, Sade received interest from record labels and signed to Epic. Recording for the album began in 1983 ."},"artist_ref":{"id":162183050500202,"name":"Sade","info":{"img":null}},"labels":[],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"musthear,rym"},{"id":242048506390872,"type":"genre","name":"Pop Soul","artist":null,"year":null,"weight":250,"yt":null,"src":"musthear"},{"id":204877716424121,"type":"genre","name":"Sophisti-Pop","artist":null,"year":null,"weight":223,"yt":null,"src":"musthear,rym"},{"id":50337978407967,"type":"genre","name":"Smooth Soul","artist":null,"year":null,"weight":217,"yt":null,"src":"musthear,rym"},{"id":134617208481587,"type":"genre","name":"quiet storm","artist":null,"year":null,"weight":6,"yt":null,"src":"musthear"}],"lists":[{"id":126751190489920,"name":"RYM