{"id":16759689311911,"type":"artist","name":"Nanci Griffith","artist":null,"year":null,"weight":14,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Nanci_Griffith_at_BBC_Radio_2_Folk_Awards_2010.jpg?width=500","bio":"Nanci Caroline Griffith es una cantante, guitarrista y compositora norteamericana nacida el 6 de julio de 1953, en Seguin, Texas.\n\nNanci Griffith ha abordado, en su carrera, varios géneros musicales, predominantemente country, folk, y lo que ella llama “folkabilly”. Ganó un premio Grammy al mejor álbum de folk contemporáneo en 1994,  por su disco “Other Voices, Other Rooms”, en el que versionó las canciones de los artistas que tuvieron en ella una mayor influencia musical.","tags":["country","folk","female vocalists","singer-songwriter","americana"]},"works":[{"id":139518956786167,"type":"album","name":"There's a Light Beyond These Woods","artist":"Nanci Griffith","year":1978,"weight":9,"yt":"LGcAWd-Xtt4","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":143831318859506,"name":"RYM Top — Country — Country Folk","rank":154,"scaruffi":null}],"n_lists":1}},{"id":186172481160271,"type":"album","name":"Poet in My Window","artist":"Nanci Griffith","year":1982,"weight":13,"yt":"oJb66Do6qpM","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":588,"scaruffi":7.0},{"id":143831318859506,"name":"RYM Top — Country — Country Folk","rank":149,"scaruffi":7.0}],"n_lists":2}},{"id":60469406540899,"type":"album","name":"Once in a Very Blue Moon","artist":"Nanci Griffith","year":1984,"weight":3,"yt":"CUh7F66i6lc","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":187857422127234,"name":"RYM Top — Country — Contemporary Country","rank":21,"scaruffi":null}],"n_lists":1}},{"id":114198949170642,