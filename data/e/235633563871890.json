ar":null,"weight":536,"yt":null,"src":"ensayos"}],"album_genres":[{"id":135494496540693,"type":"genre","name":"Indie Pop","n":4},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":3},{"id":114850286715687,"type":"genre","name":"Acoustic Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Father's Diverse Ventures and Tragic Death","body":"Hugh Everett III successfully applied mathematics, specifically Lagrange multipliers, to become a millionaire. He then used some of his wealth to establish a company focused on studying the parallels between human speech and machine speech. Sadly, he died of a heart attack in 1982, and his son Mark was the one who found him. \"Later, Mr. Everett applied mathematics to making money.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Eggheads and Geeks","url":"https://www.youtube.com/watch?v=QfiRRtsZoYU"}]},{"kind":"podcast","title":"Key 90s American Alternative Band","body":"Eels is identified as one of the preeminent American alternative bands from the 1990s. Their singer, Mark Oliver Everett, is noted for his remarkable versatility. \"es una de las bandas alternativas americanas de los 90 más importantes.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Lanzamientos ABRIL 2018","url":"https://www.youtube.com/watch?v=3_SAz8OxeIA"}]},{"kind":"podcast","title":"Quest to Understand Father's Theories","body":"Following his father's death, Mark Oliver Everett embarked on a deeply personal quest to understand his father's complex scientific theories, a journey that has been documented in a PBS special. \"And Mark has since been on a quest to understand his father's theories.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Eggheads and Geeks","url":"https://www.youtube.com/watch?v=QfiRRtsZoYU"}]},{"kind":"podcast","title":"Son of a Renowned Physicist","body":"Mark Oliver Everett, known as E from The Eels, is the son of Hugh Everett III, a physicist famous for developing the Many Worlds Theory. His father's theories, initially met with skepticism, are now highly regarded for their ability to resolve paradoxes in quantum theory and have significantly influenced science fiction literature. \"His father was Hugh Everett III.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Eggheads and Geeks","url":"https://www.youtube.com/watch?v=QfiRRtsZoYU"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":41675750496620,"type":"album","name":"Beautiful Freak","work_year":1996,"list_id":192934750972716,"list":"1001 Albums You Must Hear Before You Die","src":"charts","rank":816,"year":1996,"note":null,"yt":"OP9v0UIeBec","scaruffi":null},{"id":41675750496620,"type":"album","name":"Beautiful Freak","work_year":1996,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":207,"year":1996,"note":null,"yt":"OP9v0UIeBec","scaruffi":null},{"id":41675750496620,"type":"album","name":"Beautiful Freak","list_id":187561999930396,"list":"Sputnikmusic Best Albums 1996","src":"musthear","rank":197,"year":1996,"note":null,"yt":"OP9v0UIeBec","scaruffi":null},{"id":167224087293443,"type":"song","name":"Novocaine for the Soul","work_year":1996,"list_id":248716836618435,"list":"Triple J Hottest 100 · 1996","src":"singles","rank":39,"year":1996,"note":"United States","yt":"V2yy141q8HQ","scaruffi":null},{"id":249499309151743,"type":"song","name":"Susan's House","work_year":1996,"list_id":248716836618435,"list":"Triple J Hottest 100 · 1996","src":"singles","rank":56,"year":1996,"note":"United States","yt":"lC3MH-U6yDk","scaruffi":null},{"id":28450475050026,"type":"album","name":"Electro-Shock Blues","list_id":82075953765266,"list":"RYM Top — Pop — Indie Pop","src":"musthear","rank":104,"year":1998,"note":null,"yt":"7Pvn7Aj9kpA","scaruffi":8.0},{"id":28450475050026,"