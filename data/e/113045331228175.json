{"id":113045331228175,"type":"album","name":"California","artist":"Mr. Bungle","year":1999,"weight":13,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/6000-california.jpg","aoty":71,"aoty_user":86,"sputnik":4.37,"yt":"ITEDFYdLHFA","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/mr-bungle/california-1/","aoty":"https://www.albumoftheyear.org/album/6000-mr-bungle-california.php","sputnikmusic":"https://www.sputnikmusic.com/album/1859/Mr.-Bungle-California/"},"desc":"California is the third album by the innovative experimental rock band Mr Bungle, released on the 13th July 1999. The styles that are present in this album include surf, thrash metal, doo-wop, rockabilly, circus, kecak, balladry and eastern music amongst many others, which is typical of Mr Bungle's genre-hopping madness. Many people are of the opinion that it is by far the band's most accessible, and 'normal' album. Rolling Stone has put this in various \"essential albums\" lists. It was supposed to be released on June 8, 1999; but Warner Bros. chose instead to release the similarly-titled Californication by the ."},"artist_ref":{"id":228304466027047,"name":"Mr Bungle","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/MrBungle99.JPG?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"musthear"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"rym"},{"id":55893123468232,"type":"genre","name":"Experimental Rock","artist":null,"year":null,"weight":373,"yt":null,"src":"rym"}],"lists":[{"id":173793889343323,"name":"Sputnikmusic Best Albums 1999","src":"musthear","grp":"sputnikmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":22478217896300,"name":"RYM Top