{"id":82221622153659,"type":"album","name":"Juju","artist":"Siouxsie and the Banshees","year":1981,"weight":25,"info":{"cover":"https://dn711000.ca.archive.org/0/items/mbid-3d8e6ee7-b4f9-4dc6-bb7a-2ea5e53d5d01/mbid-3d8e6ee7-b4f9-4dc6-bb7a-2ea5e53d5d01-7976593755.jpg","kind":"Album","tracks":9,"country":"US","aoty":84,"aoty_user":85,"yt":"n_bXdEA6nSM","links":{"aoty":"https://www.albumoftheyear.org/album/11981-siouxsie-and-the-banshees-juju.php"},"desc":"Juju is the fourth album by the British post-punk band Siouxsie & the Banshees. After a slightly electronic bent made on a few tracks of their last album, the Banshees returned to a more guitar-based sound for Juju, due to the now-official new Banshees guitarist, John McGeoch. Released by Polydor Records in 1981, this album also featured prominently, for the first time, the intricate percussion work of band member Budgie. Juju was remastered as a single-disc digipack in May 2006. ."},"artist_ref":{"id":237877931033244,"name":"Siouxsie and the Banshees","info":{"img":"https://cdn-images.dzcdn.net/images/artist/a29dd067cff228423b02ff6bc10c10c4/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":220327530487024,"type":"genre","name":"New Wave","artist":null,"year":null,"weight":1514,"yt":null,"src":"musthear"},{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"musthear,rym"},{"id":93579530230421,"type":"genre","name":"Gothic Rock","artist":null,"year":null,"weight":272,"yt":null,"src":"musthear,rym"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"}],"lists":[{"id":242669898096444,"name":"RYM Top — Rock — Gothic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":182218712006755,"name":"RYM Top — Rock — Post-Punk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":14,"year":null,"note":null,"total":200,