","name":"British Blues","n":10},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":6},{"id":133646791193319,"type":"genre","name":"Laurel Canyon Scene","n":6},{"id":61825535078474,"type":"genre","name":"Electric Blues","n":4},{"id":202159817309393,"type":"genre","name":"blues","n":2},{"id":23813778789982,"type":"genre","name":"Chicago Blues","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":93517293193665,"name":"Blues revival y blues-rock","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1966,"end":1972,"desc":"John Mayall define con Bluesbreakers (con Eric Clapton) el rhythm'n'blues tocado por blancos europeos, el blues-rock, y siembra el progresivo con sus discos de jazz y lounge. Su equivalente americano es Al Kooper (Blues Project, Supersession, Blood Sweat & Tears). Cream, el primer power-trio, cambia la cara del rock británico con improvisación de jazz, distorsión y solos interminables; Fleetwood Mac de Peter Green y Ten Years After llevan del blues al hard rock. En San Francisco, Janis Joplin, Steve Miller y Santana; en Los Ángeles, Taj Mahal y Ry Cooder reconstruyen las tradiciones; Bob Seger casa el grito soul con el Detroit obrero.","color":"#f87171","family":"Hard rock, metal y grunge","link":"https://volteret4.github.io/scaruffi/#blues-rock"}],"book_tracks":[{"id":42093709678054,"artist":"John Mayall","artist_id":83795188348890,"title":"Bluesbreakers","year":1966,"ess":0,"yt":"5JhzQJqlTyc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Blues revival y blues-rock","scene_id":93517293193665,"scene_link":"https://volteret4.github.io/scaruffi/#blues-rock","chapters":["Sección 3.2"],"pages":[[1,45,null]]},{"id":19054484002332,"artist":"John Mayall","artist_id":83795188348890,"title":"Hard Road","year":1967,"ess":1,"yt":"__49ktNgRI0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2