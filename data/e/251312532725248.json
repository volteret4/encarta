{"id":251312532725248,"type":"album","name":"Bug","artist":"Dinosaur Jr.","year":1988,"weight":25,"info":{"cover":"https://dn710703.ca.archive.org/0/items/mbid-211993a5-fbcc-4cac-a598-934f39f56f28/mbid-211993a5-fbcc-4cac-a598-934f39f56f28-3323362465.jpg","kind":"Album","tracks":9,"country":"GB","aoty":73,"aoty_user":80,"yt":"z45yWIXipy8","links":{"aoty":"https://www.albumoftheyear.org/album/380-dinosaur-jr-bug.php"},"desc":"\"Bug\" is the third studio album by American alternative rock band Dinosaur Jr., released in October 1988 through SST Records. Blast First and Au Go Go Records released the album in the United Kingdom and Australia, respectively. It was the last Dinosaur Jr. album with original bassist Lou Barlow until Beyond in 2007. \"Bug\" is included in the book 1001 Albums You Must Hear Before You Die. Beats Per Minute ranked it the 41st best album of the 1980s. Despite it being a favorite of many Dinosaur Jr. fans, J Mascis has said it is his least favorite Dinosaur Jr. ."},"artist_ref":{"id":164290311837445,"name":"Dinosaur Jr","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Dinosaur_Jr._at_WTAI_in_Stockholm.jpg?width=500"}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":32992220995517,"type":"genre","name":"Grunge","artist":null,"year":null,"weight":1361,"yt":null,"src":"musthear"},{"id":8412226417108,"type":"genre","name":"Indie Rock","artist":null,"year":null,"weight":1139,"yt":null,"src":"musthear,rym"},{"id":274490571464652,"type":"genre","name":"Noise Rock","artist":null,"year":null,"weight":360,"yt":null,"src":"musthear,rym"},{"id":7260641021881,"type":"genre","name":"Noise Pop","artist":null,"year":null,"weight":241,"yt":null,"src":"musthear"},{"id":32298008141495,"type":"genre","name":"Slacker Rock","artist":null,"year":null,"weight":214,"yt":null,"src":"rym"}],"lists":[{"id":215424088090262,"name":"AOTY Must Hear 198