t":null,"src":"ensayos"}],"album_genres":[{"id":170312130231429,"type":"genre","name":"Dolewave","n":3},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":1},{"id":32298008141495,"type":"genre","name":"Slacker Rock","n":1},{"id":30277598324326,"type":"genre","name":"pop","n":1},{"id":15906669628272,"type":"genre","name":"Jangle Pop","n":1},{"id":8412226417108,"type":"genre","name":"Indie Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Deadpan Singing Style","body":"Courtney Barnett is recognized for her deadpan singing style, which can sometimes lead listeners to overlook the depth and unusual nature of her lyrical content. \"Her singing style is pretty deadpan, and you may not pay attention to what she's actually saying.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Queens of Quirk","url":"https://www.youtube.com/watch?v=clPuV7ezrIc"}]},{"kind":"podcast","title":"Deadpan Singing Style","body":"Courtney Barnett, a singer-songwriter from Melbourne, is known for her deadpan singing style. This delivery can often mask the deeper, weirder, and more complex lyrical content she presents, requiring careful listening to fully appreciate her artistry. \"Her singing style is pretty deadpan, and you may not pay attention to what she's actually saying.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Queens of Quirk","url":"https://www.youtube.com/watch?v=rEawe_1Fqf0"}]},{"kind":"podcast","title":"Melbourne Singer-Songwriter","body":"Courtney Barnett is a singer-songwriter hailing from Melbourne. She is described as being \"a lot weirder than you might first think.\" \"This is a singer-songwriter from Melbourne, who is a lot weirder than you might first think.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Queens of Quirk","url":"https://www.youtube.com/watch?v=clPuV7ezrIc"}]},{"kind":"podcast","title":"Unexpected Lyrical Themes","body":"Courtney Barnett often embeds dark or bizarre narratives within seemingly cheerful songs. A prime example is \"Avant Gardener,\" which, despite its happy melody, describes someone experiencing anaphylactic shock due to a gardening accident. \"But if you listen to the words, you'll realize that it's about someone going into anaphylactic shock as the result of a bizarre gardening accident.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Queens of Quirk","url":"https://www.youtube.com/watch?v=clPuV7ezrIc"}]}],"awards":[{"kind":"award","title":"ARIA Award for Best Cover Art (2015)","body":"Won.","year":2015,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17986186"}]},{"kind":"award","title":"ARIA Award for Best Female Artist (2015)","body":"Won.","year":2015,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4653728"}]},{"kind":"award","title":"ARIA Award for Best Independent Release (2015)","body":"Won.","year":2015,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q18349452"}]},{"kind":"award","title":"ARIA Award for Breakthrough Artist - Release (2015)","body":"Won.","year":2015,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985702"}]},{"kind":"award","title":"BRIT Award for International Female Solo Artist (2016)","body":"Nominated.","year":2016,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q16985325"}]},{"kind":"award","title":"Grammy Award for Best New Artist (2016)","body":"Nominated.","year":2016,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1453643"}]},{"kind":"award","title":