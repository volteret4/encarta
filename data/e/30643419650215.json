{"id":30643419650215,"type":"album","name":"Little Dark Age","artist":"MGMT","year":2018,"weight":21,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/79228-little-dark-age_010957.jpg","aoty":76,"aoty_user":81,"yt":"rtL5oMyBHPs","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/mgmt/little-dark-age/","aoty":"https://www.albumoftheyear.org/album/79228-mgmt-little-dark-age.php"},"desc":"Little Dark Age (abbreviated as LDA) is the fourth studio album by the American rock band MGMT, released on February 9, 2018, through Columbia Records. It was the band's first album of new material in over four years, after the release of their eponymous third studio album in September 2013. It's often known for being yellow. After the band concluded touring at the end of 2014, members Andrew VanWyngarden and Benjamin Goldwasser took time off for most of 2015 before regrouping at the end of the year. The album was produced by the band with Patrick Wimberly and longtime collaborator ."},"artist_ref":{"id":203859552716529,"name":"MGMT","info":{"img":null}},"labels":[],"genres":[{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","artist":null,"year":null,"weight":266,"yt":null,"src":"rym"},{"id":57638771788875,"type":"genre","name":"Synthpop","artist":null,"year":null,"weight":260,"yt":null,"src":"rym"},{"id":141164231500862,"type":"genre","name":"Psychedelic Pop","artist":null,"year":null,"weight":245,"yt":null,"src":"rym"}],"lists":[{"id":191649555608693,"name":"RYM Top — Electronic — Synthpop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":21,"year":null,"note":null,"total":200,"scaruffi":null},{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":22,"year":null,"note":null,"total":200,"scaruffi":null},{"id":114554236241704,"name":"RYM Top — Psychedelia — Neo-Psychedelia","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":44,"year":null,"note"