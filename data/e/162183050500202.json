ruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":50337978407967,"type":"genre","name":"Smooth Soul","n":9},{"id":204877716424121,"type":"genre","name":"Sophisti-Pop","n":7},{"id":30122583811636,"type":"genre","name":"Soul","n":7},{"id":242048506390872,"type":"genre","name":"Pop Soul","n":3},{"id":265524373450282,"type":"genre","name":"jazz","n":2},{"id":176578125596945,"type":"genre","name":"Contemporary R&B","n":2},{"id":266148395847073,"type":"genre","name":"Synth Punk","n":1},{"id":242270330474188,"type":"genre","name":"Country Soul","n":1},{"id":239592851871117,"type":"genre","name":"Downtempo","n":1},{"id":219217594239320,"type":"genre","name":"Folk Metal","n":1},{"id":212257394657788,"type":"genre","name":"Gipsy Punk","n":1},{"id":207755761847598,"type":"genre","name":"Hardcore","n":1},{"id":200651337068219,"type":"genre","name":"Canzone d'autore","n":1},{"id":191043281221162,"type":"genre","name":"Brutal Prog","n":1},{"id":181296768148316,"type":"genre","name":"Digital Hardcore","n":1}],"labels":[],"album_labels":[{"id":247797822763988,"type":"label","name":"Epic","n":1}],"own_scenes":[],"scenes":[{"id":266579790140761,"name":"Naked funk: la era Reagan","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1980,"end":1990,"desc":"La era del naked funk abarca las cimas de Prince, Michael Jackson y los dos mandatos de Reagan: recortes, desindustrialización, millones de sin techo, la «guerra contra las drogas» en lugar de contra la pobreza y, desde 1982, el crack. La música negra se volvió narcisista y escapista, del «yo primero»; las bandas, demasiado caras para la ciudad. La industria ofrecía estereotipos (banda pop, crooner, banda funk guarra, según Jon Pareles), MTV no ponía vídeos negros hasta Thriller y Jackson y Prince marcaron las cuotas del crossover. En 1975 trece números 1 R&B eran funk; en 1985 diecisiete de veinte eran baladas. Warner echó a Clinton y CBS sepultó «Pumpin’ It Up»; murieron o se convirtieron Hathaway, Joe Tex, Marvin Gaye, Al Green, Larry Graham. Las máquinas sustituyeron vientos, órgano (el Yamaha DX7), batería y bajo: solo sobrevivió la guitarra rítmica sobre el bajo sintetizado y la palmada electrónica. La insinuación dejó paso al sexo explícito sin cerebro («Do Me Baby», «Beep a Freak»), y llegaron el bass de Miami (2 Live Crew), Egyptian Lover, el New Jack Swing de Teddy Riley y la farsa de Milli Vanilli. Los funkers de verdad abandonaron la radio: el underground (hip hop, go-go) llevó el funk adelante.","color":"#22d3ee","family":"Funk de los ochenta: Prince, Rick James, electro","link":"https://volteret4.github.io/Funk/#naked-funk"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":12429019494452,"type":"album","name":"Diamond Life","work_year":1984,"list_id":192934750972716,"list":"1001 Albums You Must Hear Before You Die","src":"charts","rank":532,"year":1984,"note":null,"yt":"OPgmQc3OkFs","scaruffi":null},{"id":12429019494452,"type":"album","name":"Diamond Life","work_year":1984,"list_id":215424088090262,"list":"AOTY Must Hear 1980s","src":"charts","rank":107,"year":1984,"note":null,"yt":"OPgmQc3OkFs","scaruffi":null},{"id":12429019494452,"type":"album","name":"Diamond Life","work_year":1984,"list_id":10053931114450,"list":"Pitchfork: The 200 Best Albums of the 1980s","src":"charts","rank":10,"year":1984,"note":null,"yt":"OPgmQc3OkFs","scaruffi":null},{"id":12429019494452,"type":"album","name":"Diamond Life","list_id":66678364571761,"list":"RYM Top — Pop","src":"musthear","rank":70,"year":1984,"note":null,"yt":"OPgmQc3OkFs","scaruffi":null},{"id":12429019494452,"type":"album","name":"Diamond Life","list_id":212407470817145,"list":"RYM Top — Pop — Sophisti-Pop","src":"musthear","rank":4,"year":1984,"note":null,"yt":"OPgmQc3OkFs","scaruffi":null},{"id":12429019494452,"type":"album","name":"Diamond Life","list_id":85048702844562,"list":"RYM Top — R&B","src":