,{"id":172418489038495,"type":"album","name":"Make It Easy on Yourself","artist":"Burt Bacharach","year":1969,"weight":2,"yt":"3MI-BTsGWpE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":66701177312920,"name":"RYM Top — Easy Listening","rank":33,"scaruffi":null}],"n_lists":1}},{"id":246868058062396,"type":"song","name":"(They Long to Be) Close to You","artist":"Burt Bacharach","year":1970,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"For the Record - The 70s","n":1}],"lists":[],"n_lists":0}},{"id":28988976107942,"type":"album","name":"Burt Bacharach","artist":"Burt Bacharach","year":1971,"weight":4,"yt":"C5uS-A1rfgg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":35507544569942,"name":"RYM Top — Pop — Baroque Pop","rank":156,"scaruffi":null},{"id":66701177312920,"name":"RYM Top — Easy Listening","rank":73,"scaruffi":null}],"n_lists":2}},{"id":221825731580609,"type":"album","name":"Living Together","artist":"Burt Bacharach","year":1973,"weight":4,"yt":"C5uS-A1rfgg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":35507544569942,"name":"RYM Top — Pop — Baroque Pop","rank":137,"scaruffi":null},{"id":66701177312920,"name":"RYM Top — Easy Listening","rank":48,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[{"id":14633344246502,"type":"artist","name":"Hal David (songwriting partner)","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":258906480523511,"type":"genre","name":"Baroque Pop","n":4},{"id":247802226836647,"type":"genre","name":"Brill Building","n":1},{"id":169140360411371,"type":"genre","name":"Lounge","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":153468859939986,"name":"Las cantantes de 1966","book":"1966: The Year the Decade Exploded","author":"Jon Savage","start":1961,"end":1967,"desc":"La primavera de 1966 trajo discos que respiraban apertura, y algunos de los más imaginativos los cantaban mujeres. «Walkin’ My Cat Named Dog» de Norma Tanega (febrero de 1966), producido por Herb Bernstein para Bob Crewe, mezclaba folk y bajo Motown, filosofía y ritmo go-go: una mujer que pasea sola y sin miedo por Nueva York, tan moderna y alusiva como Dylan. Tanega, pintora licenciada y camarera de campamento en los Catskills, se vio de pronto en una gira de seis semanas como única mujer (se cambiaba en un establo) y después en Londres, donde vivió con Dusty Springfield. Nancy Sinatra, con Lee Hazlewood, mezclaba Las Vegas, Los Ángeles, fantasía sadomaso y venganza femenina. Tras los Beatles, el pop británico había quedado dominado por hombres y las cantantes iban juntas en un mismo reportaje: Helen Shapiro no sobrevivió al Merseybeat; Cilla Black (Epstein, versiones de Bacharach/David), Sandie Shaw (una chica Biba descalza, fría y dueña de su imagen, que en «Nothing Comes Easy» canta a una acosadora) y Marianne Faithfull (elegida por su aspecto por Andrew Loog Oldham y arrojada a las giras) eran pioneras por el simple hecho de actuar.","color":"#38bdf8","family":"Pop de estudio: Spector, Beach Boys, Meek","link":"https://volteret4.github.io/1966/#cantantes-1966"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Hit-Making Machine","body":"Burt Bacharach, alongside his songwriting partner Hal David, was described as a \"hit making machine\" due to his consistent success in writing popular songs for various artists. \"The guy was a hit machine.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 28 - Soundtracks of the 70s","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":200228982020903,"type":"album","name":"Burt Bacharach Plays His Hits","list_id":66701177312920,"list":"RYM Top — Easy Listening","src":"musthear","rank":23,"year":1966,"note":null,"yt":"WwywBF3h3xw","scaruffi":null},{"id":200228982020903,"type":"album","name":"Burt Bacharach Plays His Hits","list_id":34001800990688,"list":"RYM Top — E