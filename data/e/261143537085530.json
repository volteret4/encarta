[{"id":138057999593946,"type":"genre","name":"Corporate Rock","artist":null,"year":null,"weight":35,"yt":null,"src":"ensayos"}],"album_genres":[{"id":25930810330885,"type":"genre","name":"AOR","n":4},{"id":187186924116159,"type":"genre","name":"arena rock","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":138197775829889,"type":"genre","name":"Progressive Rock","n":1},{"id":109063683126539,"type":"genre","name":"Hard Rock","n":1},{"id":30277598324326,"type":"genre","name":"pop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":114220518690419,"name":"Techno-rock y pop de estudio","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1973,"end":1989,"desc":"El «sonido» por encima de la melodía, el ritmo y la armonía: Electric Light Orchestra inventa el «high-tech pop»; Supertramp, Alan Parsons Project, Kansas, Styx y Split Enz. El valor de la producción define a Steely Dan (el pop-jazz pulido de los yuppies), Hall & Oates, los Fleetwood Mac de Rumours y Tusk, Toto, el «muro de sonido» titánico de Jim Steinman (Bat Out Of Hell) y la Penguin Cafe Orchestra. A finales de los setenta, el art-rock culmina en los supergrupos: 10cc, Godley & Creme, Foreigner, UK, Asia, Sky.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#studio-pop"}],"book_tracks":[{"id":90966040191544,"artist":"Styx","artist_id":261143537085530,"title":"Suite Madame Blue","year":1975,"ess":0,"yt":"CkkQPxoxJJY","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Techno-rock y pop de estudio","scene_id":114220518690419,"scene_link":"https://volteret4.github.io/scaruffi/#studio-pop","chapters":["Sección 4.5"],"pages":[[1,92,null]]},{"id":35603722184363,"artist":"Styx","artist_id":261143537085530,"title":"The Grand Illusion","year":1977,"ess":1,"yt":"JJ7Xw1p6CRI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Techno-rock y pop de estudio","scene_id":114220518690419,"scene_link":"https://volteret4.github.io/scaruffi/#studio-pop","chapters":["Sección 4.5"],"pages":[[1,92,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":92,"text":"…on Kansas (1974). However, after the elegant Magnum Opus Suite (1976), they became stars of the soft-pop ballad. Suite Madame Blue (1975), turned Styx (1) into the quintessential \"pomp-rock\" band, a style they refined on The Grand Illusion (1977), their commercial break-through. New Zealand's Split…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":113,"text":"• Styx: The Grand Illusion (1977) • Supertramp: Breakfast In America (1979) • Swell Maps: A Trip To Marineville (1979) • Synergy: Electronic Realizations…"}],"podcast":[{"kind":"podcast","title":"Backmasking Use (70s/80s)","body":"Styx utilized backmasking effects during the 1970s and 1980s, a period when the use of such recording tricks reached its height. \"Tons of artists used back masking effects in the 70s and 80s. That seems to be when things reached their peak. Iron Maiden, Pink Floyd, Sticks, Prince B-52s, Weird Al, they were all into it.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rock Explainer 5","url":"https://www.youtube.com/watch?v=_YjwRApoJhA"}]},{"kind":"podcast","title":"Uncool 1980s Concept Albums","body":"Styx was mentioned as one of the bands doing concept albums in the 1980s, a period when the format was considered \"pretty uncool\" in alternative music circles. \"I mean, when you have bands like Sticks and Queenswright doing them, that's pretty uncool.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Alt Rock Concept Albums: Part 1","url":"https://www.youtube.com/watch?v=Dm5N6yDRxXQ"}]}],"awards":[],"concerts":[{"kind":"concert","title":"Tour with April Wine 1977","body":null,"year":1977,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":234294835184740,"type":"song","name":"Lady","work_year":1975,"list_id":7520871391222,"list":"Billboard Year-End 1975","src":"singles","rank":61,"year":1975,"note":"","yt":"QumxOQganfo","scaruffi":null},{"id":234294835184740,"type":"song","name":"Lady","work_year":1975,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":61,"year":1975,"note":null,"yt":"QumxOQganfo","scaruffi":null},{"id":35603722184363,"type":"album","name":"The Grand Illusion","list_id":89076604740920,"list":"RYM Top — Rock — AOR","src":"musthear","rank":81,"year":1977,"note":null,"yt":"JJ7Xw1p6CRI","scaruffi":7.0},{"id":35603722184363,"type":"album","name":"The Grand Illusion","work_year":1977,"list_id":65232636722211,"list":"Scaruffi 1970s","src":"charts","rank":512,"year":1977,"note":null,"yt":"JJ7Xw1p6CRI","scaruffi":7.0},{"id":40064809366801,"type":"song","name":"Come Sail Away","work_year":1978,"list_id":49580741702968,"list":"Billboard Year-End 1978","src":"singles","rank":56,"year":1978,"note":"","yt":"e5MAg_yWsq8","scaruffi":null},{"id":40064809366801,"type":"song","name":"Come Sail Away","work_year":1978,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":56,"year":1978,"note":null,"yt":"e5MAg_yWsq8","scaruffi":null},{"id":23022005554505,"type":"album","name":"Pieces of Eight","list_id":89076604740920,"list":"RYM Top — Rock — AOR","src":"musthear","rank":86,"year":1978,"note":null,"yt":"PWK0Dp2zSu0","scaruffi":null},{"id":80494149226356,"type":"song","name":"Babe","work_year":1980,"list_id":219509302503571,"list":"Billboard Hot 100 nº1 · 1970s","src":"singles","rank":478,"year":1979,"note":"2 semanas","yt":null,"scaruffi":null},{"id":65390693549148,"type":"song","name":"Renegade","work_year":1979,"list_id":272107381899114,"list":"Billboard Year-End 1979","src":"singl