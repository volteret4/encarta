mbient","n":2},{"id":87625349211221,"type":"genre","name":"electronic","n":2},{"id":159918588106246,"type":"genre","name":"Progressive Electronic","n":1}],"labels":[],"album_labels":[{"id":151713233561911,"type":"label","name":"Fortuna Records","n":1}],"own_scenes":[],"scenes":[{"id":135695620098166,"name":"New age y world music","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1975,"end":2001,"desc":"En 1975 William Ackerman acuña el término y funda Windham Hill: la new age nace como reacción al rock (silenciosa, melódica, adulta, sin voz, batería ni guitarra eléctrica) y es sobre todo una síntesis de culturas, estados de ánimo, géneros y estilos de vida. Sus parientes: el jazz estético de ECM, John Fahey, el minimalismo y la kosmische musik. Guitarra (Ackerman, Michael Hedges), piano (George Winston, Michael Jones), flauta (Paul Horn), arpa, cuerdas (David Darling) y percusión; conjuntos de cámara (Shadowfax, Turtle Island String Quartet); la electrónica de Los Ángeles (Michael Stearns, Kevin Braheny, Steve Roach, el más metafísico de los mensajeros cósmicos) y la sinfónica (Constance Demby, Novus Magnificat), Robert Rich. La world music de vanguardia: Jon Hassell (Dream Theory In Malaya), Paul Winter, Kitaro, Jeff Greinke, Mark Isham, Michael Brook, Forrest Fang, Jorge Reyes. En Alemania, Peter Frohmader y los herederos de la música cósmica.","color":"#2dd4bf","family":"Vanguardia, electrónica y ambient","link":"https://volteret4.github.io/scaruffi/#new-age"},{"id":193585859679838,"name":"New age","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1978,"end":1995,"desc":"Si el ambient envuelve, la new age quiere afectar a la vida íntima: relajación, sueño, meditación.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#new-age"},{"id":17947842630791,"name":"Revival new age","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":2008,"end":2017,"desc":"Con el regreso de los aparatos analógicos se reivindica la primera new age, la más próxima al ambient solemne de los setenta.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#revival-new-age"}],"book_tracks":[{"id":103185898316817,"artist":"Steve Roach","artist_id":7499216531441,"title":"Traveler","year":1983,"ess":0,"yt":"gY2poZK5Mk0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,203,null]]},{"id":27333724537167,"artist":"Steve Roach","artist_id":7499216531441,"title":"Structures From Silence","year":1984,"ess":0,"yt":"MzUf5mXP4ZQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,203,null]]},{"id":219723259182956,"artist":"Steve Roach","artist_id":7499216531441,"title":"Dreamtime Return","year":1988,"ess":0,"yt":"BW5FRoet2eg","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,203,null]]},{"id":75714272686162,"artist":"Steve Roach","artist_id":7499216531441,"title":"Australia - Sound Of The Earth","year":1991,"ess":0,"yt":"yusDEWwfaGc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,204,null]]},{"id":214723282535254,"artist":"Steve Roach","artist_id":7499216531441,"title":"World's Edge","year":1992,"ess":1,"yt":"nXa-8MUGMxw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,204,null]]},{"id":87524096405139,"artist":"Steve Roach","artist_id":7499216531441,"title":"Dream Circle","year":1994,"ess":0,"yt":"Zp8Z7hqon6M","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,204,null]]},{"id":143650917215835,"artist":"Steve Roach","artist_id":7499216531441,"title":"The Magnificent Void","year":1996,"ess":0,"yt":"nXa-8MUGMxw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,204,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":203,"text":"…(1993), recorded in 1987, was one of the most ambitious works. By far the most prolific and successful artist of the original Los Angeles school was Steve Roach (45). He began as a shy disciple of Schulze's cosmic music with electronic suites such as Traveler (1983), but became more and more introspective…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":204,"text":"…and terrifying World's Edge (1992), Dream Circle (1994) and The Magnificent Void (1996) increased the doses of angst and unknown, and crowned Roach as the most metaphysical of the cosmic couriers. A parallel branch of electronic new-age music had to do with the symphonic sound that was made…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":204,"text":"…Yanni and others mainly reinvented pop muzak for the electronic age. The electronic soundscapes sculpted by Robert Rich (7) were second only to Steve Roach's in complexity and psychological depth. In 1982, Rich began to perform \"sleep concerts\", continuous flows of soothing and static music (a` la Brian…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":205,"text":"…guitarist Jim Scott and oboe player Nancy Rumbel), Ancient Future's Natural Rhythms (1981) and Eternal Wind's Eternal Wind (1984). Jon Hassell's and Steve Roach's \"de-contextualizing\" and \"de-constructing\" approaches to world-music exerted an enormous influence on the electronic musicians of the 1980s.…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":297,"text":"…jazz-rock of Flanger, a collaboration with percussionist Bernd Friedman, on Templates (1999). Electronic Ambient World Music Exploiting Steve Roach's idea, a number of musicians scoured the territory at the border between new-age music, ambient music and world-music. In Belgium, Vidna Obmana (2), Dirk Serries' project, fused Brian Eno and Steve Roach. Serries practiced electronic soundpainting on the ambient trilogy begun with Passage In Beauty (1991), but Echoing Delight (1993) shifted the…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":297,"text":"…evocations. This is the genre in which Serries gave his most original and poignant works, first Spiritual Bonding (1994), a collaboration with Steve Roach and Robert Rich, and then Crossing The Trail (1998). In Canada, Kenneth Newby (10), a member of the Trance Mission collective, penned Ecology Of…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":297,"text":"…Vuh. All Our Ancestors (1995) approached chamber music and Jon Hassell's fourth-world music, while the more electronic Mesh (1997) was influenced by Steve Roach's sinister soundscapes. Voices Of Kwahn offered an elegant fusion of quirky vocals and electronic/ethnic ambience on Silver Bowl Transmission…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":300,"text":"…(Pow Wow) 39. Kenneth Newby: Ecology Of Souls (Songlines) 40. Sugarsmack: Top Loader (Invisible) 41. Unwound: Fake Train (Kill Rock Stars) 42. Steve Roach: World's Edge (Fortuna, 1992) 43. Kramer: The Guilt Trip (Shimmy-Disc) 44. Autechre: Incunabula (Warp, 1993) 45. Belly: Star (Sire) 46. Aurora:…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":103185898316817,"type":"album","name":"Traveler","list_id":100525930599399,"list":"RYM Top — Electronic — Space Ambient","src":"musthear","rank":69,"year":1983,"note":null,"yt":"8YsUx6YJMs0","scaruffi":null},{"id":27333724537167,"type":"album","name":"Structures From Silence","work_year":1984,"list_id":215424088090262,"list":"AOTY Must Hear 1980s","src":"charts","rank":108,"year":1984,"note":null,"yt":"MzUf5mXP4ZQ","scaruffi":8.0},{"id":27333724537167,"type":"album","name":"Structures From Silence","list_id":4780159650629,"list":"Go to sleep. Music to help your insomnia... maybe","src":"musthear","rank":52,"year":1984,"note":null,"yt":"MzUf5mXP4ZQ","scaruffi":8.0},{"id":27333724537167,"type":"album","name":"Structures From Silence","work_year":1984,"list_id":8725275226094,"list":"Pitchfork: The 50 Best Ambient Albums of All Time","src":"charts","rank":33,"year":1984,"note":null,"yt":"MzUf5mXP4ZQ","scaruffi":8.0},{"id":27333724537167,"type":"album","name":"Structures From Silence","list_id":137629407618220,"list":"RYM Top — Ambient","src":"musthear","rank":13,"