5,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[{"id":221243548786509,"type":"genre","name":"classical","artist":null,"year":null,"weight":432,"yt":null,"src":"ensayos"}],"album_genres":[{"id":116024095069917,"type":"genre","name":"Mélodie","n":17},{"id":111882320876960,"type":"genre","name":"Impressionism","n":16},{"id":216521422687692,"type":"genre","name":"Prelude","n":4},{"id":184441416202321,"type":"genre","name":"Character Piece","n":3},{"id":114834688219630,"type":"genre","name":"String Quartet","n":3},{"id":23844382644745,"type":"genre","name":"Chamber Music","n":3},{"id":46262452793348,"type":"genre","name":"Étude","n":2},{"id":242876995964317,"type":"genre","name":"Romanticism","n":1},{"id":199766387308186,"type":"genre","name":"Moogsploitation","n":1},{"id":169159335096911,"type":"genre","name":"Avant-Garde Metal","n":1},{"id":159918588106246,"type":"genre","name":"Progressive Electronic","n":1},{"id":134641995297759,"type":"genre","name":"Baroque Music","n":1},{"id":125989373161038,"type":"genre","name":"Nocturne","n":1},{"id":99593642367688,"type":"genre","name":"Grindcore","n":1},{"id":1929433994294,"type":"genre","name":"Furry Music","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":260883469106620,"name":"La fusión: del clásico y el jazz a los jóvenes flamencos","book":"El flamenco contado con sencillez","author":"Carlos Arbelos","start":1958,"end":2002,"desc":"El flamenco nació de un crisol y lleva la fusión en su génesis, aunque la corriente ortodoxa la atribuya al comercio. Ravel, Glinka, Rimsky-Korsakov y Debussy, y en España Albéniz, Granados, Turina y Falla, metieron el son flamenco en la música clásica, y Camarón, Morente o Carmen Linares han cantado con orquesta. Desde el jazz, Miles Davis, Gil Evans y John Coltrane le añadieron sonidos flamencos a finales de los cincuenta. Y los propios flamencos ya mezclaban: Enrique el Mellizo hizo su malagueña con música gregoriana, el Chaqueta cantó por bulerías boleros de Antonio Machín en los cuarenta, la Niña de los Peines una zamba argentina, Carmen Amaya una cueca chilena, Caracol cambió la guitarra por el piano y, como Manuel Vallejo, orquestó cantes; Sabicas grabó a finales de los sesenta con un guitarrista de rock. Después vinieron Diego Carrasco (rap, blues y siguiriyas a compás), Peret, que hizo catalana la rumba acelerándola, Jorge Pardo con su saxo por bulerías o el Lebrijano con acordes andalusíes. En el baile, Joaquín Cortés, Antonio Canales o Sara Baras salen ya de academias que enseñan también clásico y jazz.","color":"#38bdf8","family":"Encuentro con otras músicas: nuevo flamenco y fusión","link":"https://volteret4.github.io/Flamenco/#fusion"},{"id":224034518296918,"name":"Impresionismo","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1890,"end":1925,"desc":"La primera vanguardia paralela al ocaso del romanticismo: texturas fugaces y transparentes que transforman el sonido en sustancia poética. Un antecedente del ambient que aspiraba a crear una impresión emocional.","color":"#8b7cf6","family":"Vanguardia y experimental","link":"https://volteret4.github.io/loops_timeline/#impresionismo"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Use of Devil's Triad","body":"Debussy, a significant figure in classical music, is mentioned as one of many classical composers who utilized the \"devil's tri tone\" (flattened fifth) in his compositions. This usage indicates the interval's presence and acceptance within the classical music canon, predating its later demonization in popular music. \"But then it did show up in a lot of classical compositions from people like Beethoven, Wagner, Debussy, Lyst, Sabelius, Bartok, dozens of others.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Uncharted \"Sneak Peak\" - Episode 5: The Satanic Panic","url":"https://www.youtube.com/watch?v=41eKVp8JIhU"}]}],"award