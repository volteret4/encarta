{"id":129675251351292,"type":"album","name":"Rapture","artist":"Anita Baker","year":1986,"weight":16,"info":{"cover":"https://dn710907.ca.archive.org/0/items/mbid-90f3f3b9-8492-3f66-a660-cdbc5fc4d4ad/mbid-90f3f3b9-8492-3f66-a660-cdbc5fc4d4ad-3461604768.jpg","yt":"2w6udgiojlE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/anita-baker/rapture"},"desc":"Rapture is the second album by the American vocalist Anita Baker. It was released in 1986, and became her breakout album, selling over 8 million copies worldwide (of which 5 million in the US) and earning her two Grammy Awards. The album's first track, \"Sweet Love\", was a top 10 Billboard hit in addition to winning a Grammy Award. The music video for the track \"Same Ole Love\" was filmed and recorded at Baker's Keyboard Lounge. In 1989, Rapture was ranked #36 on Rolling Stone magazine's list of the 100 greatest albums of the 1980s. ."},"artist_ref":{"id":179197383625941,"name":"Anita Baker","info":{"img":null}},"labels":[],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"musthear"},{"id":269705969260495,"type":"genre","name":"Disco","artist":null,"year":null,"weight":725,"yt":null,"src":"musthear"},{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"musthear"},{"id":50337978407967,"type":"genre","name":"Smooth Soul","artist":null,"year":null,"weight":217,"yt":null,"src":"musthear,rym"},{"id":19904352098817,"type":"genre","name":"Smooth Jazz","artist":null,"year":null,"weight":217,"yt":null,"src":"musthear"}],"lists":[{"id":126751190489920,"name":"RYM Top — R&B — Smooth Soul","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":41,"year":null,"note":null,"total":200,"scaruffi":null},{"id":10053931114450,"name":"Pitchfork: The 200 Best Albums of the 1980s