3303964489,"type":"album","name":"Texas Rain","artist":"Townes Van Zandt","year":2001,"weight":3,"yt":"uKrwuGl1GpU","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":119301033705212,"name":"RYM Top — Country — Progressive Country","rank":196,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":214188970482661,"type":"genre","name":"Country Folk","n":10},{"id":134533750493307,"type":"genre","name":"Progressive Country","n":7},{"id":33310639067833,"type":"genre","name":"Northern American Music","n":5},{"id":223327500886715,"type":"genre","name":"Contemporary Folk","n":4},{"id":202159817309393,"type":"genre","name":"blues","n":2},{"id":156823753286980,"type":"genre","name":"folk","n":2},{"id":7374429919951,"type":"genre","name":"country","n":2},{"id":90510611927654,"type":"genre","name":"Country Rock","n":1},{"id":63006998354228,"type":"genre","name":"Outlaw Country","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":243962098886055,"name":"Carreras en solitario: cantautores de finales de los sesenta","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1967,"end":1972,"desc":"Los excéntricos de Los Ángeles (David Axelrod, cuyos breakbeats orquestales anticipan el trip-hop; Van Dyke Parks y su música de cámara pop; David Ackles, Kim Fowley, Wild Man Fischer) y los herederos del Greenwich (Laura Nyro, Eric Andersen, David Peel, Angus MacLise y Nico, cuyas letanías fúnebres inventan el rock gótico casi por accidente: Marble Index, Desert Shore). Canadá aporta a Leonard Cohen, Gordon Lightfoot, Joni Mitchell (Blue, Hejira) y Neil Young, que con Dylan y Springsteen forma la gran tríada «moral» de la música americana e inventa la guitarra distorsionada que influirá en el grunge. En Texas, Townes Van Zandt; en Gran Bretaña, Scott Walker, Nick Drake (Pink Moon), Roy Harper, John Martyn, Cat Stevens, Rod Stewart, Eric Burdon y Jack Bruce.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#solo-60s"}],"book_tracks":[{"id":279748989864291,"artist":"Townes Van Zandt","artist_id":98832921024126,"title":"Our Mother the Mountain","year":1969,"ess":1,"yt":"Ri29Nk8FADk","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Carreras en solitario: cantautores de finales de los sesenta","scene_id":243962098886055,"scene_link":"https://volteret4.github.io/scaruffi/#solo-60s","chapters":["Sección 3.3"],"pages":[[1,54,null]]},{"id":80468221403343,"artist":"Townes Van Zandt","artist_id":98832921024126,"title":"The Late Great Townes Van Zandt","year":1972,"ess":1,"yt":"aqTgAM9mTI4","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Carreras en solitario: cantautores de finales de los sesenta","scene_id":243962098886055,"scene_link":"https://volteret4.github.io/scaruffi/#solo-60s","chapters":["Sección 3.3"],"pages":[[1,54,null]]},{"id":236037228173411,"artist":"Townes Van Zandt","artist_id":98832921024126,"title":"Flyin' Shoes","year":1978,"ess":1,"yt":"t-ntedfY9gU","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Carreras en solitario: cantautores de finales de los sesenta","scene_id":243962098886055,"scene_link":"https://volteret4.github.io/scaruffi/#solo-60s","chapters":["Sección 3.3"],"pages":[[1,54,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":54,"text":"…of \"found\" segments from his live performances, further clarified his status as a crafter of sound as opposed to mere songwriter. Texas 1967-69 Townes Van Zandt (3) was a poet of intimate, gentle, tormented, emotional ballads. His mostly acoustic art borrowed elements from country, blues and tex-mex, and…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":54,"text":"…Our Mother the Mountain (1969), his masterpiece, a parade of desolate vignettes that recast universal themes as private stories, The Late Great Townes Van Zandt (1972), his best-seller, and Flyin' Shoes (1978) were uniquely dramatic, poignant and focused. Mickey Newbury (1) was also part of the legion of…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":96,"text":"…collections. New heights were reached with Traffic from Paradise (1993), her most abstract, psychedelic, unfocused and cryptic work. Texas 1975-80 Townes Van Zandt had unwittingly started a school of singer-songwriters in Texas. For a while, that school was one of the most prolific and intriguing of the planet.…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":250,"text":"…worthy heirs to Gram Parsons and Neil Young. San Francisco's Richard Buckner (1) pursued Joe Ely's \"outlaw\" country with a voice reminiscent of Townes Van Zandt on Bloomed (1995) and particularly on the concept album Devotion And Doubt (1997), backed by Giant Sand and Marc Ribot. Protagonists of the…"}],"podcast":[{"kind":"podcast","title":"Emmylou Harris's Grief","body":"Townes Van Zant is among the beloved musicians that Emmylou Harris has struggled to accept as gone, illustrating the deep personal and artistic connections within her musical community. \"Even now, she has said it is hard to believe for her that so many of the people that were in her life and that she loved to hear sing and sing with wail and Jennings and towns van Zant just to name a couple that they're gone.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 35 - Cosmic American Music - 70s Country Rock","url":"https://seventies.libsyn.com/ep-35-cosmic-american-music-70s-country-rock"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":53585357216038,"type":"album","name":"For t