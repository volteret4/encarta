{"id":191484181821249,"type":"album","name":"Rising","artist":"Rainbow","year":1976,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/40815-rising_121920.jpg","aoty":90,"aoty_user":83,"yt":"FrJ0OCITw6g","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/rainbow/rising","aoty":"https://www.albumoftheyear.org/album/40815-rainbow-rising.php"},"desc":"\"Rising\" is a hard rock album by Rainbow, released in 1976. Rising has become known as the best album of Rainbow's career. With founder Ritchie Blackmore retaining only Ronnie James Dio from the previous album, he recruited keyboard player Tony Carey, bassist Jimmy Bain and drummer Cozy Powell to complete the new line-up. Recorded in Munich in less than a month, the album was overseen by \"Deep Purple\" engineer and rock producer Martin Birch. The album marks Dio's first work with bassist Jimmy Bain. Bain would later play bass in Dio's solo band. The album showpiece is the 8 minute ."},"artist_ref":{"id":202237403766251,"name":"Rainbow","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Rainbow_in_performance_%2827_09_1977_02_500b%29.jpg?width=500"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"rym"},{"id":174164112458259,"type":"genre","name":"Heavy Metal","artist":null,"year":null,"weight":782,"yt":null,"src":"rym"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"rym"}],"lists":[{"id":263887018784608,"name":"RYM Top — Rock — Heavy Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":10,"year":null,"note":null,"total":200,"scaruffi":null},{"id":145763083606807,"name":"RYM Top — Rock — Hard Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":15,"year":null,"note":null,"total":200,"scaruffi":null},{"id":175315787363075,"name":"RYM Top — Rock — Metal","src":"musthear","grp":"rateyourmusic"