:[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"\"Fantasia Upon One Note\" (1680) - Inspiration for Pinball Wizard","body":"Henry Purcell composed \"Fantasia Upon One Note\" in 1680, a piece characterized by one instrument maintaining a middle C throughout while other instruments weave around it. Speculation suggests Purcell might have created this piece to allow a friend with limited musical ability to participate by simply holding the middle C. Pete Townshend later found this composition \"a stunning thing to call upon\" while writing \"Pinball Wizard,\" analyzing its chords to adapt them for guitar. \"The speculation is that Purcell maybe had a friend who could not really play. So he created a piece in which the friend just needed to maintain the middle C and still participate in playing the song.\"","year":1680,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 42 - Rock Operas of the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 42 - Rock Operas of the 70s","url":"https://seventies.libsyn.com/ep-42-rock-operas-of-the-70s"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":70651081674632,"type":"album","name":"Dido & Æneas","list_id":187436681225040,"list":"RYM Top — Classical Music — Opera","src":"musthear","rank":35,"year":1962,"note":null,"yt":"LkeUpu5v1EA","scaruffi":null},{"id":70651081674632,"type":"album","name":"Dido & Æneas","list_id":89197299143822,"list":"RYM Top — Regional Music — Baroque Music","src":"musthear","rank":76,"year":1962,"note":null,"yt":"LkeUpu5v1EA","scaruffi":null},{"id":18087255285082,"type":"album","name":"Music for Queen Mary","list_id":89197299143822,"list":"RYM Top — Regional Music — Baroque Music","src":"musthear","rank":118,"year":1977,"note":null,"yt":"AYELAu9hqdU","scaruffi":null},{"id":34848518271782,"type":"album","name":"The Mexborough English Concertina Prize Band","list_id":191342032088259,"list":"RYM Top — Regional Mus