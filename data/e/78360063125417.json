{"id":78360063125417,"type":"album","name":"Exodus","artist":"Bob Marley & The Wailers","year":1977,"weight":16,"info":{"cover":"https://dn710908.ca.archive.org/0/items/mbid-41ec6d32-57ca-4e67-803a-2260f957888e/mbid-41ec6d32-57ca-4e67-803a-2260f957888e-4411204473.jpg","kind":"Album","tracks":10,"country":"DE","aoty":93,"aoty_user":87,"yt":"DHKnxAsHkSI","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/bob-marley-and-the-wailers/exodus","aoty":"https://www.albumoftheyear.org/album/18234-bob-marley-and-the-wailers-exodus.php"},"desc":"Exodus is the ninth studio album by Jamaican reggae band Bob Marley & The Wailers, released on June 3, 1977 on Island Records. Much of Exodus was recorded in London, while Marley recuperated from an assassination attempt. The success of the album propelled Marley to international stardom. A remastered version of Exodus was released in 2007, in the United Kingdom as a full length book chronicling Bob Marley's retreat into exile after his assassination attempt and the making of the album. \"Jamming,\" \"Waiting in Vain\" and \"One Love/People Get Ready\" were all major international hits. Exodus peaked at #20 on ."},"artist_ref":{"id":193744127560999,"name":"Bob Marley & The Wailers","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bob-marley-wailers-crystal-palace.jpg?width=500"}},"labels":[],"genres":[{"id":10697304889908,"type":"genre","name":"Reggae","artist":null,"year":null,"weight":615,"yt":null,"src":"musthear"},{"id":60739696558265,"type":"genre","name":"Roots Reggae","artist":null,"year":null,"weight":216,"yt":null,"src":"musthear"}],"lists":[{"id":36565743209502,"name":"Rolling Stone 500 Greatest Albums Of All Time 2023 Edition","src":"musthear","grp":null,"list_year":null,"rank":48,"year":null,"note":null,"total":500,"scaruffi":null},{"id":3080531282495,"name":"AOTY Must Hear 1970s","src":"musthear","grp":null,"list_year":null,"rank":59,"year":null,"note":null,"total":256,"scaruffi":null},{"id"