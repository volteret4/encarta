":[],"own_scenes":[],"scenes":[{"id":175501128146124,"name":"Alt-R&B","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":2010,"end":2017,"desc":"La desviación indie y experimental del R&B, con préstamos del dubstep, el deep house y otros géneros recién llegados.","color":"#f87171","family":"Hip hop, breaks y ritmo lento","link":"https://volteret4.github.io/loops_timeline/#alt-rnb"}],"book_tracks":[{"id":79136571293322,"artist":"Kelela","artist_id":18466164777680,"title":"Cut 4 Me","year":2013,"ess":0,"yt":"7Tg1T6PhiyA","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Alt-R&B","scene_id":175501128146124,"scene_link":"https://volteret4.github.io/loops_timeline/#alt-rnb","chapters":["Loops 2 · Cap. 11: Senderos que se bifurcan: irradiaciones del dubstep en el house y el R&B, y la definición de una nueva cultura de club mayoritaria"],"pages":[[2,368]]},{"id":57815321508298,"artist":"Kelela","artist_id":18466164777680,"title":"Take Me Apart","year":2017,"ess":1,"yt":"tWPDww10aic","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Alt-R&B","scene_id":175501128146124,"scene_link":"https://volteret4.github.io/loops_timeline/#alt-rnb","chapters":["Loops 2 · Cap. 11: Senderos que se bifurcan: irradiaciones del dubstep en el house y el R&B, y la definición de una nueva cultura de club mayoritaria"],"pages":[[2,432]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":368,"text":"…más humanas y frágiles. «Me gusta la música que te hace sentir vulnerable», me explicaba durante una entrevista otra de las líderes del movimiento, Kelela, la cantante californiana que debutó en 2013 con Cut 4 Me, mixtape armada con producciones de la plana"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":369,"text":"…de una reivindicación oportuna de tres figuras del pasado, capitales en la relación entre tecnología y esa desnudez de las emociones a la que aludía Kelela: Stevie Wonder, Prince y Sade. Prince había sido, incluso antes de morir en 2016, una referencia constante en la intersección entre R&B…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":370,"text":"…donde cada canción era luz y secreto. Un espacio fértil tan preñado de futuro que ha iniciado una nueva escuela —de la que participan voces como Kelela o Lafawndah— y que, con su ambición más propia de Björk, hace que buena parte del R&B colindante sea, en comparación, como una traducción del título…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":79136571293322,"type":"album","name":"Cut 4 Me","list_id":50254398381317,"list":"Pitchfork: The 200 Best Albums of the 2010s","src":"musthear","rank":192,"year":2013,"note":null,"yt":"ZuR5Dp51zFU","scaruffi":null},{"id":196979487041404,"type":"album","name":"Hallucinogen","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":464,"year":2015,"note":null,"yt":"VhjiYMSkk7k","scaruffi":null},{"id":57815321508298,"type":"album","name":"Take Me Apart","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":254,"year":2017,"note":null,"yt":"br4Pqxw8xv0","scaruffi":null},{"id":57815321508298,"type":"album","name":"Take Me Apart","list_id":168313144576350,"list":"RYM Top — Dance","src":"musthear","rank":95,"year":2017,"note":null,"yt":"br4Pqxw8xv0","scaruffi":null},{"id":57815321508298,"type":"album","name":"Take Me Apart","list_id":265709776421053,"list":"RYM Top — Electronic — Electronic Dance Music","src":"musthear","rank":65,"year":2017,"note":null,"yt":"br4Pqxw8xv0","scaruffi":null},{"id":57815321508298,"type":"alb