:3474,"yt":null,"src":"ensayos"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"ensayos"},{"id":68128513346957,"type":"genre","name":"Glam Rock","artist":null,"year":null,"weight":463,"yt":null,"src":"ensayos"},{"id":211764729901037,"type":"genre","name":"Bubblegum","artist":null,"year":null,"weight":304,"yt":null,"src":"ensayos"},{"id":23100309084479,"type":"genre","name":"glam","artist":null,"year":null,"weight":97,"yt":null,"src":"ensayos"}],"album_genres":[{"id":68128513346957,"type":"genre","name":"Glam Rock","n":5},{"id":211764729901037,"type":"genre","name":"Bubblegum","n":2},{"id":109063683126539,"type":"genre","name":"Hard Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Glam Rock Act","body":"The Sweet was one of the many UK acts that adopted and adapted the glam rock style influenced by David Bowie and Mark Bolan in the early 1970s. \"the Sweet.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Surprising History of Glam Rock","url":"https://www.youtube.com/watch?v=blDNqVFheAw"}]},{"kind":"podcast","title":"Image Management and US Touring","body":"Sweet was displeased that their hit \"Little Willie\" was released in the US a year later than in Europe (1973 vs. 1972), by which time they were actively trying to change their image away from bubblegum. Guitarist Andy Scott stated in a 1978 interview that the band intentionally did not tour the United States to capitalize on \"Little Willie\"'s success because it was 18 months \"after the fact.\" They also disliked being considered \"opening act material\" in the US and having audiences only want to hear their older bubblegum hits. \"Andy Scott who played guitar for sweet said in a 1978 interview that that was intentional and that there was quote no way the band was going to come in tour because of Little Willie being a hit 18 months after the fact.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":"https://seventies.libsyn.com/030-bubblegum"}]},{"kind":"podcast","title":"Name Changes","body":"In the late 1960s, the band was initially known as The Sweet Shop, a clear reference to the prevailing popularity of bubblegum music. The name was later shortened to The Sweet. \"In the late 60s the Sweet was known as the Sweet Shop and incredibly obvious nod to the popularity of bubble gum music. Then the name was shortened to the Sweet...\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":null},{"source":"For the Record - The 70s","episode":"Ep. 30 - The Sweet Sound of 70s Bubblegum Music","url":"https://seventies.libsyn.com/030-bubblegum"}]}],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Hey Ladies (1989)","body":null,"year":1989,"extra":{"from":"The Beastie Boys","from_id":41292547107430,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Remembering The Beastie Boys: Part 1","url":"https://www.youtube.com/watch?v=cYwk-B3qwwk"}]},{"kind":"xref","title":"Music as Escape and Teenage Influences","body":"Following a football injury that sidelined him for much of a season, music became Scott Weiland's primary escape. His favorite bands during this period included Depeche Mode, The Clash, Social Distortion, The Sweet, Echo & The Bunnymen, and Queen. \"Music became his escape, especially after a football injury forced him to sit out much of a season.\"","year":null,"extra":{"from":"Scott Weiland","from_id":900011635688,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Scott Weiland: Part 1","url":"https://www.youtube.com/watch?v=r6vVw66-gmI"}]},{"kind":"xref","title":"Sweet Stuff Foundation","body":"Josh Homme founded the Sweet Stuff Foundation, a charity dedicated to assisting musicians, producers, engineers, and their families who are facing hardships due to illness or disability. \"And finally, Josh has something called the Sweet Stuff Foundation, which is a charity that helps up musicians, producers, engineers and their families when they run into times of illness and disability.\"","year":null,"extra":{"from":"Queens of the Stone Age","from_id":125369925933209,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Secrets of Queens of the Stone Age: Part 2","url":"https://www.youtube.com/watch?v=BvhjsTUIS2o"}]}],"charts":[{"id":161592008771980,"type":"album","name":"Funny How Sweet Co-Co Can Be","list_id":122372031256721,"list":"RYM Top — Pop — Bubblegum","src":"musthear","rank":7,"year":1971,"note":null,"yt":"YI4i4c9Cdm0","scaruffi":null},{"id":13689120772594,"type":"album","name":"Gimme Dat Ding","list_id":122372031256721,"list":"RYM Top — Pop — Bubblegum","src":"musthear","rank":58,"year":1971,"note":null,"yt":"brScm8kY8gg","scaruffi":null},{"id":156260630962433,"type":"song","name":"Little Willy","work_year":1973,"list_id":130874096000071,"list":"Billboard Year-End 1973","src":"singles","rank":18,"year":1973,"note":"","yt":"NM6I-pmV0RA","scaruffi":null},{"id":156260630962433,"type":"song","name":"Little Willy","work_year":1973,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":18,"year":1973,"note":null,"yt":"NM6I-pmV0RA","scaruffi":null},{"id":115802650536112,"type":"song","name":"Blockbuster!","work_year":1973,"list_id":176272515229071,"list":"UK nº1 · 1970s","src":"singles","rank":325,"year":1973,"note":"5 semanas","yt":"Y64211sjSko","scaruffi":null},{"id":40377334890261,"type":"song","name":"The Ballroom Blitz","work_year":1975,"list_id":259695864779346,"list":"Los 40 nº1 · 1974","src":"singles","rank":6,"year":1974,"not