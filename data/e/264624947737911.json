{"id":264624947737911,"type":"album","name":"Bocanada","artist":"Gustavo Cerati","year":1999,"weight":53,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/52990-bocanada-2.jpg","aoty":90,"aoty_user":89,"sputnik":4.23,"yt":"IMw21ADHgJI","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/gustavo-cerati/bocanada","aoty":"https://www.albumoftheyear.org/album/52990-gustavo-cerati-bocanada.php","sputnikmusic":"https://www.sputnikmusic.com/album/125094/Gustavo-Cerati-Bocanada/"},"desc":"Bocanada is the second solo album by Argentinian rock musician Gustavo Cerati, considered by critics and fans as a highlight in his career and one of his best albums. His first album release after the breakup of Soda Stereo, Cerati had, during this time, been working with Plan V and Ocio, two bands oriented towards electronic music. \"Raíz\" was the album's first cut played in radio stations, \"Puente\" being the first music video to be released; \"Bocanada\" had the most music videos produced of any Cerati album to date. \"Bocanada is a fundamental album in the history of Iberoamerican Rock, ."},"artist_ref":{"id":145863581783101,"name":"Gustavo Cerati","info":{"img":null}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":207755761847598,"type":"genre","name":"Hardcore","artist":null,"year":null,"weight":540,"yt":null,"src":"rym"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"rym"},{"id":181296768148316,"type":"genre","name":"Digital Hardcore","artist":null,"year":null,"weight":404,"yt":null,"src":"rym"},{"id":99248936442916,"type":"genre","name":"Hard Dance","artist":null,"year":null,"weight":399,"yt":null,"src":"rym"},{"id":191043281221162,"type":"genre","name":"Brutal Prog