nd 1967","rank":43,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":43,"scaruffi":null}],"n_lists":2}},{"id":89320618963125,"type":"album","name":"I Love How You Love Me","artist":"Bobby Vinton","year":1968,"weight":3,"yt":"YAzJiunPCbc","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":258468824921983,"name":"RYM Top — Pop — Brill Building","rank":81,"scaruffi":null}],"n_lists":1}},{"id":48582595085076,"type":"song","name":"Sealed with a Kiss","artist":"Bobby Vinton","year":1972,"weight":4,"yt":"8rvSTBM1_lQ","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":68619710521645,"name":"Billboard Year-End 1972","rank":87,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":87,"scaruffi":null}],"n_lists":2}},{"id":148030076761474,"type":"album","name":"Party Music: 20 Hits","artist":"Bobby Vinton","year":1976,"weight":3,"yt":"f4xhdJv7a_s","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":19513901070686,"name":"RYM Top — Folk — Polka","rank":171,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":247802226836647,"type":"genre","name":"Brill Building","n":2},{"id":100106212412601,"type":"genre","name":"Teen Pop","n":1},{"id":82622897285210,"type":"genre","name":"Polka","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":233389633737411,"name":"Warhol, la Factory y el pop de 1966","book":"1966: The Year the Decade Exploded","author":"Jon Savage","start":1962,"end":1968,"desc":"En la primavera de 1966 Warhol era el artista más famoso de Estados Unidos y ya no hacía arte en el sentido tradicional: había anunciado en 1965 que dejaba la pintura por el cine, la gente y los entornos totales. La Factory de la calle 47 Este era a la vez cadena de producción de serigrafías, plató y escenario abierto; un espejo de la sociedad neoyorquina donde lo que esta despreciaba (drag queens, yonquis, chaperos, perturbados) podía volverse superstar. Sus cuadros devolvían a América sus valores (sexo, muerte, crimen, fama, dinero, producción en masa) y sus series de desastres el regodeo mediático en la muerte. Obrero gay de Pittsburgh con una rabia de outsider, se convirtió en estrella de rock en el caos de su retrospectiva de Filadelfia (octubre de 1965). Gloria Steinem lo puso en el centro de la cultura pop en Life y Susan Sontag hizo de lo camp una obsesión; Batman, A Clockwork Orange, el caso de los asesinatos de Tucson y Capote alimentaban el aire de violencia que él recortaba de las revistas. Con la anfetamina el ambiente se volvió paranoico y cruel; Danny Williams, su amante y autor de las luces del EPI, desapareció en julio. Durante 1966, sin pretenderlo, «se convirtió en América».","color":"#e5e7eb","family":"Vanguardia: Warhol, Velvet, free jazz, arte","link":"https://volteret4.github.io/1966/#warhol-factory"}],"book_tracks":[{"id":143863784501704,"artist":"Bobby Vinton","artist_id":57536998288677,"title":"Blue Velvet","year":1963,"ess":0,"yt":"icfq_foa5Mo","kind":null,"book":{"id":1,"title":"1966: The Year the Decade Exploded","author":"Jon Savage","url":"https://volteret4.github.io/1966/"},"scene":"Warhol, la Factory y el pop de 1966","scene_id":233389633737411,"scene_link":"https://volteret4.github.io/1966/#warhol-factory","chapters":["Junio: I’ll Be Your Mirror: la Velvet Underground y la América de Warhol"],"pages":[]}],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":65873579436799,"type":"song","name":"Roses Are Red (My Love)","work_year":1962,"list_id":157497903047680,"list":"Billboard Hot 100 nº1 · 1960s","src":"singles","rank":74,"year":1962,"note":"4 semanas","yt":"8rjPC7-JMUM","scaruffi":null},{"id":65873579436799,"type":"song","name":"Roses Are Red (My Love)","work_year":1962,"list_id":175487015765550,"list":"Billboard Year-End 1962","src":"singles","rank":4,"year":1962,"note":"","yt":"8rjPC7-JMUM","scaruffi":null},{"id":183412089740878,"