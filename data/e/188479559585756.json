{"id":188479559585756,"type":"album","name":"The Rhythm of the Saints","artist":"Paul Simon","year":1990,"weight":11,"info":{"cover":"https://dn710605.ca.archive.org/0/items/mbid-fa1d8308-47d4-33af-b377-ecb27483fb2d/mbid-fa1d8308-47d4-33af-b377-ecb27483fb2d-24020454806.jpg","sputnik":4.05,"yt":"pIjjy1BxA4s","links":{"sputnikmusic":"https://www.sputnikmusic.com/album/22867/Paul-Simon-The-Rhythm-of-the-Saints/"},"desc":"The Rhythm of the Saints is the eighth solo studio album by American singer-songwriter Paul Simon, released on October 16, 1990 on Warner Bros. Following the success of 1986's Graceland, on which he worked principally with South African musicians, Simon broadened his interests in diverse forms of music from around the world. He turned to Latin America for the musicians and rhythms which characterize much of this album, partnering with Afro-Brazilian superstars Grupo Cultural Olodum, masters of the heavily percussive sub-style of samba called Batuque or Batucada. The group's drumming is featured on the opening song and first single, \"The ."},"artist_ref":{"id":278428123620793,"name":"Paul Simon","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Paul_Simon_2007.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":156823753286980,"type":"genre","name":"folk","artist":null,"year":null,"weight":510,"yt":null,"src":"musthear"}],"lists":[{"id":90391435651867,"name":"Sputnikmusic Best Albums 1990","src":"charts","grp":"sputnikmusic","list_year":null,"rank":64,"year":1990,"note":n