{"id":95114693218688,"type":"album","name":"Jubilee","artist":"Japanese Breakfast","year":2021,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/341271-jubilee.jpg","aoty":86,"aoty_user":82,"sputnik":3.77,"yt":"11XhhY_oLsg","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/japanese-breakfast/jubilee","aoty":"https://www.albumoftheyear.org/album/341271-japanese-breakfast-jubilee.php","sputnikmusic":"https://www.sputnikmusic.com/album/390121/Japanese-Breakfast-Jubilee/"},"desc":"Jubilee is the third studio album by American alternative pop band Japanese Breakfast. It was released on June 4, 2021, through Dead Oceans. Zauner has described the album as being about joy. This is in contrast to her previous two albums, Psychopomp and Soft Sounds from Another Planet, both of which had prevalent themes of grief surrounding her mother's death from pancreatic cancer in 2014. Zauner took music theory lessons and studied piano in preparation for Jubilee. She noted \"I was just able to incorporate more interesting chord changes and write more on piano for the first time\". Supported by ."},"artist_ref":{"id":245656122635137,"name":"Japanese Breakfast","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"rym"},{"id":236061900877969,"type":"genre","name":"Chamber Pop","artist":null,"year":null,"weight":245,"yt":null,"src":"rym"}],"lists":[{"id":28572826268451,"name":"RYM Top — Pop — Chamber Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":15,"year":null,"note":null,"total":200,"scaruffi":null},{"id":82075953765266,"name":"RYM Top — Pop — Indie Pop","src":"musthear","grp":"rateyourm