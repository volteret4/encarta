{"id":72524262080855,"type":"album","name":"The Shape of Jazz to Come","artist":"Ornette Coleman","year":1959,"weight":19,"info":{"cover":"https://ia801308.us.archive.org/19/items/mbid-c4a1b794-7bb5-411a-a876-7af045cf6f22/mbid-c4a1b794-7bb5-411a-a876-7af045cf6f22-12407949899.jpg","kind":"Album","tracks":6,"country":"US","aoty":100,"aoty_user":82,"yt":"kcslwKxCTR0","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/ornette-coleman/the-shape-of-jazz-to-come-4","aoty":"https://www.albumoftheyear.org/album/13346-ornette-coleman-the-shape-of-jazz-to-come.php"},"desc":"Ornette Coleman's Atlantic debut, The Shape of Jazz to Come, was a watershed event in the genesis of avant-garde jazz, profoundly steering its future course and throwing down a gauntlet that some still haven't come to grips with. The record shattered traditional concepts of harmony in jazz, getting rid of not only the piano player but the whole idea of concretely outlined chord changes. The pieces here follow almost no predetermined harmonic structure, which allows Coleman and partner Don Cherry an unprecedented freedom to take the melodies of their solo lines wherever they felt like going in the moment, regardless ."},"artist_ref":{"id":16023950177236,"name":"Ornette Coleman","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Ornette_Coleman.jpg?width=500"}},"labels":[],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","artist":null,"year":null,"weight":235,"yt":null,"src":"rym"}],"lists":[{"id":34130462682279,"name":"AOTY Must Hear 1950s","src":"musthear","grp":null,"list_year":null,"rank":3,"year":null,"note":null,"total":19,"scaruffi":null},{"id":271813569514477,"name":"RYM Top — Jazz — Avant-Garde Jazz","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":10,"year":null,"note":null,"total":200,"scaruffi":null},{"id":1279839