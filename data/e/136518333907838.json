{"id":136518333907838,"type":"album","name":"#1 Record","artist":"Big Star","year":1972,"weight":17,"info":{"cover":"https://dn711306.ca.archive.org/0/items/mbid-85455e7b-953e-404c-a8f9-061d71fc4aba/mbid-85455e7b-953e-404c-a8f9-061d71fc4aba-15870976012.jpg","kind":"Album","tracks":12,"country":"JP","yt":"9c43fv9RUhw","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/big-star/_1-record-5"},"desc":"#1 Record is the debut album by the American rock band Big Star. It was released in August 1972 by Memphis-based Ardent Records. Many critics praised the album's vocal harmonies and song craft but #1 Record suffered from poor distribution and sold fewer than 10,000 copies upon its initial release. However, #1 Record gained wider attention in the late '70s in the UK when EMI reissued it with Radio City as a double LP package due to increasing demand. The same combination was used when the album was released on CD in 1992. In 2012 it was ranked number 434 ."},"artist_ref":{"id":251086445359035,"name":"Big Star","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Big_Star_at_Hyde_Park.jpg?width=500"}},"labels":[],"genres":[{"id":121661734395550,"type":"genre","name":"Power Pop","artist":null,"year":null,"weight":369,"yt":null,"src":"musthear,rym"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"rym"},{"id":190318565344926,"type":"genre","name":"Folk Pop","artist":null,"year":null,"weight":248,"yt":null,"src":"rym"},{"id":223327500886715,"type":"genre","name":"Contemporary Folk","artist":null,"year":null,"weight":247,"yt":null,"src":"rym"}],"lists":[{"id":4389278164509,"name":"Music Genre Tree","src":"musthear","grp":"musicbrainz","list_year":null,"rank":5,"year":null,"note":null,"total":1042,"scaruffi":null},{"id":22099031234954,"name":"RYM Top — Rock — Power Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":10,"year":null,"note":null,"total":200,"scaruffi":null},{"id