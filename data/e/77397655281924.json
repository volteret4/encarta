phys. This demonstrates a modern trend where genre snobbishness is decreasing, allowing for a broader appreciation of musical aesthetics across different rock subgenres. \"And today it's to the point where even hardcore new rock bands, alt rock bands, alternative bands like the Dropkick Murphy's are having fun recording AC DC songs.\"","year":null,"extra":{"from":"AC/DC","from_id":41020763354180,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Definition (from the vault)","url":"https://www.youtube.com/watch?v=Ft8nruhWCas"}]}],"charts":[{"id":248738328420012,"type":"album","name":"Do or Die","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank":15,"year":1998,"note":null,"yt":"1DDJEK_6_s4","scaruffi":null},{"id":259436174448768,"type":"album","name":"The Gang's All Here","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank":21,"year":1999,"note":null,"yt":"iPR9EjHMmok","scaruffi":null},{"id":130286358280597,"type":"album","name":"Mob Mentality","list_id":146697378391523,"list":"RYM Top — Rock — Oi!","src":"musthear","rank":85,"year":2000,"note":null,"yt":"GupYbriujn4","scaruffi":null},{"id":267026617652468,"type":"album","name":"Sing Loud, Sing Proud!","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank":16,"year":2001,"note":null,"yt":"u9t9gUwHzyU","scaruffi":null},{"id":250031954779237,"type":"album","name":"Blackout","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank":12,"year":2003,"note":null,"yt":"Bn7KsQPvkf4","scaruffi":null},{"id":121995526451955,"type":"album","name":"The Warrior's Code","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank":19,"year":2005,"note":null,"yt":"T456Izv8QJs","scaruffi":null},{"id":75158399474781,"type":"album","name":"The Meanest of Times","list_id":136255077334643,"list":"RYM Top — Rock — Celtic Punk","src":"musthear","rank"