296768148316,"type":"genre","name":"Digital Hardcore","n":2},{"id":166164464399388,"type":"genre","name":"Sa'idi","n":2},{"id":99248936442916,"type":"genre","name":"Hard Dance","n":2},{"id":75145648828276,"type":"genre","name":"Gangstarap","n":2},{"id":40300593204828,"type":"genre","name":"Folk Punk","n":2}],"labels":[{"id":207944876771206,"type":"label","name":"Own Label","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"}],"album_labels":[{"id":236286455240733,"type":"label","name":"Constellation","n":2}],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Collective Formed in 1994 (Montreal)","body":"Godspeed You! Black Emperor, a collective formed in Montreal in 1994, is fiercely independent with its own label and has garnered a global cult following. They are highly influential in the post-rock universe. \"In Montreal, there is Godspeed U-Black Emperor, a collective formed in 1994.\"","year":1994,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post-Rock? Part 1","url":"https://www.youtube.com/watch?v=pLf3kUONewg"}]},{"kind":"podcast","title":"Collaboration with Steve Albini","body":"The legendary producer Steve Albini, known for his work with Nirvana and Pixies, also worked on albums with Godspeed You! Black Emperor. \"This is from a 2009 album entitled Him to the Immortal Wind, which is a big fan favorite and recorded by the legendary Steve Elbeni, who did all those albums with Nirvana and the Pixies and the Breeders and Bush. And here we go again, Godspeed you, Black Emperor.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"podcast","title":"Continued Activity in the 90s","body":"The band, a Canadian group, continued their distinct musical approach into the late 1990s, further cementing their role in the post-rock scene. \"Canada's Godspeed U-Black Emperor kept doing whatever they were doing.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"podcast","title":"Dystopian, Political, Anarchist Themes","body":"The band's music and themes often explore dystopian, highly political, and even anarchist concepts. They are vocal supporters of prisoners and those wronged by society, extending their activism through numerous side projects. \"This can be dystopian, highly political, and even anarchist. They are also vocal supporters of prisoners and those who have been wronged by society, and there are tons of side projects all pursuing the same ends.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post-Rock? Part 1","url":"https://www.youtube.com/watch?v=pLf3kUONewg"}]},{"kind":"podcast","title":"Instrumental Music with Spoken Word","body":"Their music is mostly instrumental, but they incorporate spoken word monologues and field recordings to build mood, atmosphere, and crescendos over extended track lengths (often 20 minutes or more). \"Most of their stuff is instrumental, although they do make use of spoken word monologues in field recordings.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post-Rock? Part 1","url":"https://www.youtube.com/watch?v=pLf3kUONewg"}]},{"kind":"podcast","title":"Montreal Collective","body":"Godspeed You! Black Emperor is described as a Montreal collective that significantly contributed to defining post-rock in the 1990s. \"And because Grunge and everything else that went along with it opened people's ears to new ideas, we got bands like StereoLab and Tortoise and the wild Godspeed U-Black Emperor, the Montreal Collective, that went a long way towards defining what we're talking about here.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"podcast","title":"Recommended Post-Rock Band","body":"The band is explicitly listed as a recommendation for those wanting to explore post-rock further. \"If you want to go deeper, look into bands like Talk Talk, Slint, Barxide Coses, Tortoise, Magwai, Stereolab, Godspeed you, Black Amper, we always keep coming back to them.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"podcast","title":"Touring Partners","body":"Explosions in the Sky, a Texas-based post-rock band, toured with Godspeed You! Black Emperor. \"They've toured with nine-inch nails, Fugazi, and here's that name again, Godspeed, New Black Emperor.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"podcast","title":"Trent Reznor as a Fan","body":"Trent Reznor of Nine Inch Nails is noted as a major fan of Godspeed You! Black Emperor, highlighting their significant influence. \"And Trent Resner of Nine-East Nails is a major fan.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post-Rock? Part 1","url":"https://www.youtube.com/watch?v=pLf3kUONewg"}]}],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Touring Partners","body":"They have toured with notable bands such as Nine Inch Nails, Fugazi, and Godspeed You! Black Emperor. \"They've toured with nine-inch nails, Fugazi, and here's that name again, Godspeed, New Black Emperor.\"","year":null,"extra":{"from":"Explosions In The Sky","from_id":29559527086188,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post Rock? Part 2","url":"https://www.youtube.com/watch?v=9-v4qnOO8wY"}]},{"kind":"xref","title":"Trent Reznor's Band","body":"Trent Reznor, a major fan of Godspeed You! Black Emperor, is associated with Nine Inch Nails. \"And Trent Resner of Nine-East Nails is a major fan.\"","year":null,"extra":{"from":"Nine Inch Nails","from_id":2805971814642,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"What Exactly is Post-Rock? Part 1","url":"https://www.youtube.com/watch?v=pLf3kUONewg"}]}],"charts":[{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":118267099057662,"list":"AOTY Must Hear 1990s","src":"musthear","rank":119,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":136877365715781,"list":"Albums as Described by Spongebob Squarepants quotes","src":"musthear","rank":12,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","work_year":1997,"list_id":144801247485670,"list":"Pitchfork: The 150 Best Albums of the 1990s","src":"charts","rank":85,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":29313386906499,"list":"RYM Top — Dance — Digital Hardcore","src":"musthear","rank":52,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":235913166157674,"list":"RYM Top — Electronic — Hard Dance","src":"musthear","rank":52,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":52731136244071,"list":"RYM Top — Electronic — Hardcore","src":"musthear","rank":52,"year":1997,"note":null,"yt":"ft0v_NoeljQ","scaruffi":null},{"id":175330670880066,"type":"album","name":"F♯ A♯ ∞","list_id":9048144842230,"list":"RYM Top — Electronic — Synth Punk","src":"musthear","rank":52,"year":1997,"note":nu