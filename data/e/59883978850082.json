44726225,"name":"Billboard Year-End 1974","rank":42,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":42,"scaruffi":null}],"n_lists":2}},{"id":77843394913049,"type":"song","name":"Eli's Coming","artist":"Three Dog Night","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"For the Record - The 70s","n":1}],"lists":[],"n_lists":0}},{"id":185442343207124,"type":"song","name":"Old Fashioned Love Song","artist":"Three Dog Night","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"For the Record - The 70s","n":1}],"lists":[],"n_lists":0}}],"members":[{"id":244195765852424,"type":"artist","name":"Other two unnamed lead singers","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":232215491423164,"type":"artist","name":"Corey Wells","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"ensayos"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"},{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"ensayos"},{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"ensayos"},{"id":20619342488979,"type":"genre","name":"Funk","artist":null,"year":null,"weight":643,"yt":null,"src":"ensayos"}],"album_genres":[{"id":133646791193319,"type":"genre","name":"Laurel Canyon Scene","n":5},{"id":87379772038769,"type":"genre","name":"Blue-Eyed Soul","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Hit Machine (1968-1973)","body":"Three Dog Night established themselves as an early \"hit machine\" with ten Top 10 singles between 1968 and 1973, including three number one hits. They were also known for successfully recording songs by notable songwriters like Paul Williams, Laura Nyro, and Randy Newman. \"This band was an early hit machine. Ten top 10 singles between 1968 and 1973.\"","year":1968,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 39 - American Top 40 - Keeping Our Feet on the Ground and Reaching for the Stars (Part 1)","url":null}]},{"kind":"podcast","title":"Co-hosts of First New Year's Rockin' Eve (1972)","body":"Three Dog Night served as the co-hosts for the inaugural production of Dick Clark's New Year's Rockin' Eve in 1972. They performed their song \"Celebrate\" as the very first musical offering of the special. \"Dick Clark's New Year's Rock and Eve was first produced in 1972 with co-hosts Three Dog Night.\"","year":1972,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null}]},{"kind":"podcast","title":"Meeting Place for Donna Summer, Moroder, Bellotte (1973)","body":"American band Three Dog Night had a German recording session in 1973 where Donna Summer met Giorgio Moroder and Pete Bellotte, leading to the formation of their groundbreaking creative partnership. \"The three of them met at a German recording session for American band Three Dog Night in 1973.\"","year":1973,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"The Queen of Disco Edition Part 1 (Encore)","url":null}]},{"kind":"podcast","title":"First Song on American Top 40","body":"Three Dog Night holds the distinction of having their song \"Mama Told Me (Not To Come)\" played as the very first track on the radio show American Top 40 with Casey Kasem. \"Three Dog Night had the distinction of having the first song played on American top 40 with Casey Kasim, Mama told me not to come.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 47 - Dick Clark's Entertainment Empire","url":null}]},{"kind":"podcast","title":"Three Lead Singers","body":"A somewhat unusual characteristic of Three Dog Night was their lineup featuring three lead singers. Corey Wells, one of these vocalists, was instrumental in convincing his bandmates that \"Mama Told Me Not To Come\" had hit potential. \"One thing that's a bit unusual about three dog night is that they had three lead singers.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 39 - American Top 40 - Keeping Our Feet on the Ground and Reaching for the Stars (Part 1)","url":null}]},{"kind":"podcast","title":"Vocal Influences of Corey Wells","body":"Corey Wells, a lead singer for Three Dog Night, informed Ben Fong Torres of Rolling Stone in 1972 that his favorite singers were Otis Redding, Sam and Dave, and Al Green. These R&B influences were audibly present in the band's music, such as \"Mama Told Me Not To Come.\" \"He told Ben Fong Torres of Rolling Stone in 1972 that his favorite singers were Otis Redding, Sam and Dave and Al Green. You can hear that. You can hear the 60s R&B influence in this song.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 39 - American Top 40 - Keeping Our Feet on the Ground and Reaching for the Stars (Part 1)","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":136145867580458,"type":"album","name":"Three Dog Night","list_id":177455037556203,"list":"RYM Top — Scenes & Movements — Laurel Canyon Scene","src":"musthear","rank":149,"year":1968,"note":null,"yt":"crFz9GQ_Xec","scaruffi":null},{"id":228317751774256,"type":"song","name":"One","work_year":1969,"list_id":279209370709843,"list":"Billboard Year-End 1969","src":"singles","rank":11,"year":1969,"note":"","yt":"M8JO51TLGgg","scaruffi":null},{"id":158314714724572,"type":"song","name":"Easy to Be Hard","work_year":1969,"list_id":279209370709843,"list":"Billboard Year-End 1969","src":"singles","rank":33,"year":1969,"note":"","yt":"adPIeQDeCsU","scaruffi":null},{"i