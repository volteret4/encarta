{"id":167452234349515,"type":"album","name":"All Things Must Pass","artist":"George Harrison","year":1970,"weight":83,"info":{"cover":"https://dn710700.ca.archive.org/0/items/mbid-f953e75a-83b2-3e70-8454-40f546b04a52/mbid-f953e75a-83b2-3e70-8454-40f546b04a52-8094800915.jpg","kind":"Album","tracks":9,"country":"US","aoty":96,"aoty_user":90,"yt":"bEoaZc7pY4M","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/george-harrison/all-things-must-pass","aoty":"https://www.albumoftheyear.org/album/6083-george-harrison-all-things-must-pass.php"},"desc":"All Things Must Pass is a triple album by English musician George Harrison. Released in November 1970, it includes the hit singles \"My Sweet Lord\" and \"What Is Life\", as well as songs such as \"Isn't It a Pity\" and the title track that were turned down by Harrison's former band, the Beatles. The album reflects the influence of his musical activities outside the Beatles during 1968–70 – with Bob Dylan, the Band, Delaney & Bonnie, Billy Preston and others – and Harrison's growth as an artist beyond his supporting role to former bandmates John Lennon and Paul McCartney. The ."},"artist_ref":{"id":131487512348058,"name":"George Harrison","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/George_Harrison_1974_%28cropped%29.jpg?width=500"}},"labels":[],"genres":[{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear,rym"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear,rym"},{"id":151519479822379,"type":"genre","name":"gospel","artist":null,"year":null,"weight":255,"yt":null,"src":"musthear"},{"id":141164231500862,"type":"genre","name":"Psychedelic Pop","artist":null,"year":null,"weight":245,"yt":null,"src":"musthear"},{"id":190589917177789,"type":"genre","name":"Jam Band","artist":null,"year":null,"weight":212,"yt":null,"src":"musthear"},{"id":207755761847598,"t