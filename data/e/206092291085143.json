{"id":206092291085143,"type":"album","name":"Chelsea Girl","artist":"Nico","year":1967,"weight":11,"info":{"cover":"https://dn711300.ca.archive.org/0/items/mbid-25e398a4-8a0a-4ab3-9d0d-128dc6106511/mbid-25e398a4-8a0a-4ab3-9d0d-128dc6106511-23069826567.png","kind":"Album","tracks":10,"country":"XW","yt":"hpSizAu5CW0","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/nico/chelsea-girl"},"desc":"Chelsea Girl is the debut solo studio album by German singer Nico, released on October 1967, through Verve Records. The album recorded following Nico's collaboration with the Velvet Underground on their 1967 debut studio album. The title is a reference to Andy Warhol's 1966 film Chelsea Girls, in which Nico starred. Much of the album features instrumental work and songwriting credits from Velvet Underground members Lou Reed, Sterling Morrison and John Cale. The song \"I'll Keep It with Mine\" was written by Bob Dylan, while three songs are by Jackson Browne, who contributes guitar. ."},"artist_ref":{"id":58559097956203,"name":"Nico","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Velvet_Underground_%26_Nico_publicity_photo_%28retouched%29_%28cropped%29.jpg?width=500"}},"labels":[],"genres":[{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"musthear"},{"id":258906480523511,"type":"genre","name":"Baroque Pop","artist":null,"year":null,"weight":269,"yt":null,"src":"musthear"},{"id":153170436375,"type":"genre","name":"Chamber Folk","artist":null,"year":null,"weight":219,"yt":null,"src":"rym"}],"lists":[{"id":108997246366764,"name":"RYM Top — Folk — Chamber Folk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":34,"year":null,"note":null,"total":200,"scaruffi":null},{"id":32093215757431,"name":"Pitchfork: The 200 Best Albums of the 1960s","src":"musthear