"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":107432201760054,"name":"RYM Top — Rock — Beat","rank":181,"scaruffi":null}],"n_lists":1}},{"id":127443704813736,"type":"song","name":"Anyway You Want It","artist":"Dave Clark Five","year":null,"weight":7,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":2}],"lists":[],"n_lists":0}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":10205813290158,"type":"genre","name":"Beat","n":10}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Bobby Graham's Uncredited Drumming","body":"Bobby Graham, a session drummer for The Kinks, is \"now best known\" for performing all the drumming that was credited to Dave Clark on records by The Dave Clark Five, including hits like \"Bits and Pieces.\" \"Graham is now best known for having done all the drumming credited to Dave Clark on records by the Dave Clark 5, such as bits and pieces.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 119: \"You Really Got Me\" by the Kinks","url":"https://www.youtube.com/watch?v=_XNJ6Qwmh_c"}]},{"kind":"podcast","title":"First Kinks Tour Companions","body":"The Kinks embarked on their \"first big tour\" sharing the bottom of the bill with The Dave Clark Five and The Hollies, who were positioned higher up. This tour marked Mick Avory's first live performances with The Kinks. \"playing on the bottom of the bill with the Dave Clark Faye from the Hollies further up.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 119: \"You Really Got Me\" by the Kinks","url":"https://www.youtube.com/watch?v=_XNJ6Qwmh_c"}]}],"awards":[{"kind":"award","title":"Rock and Roll Hall of Fame (2008)","body":"Won.","year":2008,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q179191"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Anyway You Want It (1996) – Dave Clark Five Cover with Eddie Vedder","body":null,"year":1996,"extra":{"from":"The Ramones","from_id":196070018852501,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Ongoing History Book of Lasts","url":"https://www.youtube.com/watch?v=Epz5Sn151bk"}]},{"kind":"xref","title":"Anyway You Want It (1996) – Performance with Ramones","body":null,"year":1996,"extra":{"from":"Eddie Vedder","from_id":280885039056347,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Ongoing History Book of Lasts","url":"https://www.youtube.com/watch?v=Epz5Sn151bk"}]},{"kind":"xref","title":"Final Concert (August 6, 1996) – The Palace, Hollywood","body":"The Ramones played their 2263rd and final gig on August 6, 1996, at The Palace in Hollywood, planned as a celebration of their career. By the 1990s, the band was finally being recognized as pioneers by alternative artists like Pearl Jam, Green Day, and Nirvana. The farewell included dates on the Lollapalooza tour that year, performing alongside Metallica and Soundgarden. Lemmy of Motorhead attended, and Eddie Vedder joined them on stage for their last song, a cover of Dave Clark Five's \"Anyway You Want It.\" The band members simply walked off stage without a farewell speech after the final song. \"That final show was on August 6th of 1996. All kinds of people came to pay their respects, including Lemmy of Motorhead.\"","year":1996,"extra":{"from":"The Ramones","from_id":196070018852501,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Ongoing History Book of Lasts","url":"https://www.youtube.com/watch?v=Epz5Sn151bk"}]}],"charts":[{"id":251533872554433,"type":"song","name":"Glad All Over","work_year":1964,"list_id":161507989025637,"list":"Billboard Year-End 1964","src":"singles","rank":23,"year":1964,"note":"","yt":"NHtNFaa2ne0","scaruffi":null},{"id":2