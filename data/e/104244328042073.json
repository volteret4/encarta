l,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":264964061812397,"type":"artist","name":"Johnny Bennett and the Rock & Roll trio (backing band)","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"genres":[],"album_genres":[{"id":57634881244651,"type":"genre","name":"Skiffle","n":9},{"id":156493887492965,"type":"genre","name":"Second British Folk Revival","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":133200493093823,"name":"Rock'n'roll","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1951,"end":1957,"desc":"Fusión de rhythm'n'blues y country, con mucho más peso del primero. Chuck Berry inventa en 1955 el rock'n'roll tal como se conocerá durante cincuenta años (la guitarra como instrumento protagonista, canciones propias que hablan a los adolescentes); Bo Diddley aporta el ritmo «hambone», Little Richard y Esquerita el histerismo y el maquillaje (el primer «decadence-rock»), Jerry Lee Lewis el piano feroz y Sun Records el rockabilly. Elvis Presley es, para Scaruffi, «la primera gran estafa del rock'n'roll». Buddy Holly y Eddie Cochran abren otra vía; en paralelo nacen el soul (Ray Charles), la exótica (Martin Denny, Esquivel), la música electrónica de cinta y, en Gran Bretaña, el skiffle.","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#rocknroll"}],"book_tracks":[{"id":218075186486054,"artist":"Lonnie Donegan","artist_id":104244328042073,"title":"Rock Island Line","year":1955,"ess":0,"yt":"wI4nRD-DRpk","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Rock'n'roll","scene_id":133200493093823,"scene_link":"https://volteret4.github.io/scaruffi/#rocknroll","chapters":["Sección 2.2"],"pages":[[1,15,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":15,"text":"…of fast-paced, exuberant and melodic jug-music performed with traditional blues instruments such as washboard and kazoo, that had been imported by Lonnie Donegan's Rock Island Line (1955). • 1951: China annexes Tibet • 1951: first color TV transmissions • 1951: the first commercial computer is built, the…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":311,"text":"…loner and sometimes juvenile delinquent ？ Pete Seeger releases the first album of African music by a white musician, Bantu Choral Folk Songs ？ Lonnie Donegan's Rock Island Line launches a new genre in Britain, \"skiffle\" ？ Hungarian composer Georg Ligeti, while studying at Cologne, coins a \"texture music\"…"}],"podcast":[{"kind":"podcast","title":"US Tour with Guitar (1957)","body":"In 1957, as part of a \"one-in, one-out\" exchange agreement between the musicians' unions that allowed American rock and roll group Bill Haley and the Comets to tour the UK, Lonnie Donegan was again permitted to tour the US. Crucially, this time he was allowed to play his guitar. \"Similarly, when Bill Haley and the Comets became the first American Rock & Roll group to toured the UK, in 1957, Lonnie Donigan was allowed to toured the US again, and this time he could play his guitar.\"","year":1957,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"REUPLOAD Episode 71: \"Willie and the Hand Jive\" by Johnny Otis","url":"https://www.youtube.com/watch?v=Ez6BCUlI6Rg"}]},{"kind":"podcast","title":"US Tour Restrictions (Post-Rock Island Line)","body":"When Lonnie Donegan toured the US following the success of \"Rock Island Line,\" he was permitted to sing but was explicitly \"not allowed to play guitar\" due to the strict mutual protectionist agreement between the American and British musicians' unions. \"Dunnegan was allowed to sing, but not allowed to play guitar.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"REUPLOAD Episode 71: \"Willie and the Hand Jive\" by Johnny Otis","url":"https://www.youtube.com/watch?v=Ez6BCUlI6Rg"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":218075186486054,"type":"song","name":"Rock Island Line","work_year":1956,"list_id":187149301118433,"list":"Billboard Year-End 1956","src":"singles","rank":50,"year":1956,"note":"","yt":"wI4nRD-DRpk","scaruffi":null},{"id":218075186486054,"type":"song","name":"Rock Island Line","work_year":1956,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":50,"year":1956,"note":null,"yt":"wI4nRD-DRpk","scaruffi":null},{"id":56086194690154,"type":"album","name":"Lonnie Donegan Showcase","list_id":210060755828393,"list":"RYM Top — Folk — Skiffle","src":"musthear","rank":1,"year":1956,"note":null,"yt":"YMQYDz2mGsk","scaruffi":null},{"id":56086194690154,"type":"album","name":"Lonnie Donegan Showcase","list_id":233564640149435,"list":"RYM Top — Scenes & Movements — Second British Folk Revival","src":"musthear","rank":200,"year":1956,"note":null,"yt":"YMQYDz2mGsk","scaruffi":null},{"id":9681895074908,"type":"song","name":"Cumberland Gap","work_year":1957,"list_id":95472960493301,"list":"UK nº1 · 1950s","src":"singles","rank":57,"year":1957,"note":"5 semanas","yt":"jWA997xM9MI","scaruffi":null},{"id":205398093793176,"type":"song","name":"Gamblin' Man / Puttin' On the Style","work_year":1957,"list_id":95472960493301,"list":"UK nº1 · 1950s","src":"singles","rank":61,"year":1957,"note":"2 semanas","yt":"l0t2wjMe4i8","scaruffi":null},{"id":108569279636999,"type":"album","name":"Lonnie","list_id":210060755828393,"list":"RYM Top — Folk — Skiffle","src":"musthear","rank":7,"year":1958,"note":null,"yt":"00KEm3mj3zk","scaruffi":null},{"id":240608410563270,"type":"album","name":"Lonnie Rides Again","list_id":210060755828393,"list":"RYM Top — Folk — Skiffle","src":"musthear","rank":5,"year":1959,"note":null,"yt":"kSK10gpWzvc","