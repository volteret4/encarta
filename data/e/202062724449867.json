{"id":202062724449867,"type":"album","name":"Untrue","artist":"Burial","year":2007,"weight":93,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/403-untrue_030405.jpg","aoty":92,"aoty_user":85,"sputnik":4.26,"yt":"GrChfkWDq9o","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/burial/untrue-5/","aoty":"https://www.albumoftheyear.org/album/403-burial-untrue.php","sputnikmusic":"https://www.sputnikmusic.com/album/22440/Burial-Untrue/"},"desc":"Untrue is the second album by the formerly-anonymous-but-now-unmasked dubstep producer known as Burial. It was released on November 4th, 2007 as a 13-track Digipack CD and a nine-track 2xLP from which some of the beatless pieces were edited. The album received a large amount of praise from many publications: It was named the best album of 2007 by Sputnikmusic, the 2nd best by The Wire, the 8th by Tiny Mix Tapes, and 10th by Pitchfork Media. It is also the second highest rated album of 2007 according to the review averaging website, Metacritic. ."},"artist_ref":{"id":14571947825848,"name":"The Burial","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Burial1.svg?width=500"}},"labels":[],"genres":[{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"musthear"},{"id":55791901681639,"type":"genre","name":"Dubstep","artist":null,"year":null,"weight":260,"yt":null,"src":"musthear,rym"},{"id":217500735850052,"type":"genre","name":"Future Garage","artist":null,"year":null,"weight":206,"yt":null,"src":"musthear,rym"},{"id":113318565466344,"type":"genre","name":"hauntology","artist":null,"year":null,"weight":33,"yt":null,"src":"musthear"},{"id":207755761847598,"type":"genre","name":"Hardcore","artist":null,"year":null,"weight":540,"yt":null,"src":"rym"},{"id":181296768148316,"type":"genre","name":"Digital Hardcore","artist":null,"year":null,"weight":404,"yt":null,"src":"rym"},{"id":99248936442916,"type":"genre","name":"Hard Dance","artis