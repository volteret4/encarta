{"id":263548810867352,"type":"album","name":"Odyssey","artist":"HOME","year":2014,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/113274-odyssey_190718.jpg","aoty":80,"yt":"1yJ5GGt7F-c","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/home/odyssey","aoty":"https://www.albumoftheyear.org/album/113274-home-odyssey.php"},"desc":"Odyssey is Home's second album, released on July 1, 2014. It contains twelve tracks, ranging from three to five minutes in length, with the exception of the titular track \"Odyssey\", which is over six minutes. The album was released in 2016 as a physical black vinyl disc before selling out. It featured all the original songs, alternative artwork, and 5 previously unreleased demos as bonus tracks to conclude the album. It was later re-released as a translucent orange vinyl, which also sold out. The five bonus tracks are entitled \"Flatline\", \"Heading Up\", \"Oracle\", \"Rains\", \"Soak\" and \"Somewhere in Silence\". ."},"artist_ref":{"id":59052365247220,"name":"Home","info":{"img":"https://cdn-images.dzcdn.net/images/artist/e23066163f21176a822b54001ee648a2/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":55143051280122,"type":"genre","name":"Indietronica","artist":null,"year":null,"weight":225,"yt":null,"src":"rym"},{"id":220879654471976,"type":"genre","name":"Chillwave","artist":null,"year":null,"weight":222,"yt":null,"src":"rym"},{"id":188582154918049,"type":"genre","name":"Synthwave","artist":null,"year":null,"weight":208,"yt":null,"src":"rym"},{"id":247041107475698,"type":"genre","name":"Chillsynth","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"}],"lists":[{"id":164866906706039,"name":"RYM Top — Electronic — Chillsynth","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":200,"scaruffi":null},{"id":106432725883025,"name":"RYM Top — Electronic — Synthwave","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":2,"year":nul