:[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Grammy Win with Silk Sonic (2022)","body":"Anderson .Paak won a Grammy in 2022 as part of the retro-style duo project Silk Sonic, alongside Bruno Mars, who continued his trend of repeat wins. \"Bruno took the prize with his retro style Anderson Pock Duo Project Silk Sonic.\"","year":2022,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"And the Grammy Goes to… Edition Part 2","url":null}]},{"kind":"podcast","title":"Chemistry with Bruno Mars","body":"Critics widely admired Anderson .Paak's chemistry with Bruno Mars on their Silk Sonic debut album, \"An Evening with Silk Sonic.\" Their musical and performance synergy was noted as contributing to the album's success and positive reception. \"Critics found the music cheeky but also sincere and admired Bruno's chemistry with Anderson Pock.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Lenny on Mars Edition Part 2","url":null}]},{"kind":"podcast","title":"Collaboration with Bruno Mars","body":"West Coast rapper Anderson .Paak announced in 2021 that he had recorded an album with Bruno Mars as a duo under the group name Silk Sonic, where they effectively \"play acted the roles of 70s style soulman.\" This collaboration marked a significant new project for both artists, doubling down on classic Black music tropes. \"And in 2021, Mars and his friend and collaborator, West Coast rapper Anderson Pock, announced that they had recorded an album as a duo under the group name Silk Sonic.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Lenny on Mars Edition Part 2","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":206834596013052,"type":"album","name":"Malibu","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":443,"year":2016,"note":null,"yt":"ferZnZ0_rSM","scaruffi":null},{