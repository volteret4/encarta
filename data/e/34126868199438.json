r":null,"weight":240,"yt":null,"src":"ensayos"}],"album_genres":[{"id":89886331015150,"type":"genre","name":"Jazz Fusion","n":6},{"id":265524373450282,"type":"genre","name":"jazz","n":3},{"id":209337655829349,"type":"genre","name":"ECM Style Jazz","n":2},{"id":239592851871117,"type":"genre","name":"Downtempo","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":70279236005425,"name":"Fusión jazz-rock","book":"Historia del jazz","author":"Ted Gioia","start":1967,"end":1995,"desc":"El jazz siempre fue fusión («nada de lo que venga de Nueva Orleans es puro»), pero desde Bitches Brew (400.000 copias el primer año) la palabra significa jazz con rock, y amplía la base económica de todo el jazz en los setenta. Miles sigue con discos crudos montados por Teo Macero (Jack Johnson, Live-Evil, On the Corner) y acaba de telonero de los Headhunters de Herbie Hancock. Sus antiguos músicos fundan los grupos clave: Return to Forever de Chick Corea (sabor latino, «Spain»), la Mahavishnu Orchestra de John McLaughlin (rock a lo Hendrix, música india) y Weather Report de Zawinul y Shorter, una estética de Ellington aplicada al pop electrónico, con el bajo de Jaco Pastorius («Birdland»). Del lado del rock: Blood, Sweat & Tears, Chase, Hendrix, Sly Stone y Frank Zappa. Luego llegan el jazz pulido para la radio, Spyro Gyra y Kenny G, el M-Base de Steve Coleman y Cassandra Wilson, el acid jazz de Londres y US3, y el último Miles con el hip hop de doo-bop. Pat Metheny es el guitarrista más visionario del estilo.","color":"#a3e635","family":"Fusión: jazz-rock, ECM y músicas del mundo","link":"https://volteret4.github.io/jazz/#fusion-jazz-rock"}],"book_tracks":[{"id":124763712717970,"artist":"Pat Metheny Group","artist_id":34126868199438,"title":"Still Life (Talking)","year":1987,"ess":0,"yt":"6_Qw__Rrbok","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Fusión jazz-rock","scene_id":70279236005425,"