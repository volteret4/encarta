{"id":34126868199438,"type":"artist","name":"Pat Metheny Group","artist":null,"year":null,"weight":16,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Steve_Rodby_and_Pat_Metheny.jpg?width=500","bio":"El Pat Metheny Group (también conocido como PMG) es un grupo de jazz y jazz fusion fundado en 1977. Los principales miembros del grupo son el guitarrista y líder de la banda Pat Metheny, el compositor, teclista y pianista Lyle Mays y el bajista y productor Steve Rodby. Entre otros miembros está Paul Wertico, que fue el batería del grupo durante 18 años.\n\nEn la Universidad de Miami, Pat Metheny, conoció al que luego sería el legendario bajista, Jaco Pastorius.","tags":["jazz","Fusion","jazz fusion","guitar","jazz guitar"]},"works":[{"id":24057156250787,"type":"album","name":"Pat Metheny Group","artist":"Pat Metheny Group","year":1978,"weight":5,"yt":"gMwSRJH46jg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":235110983059095,"name":"RYM Top — Jazz — Jazz Fusion","rank":46,"scaruffi":null},{"id":272662666892682,"name":"RYM Top — Jazz — ECM Style Jazz","rank":4,"scaruffi":null}],"n_lists":2}},{"id":247532976056935,"type":"album","name":"Offramp","artist":"Pat Metheny Group","year":1982,"weight":5,"yt":"_4GyNmXHpIc","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":235110983059095,"name":"RYM Top — Jazz — Jazz Fusion","rank":119,"scaruffi":null},{"id":272662666892682,"name":"RYM Top — Jazz — ECM Style Jazz","rank":19,"scaruffi":null}],"n_lists":2}},{"id":133548981473656,"type":"song","name":"This Is Not America","artist":"Pat Metheny Group","year":1985,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"Hit Parade Music History and Music Trivia","n":1}],"lists":[],"n_lists":0}},{"id":124763712717970,"type":"album","name":"Still Life (Talking)","artist":"Pat Metheny Group","year":1987,"weight":9,"yt":"MxAbaMqxZec","src":"books,musthear","from":{"books":[{"name":"Historia del jazz","title":"Histori