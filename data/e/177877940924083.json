{"id":177877940924083,"type":"album","name":"downward is heavenward","artist":"Hum","year":1998,"weight":14,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/30342-downward-is-heavenward-1.jpg","aoty":87,"aoty_user":84,"yt":"HsNyU0kkJaM","links":{"aoty":"https://www.albumoftheyear.org/album/30342-hum-downward-is-heavenward.php"},"desc":"Downward Is Heavenward is the fourth studio album by the Champaign, Illinois alternative rock band Hum. Downward Is Heavenward was recorded in 1997, and first released on January 27, 1998, by RCA Records. Some websites such as AllMusic list it as being a 1997 album rather than a 1998 album, presumably because all versions of the album bear a 1997 copyright date. The title of the album appears as a lyric in \"Afternoon with the Axolotls\". Despite selling fewer copies than its predecessor You'd Prefer an Astronaut, the album was critically acclaimed. ."},"artist_ref":{"id":125007946400060,"name":"Hum","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"rym"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","artist":null,"year":null,"weight":714,"yt":null,"src":"rym"},{"id":237890000566646,"type":"genre","name":"Post-Hardcore","artist":null,"year":null,"weight":341,"yt":null,"src":"rym"}],"lists":[{"id":199353246998089,"name":"Sputnikmusic Best Albums 1998","src":"charts","grp":"sputnikmusic","list_year":null,"rank":27,"year":1998,"note":null,"total":200,"scaruffi":null},{"id":15546028624161,"name":"RYM Top — Rock — Post-Hardcore","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":36,"year":null,"note":null,"total":200,"scaruffi":null},{"id":79201857171461,"name":"RYM Top — Rock — Hardcore [Punk]","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":50,"year":null,"note"