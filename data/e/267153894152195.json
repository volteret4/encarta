{"id":267153894152195,"type":"artist","name":"Dog Faced Hermans","artist":null,"year":null,"weight":10,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/219181767b5d65e6b92ca12655f1dd38/1000x1000-000000-80-0-0.jpg","bio":"Originarios de Edimburgo, Escocia en 1986 pero afincados en Amsterdam, los Dog Faced Hermans fueron una banda catalogada como \"Prunk-Folk-Progressive-Noise\". A esto se agrega el hecho de utilizar instrumentaciones no convencionales, ser grandes amigos de los maravillosos The Ex  y tener como vocalista a una mujer de bizarra personalidad, lo que completa el cocktail.\nTras sacar cuatro álbumes de estudio, varios EPs y álbumes en vivo, se separaron en 1995.","tags":["post-punk","no wave","Avant-Garde","anarcho-punk","punk"]},"works":[{"id":52489019675264,"type":"album","name":"Humans Fly","artist":"Dog Faced Hermans","year":1988,"weight":9,"yt":"NZL9dSOlGis","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":70166951544843,"name":"RYM Top — Rock — Art Punk","rank":133,"scaruffi":null}],"n_lists":1}},{"id":74418867727892,"type":"album","name":"Every Day Timebomb","artist":"Dog Faced Hermans","year":1989,"weight":9,"yt":"J4XA-o1vw9c","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":70166951544843,"name":"RYM Top — Rock — Art Punk","rank":63,"scaruffi":null}],"n_lists":1}},{"id":97717828078737,"type":"album","name":"Mental Blocks for All Ages","artist":"Dog Faced Hermans","year":1991,"weight":11,"yt":"LcdcKXTu3gI","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":70166951544843,"name":"RYM Top — Rock — Art Punk","rank":51,"scaruffi":null},{"id":182218712006755,"name":"RYM Top — Rock — Post-Punk","rank":158,"scaruffi":null}],"n_lists":2}},{"id":12