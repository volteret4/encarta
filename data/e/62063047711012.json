{"id":62063047711012,"type":"album","name":"Stakes Is High","artist":"De La Soul","year":1996,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/17007-stakes-is-high-1.jpg","aoty":71,"aoty_user":87,"yt":"P6fng8uHtBw","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/de-la-soul/stakes-is-high","aoty":"https://www.albumoftheyear.org/album/17007-de-la-soul-stakes-is-high.php"},"desc":"Stakes Is High is De La Soul's fourth full-length album, released on July 2, 1996. The album marked a change in the group's sound and direction as it was their first release not to be produced in collaboration with Prince Paul. Stakes Is High was mainly produced by the group themselves with additional tracks provided by Jay Dee, DJ Ogee, Spearhead X and Skeff Anslem. It is considered to be the group's darkest and most serious album in terms of subject matter and production. ."},"artist_ref":{"id":45661823481623,"name":"De La Soul","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/De_La_Soul_by_foto_di_matti.jpg?width=500"}},"labels":[],"genres":[{"id":26869950655266,"type":"genre","name":"Conscious Hip Hop","artist":null,"year":null,"weight":252,"yt":null,"src":"rym"},{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"}],"lists":[{"id":16699661381161,"name":"RYM Top — Hip Hop — Conscious Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":23,"year":null,"note":null,"total":200,"scaruffi":null},{"id":45584128953585,"name":"RYM Top — Scenes & Movements — East Coast Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":33,"year":null,"note":null,"total":200,"scaruffi":null},{"id":43654442755664,"name":"RYM Top — Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":80,"year":null,"note":null,"total":200,"scaruffi":null},{"id":255227989163511,"name":"RYM Top — Scenes & Movements","src":"musthear","grp":"rateyour