{"id":38100631130362,"type":"artist","name":"The Appleseed Cast","artist":null,"year":null,"weight":10,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/10c816451d1d278d91732af524843173/1000x1000-000000-80-0-0.jpg","bio":"The Appleseed Cast es una banda post-rock, proveniente de Lawrence, Kansas compuesta por Christopher Crisci (voz), Aaron Pillar (guitarra), Marc Young (bajo), Aaron Coker (bateria).\nEn 1998 lanzaron su primer almbum \" The End of the Ring Wars\", el cual tuvo bastante reconocimiento en la escena emo de la epoca, apesar de sus parecidos con otras bandas mas influyentes de ese entonces, como Sunny Day Real State o Braid.\nEn 1999, sacaron Mare Vitalis","tags":["post-rock","indie","emo","indie rock","alternative"]},"works":[{"id":8520608350200,"type":"album","name":"The End of the Ring Wars","artist":"The Appleseed Cast","year":1998,"weight":3,"yt":"d8MYmdm2qWE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":224729159309899,"name":"RYM Top — Rock — Midwest Emo","rank":95,"scaruffi":null}],"n_lists":1}},{"id":164381410809835,"type":"album","name":"Mare Vitalis","artist":"The Appleseed Cast","year":2000,"weight":16,"yt":"50MbYqauyZI","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":44456762010629,"name":"Sputnikmusic Best Albums 2000","rank":86,"scaruffi":null},{"id":46410313403407,"name":"RYM Top — Rock — Post-Rock","rank":189,"scaruffi":null},{"id":224729159309899,"name":"RYM Top — Rock — Midwest Emo","rank":65,"scaruffi":null}],"n_lists":3}},{"id":37095437037968,"type":"album","name":"Low Level Owl: Volume I","artist":"The Appleseed Cast","year":2001,"weight":3,"yt":"eLYfjFSfNfs","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":224729159309899,"name":"RYM Top — Rock — Midwest Emo","rank":137,"scaruffi":null}],"n_lists":1}},{"id":214466326956647,"type":"album","name":"Low Level Owl: Volume II","artist"