 promised to deliver. \"The first test pressing, a CD used to demonstrate the new technology, was a recording of the Berlin Philharmonic, conducted by Herbert von Karrihan, performing Richard Strauss' and Elpine Symphony. This appeared in 1979, and this recording was chosen for its clarity and wide range of dynamics, something that the compact is promised.\"","year":1979,"extra":{"from":"Berlin Philharmonic","from_id":192006071219547,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Rise and Fall of the CD","url":"https://www.youtube.com/watch?v=BHkJFA0LMro"}]}],"charts":[{"id":44666035110396,"type":"album","name":"Vier letzte Lieder; Duets From \"Arabella\"","list_id":123282505298412,"list":"RYM Top — Regional Music — German Music","src":"musthear","rank":149,"year":1954,"note":null,"yt":"vUmVcdPvnTk","scaruffi":null},{"id":44666035110396,"type":"album","name":"Vier letzte Lieder; Duets From \"Arabella\"","list_id":150880377984844,"list":"RYM Top — Regional Music — Lied","src":"musthear","rank":57,"year":1954,"note":null,"yt":"vUmVcdPvnTk","scaruffi":null},{"id":267890622576542,"type":"album","name":"Salome","list_id":187436681225040,"list":"RYM Top — Classical Music — Opera","src":"musthear","rank":4,"year":1962,"note":null,"yt":"YVR3dQKTQTI","scaruffi":null},{"id":267890622576542,"type":"album","name":"Salome","list_id":279116185267176,"list":"RYM Top — Scenes & Movements — Romanticism","src":"musthear","rank":24,"year":1962,"note":null,"yt":"YVR3dQKTQTI","scaruffi":null},{"id":259272957152017,"type":"album","name":"Vier letzte Lieder; Muttertändelei; Waldseligkeit; Zueignung; Freundliche Vision; Die heiligen drei Könige","list_id":53134796196795,"list":"RYM Top — Classical Music — Art Song","src":"musthear","rank":6,"year":1966,"note":null,"yt":"VZwCJn-6DSs","scaruffi":null},{"id":259272957152017,"type":"album","name":"Vier letzte Lieder; Muttertändelei; Waldseligkeit; Zueignung; Freundliche Vision; Die heiligen drei Könige","li