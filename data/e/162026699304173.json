{"id":162026699304173,"type":"album","name":"Selmasongs","artist":"Björk","year":2000,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/5799-selmasongs_211351.jpg","aoty":73,"aoty_user":81,"yt":"YYPbUJSLyW4","links":{"aoty":"https://www.albumoftheyear.org/album/5799-bjork-selmasongs.php"},"desc":"Selmasongs is the first soundtrack album by Icelandic musician Björk. It was released on September 18, 2000, by One Little Indian Records to promote and accompany the film Dancer in the Dark. In the film, Björk starred as Selma Ježková, a Czech immigrant who has moved to the United States. The album features classical arrangements, as well as melodies and beats composed of sounds from mundane objects, such as factory machines and trains. ."},"artist_ref":{"id":158197663535109,"name":"Bjork","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bj%C3%B6rk_at_Cannes.jpg?width=500"}},"labels":[],"genres":[],"lists":[{"id":44735175437010,"name":"AOTY Must Hear 2000s","src":"charts","grp":"AOTY","list_year":null,"rank":489,"year":2000,"note":null,"total":520,"scaruffi":null}],"podcast":[],"book_tracks":[{"id":162026699304173,"artist":"Bjork","artist_id":158197663535109,"title":"Selmasongs","year":2000,"ess":0,"yt":"k636xkXkWwg","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cantautoras de los noventa","scene_id":198167102636761,"scene_link":"https://volteret4.github.io/scaruffi/#women-90s","chapters":["Sección 6.6"],"pages":[[1,254,null]]}],"others":[{"id":205117217966799,"type":"album","name":"Vespertine","year":2001,"weight":79},{"id":131150095098912,"type":"album","name":"Debut","year":1993,"weight":72},{"id":95441141924301,"type":"album","name":"Homogenic","year":1997,"weight":71},{"id":31419824613782,"type":"album","name":"Post","year":1995,"weight":65},{"id":178006080253613,"type":"album","name":"Utopia","year":2017,"weight":37},{"id"