{"id":66228533427430,"type":"album","name":"Deltron 3030","artist":"Deltron 3030","year":2000,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/8331-deltron-3030.jpg","aoty":82,"aoty_user":88,"sputnik":4.33,"yt":"u9HQ0pbHcCw","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/deltron-3030/deltron-3030","aoty":"https://www.albumoftheyear.org/album/8331-deltron-3030-deltron-3030.php","sputnikmusic":"https://www.sputnikmusic.com/album/1451/Deltron-3030-Deltron-3030/"},"desc":"Deltron 3030 is the debut album by the hip hop supergroup of the same name: rapper Del the Funky Homosapien, producer Dan the Automator, and DJ Kid Koala. It was released on May 23, 2000 by 75 Ark. The album was reissued on July 1, 2008 with 3 bonus remixes. The album's cover features a photograph of the Perisphere, a structure constructed for the 1939 New York World's Fair. It is a rap opera concept album set in a dystopian year 3030. The album's story casts Del in the role of Deltron Zero, a disillusioned mech soldier and interplanetary computer ."},"artist_ref":{"id":14121996717552,"name":"Deltron 3030","info":{"img":null}},"labels":[],"genres":[{"id":167455165178139,"type":"genre","name":"West Coast Hip Hop","artist":null,"year":null,"weight":226,"yt":null,"src":"rym"},{"id":69149423353287,"type":"genre","name":"Abstract Hip Hop","artist":null,"year":null,"weight":224,"yt":null,"src":"rym"}],"lists":[{"id":74398601725713,"name":"RYM Top — Scenes & Movements — West Coast Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},{"id":96087554392730,"name":"RYM Top — Hip Hop — Abstract Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":7,"year":null,"note":null,"total":200,"scaruffi":null},{"id":44456762010629,"name":"Sputnikmusic Best Albums 2000","src":"charts","grp":"sputnikmusic","list_year":null,"rank":10,"year":2000,"note":null,"total":200,"scaruffi":null},{"id":4