e":"Boogie Rock","n":5},{"id":133646791193319,"type":"genre","name":"Laurel Canyon Scene","n":4},{"id":211270792239401,"type":"genre","name":"Roots Rock","n":2},{"id":186201380116213,"type":"genre","name":"classic rock","n":2},{"id":226957794705172,"type":"genre","name":"Country Blues","n":1},{"id":202159817309393,"type":"genre","name":"blues","n":1},{"id":157953610416146,"type":"genre","name":"Swamp Rock","n":1},{"id":90510611927654,"type":"genre","name":"Country Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":277196802515577,"name":"Country-rock y roots-rock","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1968,"end":1975,"desc":"En los setenta, el reajuste a los viejos valores (blues, folk, country) convierte al rock en uno de los mayores éxitos del consumismo: el Establishment ya no intenta destruirlo, lo absorbe. El country-rock de Gram Parsons es una moda enorme: Commander Cody, New Riders Of The Purple Sage, Manassas, Nitty Gritty Dirt Band, Poco y los Eagles (Desperado, Hotel California); en Nashville surgen los «outlaws» (Waylon Jennings, Willie Nelson, Kris Kristofferson). El roots-rock sigue con Hot Tuna, Little Feat y Doobie Brothers, y la nostalgia recupera el blues (Roy Buchanan, Bonnie Raitt), la armonía vocal (Manhattan Transfer, Roches, McGarrigle Sisters) y los cincuenta (American Graffiti).","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#country-rock"}],"book_tracks":[{"id":280406037522677,"artist":"Little Feat","artist_id":75074417156393,"title":"Sailin' Shoes","year":1972,"ess":1,"yt":"or_Ivxj0lao","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Country-rock y roots-rock","scene_id":277196802515577,"scene_link":"https://volteret4.github.io/scaruffi/#country-rock","chapters":["Sección 4.2"],"pages":[[1,80,null]]},{"id":13742