{"id":221848576495269,"type":"artist","name":"Harry Nilsson","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Harry_Nilsson_%281973%29.png?width=500","bio":"Harry Nilsson (1941 - 1994) fue un músico y cantante norteamericano ganador de dos premios Grammy. Sus canciones más conocidas fueron \"Without You\", \"One is the loneliest number\" y \"Everybody's Talkin'\". De joven recibió la influencia del rhythm and blues de artistas como Ray Charles y los Everly Brothers.\n\nEn 1964, Nilsson trabajó con Phil Spector, escribiendo tres canciones para él.\n\nEn 1971 obtuvo su mayor éxito con \"Without You\", canción original del grupo Badfinger","tags":["singer-songwriter","classic rock","rock","folk","pop"]},"works":[{"id":74436299271612,"type":"song","name":"Everybody's Talkin'","artist":"Harry Nilsson","year":1969,"weight":4,"yt":"55xQu9eIPIA","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":279209370709843,"name":"Billboard Year-End 1969","rank":73,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":73,"scaruffi":null}],"n_lists":2}},{"id":118690672206122,"type":"album","name":"Nilsson Schmilsson","artist":"Harry Nilsson","year":1971,"weight":6,"yt":"6xJBWca1l4w","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":105652744207575,"type":"song","name":"Coconut","artist":"Harry Nilsson","year":1972,"weight":4,"yt":"TsSuueEGQSM","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":68619710521645,"name":"Billboard Year-End 1972","rank":66,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":66,"scaruffi":null}],"n_lists":2}},{"id":181460479416423,"type":"song","name":"Without You","artist":"Harry Nilsson","year":1972,"weight":9,"yt":"8dnUv3DUP4E","src":"charts,ensayos,singles","from":{"books":[],"podcasts":[{"name":"Hi