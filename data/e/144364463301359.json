{"id":144364463301359,"type":"album","name":"Jackson C. Frank","artist":"Jackson C. Frank","year":1965,"weight":14,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/30917-jackson-c-frank.jpg","aoty":90,"aoty_user":84,"yt":"EaE2DWk5Hyk","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/jackson-c-frank/jackson-c-frank","aoty":"https://www.albumoftheyear.org/album/30917-jackson-c-frank-jackson-c-frank.php"},"desc":"Jackson C. Frank is the debut album by Jackson C. Frank, released in December 1965 by Columbia (EMI). It was the only studio album he released before his death. The album was produced in 1965 by Paul Simon in London, and both Al Stewart and Art Garfunkel attended the recording. The album features Frank on guitar and vocals with Simon and Stewart providing an occasional second guitar. Frank was reportedly so nervous that in order to play and sing, he had to have screens around him. The album was recorded in less than three hours in London at CBS Studios. ."},"artist_ref":{"id":74426344961404,"name":"Jackson C. Frank","info":{"img":"https://cdn-images.dzcdn.net/images/artist/b8d6ea0d3c81eea02864a4f42443afd4/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":223327500886715,"type":"genre","name":"Contemporary Folk","artist":null,"year":null,"weight":247,"yt":null,"src":"rym"}],"lists":[{"id":87310548737747,"name":"RYM Top — Folk — Contemporary Folk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":51,"year":null,"note":null,"total":200,"scaruffi":null},{"id":94905110718967,"name":"RYM Top — Folk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":51,"year":null,"note":null,"total":200,"scaruffi":null},{"id":244769911076515,"name":"RYM Top — Singer-Songwriter","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":69,"year":null,"note":null,"total":200,"scaruffi":null},{"id":149374210477972,"name":"AOTY Must Hear 1960s","src":"charts","grp":"AOTY","list_year":null,"rank":71,"year":1965,"note":n