{"id":259647589123361,"type":"album","name":"Tunnel of Love","artist":"Bruce Springsteen","year":1987,"weight":10,"info":{"cover":"https://ia803407.us.archive.org/8/items/mbid-de3273d0-4906-4760-b8e2-51a7ffde946b/mbid-de3273d0-4906-4760-b8e2-51a7ffde946b-31594389382.jpg","yt":"5hsy2h6sUc8","desc":"Tunnel of Love is the eighth studio album by American singer-songwriter Bruce Springsteen, released on October 9, 1987. Although members of the E Street Band occasionally performed on the album, Springsteen recorded most of the parts himself, often with drum machines and synthesizers. While the album's liner notes list the E Street Band members under that name, Shore Fire Media, Springsteen's public relations firm, does not count it as an E Street Band album and 2002's The Rising was advertised as his first studio album with the E Street Band since Born in the USA. The album won Best Rock ."},"artist_ref":{"id":168754358908938,"name":"Bruce Springsteen","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bruce_Springsteen_2025.jpg?width=500"}},"labels":[],"genres":[{"id":53681850040905,"type":"genre","name":"Rock & Roll","artist":null,"year":null,"weight":1066,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":251671925246370,"type":"genre","name":"Soft Rock","artist":null,"year":null,"weight":418,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"},{"id":106381401668595,"type":"genre","name":"Heartland Rock","artist":null,"year":null,"weight":254,"yt":null,"src":"musthear"}],"lists":[{"id":10053931114450,"name":"Pitchfork: The 200 Best Albums of the 1980s","src":"charts","grp":"musicbrainz","list_year":null,"rank":124,"year":1987,"note