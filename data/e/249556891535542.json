{"id":249556891535542,"type":"album","name":"Blowout Comb","artist":"Digable Planets","year":1994,"weight":19,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/22899-blowout-comb_093701.jpg","aoty":83,"aoty_user":85,"sputnik":4.17,"yt":"f1ojpZfFXx4","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/digable-planets/blowout-comb","aoty":"https://www.albumoftheyear.org/album/22899-digable-planets-blowout-comb.php","sputnikmusic":"https://www.sputnikmusic.com/album/8909/Digable-Planets-Blowout-Comb/"},"desc":"Blowout Comb is the second studio album by American hip hop group Digable Planets, released October 18, 1994, on Pendulum/EMI Records. The album was written and recorded in Brooklyn, New York, where the group moved, with recording sessions beginning in 1993 and finishing in 1994. On Blowout Comb, Digable Planets abandoned the radio friendly style of their debut album and worked with a more stripped-down sound. The album features a diverse range of samples and live instruments, and contains lyrical themes of the inner city and Black nationalism. It also features guest appearances from Guru of Gang Starr, Jeru the ."},"artist_ref":{"id":102004087844484,"name":"Digable Planets","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/171_Digable_Planets_%285251694375%29.jpg?width=500"}},"labels":[],"genres":[{"id":136937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"musthear"},{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":145450397810410,"type":"genre","name":"Jazz Rap","artist":null,"year":null,"weight":238,"yt":null,"src":"musthear,rym"},{"id":26869950655266,"type":"genre","name":"Conscious Hip Hop","artist":null,"year":null,"weight":252,"yt":null,"src":"rym"},{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"}],"lists":[{"id":2