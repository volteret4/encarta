il Baby: Atlanta, ciudad del fénix, destruye su sonido cada pocos años para crear otro.","color":"#f472b6","family":"El Sur: Miami, Atlanta, Houston, Memphis, Nueva Orleans","link":"https://volteret4.github.io/ComeUp/#trap"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":162536922161530,"type":"song","name":"Bank Account","work_year":2017,"list_id":6482552382804,"list":"Billboard Year-End 2017","src":"singles","rank":48,"year":2017,"note":"","yt":"sV2t3tW_JTQ","scaruffi":null},{"id":162536922161530,"type":"song","name":"Bank Account","work_year":2017,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":48,"year":2017,"note":null,"yt":"sV2t3tW_JTQ","scaruffi":null},{"id":51530843858658,"type":"album","name":"Without Warning","list_id":30975222555123,"list":"RYM Top — Hip Hop — Trap","src":"musthear","rank":122,"year":2017,"note":null,"yt":"MPVlTjziuzw","scaruffi":null},{"id":51530843858658,"type":"album","name":"Without Warning","list_id":218288666034832,"list":"RYM Top — Scenes & Movements — Southern Hip Hop","src":"musthear","rank":190,"year":2017,"note":null,"yt":"MPVlTjziuzw","scaruffi":null},{"id":196655572033582,"type":"song","name":"A Lot","work_year":2019,"list_id":157045614843478,"list":"Billboard Year-End 2019","src":"singles","rank":42,"year":2019,"note":"","yt":"DmWWqogr_r8","scaruffi":null},{"id":196655572033582,"type":"song","name":"A Lot","work_year":2019,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":42,"year":2019,"note":null,"yt":"DmWWqogr_r8","scaruffi":null},{"id":261298686285673,"type":"album","name":"Savage Mode II (Chopped Not Slopped)","list_id":154957356597911,"list":"RYM Top — Hip Hop — Chopped and Screwed","src":"musthear","rank":7,"year":2020,"note":null,"yt":"Y6eirCiWI4Y","scaruffi":null},{"id":85442400559230,"type":"song","name":"Redrum","work_year":2024,"list_id":171098475404130,"list":"Billboard Year-End 2024","src":"si