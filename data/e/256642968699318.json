,"members":[],"member_of":[],"genres":[],"album_genres":[{"id":153989329837984,"type":"genre","name":"Slowcore","n":6},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":4},{"id":194427380844280,"type":"genre","name":"Folk Rock","n":4},{"id":8412226417108,"type":"genre","name":"Indie Rock","n":3},{"id":185670346256268,"type":"genre","name":"rock","n":2},{"id":72160633815519,"type":"genre","name":"Shoegaze","n":1},{"id":19761880143227,"type":"genre","name":"Dream Pop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":204583008336748,"name":"Slo-core","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2002,"desc":"Una de las innovaciones más importantes de los noventa: versión lenta, onírica y melancólica del dream-pop, descendiente de Galaxie 500 y Yo La Tengo, con composiciones largas y contenidas. Codeine la consagran (Frigid Stars); Seam, Red House Painters de Mark Kozelek (Down Colorful Hill), Low (I Could Live In Hope, Trust: el haiku del rock) y Bedhead. La balada etérea femenina: Mazzy Star, His Name Is Alive, Moon Seven Times, Congo Norvell, Helium, Elysian Fields. La balada atmosférica: Idaho, Acetone, Low Road, American Analog Set, Calla, y el «rock textural» del Noroeste: Built To Spill (Perfect From Now On), Silkworm, Red Stars Theory, Death Cab For Cutie. En Inglaterra, Drugstore, Mojave 3, Movietone.","color":"#c084fc","family":"Psicodelia, garage y shoegaze","link":"https://volteret4.github.io/scaruffi/#slo-core"}],"book_tracks":[{"id":26022349287786,"artist":"Red House Painters","artist_id":256642968699318,"title":"Down Colorful Hill","year":1992,"ess":1,"yt":"-5gk1aIDfX8","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Slo-core","scene_id":204583008336748,"scene_link":"https://volteret4.github.io/scaruffi/#slo-core","chapters":["Sección 6.8"],"pages":[[1,258,null]]},{"id":2535