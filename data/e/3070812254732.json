ght":3,"yt":"ddsHDgohak0","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":114943012715183,"name":"RYM Top — Electronic — Musique concrète","rank":180,"scaruffi":null}],"n_lists":1}},{"id":29563914567196,"type":"album","name":"Field Recording and Fox Spirits","artist":"David Toop","year":2020,"weight":3,"yt":"rW416-UFipk","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":212500639210229,"name":"RYM Top — Spoken Word — Interview","rank":7,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":236863449870361,"type":"genre","name":"Free Improvisation","n":1},{"id":217858086851026,"type":"genre","name":"Interview","n":1},{"id":194466035942673,"type":"genre","name":"Tribal Ambient","n":1},{"id":87625349211221,"type":"genre","name":"electronic","n":1},{"id":54532248910369,"type":"genre","name":"Electroacoustic","n":1},{"id":52564062876627,"type":"genre","name":"EAI","n":1},{"id":50244142277993,"type":"genre","name":"Musique concrète","n":1},{"id":26161963806140,"type":"genre","name":"Musique concrète instrumentale","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":269732828614358,"name":"El funk sampleado: la vuelta del funk en el rap","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1979,"end":1995,"desc":"El rap fue siempre, según David Toop, «habla sincopada sobre un ritmo funk». Con el sampler, a finales de los ochenta empezó el verdadero renacimiento del funk: hacia 1990 las grandes estrellas del rap sampleaban casi exclusivamente música de la Era Funk, y no la de Motown, el R&B anterior, el pop soul, el disco o el rock blanco. Los éxitos funk quedaron desguazados como un coche abandonado: «Turn This Mutha Out» de M. C. Hammer copia el coro de «Tear the Roof Off the Sucker», «U Can’t Touch This» repite el riff de «Super Freak» y Digital Underground usó «(Not Just) Knee Deep» en tres temas de Sons of the P. A la vez, raperos afrocéntricos recuperaban la conciencia negra de los sesenta. Las demandas legales lo han hecho más difícil, pero bajo el rap sigue el funk que lo engendró.","color":"#94a3b8","family":"Hip hop, go-go y funk de los noventa","link":"https://volteret4.github.io/Funk/#sampling"},{"id":17311842896835,"name":"London Musicians' Collective y The Flying Lizards","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1975,"end":1984,"desc":"La cultura británica de la improvisación libre, autonomista desde principios de los setenta (sello Incubus, revista Musics), acoge el caos del punk: el LMC de David Toop y Steve Beresford mezcla virtuosos y amateurs en el Jazz Punk Bonanza, en la estela de Fluxus, John Cage y The Portsmouth Sinfonia. De ese entorno sale el mayor hit de la vanguardia: el «Money» de The Flying Lizards (1979), con un piano lleno de objetos y la voz glacial de Deborah Evans, proyecto del productor autodidacta David Cunningham (admirador de Joe Meek, Phil Spector y Lee Perry).","color":"#fb7185","family":"Vanguardia postpunk: dub, funk y política","link":"https://volteret4.github.io/Postpunk/#lmc"},{"id":154078539123768,"name":"Aislacionismo","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1993,"end":1997,"desc":"La rama más fría del ambient noventero: placer en la oscuridad, la opresión y el lado oscuro del alma.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#aislacionismo"}],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":70337992179164,"type":"album","name":"Screen Ceremonies","work_year":1995,"list_id":13018320481353,"list":"Scaruffi 1990s","src":"charts","rank":585,"year":1995,"note":null,"yt":"BI_3uYz6ZlQ","scaruffi":7.0},{"id":37056874093350,"type":"album","name":"Pink Noir","list_id":201123809480309,"list":"RYM Top — Ambient — Tribal Ambient","src":"musthear","rank":113,"year"