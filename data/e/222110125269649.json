{"id":222110125269649,"type":"album","name":"Tracy Chapman","artist":"Tracy Chapman","year":1988,"weight":27,"info":{"cover":"https://dn710108.ca.archive.org/0/items/mbid-b0760dd1-8667-4b8d-b8e4-8385b21239bb/mbid-b0760dd1-8667-4b8d-b8e4-8385b21239bb-5768430674.jpg","kind":"Album","tracks":11,"country":"XG","scaruffi":7.0,"aoty":87,"aoty_user":82,"yt":"Q2wneBVssPc","links":{"spotify":"https://open.spotify.com/album/6hmmX5UP4rIvOpGSaPerV8","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_kOlULPsnRbEXhiXK0WWAbxacxQMWKkiOM","rateyourmusic":"https://rateyourmusic.com/release/album/tracy-chapman/tracy-chapman-19","aoty":"https://www.albumoftheyear.org/album/6815-tracy-chapman-tracy-chapman.php"},"desc":"Tracy Chapman is the self-titled debut studio album by American singer-songwriter Tracy Chapman, released on April 5, 1988, by Elektra Records. Produced by David Kershenbaum, the album is noted for its sparse, acoustic arrangements and socially conscious lyrics, which stood in stark contrast to the synthesized pop and glam metal dominating the charts at the time. The album's commercial breakthrough is famously attributed to Chapman's impromptu performance at the Nelson Mandela 70th Birthday Tribute concert in June 1988. After Stevie Wonder suffered equipment failure, Chapman took the stage alone with her guitar during prime time, captivating a global audience. Following ."},"artist_ref":{"id":175053255599613,"name":"Tracy Chapman","info":{"img":"https://cdn-images.dzcdn.net/images/artist/c791a2bdb4e5e430ce9230cca8083b23/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear,rym"},{"id":156823753286980