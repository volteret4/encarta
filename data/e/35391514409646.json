{"id":35391514409646,"type":"album","name":"MAY GOD BLESS YOUR HUSTLE","artist":"MIKE","year":2017,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/83377-may-god-bless-your-hustle-2.jpg","aoty":82,"aoty_user":81,"yt":"Wt76_xe6CU8","links":{"aoty":"https://www.albumoftheyear.org/album/83377-mike-may-god-bless-your-hustle.php"},"desc":"MAY GOD BLESS YOUR HUSTLE is an underground and experimental hip-hop album by New York rapper MIKE. It was released on Bandcamp and Soundcloud on June 21, 2017. The album features a stream-of-consciousness type of lyrical approach from MIKE where many of the songs don’t necessarily have a specific topic, rather MIKE vents his thoughts sporadically. The production is sample driven. Many of the samples are slowed or pitched down rather than sped up. Many tracks feature rather off-kilter drum patterns while others have little to no drums. ."},"artist_ref":{"id":55115913645331,"name":"Mike","info":{"img":null}},"labels":[],"genres":[{"id":107037851142420,"type":"genre","name":"Experimental Hip Hop","artist":null,"year":null,"weight":263,"yt":null,"src":"rym"},{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"},{"id":69149423353287,"type":"genre","name":"Abstract Hip Hop","artist":null,"year":null,"weight":224,"yt":null,"src":"rym"}],"lists":[{"id":182111400206179,"name":"RYM Top — Hip Hop — Experimental Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":50,"year":null,"note":null,"total":200,"scaruffi":null},{"id":96087554392730,"name":"RYM Top — Hip Hop — Abstract Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":54,"year":null,"note":null,"total":200,"scaruffi":null},{"id":45584128953585,"name":"RYM Top — Scenes & Movements — East Coast Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":110,"year":null,"note":null,"total":200,"scaruffi":null},{"id":84472050122582,"name":"AOTY Mus