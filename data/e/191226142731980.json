{"id":191226142731980,"type":"album","name":"Franks Wild Years","artist":"Tom Waits","year":1987,"weight":18,"info":{"cover":"https://dn710902.ca.archive.org/0/items/mbid-ef645938-2cee-4e37-bf47-555ec55c7259/mbid-ef645938-2cee-4e37-bf47-555ec55c7259-9742909983.jpg","kind":"Album","tracks":17,"country":"XE","scaruffi":7.5,"yt":"3UqbMRCctL8","links":{"spotify":"https://open.spotify.com/album/22mcOt74IVtCeR5hoIfveO","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lB37BzkW5_zrKhhazQmrn5J4JlPqA2Ckk","rateyourmusic":"https://rateyourmusic.com/release/album/tom-waits/franks-wild-years"},"desc":"Franks Wild Years is the tenth studio album by Tom Waits, released 1987 on Island Records. Subtitled \"Un Operachi Romantico in Two Acts\", the album contains songs written by Waits and collaborators (mainly his wife, Kathleen Brennan) for a play of the same name. The shared title of the album and the play is an iteration of \"Frank's Wild Years\", a song from Waits' 1983 album Swordfishtrombones. The play had its world premiere at the Briar St. Theatre in Chicago, Illinois, on June 22, 1986, performed by the Steppenwolf Theatre Company. ."},"artist_ref":{"id":96611256838042,"name":"Tom Waits","info":{"img":"https://cdn-images.dzcdn.net/images/artist/8fb57c7acdbffa039c3667dbdbe21498/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":163225726165579,"type":"genre","name":"Blues Rock","artist":null,"year":null,"weight":458,"yt":null,"src":"musthear"},{"id":55893123468232,"type":"genre","name":"Experimental Rock","artist":null,"year":null,"weight":373,"yt":null,"src":"musthear"},{"id":173341470623130,"typ