s":3}}],"members":[],"member_of":[{"id":39107731914008,"type":"artist","name":"Roxy Music","artist":null,"year":1971,"weight":171,"yt":null,"src":"ensayos"}],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"ensayos"}],"album_genres":[{"id":204877716424121,"type":"genre","name":"Sophisti-Pop","n":6},{"id":68128513346957,"type":"genre","name":"Glam Rock","n":3},{"id":163536058891268,"type":"genre","name":"Traditional Pop","n":2},{"id":162702679144612,"type":"genre","name":"British Music","n":1},{"id":156472819307530,"type":"genre","name":"British Dance Band","n":1},{"id":56173113450769,"type":"genre","name":"Swing","n":1},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":1},{"id":9877689544171,"type":"genre","name":"Standards","n":1},{"id":9343125461845,"type":"genre","name":"Adult Contemporary","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":57005035735048,"name":"Glam arty: Bowie, Roxy Music y Eno","book":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","start":1971,"end":1976,"desc":"El costado intelectual del glam. Bowie, «el más grande diletante del rock», fue la inspiración clave del ethos postpunk del cambio constante; Roxy Music y los discos solistas proto-new wave de Brian Eno, con sus ruidos de sintetizador, anticipan el sonido de la década siguiente.","color":"#f59e0b","family":"Antecedentes: punk, art rock, kraut y glam","link":"https://volteret4.github.io/Postpunk/#glam-art"}],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Background and Role in Roxy Music","body":"Brian Ferry was the frontman for Roxy Music, which he helped form in 1970 as an experimental art rock band. Prior to this, he had been fired from a job teaching ceramics at a girl's school. \"an out front was Brian Ferry, who had just been fired from his job teaching ceramics at a girl's school.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Surprising History of Glam Rock","url":"https://www.youtube.com/watch?v=blDNqVFheAw"}]},{"kind":"podcast","title":"Dating Life","body":"When Brian Ferry was 61 years old, he dated a 27-year-old model who had previously dated his son, Otis Ferry. \"When dad was 61, he dated a 27 year old model. What was interesting was that model once dated Otis.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock Star Kids ｜ From the Archives","url":"https://www.youtube.com/watch?v=U40hOYy_94E"}]},{"kind":"podcast","title":"Iconic Band Leader","body":"Brian Ferry was the legendary leader of Roxy Music, recognized as one of the most stylish British bands of the mid to late 1970s. Roxy Music sold numerous records and provided inspiration to millions, often appealing to fans of David Bowie. \"Brian Ferry was the legendary leader of Roxy Music, one of the most stylish of all the British bands of the middle and late 70s.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock Star Kids ｜ From the Archives","url":"https://www.youtube.com/watch?v=U40hOYy_94E"}]},{"kind":"podcast","title":"Rejected \"Don't You (Forget About Me)\"","body":"Brian Ferry of Roxy Music was the first artist approached to record the song \"Don't You (Forget About Me)\" for *The Breakfast Club* soundtrack, but he disliked it and turned it down. The song, written by Keith Forsey with Ferry initially in mind, went on to become a massive hit for Simple Minds after several other artists also rejected it. \"Kelsey wrote a song with Roxy Music's Brian Ferry in mind, but Ferry didn't like it and turned it down.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Key Alt-Rock Movie Soundtracks","url":"https://www.youtube.com/watch?v=zIkjd1OjCXM"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":30202485057118,"type":"album","name":"These Foolish Things","list