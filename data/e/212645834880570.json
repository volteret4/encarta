{"id":212645834880570,"type":"album","name":"Skinty Fia","artist":"Fontaines D.C.","year":2022,"weight":11,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/456966-skinty-fia.jpg","aoty":87,"aoty_user":80,"sputnik":3.8,"yt":"rwKzmVRaKUY","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/fontaines-d_c/skinty-fia","aoty":"https://www.albumoftheyear.org/album/456966-fontaines-dc-skinty-fia.php","sputnikmusic":"https://www.sputnikmusic.com/album/416743/Fontaines-D.C.-Skinty-Fia/"},"desc":"Skinty Fia is the third studio album by Irish rock band Fontaines D.C. It was released on 22 April 2022 via Partisan Records. Like the band's two previous albums – 2019's Dogrel and 2020's A Hero's Death – Skinty Fia was produced by Dan Carey. Its title refers to an old Irish saying that drummer Tom Coll's great-aunt used to say. The phrase \"Skinty Fia\" translates to \"the damnation of the deer\". Both the title and the cover art allude to the extinct Irish elk, also known as the \"giant deer\". Skinty Fia became the band's first number-one album in ."},"artist_ref":{"id":53970800975101,"name":"Fontaines D.C.","info":{"img":null}},"labels":[],"genres":[{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"musthear"},{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"rym"},{"id":93579530230421,"type":"genre","name":"Gothic Rock","artist":null,"year":null,"weight":272,"yt":null,"src":"rym"}],"lists":[{"id":242669898096444,"name":"RYM Top — Rock — Gothic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":35,"year":null,"note":null,"total":200,"scaruffi":null},{"id":143183292157716,"name":"Sputnikmusic Best Albums 2022","src":"musthear","grp":"sputnikmusic","list_year":null,"rank":138,"year":null,"note":null,"total":200,"scaruffi":null},{"id":182218712006755,"name":"RYM Top — Rock — Post-Punk","src":"musthear","grp":"rateyourmusic"