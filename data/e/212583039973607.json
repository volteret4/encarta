{"id":212583039973607,"type":"artist","name":"Michael Stearns","artist":null,"year":null,"weight":13,"info":{"bio":"Michael Stearns (born 1948) is a United States musician and composer of ambient music. He is also known as a film composer, sound designer and soundtrack producer for large format films, theatrical films, documentaries, commercials, and themed attractions.\n\nGrowing up in Tucson, Arizona, Michael Stearns started practicing guitar at 13. At 16, he played in a surf music band, sometimes backing artists such as The Lovin' Spoonful and Paul Revere & the Raiders. <a href=\"https://www.last.fm/music/Michael+Stearns\">Read more on Last.fm</a>","tags":["ambient","Space Ambient","new age","deep ambient","atmospheric"],"img":"https://lastfm.freetls.fastly.net/i/u/300x300/2a96cbd8b46e442fc41c2b86b821562f.png","similar":["Steve Roach","Rudy Adrian","Robert Rich","Jonn Serrie","David Helpling"],"listeners":"104891","links":{"lastfm":"https://www.last.fm/music/Michael+Stearns"}},"works":[{"id":40670829884293,"type":"album","name":"Ancient Leaves","artist":"Michael Stearns","year":1977,"weight":3,"yt":"UwahD6FHA9g","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":100525930599399,"name":"RYM Top — Electronic — Space Ambient","rank":35,"scaruffi":null}],"n_lists":1}},{"id":17149844709710,"type":"album","name":"Morning Jewel","artist":"Michael Stearns","year":1980,"weight":3,"yt":"uebz4PAnTt0","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":100525930599399,"name":"RYM Top — Electronic — Space Ambient","rank":56,"scaruffi":null}],"n_lists":1}},{"id":264567270190494,"type":"album","name":"Planetary Unfolding","artist":"Michael Stearns","year":1981,"weight":12,"yt":"SZxrMwtBZaY","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":100525930599399,"name":"RYM Top — Electronic — Space Ambient","rank":10,"scaruffi":null},{"id":106284046011718,"na