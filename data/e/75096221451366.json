{"id":75096221451366,"type":"album","name":"World Of Echo","artist":"Arthur Russell","year":1986,"weight":21,"info":{"cover":"https://dn710901.ca.archive.org/0/items/mbid-a8c0921c-1fc5-31b3-99e6-4cbe676aea18/mbid-a8c0921c-1fc5-31b3-99e6-4cbe676aea18-14023274587.jpg","kind":"Album","tracks":18,"scaruffi":7.0,"yt":"XLPvft-p6Gw","links":{"spotify":"https://open.spotify.com/album/7hodLjVNQZSsNEqvG77ZkI","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_kBT7X8kK3gNaOPPe0P79qmrgy9CebyASg","bandcamp":"https://arthurrussell.bandcamp.com/album/world-of-echo","rateyourmusic":"https://rateyourmusic.com/release/album/arthur-russell/world-of-echo"},"desc":"World of Echo is the only full-length non-collaborative studio album recorded, released and compiled by Arthur Russell during his lifetime. It was released in 1986 on Upside Records in the United States and on Rough Trade Records in the United Kingdom. Departing from his dance music recordings of the time, it instead features Russell solo on cello with added electronics and production effects, including echo, reverb, and distortion. Audika Records issued a remastered limited edition CD on 27 October 2004 which included bonus tracks and a DVD with footage by Phill Niblock. They subsequently issued another CD on 11 January ."},"artist_ref":{"id":37548125563371,"name":"Arthur Russell","info":{"img":"https://cdn-images.dzcdn.net/images/artist/755343562dff403b8c65becd4511701d/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":156823753286980,"type":"genre","name":"folk","artist":null,"year":null,"weight":510,"yt":null,"src":"musthear"},{"id":133750237876598,"type":"genre","name":"Avant-Folk","artist":null,"year":null,"weight":211,"yt":null,"src":"musthear,rym"},{"id":111306765148197,"type":"genre","name":"dance","artist":null,"year":null,"weight":151,"yt":null,"src":"musthear"},{"id":53692558339894,"type":"genre","name":"experimental","artist":null,"year":null,"weight":63,"yt":null,"src":"musthear"},{"id":179990336