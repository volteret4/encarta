um_labels":[],"own_scenes":[],"scenes":[{"id":227407993671548,"name":"Roots-rock de los ochenta y cow-punk","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1984,"end":1995,"desc":"Como en 1970 tras 1966, la new wave de 1976 va seguida de un revival del roots-rock, esta vez gradual y disfrazado: punks que desfiguran los estilos tradicionales (X, Dream Syndicate, Gun Club) y los «cow-punks» que tocan country ambientado entre inadaptados: Long Ryders, Jason & The Scorchers, Fetchin Bones, Lone Justice, Beat Farmers. El populismo de Los Lobos, Del Fuegos, Del-Lords y Walkabouts; en la Costa Oeste, los dementes Camper Van Beethoven, Donner Party, Catheads, Thin White Rope y los American Music Club de Mark Eitzel; en Texas, Wild Seeds, Poi Dog Pondering, Glass Eye; en los Grandes Lagos, BoDeans, Soul Asylum, Afghan Whigs, Shrimp Boat y los canadienses Cowboy Junkies. Nashville se renueva con los neotradicionalistas (George Strait, Randy Travis, Garth Brooks, Lyle Lovett, Steve Earle, Dwight Yoakam) y el surf instrumental vuelve con Shadowy Men On A Shadowy Planet.","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#roots-80s"}],"book_tracks":[{"id":34782240480053,"artist":"Lyle Lovett","artist_id":123462154227157,"title":"Lyle Lovett","year":1986,"ess":0,"yt":"3tHKa9t9yU0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Roots-rock de los ochenta y cow-punk","scene_id":227407993671548,"scene_link":"https://volteret4.github.io/scaruffi/#roots-80s","chapters":["Sección 5.17"],"pages":[[1,195,null]]},{"id":216533073009486,"artist":"Lyle Lovett","artist_id":123462154227157,"title":"Pontiac","year":1988,"ess":0,"yt":"KGIsPLB9Ua4","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Roots-rock de los ochenta y cow-punk","scene_id":227407993671548,"scene_link":"https://volteret4.github.io/scaruffi/#roots-80s","chapters":["Sección 5.17"],"pages":[[1,195,null]]},{"id":144785961772374,"artist":"Lyle Lovett","artist_id":123462154227157,"title":"His Large Band","year":1989,"ess":0,"yt":"fLU_IYflUkQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Roots-rock de los ochenta y cow-punk","scene_id":227407993671548,"scene_link":"https://volteret4.github.io/scaruffi/#roots-80s","chapters":["Sección 5.17"],"pages":[[1,195,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":195,"text":"…less fluent in the new idiom, for example, Jim Lauderdale, a prolific songwriter whose best album was probably Planet of Love (1991), The music of Lyle Lovett (1) was hardly country music at all. His debut, Lyle Lovett (1986), borrowed from country, rock, rhythm'n'blues, jazz, folk and pop. Pontiac (1988) achieved a formidable balance of atmosphere, tunesmith, rhythm and melody. Lovett even embraced big-band jazz with His Large Band (1989). Guitar Town (1986), by Steve Earle (1), shocked the scene with its loud and frantic sound…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":34782240480053,"type":"album","name":"Lyle Lovett","list_id":187857422127234,"list":"RYM Top — Country — Contemporary Country","src":"musthear","rank":64,"year":1986,"note":null,"yt":"7g-ySe8nEV0","scaruffi":null},{"id":216533073009486,"type":"album","name":"Pontiac","list_id":118798969175346,"list":"RYM Top — Country — Alt-Country","src":"musthear","rank":176,"year":1988,"note":null,"yt":"rEk7_Y4JRA0","scaruffi":7.0},{"id":216533073009486,"type":"album","name":"Pontiac","list_id":119301033705212,"list":"RYM Top — Country — Progressive Country","src":"musthear","rank":89,"year":1988,"note":null,"yt":"rEk7_Y4JRA0","scaruffi":7.0},{"id":216533073