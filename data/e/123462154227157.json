{"id":123462154227157,"type":"artist","name":"Lyle Lovett","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Lyle_Lovett_at_Oregon_Zoo.jpg?width=500","bio":"Lyle Lovett nacio el dia 1 de Noviembre de 1957. Hijo de un ejecutivo de marketing y de una entrenadora deportiva, se educó en la universidad A&M de Texas, donde estudió periodismo y lengua alemana. Su carrera en la música comenzó como compositor, y en 1986 firmó con MCA Records para grabar su primer álbum homónimo 'Lyle Lovett'. Aunque normalmente asociado al género country, sus composiciones incorporan a menudo elementos del folk, swing, blues, jazz y gospel, así como el más puro y tradicional country & western.","tags":["country","Alt-country","singer-songwriter","americana","texas"]},"works":[{"id":34782240480053,"type":"album","name":"Lyle Lovett","artist":"Lyle Lovett","year":1986,"weight":9,"yt":"7g-ySe8nEV0","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":187857422127234,"name":"RYM Top — Country — Contemporary Country","rank":64,"scaruffi":null}],"n_lists":1}},{"id":216533073009486,"type":"album","name":"Pontiac","artist":"Lyle Lovett","year":1988,"weight":20,"yt":"rEk7_Y4JRA0","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":541,"scaruffi":7.0},{"id":118798969175346,"name":"RYM Top — Country — Alt-Country","rank":176,"scaruffi":7.0},{"id":119301033705212,"name":"RYM Top — Country — Progressive Country","rank":89,"scaruffi":7.0}],"n_lists":3}},{"id":144785961772374,"type":"album","name":"His Large Band","artist":"Lyle Lovett","year":1989,"weight":6,"yt":"fLU_IYflUkQ","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lis