"own_scenes":[],"scenes":[{"id":95102149612343,"name":"Rock progresivo","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1967,"end":1976,"desc":"Al emigrar a Gran Bretaña, el rock se convierte en mercancía de moda pero también se descontextualiza: lo que en EE UU era el diario de la juventud se vuelve en Gran Bretaña un ensayo. El progresivo no comenta la cultura juvenil sino que busca la innovación técnica: arranca con las óperas rock (S.F. Sorrow, Tommy) y los álbumes conceptuales, lo cimentan Traffic, Jeff Beck, Jethro Tull, Family y Genesis, y alcanza su cima con King Crimson (In The Court Of The Crimson King), Van Der Graaf Generator y Yes. Colosseum, la Third Ear Band (inventores de la world music), las variantes góticas (High Tide, Black Widow) y folk (Comus, Strawbs), Gentle Giant, Emerson Lake & Palmer y Roxy Music, que revoluciona el género y prepara la new wave y el synth-pop.","color":"#38bdf8","family":"Progresivo, krautrock y jazz-rock","link":"https://volteret4.github.io/scaruffi/#prog-rock"}],"book_tracks":[{"id":268520008975672,"artist":"Jade Warrior","artist_id":148042570135842,"title":"Last Autumn's Dream","year":1972,"ess":1,"yt":"17xn_-N874w","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Rock progresivo","scene_id":95102149612343,"scene_link":"https://volteret4.github.io/scaruffi/#prog-rock","chapters":["Sección 3.5"],"pages":[[1,60,null]]},{"id":250811068398268,"artist":"Jade Warrior","artist_id":148042570135842,"title":"Waves","year":1975,"ess":1,"yt":"LVwfBvVU1HI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Rock progresivo","scene_id":95102149612343,"scene_link":"https://volteret4.github.io/scaruffi/#prog-rock","chapters":["Sección 3.5"],"pages":[[1,60,null]]},{"id":179730259264021,"artist":"Jade Warrior"