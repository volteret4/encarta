","name":"Contemporary Pop","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":19499532832736,"type":"genre","name":"Electropop","n":7},{"id":11529772759107,"type":"genre","name":"Bubblegum Bass","n":6},{"id":223122507869858,"type":"genre","name":"Dance-Pop","n":3},{"id":205187608484203,"type":"genre","name":"Hyperpop","n":3},{"id":65067151178508,"type":"genre","name":"Electronic Dance Music","n":3},{"id":129140599487979,"type":"genre","name":"Deconstructed Club","n":2},{"id":264824775713421,"type":"genre","name":"club","n":1},{"id":213282791976178,"type":"genre","name":"Alt-Pop","n":1},{"id":107037851142420,"type":"genre","name":"Experimental Hip Hop","n":1},{"id":97587253038382,"type":"genre","name":"Electro House","n":1},{"id":87625349211221,"type":"genre","name":"electronic","n":1},{"id":37008358870220,"type":"genre","name":"edm","n":1},{"id":30277598324326,"type":"genre","name":"pop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":30829935814163,"name":"Underground online","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":2010,"end":2017,"desc":"Una generación que madura y se promociona en internet, lejos de la industria, con YouTube o Bandcamp.","color":"#f472b6","family":"Rock, synth-pop y canción","link":"https://volteret4.github.io/loops_timeline/#underground-online"}],"book_tracks":[{"id":82787180501176,"artist":"Charli XCX","artist_id":74010971913388,"title":"Pop 2","year":2017,"ess":1,"yt":"Uu46hHkqAi0","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Underground online","scene_id":30829935814163,"scene_link":"https://volteret4.github.io/loops_timeline/#underground-online","chapters":["Loops 2 · Cap. 10: Demonios de neón: la escena EDM, entre la resurrección de la cultura rave y la sumisión al mercado del pop"],"pages":[[2,352],[2,431]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":352,"text":"…de una adolescencia conflictiva: la popular estrella canadiense Carly Rae Jepsen colaboró con Danny L Harle en «Super Natural», y más tarde con Charli XCX en su mixtape Pop 2 (2017), producida por equipos de PC Music y en la que también asoman figuras principales del pop hipermoderno y sexy como Tove…"}],"podcast":[{"kind":"podcast","title":"Extensive Discography Before 2020","body":"Before \"How I'm Feeling Now,\" Charli XCX was not a newcomer; in fact, between singles, albums, mixtapes, and EPs, she had more than twenty releases. \"De hecho, entre singles, discos, mixtapes y EPs llevaba más de una vintena de lanzamientos.\"","year":2020,"extra":null,"srcs":[{"source":"Central Sonora","episode":"5 Discos Para Entrarle al HYPERPOP","url":"https://www.youtube.com/watch?v=wP8MaC-2D8A"}]},{"kind":"podcast","title":"Consolidated Voice in Contemporary Pop","body":"Through themes like \"Claws\" and \"Forever,\" which display a mix of vulnerability and euphoria, she consolidated her position as one of the most important voices not only in hyperpop but in contemporary pop in general. \"Consolidando a Charlie como una de las voces más importantes no solo de Liverpool, sino del pop contemporáneo general.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"5 Discos Para Entrarle al HYPERPOP","url":"https://www.youtube.com/watch?v=wP8MaC-2D8A"}]},{"kind":"podcast","title":"Imitator of Lady Gaga","body":"Charli XCX is listed as one of the artists whose electropop and Euro dance beats from the early 2010s showed emulation of Lady Gaga's sound during her imperial phase. \"picture all of the electropop and Euro dance beats from that period, from iconopop to Kesha, Charlie XCX to Toe Vlo.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Material Girl in an Imperial World Edition Part 1","url":null}]},{"kind":"podcast","title":"Regular Collaborator and Image Cultivator","body":"She has been a regular collaborator of the PC Music label since 2015 and with artists like Sophie, cultivating her image as the \"pop star of the future\" during those years. \"Collaboradora habitual del 3Y PC Music desde el año 2015, y de artistas como Sophie, Charlie XX fue lavarando esa imagen de estrella del pop del futuro durante esos años.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"5 Discos Para Entrarle al HYPERPOP","url":"https://www.youtube.com/watch?v=wP8MaC-2D8A"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":103165501422380,"type":"album","name":"True Romance","list_id":177232549654988,"list":"Favorite Electronic Pop Albums @alin","src":"musthear","rank":215,"year":2013,"note":null,"yt":"JhPDFmoqmKY","scaruffi":null},{"id":103165501422380,"type":"album","name":"True Romance","list_id":141930405636958,"list":"RYM Top — Pop — Alt-Pop","src":"musthear","rank":80,"year":2013,"note":null,"yt":"JhPDFmoqmKY","scaruffi":null},{"id":105362727935524,"type":"song","name":"Boom Clap","work_year":2014,"list_id":157980046529254,"list":"Billboard Year-End 2014","src":"singles","rank":34,"year":2014,"note":"","yt":"AOPMlIIg_38","scaruffi":null},{"id":105362727935524,"type":"song","name":"Boom Clap","work_year":2014,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":34,"year":2014,"note":null,"yt":"AOPMlIIg_38","scaruffi":null},{"id":196908675161119,"type":"album","name":"Sucker","list_id":177232549654988,"list":"Favorite Electronic Pop Albums @alin","src":"musthear","rank":246,"year":2014,"note":null,"yt":"WwtbVFtKEEg","scaruffi":null},{"id":141452462695906,"type":"album","name":"Vroom Vroom","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":439,"year":2016,"note":null,"yt":"bTCvBdrnZf0","scaruffi":null},{"id":82787180501176,"type":"album","name":"Pop 2"