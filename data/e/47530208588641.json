ype":"genre","name":"Philly Soul","n":8},{"id":30122583811636,"type":"genre","name":"Soul","n":2},{"id":50337978407967,"type":"genre","name":"Smooth Soul","n":1}],"labels":[{"id":144893323513112,"type":"label","name":"Philadelphia International Records","artist":null,"year":null,"weight":37,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[{"id":7236829286537,"name":"El sonido de Filadelfia","book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","start":1971,"end":1980,"desc":"El imperio de Kenny Gamble y Leon Huff, distribuido por CBS: los O’Jays, los Intruders, Billy Paul y Harold Melvin & the Blue Notes con Teddy Pendergrass, sobre la banda de la casa MFSB (Norman Harris, Bobby Eli, Ronnie Baker, Earl Young), la más exitosa de los setenta; su «TSOP» fue la sintonía de Soul Train. Los O’Jays fueron el altavoz del comentario social de Gamble: «Back Stabbers» (1972), Ship Ahoy (1974) con su travesía en un barco negrero, «For the Love of Money» (que el éxito convirtió en música de centro comercial), Survival, Family Reunion. Después de 1976 desapareció el mensaje del soul, y con Gloria Gaynor y Donna Summer la frontera entre el disco, el funk y el soul se borró.","color":"#facc15","family":"Soul y proto-funk: Stax, Nueva Orleans, Motown","link":"https://volteret4.github.io/Funk/#philly-sound"}],"book_tracks":[{"id":189738864338674,"artist":"Harold Melvin & the Blue Notes","artist_id":47530208588641,"title":"The Love I Lost","year":1973,"ess":0,"yt":"ZTt649Hvtxs","kind":null,"book":{"id":4,"title":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","url":"https://volteret4.github.io/Funk/"},"scene":"El sonido de Filadelfia","scene_id":7236829286537,"scene_link":"https://volteret4.github.io/Funk/#philly-sound","chapters":["Cap. 10: Soul funky: Express Yourself"],"pages":[[1,148]]},{"id":55251712092028,"artist":"Harold Melvin & the Blue Notes","artist_id":47530208588641,"title":"Bad Luck","year":1975,"ess":0,"yt":"mykhgDJvp6g","kind":null,"book":{"id":4,"title":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","url":"https://volteret4.github.io/Funk/"},"scene":"El sonido de Filadelfia","scene_id":7236829286537,"scene_link":"https://volteret4.github.io/Funk/#philly-sound","chapters":["Cap. 10: Soul funky: Express Yourself"],"pages":[[1,148]]}],"mentions":[{"book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","page":146,"text":"…the pack. Hooked up with and distributed by CBS Records, the Philly Sound boasted a lineup that included the O’Jays, the Intruders, Billy Paul, and Harold Melvin & the Blue Notes featuring Theodore Pendergrass, as well as the house band, MFSB (Mother, Father, Sister, Brother). Every one of these acts scored huge national hits…"},{"book":"Funk: The Music, the People, and the Rhythm of the One","author":"Rickey Vincent","page":148,"text":"…between the slicker sound of disco, the street sound of The Funk, and the once familiar sentimental sound of soul. The Four Tops’ “Catfish,” Harold Melvin and the Blue Notes’ “Bad Luck” and “The Love I Lost,” and the Spinners’ “Mighty Love” were all brilliant, upbeat gospel/soul grooves that thematically fit all too…"}],"podcast":[{"kind":"podcast","title":"Pre-PIR Career Struggles","body":"Before their 1971 signing with Philadelphia International Records, Harold Melvin & The Blue Notes, similar to The O'Jays, endured a lengthy and difficult career. Collectively, the two groups had over 30 years of experience, recorded for 20 different labels, and had never achieved a Top 40 hit, primarily performing on the hotel lounge circuit. \"Harold Melvin in the Blue Notes had pretty much given up on recording careers and were playing the hotel lounge circuit.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 37 - Philly Soul and the Sound of the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 37 - Philly Soul and the Sound of the 70s","url":"https://seventies.libsyn.com/ep-37-philly-soul-and-the-sound-of-the-70s"}]},{"kind":"podcast","title":"Teddy Pendergrass's Transition","body":"A pivotal shift in the group's trajectory occurred when Teddy Pendergrass moved from his role as drummer to become the lead singer, a crucial strategic decision that coincided with their signing to PIR and significantly contributed to their subsequent success. \"Teddy Pendergrass stepped out from behind the drum kit into the role of lead singer.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 37 - Philly Soul and the Sound of the 70s","url":null},{"source":"For the Record - The 70s","episode":"Ep. 37 - Philly Soul and the Sound of the 70s","url":"https://seventies.libsyn.com/ep-37-philly-soul-and-the-sound-of-the-70s"}]}],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Don't Leave Me This Way (1976)","body":null,"year":1976,"extra":{"from":"Thelma Houston","from_id":28624997601256,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Life After Music","url":"https://www.youtube.com/watch?v=7jMfH9xAOpI"}]},{"kind":"xref","title":"Don't Leave Me This Way (1986)","body":null,"year":1986,"extra":{"from":"The Communards","from_id":32077985991468,"type":"song"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Life After Music","url":"https://www.youtube.com/watch?v=7jMfH9xAOpI"}]},{"kind":"xref","title":"The Communards (1986)","body":null,"year":1986,"extra":{"from":"The Communards","from_id":32077985991468,"type":"album"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Life After Music","url":"https://www.youtube.com/watch?v=7jMfH9xAOpI"}]}],"charts":[{"id":3925103772931,"type":"album","name":"I Miss You","list_id":85048702844562,"list":"RYM Top — R&B","src":"musthear","rank":128,"year":1972,"note":null,"yt":"fnnvRMSMWaI","scaruffi":null},{"id":39251037729