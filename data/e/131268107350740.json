:[],"own_scenes":[],"scenes":[{"id":133200493093823,"name":"Rock'n'roll","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1951,"end":1957,"desc":"Fusión de rhythm'n'blues y country, con mucho más peso del primero. Chuck Berry inventa en 1955 el rock'n'roll tal como se conocerá durante cincuenta años (la guitarra como instrumento protagonista, canciones propias que hablan a los adolescentes); Bo Diddley aporta el ritmo «hambone», Little Richard y Esquerita el histerismo y el maquillaje (el primer «decadence-rock»), Jerry Lee Lewis el piano feroz y Sun Records el rockabilly. Elvis Presley es, para Scaruffi, «la primera gran estafa del rock'n'roll». Buddy Holly y Eddie Cochran abren otra vía; en paralelo nacen el soul (Ray Charles), la exótica (Martin Denny, Esquivel), la música electrónica de cinta y, en Gran Bretaña, el skiffle.","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#rocknroll"},{"id":231270189174368,"name":"Easy listening / Space age pop","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1954,"end":1968,"desc":"El primer lounge quiso explorar el nuevo espacio —exterior y sonoro—: estéreo, ondiolín y theremín al servicio de una música cómoda y misteriosa.","color":"#f472b6","family":"Rock, synth-pop y canción","link":"https://volteret4.github.io/loops_timeline/#space-age"}],"book_tracks":[{"id":29281065886458,"artist":"Martin Denny","artist_id":131268107350740,"title":"Exotica","year":null,"ess":0,"yt":"Da37N6DsXvI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Rock'n'roll","scene_id":133200493093823,"scene_link":"https://volteret4.github.io/scaruffi/#rocknroll","chapters":["Sección 2.2"],"pages":[[1,14,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":14,"text":"…and more bizarre records. In 1955 Pete Seeger released the first album of African music by a white musician, Bantu Choral Folk Songs, and in 1956 Martin Denny's Exotica created a new genre. Mexican composer Esquivel concocted super-kitschy lounge music, scoring odd melodies and counterpoints for exotic…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":202,"text":"…and others to further expand their music towards other ethnic sounds. It was an evolution of the Byrds' raga-rock and of Les Baxter's and Martin Denny's \"exotica\", but facilitated by a larger availability of exotic instruments and of exotic recordings. The naive multi-cultural experiments of…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":311,"text":"…？ The popularity of rock and roll causes the record industry to boom and allows independent labels to flourish 1956 ？ Ska develops in Jamaica ？ Martin Denny's Exotica invents a new genre ？ Louis and Bebe Barron's soundtrack for the science-fiction film Forbidden Planet uses only electronic instruments ？…"}],"podcast":[{"kind":"podcast","title":"Exotica's Originator","body":"Martin Denny y su conjunto musical tocaban en un bar exótico en Hawái para ambientar. Durante una de sus presentaciones nocturnas, notó que los sapos cercanos croaban al ritmo de la música. Cuando la banda se detenía, los sapos también lo hacían. Denny y su grupo comenzaron a interactuar con los sapos, imitando cantos de pájaros y otros sonidos de animales, lo que encantó al público y dio origen al género exótica. \"Durante una de sus presentaciones nocturnas, notó que los sapos cercanos coraban al ritmo de la música.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"Así sonaba el pop de la era atómica","url":"https://www.youtube.com/watch?v=LqPX20XSa_s"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":29281065886458,"type":"album","name":"Exotica","list_id":4389278164509,"list":"Music Genre Tree"