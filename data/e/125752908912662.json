{"id":125752908912662,"type":"album","name":"Criminal Minded","artist":"Boogie Down Productions","year":1987,"weight":30,"info":{"cover":"https://ia801508.us.archive.org/19/items/mbid-f91244bf-8b14-4548-be56-60f32640f14d/mbid-f91244bf-8b14-4548-be56-60f32640f14d-4395476689.jpg","kind":"Album","tracks":10,"country":"US","yt":"lM77h4D4Yh0","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/boogie-down-productions/criminal-minded-4"},"desc":"Criminal Minded is the debut studio album by hip hop music group Boogie Down Productions, released on March 3, 1987 by B-Boy Records. It is considered a highly influential hip hop album and one of the first in the gangsta rap genre. Since its release, the album has been sampled, interpolated and paraphrased. Its samples and direct influences were unusual at the time, ranging from liberal use of dancehall reggae (as well as the more commonly used James Brown) to rock music artists such as AC/DC, The Beatles and Billy Joel. The album was eventually certified Gold by the RIAA. ."},"artist_ref":{"id":69090772203417,"name":"Boogie Down Productions","info":{"img":"https://cdn-images.dzcdn.net/images/artist/c8ccd6127006b2be72f252be2257a882/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":138496995988479,"type":"genre","name":"Hardcore Hip Hop","artist":null,"year":null,"weight":261,"yt":null,"src":"musthear"},{"id":187675146138866,"type":"genre","name":"Mid-School Hip Hop","artist":null,"year":null,"weight":109,"yt":null,"src":"rym"}],"lists":[{"id":160805225684486,"name":"RYM Top — Hip Hop — Mid-School Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":3,"year":null,"note":null,"total":109,"scaruffi":null},{"id":10053931114450,"name":"Pitchfork: The 200 Best Albums of the 1980s","src":"charts","grp":"musicbrainz","list_year":null,"rank":20,"year":1987,"note":null,"total":200,"scaruffi":null},{"id":36565743209502,"name":"Rolling Stone 500 Greatest Albums Of All Time 2023 Edition","src":"musthe