{"id":60558339375050,"type":"album","name":"Led Zeppelin III","artist":"Led Zeppelin","year":1970,"weight":26,"info":{"cover":"https://dn710700.ca.archive.org/0/items/mbid-7aadcfa2-df82-480e-8d2d-7ec4d0b41172/mbid-7aadcfa2-df82-480e-8d2d-7ec4d0b41172-1287533205.jpg","kind":"Album","tracks":10,"country":"US","aoty":82,"aoty_user":81,"yt":"4ryKUOjCgds","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/led-zeppelin/led-zeppelin-iii","aoty":"https://www.albumoftheyear.org/album/4523-led-zeppelin-led-zeppelin-iii.php"},"desc":"Led Zeppelin III, the third album by English rock band Led Zeppelin. It was recorded between January and July 1970 and was released October 5, 1970 by Atlantic Records. Led Zeppelin III marked a change in focus for the band from late 1960s hard rock to a more folk rock and acoustic inspired sound. These styles had been present to a lesser degree in the band's first two releases, but here it was the main style - and one that would remain prominent in the group's later albums. This change in direction endeared the band to many progressive rock fans ."},"artist_ref":{"id":212666524076420,"name":"Led Zeppelin","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Led_zeppelin_revista_pelo_1971.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear,rym"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"musthear,rym"},{"id":163225726165579,"type":"genre","name":"Blues Rock","artist":null,"year":null,"weight":458,"yt":null,"src":"musthear"},{"id":202159817309393,"type":"genre","name":"blues","artist":null,"year":null,"weight":444,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"wei