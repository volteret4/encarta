ruffi":null},{"id":209773919132126,"name":"RYM Top — Scenes & Movements — Mod","rank":66,"scaruffi":null},{"id":242302941379922,"name":"RYM Top — Rock — Britpop","rank":193,"scaruffi":null}],"n_lists":3}},{"id":214527464996652,"type":"album","name":"Painting","artist":"Ocean Colour Scene","year":2013,"weight":5,"yt":"60iQYHORP6M","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":122154202127653,"name":"RYM Top — Rock — Mod Revival","rank":68,"scaruffi":null},{"id":209773919132126,"name":"RYM Top — Scenes & Movements — Mod","rank":99,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[],"genres":[{"id":238796249276494,"type":"genre","name":"Britpop","artist":null,"year":null,"weight":831,"yt":null,"src":"ensayos"}],"album_genres":[{"id":54724129964741,"type":"genre","name":"Mod","n":7},{"id":1900502110055,"type":"genre","name":"Mod Revival","n":7},{"id":238796249276494,"type":"genre","name":"Britpop","n":6},{"id":252828057917300,"type":"genre","name":"Baggy","n":1},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":1},{"id":8412226417108,"type":"genre","name":"Indie Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":193634530822272,"name":"Brit-pop y post-pop","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2001,"desc":"Como tantas veces, el fenómeno más publicitado es el menos interesante: un «brit-pop» de grupos terriblemente parecidos y tediosos, sin apenas imaginación. Lo anticipan Lightning Seeds, La's, Teenage Fanclub y Heavenly; estalla con Boo Radleys, Blur (Parklife) y Oasis (el «farol» que mejor personifica la moda). Suede y el glam-pop (Super Furry Animals, Placebo), las excepciones de High Llamas (Hawaii) y Supergrass, el revival mod (Ocean Colour Scene, Wildhearts), Elastica, Sleeper, las Spice Girls; Trembling Blue Stars, Tindersticks, Delgados. El post-pop de Radiohead, «la banda más publicitada y sobrevalorada de la década», cuyo OK Computer es una obra maestra del falso vanguardismo; Coldplay, Travis.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#britpop"}],"book_tracks":[{"id":44891237906834,"artist":"Ocean Colour Scene","artist_id":140715076499489,"title":"Moseley Shoals","year":1996,"ess":0,"yt":"1rr4tXN2eJM","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Brit-pop y post-pop","scene_id":193634530822272,"scene_link":"https://volteret4.github.io/scaruffi/#britpop","chapters":["Sección 6.11"],"pages":[[1,271,null]]}],"mentions":[],"podcast":[{"kind":"podcast","title":"Britpop Party Attendee","body":"Ocean Colour Scene was listed among the bands that were part of the Britpop scene and received coverage during its peak. \"Here's a list of some of the people at the Britpop party. ...Ocean Color Scene...\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 90s Part 4: Britpop","url":"https://www.youtube.com/watch?v=5q5EnZj1FwE"}]},{"kind":"podcast","title":"Similar to Oasis","body":"Ocean Colour Scene was among the bands that started to appear, sounding similar to Oasis, demonstrating the latter's popularity and influence within the Britpop scene. \"The Oasis approach proved to be so popular that they started to hear and see similar bands.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt Rock: Chapter 12","url":"https://www.youtube.com/watch?v=DSvoppf1dGY"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":183233413113557,"type":"album","name":"Ocean Colour Scene","list_id":53161726480591,"list":"RYM Top — Rock — Baggy","src":"musthear","rank":48,"year":1992,"note":null,"yt":"3lwX7pdhc7M","scaruffi":null},{"id":44891237906834,"type":"album","name":"Moseley Shoals","list_id":238350566072075,"list":"Pitchfork: The 50 Best Britpop Albums","src":"must