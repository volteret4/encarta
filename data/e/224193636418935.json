{"id":224193636418935,"type":"album","name":"Rain Dances","artist":"Camel","year":1977,"weight":12,"info":{"cover":"https://dn720700.ca.archive.org/0/items/mbid-b317e02d-be44-4401-a624-c99808d7bc39/mbid-b317e02d-be44-4401-a624-c99808d7bc39-20550769832.jpg","kind":"Album","tracks":9,"country":"JP","scaruffi":7.0,"yt":"gK5F4b8qG9s","links":{"spotify":"https://open.spotify.com/album/5g9XeA0rKJANXqwOVio3o4","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_md9m7NqQCxYJeAzXCyRcyAp0-Xpsu_2rc","rateyourmusic":"https://rateyourmusic.com/release/album/camel/rain-dances-4"},"desc":"Rain Dances is the fifth studio album album by English progressive rock band Camel. It was released in 1977, with Deram Records, and brought a major change to the band's lineup, by replacing bassist Doug Ferguson with ex-Caravan Richard Sinclair and by adding saxophonist Mel Collins, former King Crimson member. Album summary Rain Dances possesses a more jazzy sound than the previous albums. That is mostly thanks to Sinclair's appearance, but also because of the band's aim to change their musical direction and molding the music into a more commercial smoothness. Another distinguishing point is the absence of Latimer's flute ."},"artist_ref":{"id":20044460785826,"name":"Camel","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Camel_headlining_Saturday_night_at_Ramblin_Man_2015_-_19475294134.jpg?width=500"}},"labels":[],"genres":[{"id":191826593279813,"type":"genre","name":"Art Rock","artist":null,"year":null,"weight":531,"yt":null,"src":"musthear"},{"id":138197775829889,"type":"genre","name":"Progressive Rock","artist":null,"year":null,"weight":439,"yt":null,"src":"musthear"}],"lists":[{"id":65232636722211,"name":"Scaruffi 1970s","src":"charts","grp":"Scaruffi","list_year":null,"rank":208,"year":1977,"note":null,"total":572,"scaruffi":7.0}],"podcast":[],"book_tracks":[{"id":224193636418935,"artist":"Camel","artist_id":20044460785826,"title":"Rain Dances","year":1977,"ess":1,