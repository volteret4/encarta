75805261026,"type":"album","name":"Rhapsody – 10 of his Greatest Piano Improvisations","artist":"Erroll Garner","year":2010,"weight":5,"yt":"UHXGBg6aCGE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":265238898886802,"name":"RYM Top — Jazz — Stride","rank":64,"scaruffi":null},{"id":280702155250789,"name":"RYM Top — Regional Music — Ragtime","rank":110,"scaruffi":null}],"n_lists":2}},{"id":279014911926716,"type":"album","name":"Piano Greats Starring Errol Garner and Art Tatun, Mike Di Napoli","artist":"Erroll Garner /","year":null,"weight":3,"yt":null,"src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":265238898886802,"name":"RYM Top — Jazz — Stride","rank":115,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":173049125996624,"type":"genre","name":"Stride","n":19},{"id":261516756034660,"type":"genre","name":"Ragtime","n":18},{"id":56173113450769,"type":"genre","name":"Swing","n":3},{"id":83242304689053,"type":"genre","name":"Bebop","n":2},{"id":151625601973552,"type":"genre","name":"Cool Jazz","n":1},{"id":73462906774042,"type":"genre","name":"Mambo","n":1},{"id":43371867581873,"type":"genre","name":"Cuban Music","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":138287060444582,"name":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","book":"Historia del jazz","author":"Ted Gioia","start":1943,"end":1990,"desc":"Mientras Powell, Monk y Tristano no encajan en el mercado de los cincuenta, otros seis pianistas llevan el piano moderno al gran público sin traicionar el jazz, pese al recelo de una crítica que identifica éxito con haberse «vendido». Oscar Peterson, descubierto por Norman Granz, heredero técnico de Tatum pero más deudor de Nat Cole, es «la voluntad de swing». Nat King Cole, pianista entre Hines y el bop en su trío sin batería, acaba como gran cantante popular. George Shearing populariza un suave sonido de quinteto («Lullaby of Birdland»). Erroll Garner, autodidacta que no leía música, hace sonar el piano como guitarra, batería o arpa (Concert by the Sea, «Misty»). Ahmad Jamal, con su uso del espacio, influye en Miles Davis y anticipa a Bill Evans (But Not for Me). Dave Brubeck, alumno de Milhaud, con Paul Desmond y Time Out legitima los compases inusuales con «Take Five».","color":"#f472b6","family":"Piano y voces: stride, boogie y cantantes","link":"https://volteret4.github.io/jazz/#piano-popular"}],"book_tracks":[{"id":57152719946819,"artist":"Erroll Garner","artist_id":75827444591607,"title":"Misty","year":1954,"ess":0,"yt":"P_tAU3GM9XI","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Cap. 6: El jazz moderno"],"pages":[[1,278]]},{"id":163208866849743,"artist":"Erroll Garner","artist_id":75827444591607,"title":"Concert by the Sea","year":1955,"ess":0,"yt":"D8L7MWqXd5A","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Cap. 6: El jazz moderno"],"pages":[[1,275],[1,278],[1,439]]},{"id":36096493615723,"artist":"Erroll Garner","artist_id":75827444591607,"title":"Afternoon of an Elf","year":1955,"ess":0,"yt":"sfF2H1VCktE","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Cap. 6: El jazz moderno"],"pages":[[1,278]]},{"id":244759843388622,"artist":"Erroll Garner","artist_id":75827444591607,"title":"I’ll Remember","year":1955,"ess":1,"yt":"I_aILGaLqyc","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Discografía recomendada: Discografía recomendada"],"pages":[[1,439]]},{"id":63019938450968,"artist":"Erroll Garner","artist_id":75827444591607,"title":"Paris Impressions","year":1958,"ess":0,"yt":"yyzp2dipxkc","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Cap. 6: El jazz moderno"],"pages":[[1,278]]},{"id":107239622849034,"artist":"Erroll Garner","artist_id":75827444591607,"title":"Magician","year":1974,"ess":0,"yt":"dBOsfSKqXHw","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Peterson, Garner, Jamal, Brubeck y el piano para el gran público","scene_id":138287060444582,"scene_link":"https://volteret4.github.io/jazz/#piano-popular","chapters":["Cap. 6: El jazz moderno"],"pages":[[1,278]]}],"mentions":[{"book":"Historia del jazz","author":"Ted Gioia","page":275,"text":"…las serpeantes líneas melódicas de Tristano. Correspondió a otros pianistas —Oscar Peterson, Nat Cole, George Shearing, Ahmad Jamal, Dave Brubeck y Erroll Garner— el desarrollo de un mayor público para el piano de jazz contemporáneo. Pese a sus diferencias, estos seis artistas del teclado eran intérpretes…"},{"book":"Historia del jazz","author":"Ted Gioia","page":275,"text":"…éxitos entre el público general — como «Take Five», de Brubeck, «Poinciana», de Jamal, West Side Story, de Peterson, o Concert by the Sea, de Garner— resultaban también elogiables como creaciones de primera fila. A lo largo de su carrera, Oscar Peterson hubo de cargar con la responsabilidad de…"},{"book":"Historia del jazz","author":"Ted Gioia","page":277,"text":"…músicos de su generación. La realidad, en cambio, es que buena parte de su producción grabada sólo apunta la complejidad de su personalidad musical. Erroll Garner, contemporáneo de Shearing, también llegó a tener muchos seguidores durante los años cincuenta, alcanzando tales cotas de fama que en 1958 el…"},{"book":"Historia del jazz","author":"Ted Gioia","page":277,"text":"…la música de concierto, tomó una decisión sin precedentes al entrar en el terreno del jazz para representarle. De todos los pianistas tratados aquí, Garner es quien menos vínculos poseía con el estilo bebop (pese a haber grabado y actuado con Charlie Parker durante la etapa de Bird en Los Ángeles). En realidad es difícil clasificar a Garner como miembro de escuela alguna. Su estilo era profundamente personal, a veces estrafalario, pero nunca pedestre. Luchó contra las limitaciones del…"},{"book":"Historia del jazz","author":"Ted Gioia","page":278,"text":"…con que podía rezagarse varios pasos por detrás del compás con un perezoso swing o bien cargar con todas sus fuerzas olvidando toda prudencia. Garner era autodidacta (¿quién podría haberle instruido en este estilo hecho de retazos?), y no sabía solfeo, aunque esto nada hizo por impedir su carrera musical. Sus manos eran asombrosas. Se dice que abarcaban una decimotercera (algo asombroso dada la diminuta estatura de Garner), y podía firmar autógrafos tanto con la izquierda como con la derecha. Esta condición de ambidextro también se manifestaba en el teclado. «Podía…"},{"book":"Historia del jazz","author":"Ted Gioia","page":278,"text":"…señaló maravillado Sy Johnson en una ocasión, «y desarrollar por separado lo que hacía con cada mano»[133]. Y pocos pianistas sabían mejor que Garner cómo mantener los diez dedos haciendo algo útil —y bien remunerado—. Se dice que realizó más de mil grabaciones para setenta sellos distintos. Dada…"},{"book":"Historia del jazz","author":"Ted Gioia","page":278,"text":"…(inmortalizada posteriormente por la película de cine negro Play Misty for Me) y su gran éxito para Columbia Concert by the Sea. Otros proyectos de Garner incluyen Paris Impressions, Afternoon of an Elf y Magician. El piano poco denso y ultra cool de Ahmad Jamal podría situarse en las antípodas de las oscilantes meditaciones rococó de Garner. Y si Garner tenía sus raíces en una época anterior, con sus ritmos anteriores al bop y un sentido tradicional del swing, Jamal era un heraldo del jazz del…"},{"book":"Historia del jazz","author":"Ted Gioia","page":280,"text":"…admiraba el público general. Su música tendía a ser compleja desde el punto de vista rítmico, pero rara vez tenía el explosivo swing de Peterson o Garner. Su única deferencia hacia los gustos del público de masas estaba en la elección de su repertorio, populista hasta el extremo, con una mezcla de…"},{"book":"Historia del jazz","author":"Ted Gioia","page":344,"text":"…en los locales musicales de la ciudad —había recibido algunas clases y demostraba tener una gran habilidad para la música—. Cuando un joven llamado Erroll Garner se unió a la banda, Blakey pasó a tocar la batería. (Cabe preguntarnos aquí por la posible existencia de una influencia a medio plazo. Como…"},{"book":"Historia del jazz","author":"Ted Gioia","page":344,"text":"…por practicar repentinos cambios dinámicos y extrañas exclamaciones musicales sorprendentemente similares al característico estilo pianístico de Garner). En 1939 Blakey se unió a Fletcher Henderson y más tarde trabajó con Mary Lou Williams antes de probar por primera vez el jazz moderno como batería…"},{"book":"Historia del jazz","author":"Ted Gioia","page":379,"text":"…mucho más allá de las figuras del bop reinantes en sus años de formación para incluir a Fats Waller, Jimmy Lunceford, Chick Webb, Cab Calloway, Erroll Garner, Dave Brubeck, Jaki Byard, Dick Twardzik, Horace Silver y, sobre todo, Duke Ellington. Si las últimas obras de Coleman se inspiraban en estilos…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":173820484948505,"type":"album","name":"Piano Solos","list_id":265238898886802,"list":"RYM Top — Jazz — Stride","src":"musthear","rank":34,"year":1946,"note":null,"yt":"JUCVJpMJfeo","scaruffi":null},{"id":173820484948505,"type":"album","name":"Piano Solos","list_id":280702155250789,"list":"RYM Top — Regional Music — Ragtime","src":"musthear","rank":51,"year":1946,"note":null,"yt":"JUCVJpMJfeo","scaruffi":null},{"id":202865411764021,"type":"album","name":"Playing Piano Solos","list_id":265238898886802,"list":"RYM Top — Jazz — Stride","src":"musthear","rank":44,"year":1949,"note":null,"yt":"P_tAU3GM9XI","scaruffi":null},{"id":165560205975261,"type":"album","name":"Playing Piano Solos, Vol. 3","list_id":265238898886802,"list":"RYM Top — Jazz — Stride","src":"musthear","rank":77,"year":1949,"note":null,"yt":"lw0YpJiaWLk","scaruffi":null},{"id":202865411764021,"type":"album","name":"Playing Piano Solos","list_id":280702155250789,"list":"RYM Top — Regional Music — Ragtime","src":"musthear","rank":74,"year":1949,"note":null,"yt":"P_tAU3GM9XI","scaruffi":null},{"id":165560205975261,"type":"album","name":"Playing Piano Solos, Vol. 3","list_id":280702155250789,"list":"RYM Top — Regional Music — Ragtime","src":"musthear","rank":152,"year":1949,"note":null,"yt":"lw0YpJiaWLk","scaruffi":null},{"id":39671787401967,"type":"album","name":"Piano Moods","list_id":265238898886802,"list":"RYM Top — Jazz — Stride","src":"musthear","rank":18,"year":1950,"note":null,"yt":"JUCVJpMJfeo","scaruffi":null},{"id":39671787401967,"type":"album","name":"Piano Moods","list_id":104623756088987,"list":"RYM Top — Jazz — Swing","src":"musthear","rank":83,"year":1950,"note":null,"yt":"JUCVJpMJfeo","scaruffi":null},{"id":39671787401967,"type":"album","name":"Piano Moods","lis