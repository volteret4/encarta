,"podcasts":[],"lists":[{"id":23522560571624,"name":"Sputnikmusic Best Albums 2025","rank":41,"scaruffi":null},{"id":68116810416510,"name":"RYM Top — Rock — Gothic Metal","rank":45,"scaruffi":null},{"id":68519467142167,"name":"RYM Top — Rock — Doom Metal","rank":165,"scaruffi":null}],"n_lists":3}},{"id":132856548579350,"type":"album","name":"Icon 30","artist":"Paradise Lost","year":2030,"weight":3,"yt":"5r5WfIHfu3M","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":68116810416510,"name":"RYM Top — Rock — Gothic Metal","rank":132,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":276780882306134,"type":"genre","name":"Gothic Metal","n":13},{"id":255263121494129,"type":"genre","name":"Metal","n":6},{"id":106139165979762,"type":"genre","name":"Death Doom Metal","n":4},{"id":64491050809040,"type":"genre","name":"Doom Metal","n":4},{"id":93579530230421,"type":"genre","name":"Gothic Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":52427769209791,"name":"Doom, super-doom y stoner rock","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2000,"desc":"El doom (exageración lenta, gótica y barroca de los grooves de Black Sabbath) crece en Inglaterra: Paradise Lost, Cathedral (las largas suites líricas de Forest Of Equilibrium), My Dying Bride y Electric Wizard, que infla la pesadez hasta que la música ya no fluye, solo retumba (Come My Fanatics, Dopethrone); Orange Goblin, Katatonia. El «super-doom» de los Melvins sigue en Seattle con Earth (drones colosales entre La Monte Young y monstruos extraterrestres), Karp, Sunn, y el «sludgecore» del Sur (Eyehategod, Harvey Milk). El stoner rock: Kyuss, Queens Of The Stone Age, Sleep, Fu Manchu, Monster Magnet, Wellwater Conspiracy, Boris.","color":"#f87171","family":"Hard rock, metal y grunge","link":"https://volteret4.github.io/scaruffi/#stoner-doom"}],"book_tracks":[{"id":190577669592444,"artist":"Paradise Lost","artist_id":25426047432602,"title":"Paradise Lost","year":1990,"ess":0,"yt":"t9XzCWeIn-E","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Doom, super-doom y stoner rock","scene_id":52427769209791,"scene_link":"https://volteret4.github.io/scaruffi/#stoner-doom","chapters":["Sección 6.16"],"pages":[[1,288,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":288,"text":"…of Black Sabbath's deadly grooves) became more and more popular in England thanks to a number of progressively more sophisticated groups. Paradise Lost, who debuted with Paradise Lost (1990), were the least creative of the founding fathers, but Cathedral (1), featuring vocalist Lee Dorrian (ex-Napalm Death), invented a new format…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":326,"text":"…Gabriel's Passion, Pandora's Box's Original Sin, Flaming Lips's Telepathic Surgery, Bitch Magnet's Umber, Dogbowl's Tit, Godflesh's Streetcleaner ？ Paradise Lost invents \"doom-metal\" ？ Meat Beat Manifesto invents \"jungle\" (or \"drum'n'bass\") music, a syncopated variant of house, a fusion of hip hop and techno,…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":194322337047318,"type":"album","name":"Gothic","list_id":34791388276823,"list":"RYM Top — Rock — Death Doom Metal","src":"musthear","rank":22,"year":1991,"note":null,"yt":"YRVeOjx8hqI","scaruffi":null},{"id":194322337047318,"type":"album","name":"Gothic","list_id":68519467142167,"list":"RYM Top — Rock — Doom Metal","src":"musthear","rank":80,"year":1991,"note":null,"yt":"YRVeOjx8hqI","scaruffi":null},{"id":194322337047318,"type":"album","name":"Gothic","work_year":1991,"list_id":222945056519976,"list":"Sputnikmusic Best Albums 1991","src":"charts","rank":162,"year":1991,"note":null,"yt":"YRVeOjx8hqI","scaruffi":null},{"id":257331407961694,"type":"album","name":