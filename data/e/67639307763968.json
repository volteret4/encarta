e":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"ensayos"},{"id":129644386263637,"type":"genre","name":"Punk Rock","artist":null,"year":null,"weight":1272,"yt":null,"src":"ensayos"},{"id":21082178992256,"type":"genre","name":"Skate Punk","artist":null,"year":null,"weight":290,"yt":null,"src":"ensayos"},{"id":208209582464218,"type":"genre","name":"Skate Culture","artist":null,"year":null,"weight":6,"yt":null,"src":"ensayos"}],"album_genres":[{"id":21082178992256,"type":"genre","name":"Skate Punk","n":12},{"id":41768310007919,"type":"genre","name":"Melodic Hardcore","n":8},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","n":1},{"id":129644386263637,"type":"genre","name":"Punk Rock","n":1},{"id":31482837869539,"type":"genre","name":"Punk","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":133100657668392,"name":"Hardcore en la era del punk-pop: emocore, ska-core y post-hardcore","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1989,"end":2001,"desc":"Mientras las revistas anuncian la «muerte del punk», el hardcore se convierte en un movimiento que no deja pueblo sin tocar y genera subgéneros. El «emocore» (Jawbreaker, Weezer, Sunny Day Real Estate, Promise Ring, At The Drive-In, Jimmy Eat World, Seaweed); el hardcore progresivo de Washington (Nation Of Ulysses, Make-Up, Shudder To Think, Jawbox, Edsel, Lungfish, Circus Lupus, Dismemberment Plan); el «ska-core» (Operation Ivy, Rancid, Mighty Mighty Bosstones, Sublime, No Doubt); el punk-pop que llega a las listas (Green Day, Offspring, Flop, Pennywise, Pegboy, Superchunk, Queers); el garage-punk californiano (Drive Like Jehu, Rocket From The Crypt, Blink 182, Zen Guerrilla); el jazzcore (Bazooka, Iceburn); la vieja escuela (D Generation, Supersuckers, Zeke, Dropkick Murphys, Silverfish, Turbonegro) y el post-hardcore de Unwound.","color":"#fb7185","family":"Punk, new wave, hardcore y noise","link":"https://volteret4.github.io/scaruffi/#punk-pop-90s"}],"book_tracks":[{"id":137709258875797,"artist":"Pennywise","artist_id":67639307763968,"title":"Pennywise","year":1991,"ess":0,"yt":"w7RTLQdrhcQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore en la era del punk-pop: emocore, ska-core y post-hardcore","scene_id":133100657668392,"scene_link":"https://volteret4.github.io/scaruffi/#punk-pop-90s","chapters":["Sección 6.15"],"pages":[[1,283,null]]},{"id":199591063929010,"artist":"Pennywise","artist_id":67639307763968,"title":"Unknown Road","year":1993,"ess":0,"yt":"HyNBmTNzCgQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore en la era del punk-pop: emocore, ska-core y post-hardcore","scene_id":133100657668392,"scene_link":"https://volteret4.github.io/scaruffi/#punk-pop-90s","chapters":["Sección 6.15"],"pages":[[1,283,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":283,"text":"…the likes) had inspired Green Day, in the 1990s Los Angeles was, de facto, a colony of San Francisco, recycling whatever was successful up north. Pennywise (1) led the charge with Pennywise (1991), and a sound that, while respectful of the masters of \"beach punk\", was also more pensive and atmospheric, eventually achieving the depth of…"}],"podcast":[{"kind":"podcast","title":"Booked for Content Pivot (1996)","body":"Pennywise was one of the bands brought on board for the 1996 Warped Tour, aligning with the festival's new direction to highlight punk and music that resonated with skate culture, following its sponsorship by Vans. \"This meant booking fishbone, the muddy, muddy boss tones, no effect, 3-11 penny wise, and this weird new group from San Diego called Blink 182.\"","year":1996,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"24 Years of the Warped Tour","url":"https://www.youtube.com/watch?v=7jfQaUV6Bq4"}]},{"kind":"podcast","title":"Financial Support for Blink-182 Tour","body":"When Blink-182 received an invitation to tour Australia but lacked the financial means to go, the members of Pennywise generously purchased their plane tickets. \"So the guys in the band Pennywise bought them their tickets.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 1","url":"https://www.youtube.com/watch?v=eljIIqCu5gU"}]}],"awards":[],"concerts":[{"kind":"concert","title":"Vans Warped Tour (1996)","body":null,"year":1996,"extra":null,"srcs":[]},{"kind":"concert","title":"Warped Tour","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[{"kind":"xref","title":"Blink-182's Manager","body":"Rick DeVoe became the manager for Blink-182, and he also managed other prominent bands such as The Offspring, No Effects, and Pennywise. He played a key role in raising Blink's profile, particularly within the snowboard community. \"The band attracted a manager, a guy by the name of Rick DeVoe, who also worked with groups like The Offspring and No Effects in Pennywise.\"","year":null,"extra":{"from":"Rick DeVoe","from_id":193008499545596,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 1","url":"https://www.youtube.com/watch?v=eljIIqCu5gU"}]},{"kind":"xref","title":"Manager Rick DeVoe","body":"The band secured Rick DeVoe as their manager, a professional who also managed groups like The Offspring, No Effects, and Pennywise, and who played a significant role in elevating Blink's profile, particularly within the snowboard crowd. \"The band attracted a manager, a guy by the name of Rick DeVoe, who also worked with groups like The Offspring and No Effects in Pennywise.\"","year":null,"extra":{"from":"blink‐182","from_id":214386792607367,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 1","url":"https://www.youtube.com/watch?v=eljIIqCu5gU"}]},{"kind":"xref","title":"New Millennium Success","body":"By the new millennium, this band was among the newer acts doing well as skate punk became massive. \"Not only were bands like Blink 182, the offspring, MXPX, Pennywise, and No Effects doing well, so were newer bands. Some 41, for example.\"","year":null,"extra":{"from":"Sum 41","from_id":165844528454639,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"History of Skate Punk","url":"https://www.youtube.com/watch?v=44dXy0StjIQ"}]},{"kind":"xref","title":"Pennywise's Financial Support","body":"When Blink-182 received an invitation to perform in Australia but lacked the necessary funds for travel, the members of the band Pennywise stepped in and purchased their plane tickets. \"So the guys in the band Pennywise bought them their tickets.\"","year":null,"extra":{"from":"blink‐182","from_id":214386792607367,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 1","url":"https://www.youtube.com/watch?v=eljIIqCu5gU"}]},{"kind":"xref","title":"Tours with Skate Punk Bands","body":"The Offspring landed tours with Pennywise and other similar skate punk bands, establishing their presence in the scene. \"They landed tours with Pennywise and a few other like-minded Skate Punk bands.\"","year":null,"extra":{"from":"The Offspring","from_id":157851789733522,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"History of Skate Punk","url":"https://www.youtube.com/watch?v=44dXy0StjIQ"}]}],"charts":[{"id":137709258875797,"type":"album","name":"Pennywise","list_id":262267672471842,"list":"RYM Top — Rock — Melodic Hardcore","src":"musthear","rank":125,"year":1991,"note":null,"yt":"w7RTLQdrhcQ","scaruffi":7.0},{"id":13770925