{"id":89325186629899,"type":"album","name":"'Round About Midnight","artist":"Miles Davis","year":1957,"weight":13,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/12955-round-about-midnight_182802.jpg","aoty":100,"aoty_user":81,"yt":"hazvLeTKkZA","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/miles-davis/round-about-midnight","aoty":"https://www.albumoftheyear.org/album/12955-miles-davis-round-about-midnight.php"},"desc":"'Round About Midnight is an album by jazz musician Miles Davis. It was his debut on Columbia Records, and was originally released in March 1957 (CL 949). The album took its name from the Thelonious Monk song \"'Round Midnight\". Recording sessions took place at Columbia Studio D on October 26, 1955, and at Columbia's 30th Street Studio on June 5 and September 10, 1956. 'Round About Midnight is widely recognized by jazz critics as a landmark album in hard bop and one of the greatest jazz albums of all time. On April 17, 2001, Sony reissued the album for compact ."},"artist_ref":{"id":92995535260784,"name":"Miles Davis","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Miles_Davis_by_Palumbo_cropped.jpg?width=500"}},"labels":[],"genres":[{"id":90794434709999,"type":"genre","name":"Hard Bop","artist":null,"year":null,"weight":220,"yt":null,"src":"rym"}],"lists":[{"id":34130462682279,"name":"AOTY Must Hear 1950s","src":"musthear","grp":null,"list_year":null,"rank":15,"year":null,"note":null,"total":19,"scaruffi":null},{"id":57714771365426,"name":"RYM Top — Jazz — Hard Bop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":21,"year":null,"note":null,"total":200,"scaruffi":null},{"id":127983995863234,"name":"RYM Top — Jazz","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":116,"year":null,"note":null,"total":200,"scaruffi":null}],"podcast":[],"book_tracks":[{"id":89325186629899,"artist":"Miles Davis","artist_id":92995535260784,"title":"'Round About Midnight","year":1957,"ess":1,"yt