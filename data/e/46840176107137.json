":54,"scaruffi":null}],"n_lists":1}},{"id":122493982224095,"type":"album","name":"Just Today","artist":"Bobby Vee","year":1968,"weight":3,"yt":"bCN6uWNS_is","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":258468824921983,"name":"RYM Top — Pop — Brill Building","rank":68,"scaruffi":null}],"n_lists":1}},{"id":199238728374431,"type":"song","name":"Rub-a-Dub-Dub","artist":"Bobby Vee","year":null,"weight":7,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":2}],"lists":[],"n_lists":0}},{"id":279085343130249,"type":"song","name":"Suzie Baby","artist":"Bobby Vee","year":null,"weight":10,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":3}],"lists":[],"n_lists":0}},{"id":11898892229091,"type":"song","name":"Suzy Baby","artist":"Bobby Vee","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"A History of Rock Music in 500 Songs","n":1}],"lists":[],"n_lists":0}}],"members":[],"member_of":[{"id":41007934489462,"type":"artist","name":"Bobby Vee's Band","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"}],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"},{"id":53681850040905,"type":"genre","name":"Rock & Roll","artist":null,"year":null,"weight":1066,"yt":null,"src":"ensayos"}],"album_genres":[{"id":247802226836647,"type":"genre","name":"Brill Building","n":5},{"id":100106212412601,"type":"genre","name":"Teen Pop","n":2},{"id":44132676723998,"type":"genre","name":"Merseybeat","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Winter Dance Party Replacement (1959)","body":"Bobby Vee, a young Minnesotan Holly sound-alike whose first single \"Suzie Baby\" was about to be released, was picked up to fill out the bill on the Winter Dance Party tour immediately after the fatal plane crash. \"A new young singer was picked up to round out the bill on the next gig, a young Minnesotan Holly Sounder-like called Bobby V, whose first single Suzy Baby was just about to come out.\"","year":1959,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 74: \"It Doesn't Matter Any More\" by Buddy Holly","url":"https://www.youtube.com/watch?v=6unib5T2mDQ"}]},{"kind":"podcast","title":"Covering for Buddy Holly","body":"Bobby Vee was recruited from Fargo, North Dakota, to cover for Buddy Holly at a show after Holly's death. He had a voice similar to Holly's, especially if not listened to closely. \"A singer from Fargo North Dakota named Bobby V, was drafted in to cover for Holly at the show that Holly had been travelling to when he died.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 97: \"Song to Woody\" by Bob Dylan","url":"https://www.youtube.com/watch?v=3DufLVcZyc4"}]},{"kind":"podcast","title":"Dylan's Appreciation","body":"Bob Dylan, despite making a name for himself with very different music, consistently argued that Bobby Vee deserved more respect than he typically received, believing there was merit in his music. \"he would always argue that V deserved rather more respect than he usually got, and that there was some merit to his music.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 97: \"Song to Woody\" by Bob Dylan","url":"https://www.youtube.com/watch?v=3DufLVcZyc4"}]},{"kind":"podcast","title":"Hiring Robert Zimmerman (Year not specified)","body":"When Bobby Vee later toured on his own, he hired Robert Zimmerman (who performed as Elston Gunn) as his piano player. \"When V went out on tour on his own later, he hired that Zimmerman kid we mentioned earlier as his piano player.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 74: \"It Doesn't Matter Any More\" by Buddy Holly","url":"https://www.youtube.com/watch?v=6unib5T2mDQ"}]},{"kind":"podcast","title":"Scopatone Involvement","body":"Bobby V was among the artists who produced films for the Scopatone machines. These machines were a form of video jukebox popular in the mid-1960s, offering short, often color, musical films in public venues. \"The Sedacca, Bobby V, Dion Warwick, and a few others got into the Scopatone business.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Future of the Music Video - Part 1","url":"https://www.youtube.com/watch?v=lqd6IbUJ7tg"}]},{"kind":"podcast","title":"Wave of \"Bobbys\"","body":"Vee had a career as one of the \"wave of Bobby's\" who frequently appeared on \"American Bandstand\" in the late 1950s and early 1960s. \"V would go on to have a career as one of the wave of Bobby's that swarmed all over American bandstand in the late 50s and early 60s\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 97: \"Song to Woody\" by Bob Dylan","url":"https://www.youtube.com/watch?v=3DufLVcZyc4"}]}],"awards":[],"concerts":[{"kind":"concert","title":"Winter Dance Party (Replacement Act)","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":222583494359945,"type":"song","name":"Devil or Angel","work_year":1960,"list_id":132782249584307,"list":"Billboard Year-End 1960","src":"singles","rank":59,"year":1960,"note":"","yt":"jz4cOMjtkaA","scaruffi":null},{"id":222583494359945,"type":"song","name":"Devil or Angel","work_year":1960,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":59,"year":1960,"note":null,"yt":"jz4cOMjtkaA","scaruffi":null},{"id":209045885322088,"type":"song","name":"Take Good Care of My Baby","work_year":1961,"list_id":157497903047680,"list":"Billboard Hot 100 nº1 · 1960s","src":"singles","rank":58,"year":1961,"note":"3 semanas