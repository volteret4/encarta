{"id":502577460964,"type":"album","name":"Wide Awake!","artist":"Parquet Courts","year":2018,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/103095-wide-awake.jpg","aoty":84,"aoty_user":82,"yt":"eZXS8Jpkiac","links":{"aoty":"https://www.albumoftheyear.org/album/103095-parquet-courts-wide-awake.php"},"desc":"Wide Awake! is the sixth studio album by American indie rock band Parquet Courts, released on May 18, 2018 on Rough Trade Records. The album was first announced in February 2018, while the album was recorded in December 2017 to January 2018. The band recruited Danger Mouse to produce the album, as the band claimed, as a way to push themselves outside of their comfort zone. Wide Awake! received critical acclaim upon its release. At Metacritic, which assigns a normalized rating out of 100 to reviews from mainstream publications, the album received an average score of 84, based on 16 ."},"artist_ref":{"id":257788868292953,"name":"Parquet Courts","info":{"img":null}},"labels":[],"genres":[{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":8412226417108,"type":"genre","name":"Indie Rock","artist":null,"year":null,"weight":1139,"yt":null,"src":"rym"},{"id":240296486236884,"type":"genre","name":"Art Punk","artist":null,"year":null,"weight":246,"yt":null,"src":"rym"}],"lists":[{"id":70166951544843,"name":"RYM Top — Rock — Art Punk","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":21,"year":null,"note":null,"total":200,"scaruffi":null},{"id":89365250498738,"name":"RYM Top — Rock — Indie Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":117,"year":null,"note":null,"total":200,"scaruffi":null},{"id":32958566637956,"name":"Sputnikmusic Best Albums 2018","src":"musthear","grp":"sputnikmusic","list_year":null,"rank":138,"year":null,"note":null,"total":200,"scaruffi":null},{"id":78805621635440,"name":"RYM Top — Rock — Punk","src":"musthear","grp":"rateyo