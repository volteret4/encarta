{"id":242726677894795,"type":"album","name":"You'd Prefer an Astronaut","artist":"Hum","year":1995,"weight":22,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/8838-youd-prefer-an-astronaut-2.jpg","aoty":80,"aoty_user":84,"yt":"c4UUessm_9U","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/hum/youd-prefer-an-astronaut","aoty":"https://www.albumoftheyear.org/album/8838-hum-youd-prefer-an-astronaut.php"},"desc":"You'd Prefer an Astronaut is the third studio album by Hum. It was released in 1995 by RCA Records as their major label debut. The title of the album is a lyric lifted from the song \"I'd Like Your Hair Long\". The album was quite succesful selling over 250.000 copies since its release, mostly due to the second single from the album, \"Stars\"; it became Hum's highest charting song, reaching 11 on Hot Modern Rock Tracks and 28 on Hot Mainstream Rock Tracks; it regained popularity a decade later after being featured in a Cadillac commercial with actress Kate Walsh. ."},"artist_ref":{"id":125007946400060,"name":"Hum","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"rym"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","artist":null,"year":null,"weight":714,"yt":null,"src":"rym"},{"id":237890000566646,"type":"genre","name":"Post-Hardcore","artist":null,"year":null,"weight":341,"yt":null,"src":"rym"}],"lists":[{"id":15546028624161,"name":"RYM Top — Rock — Post-Hardcore","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":25,"year":null,"note":null,"total":200,"scaruffi":null},{"id":79201857171461,"name":"RYM Top — Rock — Hardcore [Punk]","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":34,"year":null,"note":null,"total":200,"scaruffi":null},{"id":78805621635440,"name":"RYM To