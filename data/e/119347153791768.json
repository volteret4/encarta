{"id":119347153791768,"type":"artist","name":"The Dillinger Escape Plan","artist":null,"year":null,"weight":22,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/IMG_4170TheDillingerEscapePlan.jpg?width=500","bio":"The Dillinger Escape Plan es una banda musical formada en marzo del 1997 por Ben Weinman (guitarras), Adam Doll (bajo) y Chris Pennie (batería). En abril del mismo año, la banda añadió al vocalista Dimitri Minakakis y grabaron su debut, un mini cd que demostraba la ecléctica manera del cuarteto de llevar el sonido del hardcore mucho más allá, con cualquier herramienta a su disposición: desde jazz y ritmos latinos, hasta atmósferas industriales.","tags":["mathcore","experimental","hardcore","metalcore","metal"]},"works":[{"id":251933762007738,"type":"album","name":"Calculating Infinity","artist":"Dillinger Escape Plan","year":1999,"weight":28,"yt":"BCmQN6nZz14","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":173793889343323,"name":"Sputnikmusic Best Albums 1999","rank":40,"scaruffi":7.0},{"id":118267099057662,"name":"AOTY Must Hear 1990s","rank":16,"scaruffi":7.0},{"id":13018320481353,"name":"Scaruffi 1990s","rank":603,"scaruffi":7.0},{"id":53528518064456,"name":"RYM Top — Rock — Metalcore","rank":13,"scaruffi":7.0}],"n_lists":7}},{"id":153410118797111,"type":"album","name":"Irony Is a Dead Scene","artist":"The Dillinger Escape Plan","year":2002,"weight":5,"yt":"Xp8U6Mt_OG8","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":168227868676293,"name":"Sputnikmusic Best Albums 2002","rank":54,"scaruffi":null}],"n_lists":1}},{"id":93302579230833,"type":"album","name":"Miss Machine","artist":"The Dillinger Escape Plan","year":2004,"weight":15,"yt":"glnWYWJftTQ","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":187245616636746,"name":"Sputnikmusic Best Albums 2004","rank":84,"scaruffi":null},{"id"