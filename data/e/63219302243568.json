84815,"type":"genre","name":"Avant-Prog","n":3},{"id":274490571464652,"type":"genre","name":"Noise Rock","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":150113334913508,"name":"Neo-progresivo","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1977,"end":1997,"desc":"El impulso experimental de la new wave trae de vuelta el progresivo, con más acento jazz y nacido del ambiente no wave. En Nueva York, los Lounge Lizards de John Lurie («fake jazz»), Bill Laswell (Material, Massacre, Praxis, Axiom), los Golden Palominos de Anton Fier, Arto Lindsay y Ambitious Lovers, Scene Is Now, Dr Nerve, Mofungo, Ordinaires, Chuck Vrtacek. En Washington, Happy The Man y los Muffins, los mejores progresivos de su tiempo; en Boston, Birdsongs Of The Mesozoic; en el Oeste, Cartoon, PFS, Thinking Plague, U Totem, Adrian Belew, Michael Shrieve y Djam Karet. En Japón, After Dinner, YBO2, High Rise y Ruins; en Alemania, Caspar Brötzmann Massaker; en Inglaterra, Marillion y Ozric Tentacles; en Quebec, Jean Derome, René Lussier y Miriodor.","color":"#38bdf8","family":"Progresivo, krautrock y jazz-rock","link":"https://volteret4.github.io/scaruffi/#neo-prog"}],"book_tracks":[{"id":179195527071733,"artist":"Ruins","artist_id":63219302243568,"title":"Stonehenge","year":1990,"ess":0,"yt":"8m9wFAwR_Qs","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Neo-progresivo","scene_id":150113334913508,"scene_link":"https://volteret4.github.io/scaruffi/#neo-prog","chapters":["Sección 5.12"],"pages":[[1,164,null]]},{"id":79354363169571,"artist":"Ruins","artist_id":63219302243568,"title":"Hyderomastgroningen","year":1995,"ess":0,"yt":null,"kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Neo-progresivo","scene_id":150113334913508,"scene_link":"https://volteret4