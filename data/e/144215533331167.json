{"id":144215533331167,"type":"album","name":"Three Cheers for Sweet Revenge","artist":"My Chemical Romance","year":2004,"weight":32,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/5528-three-cheers-for-sweet-revenge_201340.jpg","aoty":77,"aoty_user":87,"yt":"A4FTbGiB1rQ","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/my-chemical-romance/three-cheers-for-sweet-revenge","aoty":"https://www.albumoftheyear.org/album/5528-my-chemical-romance-three-cheers-for-sweet-revenge.php"},"desc":"Three Cheers for Sweet Revenge is the second studio album by American rock band My Chemical Romance, released on June 8, 2004, by Reprise Records. Produced by Howard Benson, the album marked a significant departure from the raw, gritty sound of their 2002 debut I Brought You My Bullets, You Brought Me Your Love, showcasing a more polished blend of punk, pop, and post-hardcore that would propel the band to international stardom. Recorded at O'Henry Sound Studios in Burbank, California, the album is the first to feature rhythm guitarist Frank Iero on all tracks, as he had joined the band ."},"artist_ref":{"id":142748781381693,"name":"My Chemical Romance","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"rym"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":129644386263637,"type":"genre","name":"Punk Rock","artist":null,"year":null,"weight":1272,"yt":null,"src":"rym"},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","artist":null,"year":null,"weight":714,"yt":null,"src":"rym"},{"id":218004892059785,"type":"genre","name":"Emo","artist":null,"year":null,"weight":583,"yt":null,"src":"rym"},{"id":102845406900443,"type":"genre","name":"Pop Punk","artist":null,"year":null,"weight":477,"yt":null,"src":"rym"},{"id":237890000566646,"type":"genre","name":"Post-Hardcore","artist