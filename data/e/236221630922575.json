{"id":236221630922575,"type":"album","name":"All the Right Reasons","artist":"Nickelback","year":2005,"weight":10,"info":{"cover":"https://dn720705.ca.archive.org/0/items/mbid-c37d1208-0007-4952-8651-46fab4909c34/mbid-c37d1208-0007-4952-8651-46fab4909c34-42004691571.jpg","yt":"UkZxlucpRfY","desc":"All the Right Reasons is the fifth studio album by Canadian rock band Nickelback, released on October 4, 2005. It is the band's first album with former 3 Doors Down drummer Daniel Adair, who replaced Ryan Vikedal in January 2005. The album topped the Canadian Albums Chart and the American Billboard 200 albums chart and has sold over 11 million copies worldwide, according to certifications from the CRIA, the RIAA and the BPI. Seven singles were released from the album, of which four reached number one or two on the Canadian Singles Chart. The album re-entered the Finland Albums Chart ."},"artist_ref":{"id":8924700468938,"name":"Nickelback","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":109063683126539,"type":"genre","name":"Hard Rock","artist":null,"year":null,"weight":562,"yt":null,"src":"musthear"},{"id":270478598006331,"type":"genre","name":"Alternative Metal","artist":null,"year":null,"weight":293,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"},{"id":158507332972835,"type":"genre","name":"Post-Grunge","artist":null,"year":null,"weight":248,"yt":null,"src":"musthear"}],"lists":[{"id":10858627626042,"name":"Juno Awards: Album of the Year","src":"musthear","grp":"musicbrainz","list_year":null,"rank":2006,"year":null,"note":null,"total":193,"scaruffi":null}],"podcast":[],"book_tracks":[],"others":[{"id":64156906099293,"t