ame":"Dale Hawkins","artist":null,"year":null,"weight":79,"yt":null,"src":"ensayos"}],"genres":[{"id":202159817309393,"type":"genre","name":"blues","artist":null,"year":null,"weight":444,"yt":null,"src":"ensayos"}],"album_genres":[{"id":211270792239401,"type":"genre","name":"Roots Rock","n":9},{"id":166173220937290,"type":"genre","name":"Americana","n":3},{"id":90510611927654,"type":"genre","name":"Country Rock","n":2},{"id":202159817309393,"type":"genre","name":"blues","n":1},{"id":190085820831368,"type":"genre","name":"Tex-Mex","n":1},{"id":165053196394606,"type":"genre","name":"Texan Music","n":1},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":1},{"id":156823753286980,"type":"genre","name":"folk","n":1},{"id":106724307133297,"type":"genre","name":"Old-Time","n":1},{"id":98383796423204,"type":"genre","name":"Latin Alternative","n":1},{"id":71665924433698,"type":"genre","name":"Appalachian Folk Music","n":1},{"id":25807946430417,"type":"genre","name":"Indigenous North American Music","n":1},{"id":10697304889908,"type":"genre","name":"Reggae","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":93517293193665,"name":"Blues revival y blues-rock","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1966,"end":1972,"desc":"John Mayall define con Bluesbreakers (con Eric Clapton) el rhythm'n'blues tocado por blancos europeos, el blues-rock, y siembra el progresivo con sus discos de jazz y lounge. Su equivalente americano es Al Kooper (Blues Project, Supersession, Blood Sweat & Tears). Cream, el primer power-trio, cambia la cara del rock británico con improvisación de jazz, distorsión y solos interminables; Fleetwood Mac de Peter Green y Ten Years After llevan del blues al hard rock. En San Francisco, Janis Joplin, Steve Miller y Santana; en Los Ángeles, Taj Mahal y Ry Cooder reconstruyen las tradiciones; Bob Seger casa el grito soul con el Detroit obrero.","color":"#f87171","family":"Hard rock, metal y grunge","link":"https://volteret4.github.io/scaruffi/#blues-rock"}],"book_tracks":[{"id":9909110909347,"artist":"Ry Cooder","artist_id":116114379010586,"title":"Paradise And Lunch","year":1974,"ess":1,"yt":"Rd8_cDL0848","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Blues revival y blues-rock","scene_id":93517293193665,"scene_link":"https://volteret4.github.io/scaruffi/#blues-rock","chapters":["Sección 3.2"],"pages":[[1,46,null]]},{"id":183759187576075,"artist":"Ry Cooder","artist_id":116114379010586,"title":"Paris Texas","year":1985,"ess":0,"yt":"o3zEJqJhyM8","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Blues revival y blues-rock","scene_id":93517293193665,"scene_link":"https://volteret4.github.io/scaruffi/#blues-rock","chapters":["Sección 3.2"],"pages":[[1,46,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":46,"text":"…of Afro-American music, such as De Ole Folks At Home (1969), possibly his masterpiece, Real Thing (1971) and Recycling The Blues (1972); and Ry Cooder (2) would become famous with his thematic reconstructions of eras and styles (tex-mex, swing, rock'n'roll, etc), notably Paradise And Lunch (1974)…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":81,"text":"…blues-woman since Janis Joplin. who matured with Give It Up (1972). However, more original artists took the blues to places where it had never been. Ry Cooder had pioneered the musical reconstruction of past eras. Others exploited that idea in several guises. NRBQ (New Rhythm And Blues Quartet) rode the…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":184,"text":"…erudite Deep Natural (2002). Despite her tormented biography and rebellious attitudes, Shocked was fundamentally a collector of sonic icons a` la Ry Cooder. That standard of female folksinger migrated to the Bay Area via Barbara Manning (1), who had sung on two legendary folk-rock albums such as 28th…"},{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":259,"text":"…melodies that slowly crept out of their fragile envelopes on the elegant and stately Calla (1999), a softly-hallucinated music reminiscent of Ry Cooder's soundtracks and of Mark Lanegan's ambient ballads. Seattle (and the Northwest in general) originated a close relative of \"slo-core\", a form of…"}],"podcast":[{"kind":"podcast","title":"Band's Admiration","body":"Rai Cooder, identified as a \"blues legend,\" is held in high regard by The Tragically Hip. His mention clarifies a reference in the song \"At the Hundredth Meridian.\" \"And who's Rai Kooter? A blues legend, and the band likes him very, very much.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Tragically Hip's Fully Completely Reissue With Rob Baker","url":"https://www.youtube.com/watch?v=Vs1YyXgLpTE"}]},{"kind":"podcast","title":"Contribution to Hawkins' Late 60s Album","body":"Ry Cooder, a blues musician, contributed to Dale Hawkins' late 1960s album. This recording project, centered on the Swamp Rock style, was initiated after Creedence Clearwater Revival's successful cover of \"Suzy Q\" reignited Hawkins' recording career. \"along with a few newer blues musicians like Taj Mahal and Vaikudah.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 63: \"Susie Q\", by Dale Hawkins","url":"https://www.youtube.com/watch?v=4vqj1DcXOfw"}]},{"kind":"podcast","title":"Influenced by Blind Willie Johnson","body":"Rye Cooder is cited as a rock musician whose slide guitar playing was influenced by the early 20th-century blues artist Blind Willie Johnson. \"Like that, interned influence not only a billion country players, but rockers like Rye Kooter, Brian Jones and Keith Richards of the Rolling Stones and Duane Almond.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Rock Explainer 4","url":"https://www.youtube.com/watch?v=D8GU8ZpSgY8"}]}],"awards":[{"kind":"award","title":"Americana Lifetime Achievement Award for Instrumentalist (2007)","body":"Won.","year":2007,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q96586469"}]},{"kind":"award","title":"Grammy Awards","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q41254"}]}],"concerts":[],"xref":[],"charts":[{"id":208837991937833,"type":"album","name":"Ballads and Songs of the Blue Ridge Mountains: Persistence and Change","list_id":158632755471337,"list":"RYM Top — Folk — Appalachian Folk Music","src":"musthear","rank":156,"year":1968,"note":null,"yt":null,"scaruffi":null},{"id":113945951514842,"type":"album","name":"Ry Cooder","list_id":215436743643591,"list":"RYM Top — Rock — Roots Rock","src":"musthear","rank":132,"year":1970,"note":null,"yt":"WqpDThV4d48","scaruffi":null},{"id":100670630009967,"type":"album","name":"Boomer's Story","list_id":178815374306279,"list":"RYM Top — Blues","src":"musthear","rank":153,"year":1972,"note":null,"yt":"ceLQSdxPCBw","scaruffi":null},{"id":100670630009967,"type":"album","name":"Boomer's Story","list_id":103254340346721,"list":"RYM Top — Regional Music — Americana","src":"musthear","rank":106,"year":1972,"note":null,"yt":"ceLQSdxPCBw","scaruffi":null},{"id":147229483710376,"type":"album","name":"Into the Purple Valley","list_id":103254340346721,"list":"RYM Top — Regional Music — Americana","src":"musthear","rank":116,"year":1972,"note":null,"yt":"fJkuV_UOXus","scaruffi":null},{"id":147229483710376,"type":"album","name":"Into the Purple Valley","list_id":109535037444116,"list":"RYM Top — Rock — Country Rock","src":"musthear","rank":74,"year":1972,"note":null,"yt":"fJkuV_UOXus","