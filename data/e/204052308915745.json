{"id":204052308915745,"type":"song","name":"The Gift","artist":"The Velvet Underground","year":1967,"weight":10,"info":{"img":null},"artist_ref":{"id":132878248289584,"name":"The Velvet Underground","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Velvet_Underground_1968_by_Billy_Name.png?width=500"}},"labels":[],"genres":[],"lists":[],"podcast":[{"kind":"podcast","title":null,"body":"Featured on the album \"White Light/White Heat,\" this track is a prime illustration of the extreme channel separation common during the experimental phase of stereo mixing. All audio is panned either to the far left or far right, with a deliberate absence of sound in the middle, reflecting a belief that listeners would use balance controls to create their preferred mix. \"Listen to how everything is panned over to the extreme left and the extreme right.\"","year":1967,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Story of Stereo: Part 1","url":"https://www.youtube.com/watch?v=cbSmBrhNACg"}]}],"book_tracks":[],"others":[{"id":269109706839583,"type":"album","name":"White Light White Heat","year":1967,"weight":102},{"id":247152344057921,"type":"album","name":"The Velvet Underground & Nico","year":1967,"weight":74},{"id":114674453010766,"type":"song","name":"Heroin","year":1965,"weight":72},{"id":15903581861899,"type":"album","name":"The Velvet Underground","year":1969,"weight":68},{"id":48485711025490,"type":"song","name":"Venus in Furs","year":1965,"weight":44},{"id":1817921971485,"type":"song","name":"All Tomorrow's Parties","year":1993,"weight":36},{"id":119862125678355,"type":"song","name":"Sister Ray","year":1968,"weight":26},{"id":187843472267269,"type":"song","name":"I'm Waiting for the Man","year":1967,"weight":19},{"id":134661006159939,"type":"album","name":"Loaded","year":1970,"weight":16},{"id":257769212209998,"type":"work","name":"Femme Fatale","year":1967,"weight":11},{"id":206367694298915,"type":"song","name":"Waiting For