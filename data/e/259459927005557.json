{"id":259459927005557,"type":"artist","name":"Sheena Easton","artist":null,"year":null,"weight":31,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/EastonLive2009.jpg?width=500","bio":"Sheena Easton es el nombre artístico de Sheena Shirley Orr quien por su primer matrimonio tomó el apellido Easton; nació en (Bellshill, North Lanarkshire, Escocia, 27 de abril de 1959), es una actriz y cantante británica, de repertorio mayormente en inglés, si bien ha grabado exitosas versiones en español de sus \"hits\" en inglés. Su larga carrera incluye una canción para la saga de James Bond, colaboraciones con Kenny Rogers, Prince, Al Jarreau","tags":["pop","80s","female vocalists","Scottish","sheena easton"]},"works":[{"id":260412658722793,"type":"song","name":"For Your Eyes Only","artist":"Sheena Easton","year":1981,"weight":11,"yt":"fB1UxAhJgUQ","src":"charts,ensayos,singles","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":2}],"lists":[{"id":186303735515973,"name":"Billboard Year-End 1981","rank":92,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":92,"scaruffi":null}],"n_lists":2}},{"id":118968765586511,"type":"song","name":"Modern Girl","artist":"Sheena Easton","year":1981,"weight":4,"yt":"edOY_uGVPWs","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":186303735515973,"name":"Billboard Year-End 1981","rank":95,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":95,"scaruffi":null}],"n_lists":2}},{"id":119986812923647,"type":"song","name":"Morning Train","artist":"Sheena Easton","year":1981,"weight":2,"yt":null,"src":"charts","from":{"books":[],"podcasts":[],"lists":[{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":12,"scaruffi":null}],"n_lists":1}},{"id":57857068568588,"type":"song","name":"Morning Train (Nine to Five)","artist":"Sheena Easton","year":1981,"weight":3,"yt":"S_3vZYOYNYU","src":"singles","from":{"books":[],"podcasts":[