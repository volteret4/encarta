{"id":145782885812400,"type":"album","name":"This Year's Girl","artist":"Pizzicato Five","year":1991,"weight":10,"info":{"cover":"https://i.discogs.com/W3OcQMpuOtZCGbuh3I0JXLutgBQGZrz_G8C4vSunXBE/rs:fit/g:sm/q:90/h:516/w:600/czM6Ly9kaXNjb2dz/LWRhdGFiYXNlLWlt/YWdlcy9SLTE0OTc1/MS0xNjM1MTM1ODkz/LTIxMzMuanBlZw.jpeg","scaruffi":7.0,"yt":"8jbkBBOtAG8","desc":"This Year's Girl (女性上位時代) is the fifth studio album by Japanese pop band Pizzicato Five. It was released on September 1, 1991 by the Nippon Columbia imprint Seven Gods, serving as the band's first album for Nippon Columbia. This Year's Girl is the first Pizzicato Five album to feature Maki Nomiya as lead vocalist. On the album, the band augmented their Shibuya-kei sound with elements of alternative dance and began to more fully incorporate sampling into their music. ."},"artist_ref":{"id":134921440653862,"name":"Pizzicato Five","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Pizzicato_Five_logo.svg?width=500"}},"labels":[],"genres":[],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","src":"charts","grp":"Scaruffi","list_year":null,"rank":1041,"year":1991,"note":null,"total":1406,"scaruffi":7.0}],"podcast":[],"book_tracks":[{"id":145782885812400,"artist":"Pizzicato Five","artist_id":134921440653862,"title":"This Year's Girl","year":1991,"ess":0,"yt":"8jbkBBOtAG8","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Retrofuturismo y kitsch","scene_id":137971665577593,"scene_link":"https://volteret4.github.io/scaruffi/#retro-futurism","chapters":["Sección 6.11"],"pages":[[1,273,null]]}],"others":[{"id":231141305096994,"type":"album","name":"Couples","year":1987,"weight":12},{"id":114267247099565,"type":"album","name":"Happy End of the World","year":1997,"weight":9},{"id":185826191895273,"type":"album","name":"Playboy & Playgirl","year":1999,"weight":7},{"id":204564368253202,"type":"song","name":"Lov