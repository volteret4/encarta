{"id":218093354953785,"type":"album","name":"HBO (Haitian Body Odor)","artist":"Mach-Hommy","year":2016,"weight":11,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/2017/97684-hbo.jpg","aoty":82,"yt":"NM0jzOoQyj4","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/mach-hommy/hbo-haitian-body-odor","aoty":"https://www.albumoftheyear.org/album/97684-mach-hommy-hbo-haitian-body-odor.php"},"desc":"H.B.O. (Haitian Body Odor) is Mach-Hommy's ninth album. It was originally released on September 15, 2016, but was later re-released on March 10, 2017. The album is a tribute to Mach's Haitian ancestry, and covers the violence, revolution and beauty within the country. The album cover depicts former Haitian first lady Michele Bennett in a wedding dress, painted by Mach-Hommy himself. When the album first came out, it was not released on streaming platforms like how most albums would. Instead, Hommy sold copies of the album through his Instagram DM’s for $300 per copy. The album was later re-released on ."},"artist_ref":{"id":279073192966139,"name":"Mach-Hommy","info":{"img":null}},"labels":[],"genres":[{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"},{"id":126011890020151,"type":"genre","name":"Boom Bap","artist":null,"year":null,"weight":237,"yt":null,"src":"rym"},{"id":69149423353287,"type":"genre","name":"Abstract Hip Hop","artist":null,"year":null,"weight":224,"yt":null,"src":"rym"}],"lists":[{"id":96087554392730,"name":"RYM Top — Hip Hop — Abstract Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":35,"year":null,"note":null,"total":200,"scaruffi":null},{"id":96043603884883,"name":"RYM Top — Hip Hop — Boom Bap","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":43,"year":null,"note":null,"total":200,"scaruffi":null},{"id":45584128953585,"name":"RYM Top — Scenes & Movements — East Coast Hip Hop","src":"musthear","grp":"rateyourmusic","list