{"id":89469079505244,"type":"album","name":"Crosby, Stills & Nash","artist":"Crosby, Stills & Nash","year":1969,"weight":19,"info":{"cover":"https://ia800102.us.archive.org/31/items/mbid-8e770a65-a599-4501-8c36-84314600aa6b/mbid-8e770a65-a599-4501-8c36-84314600aa6b-11553414596.jpg","kind":"Album","tracks":14,"country":"US","aoty":97,"aoty_user":80,"yt":"Hm0sishe02U","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/crosby__stills_and_nash/crosby__stills_and_nash","aoty":"https://www.albumoftheyear.org/album/7027-crosby-stills-nash-crosby-stills-nash.php"},"desc":"Crosby, Stills & Nash is the debut album by Crosby, Stills & Nash, released in 1969. A landmark in folk rock and soft rock, the album introduced the trio’s signature harmonies and sophisticated songwriting, setting the stage for the rise of the Laurel Canyon sound. Featuring classics like Suite: Judy Blue Eyes, Marrakesh Express, and Helplessly Hoping, the record blends introspective lyrics with intricate acoustic arrangements. The chemistry between David Crosby, Stephen Stills, and Graham Nash proved to be groundbreaking, influencing countless artists in the singer-songwriter tradition. The album was both a critical and commercial success, solidifying CSN as one ."},"artist_ref":{"id":14219934614261,"name":"Crosby, Stills & Nash","info":{"img":null}},"labels":[],"genres":[{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear,rym"},{"id":251671925246370,"type":"genre","name":"Soft Rock","artist":null,"year":null,"weight":418,"yt":null,"src":"musthear"},{"id":223327500886715,"type":"genre","name":"Contemporary Folk","artist":null,"year":null,"weight":247,"yt":null,"src":"musthear"},{"id":200232380703960,"type":"genre","name":"Psychedelic Folk","artist":null,"year":null,"weight":228,"yt":null,"src":"musthear"