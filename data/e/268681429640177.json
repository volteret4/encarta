,"scenes":[{"id":70602249889008,"name":"Ambient house e IDM","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1989,"end":1999,"desc":"Música para relajarse en las «chill-out rooms» que se convierte en género propio, entre el techno y el minimalismo: Chill Out de KLF es su manifiesto; Irresistible Force, Orb (Adventures Beyond The Ultraworld, U.F. Orb: el DJ convertido en compositor clásico), Ultramarine, Global Communication, Spacetime Continuum, Banco De Gaia, Woob. La «Intelligent Dance Music»: Orbital (Brown Album), Eat Static, Sabres Of Paradise, Future Sound Of London, Black Dog, Leftfield, Richard James / Aphex Twin, Plastikman, Moby, Vapourspace. Y la música de baile para no bailarines: Scanner, Faithless, Lo-Fidelity Allstars, Luke Slater, Christian Vogel, David Holmes, Susumu Yokota.","color":"#2dd4bf","family":"Vanguardia, electrónica y ambient","link":"https://volteret4.github.io/scaruffi/#ambient-house"},{"id":273331343019816,"name":"Cyberdelia","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1990,"end":1998,"desc":"El trance a la británica: house envolvente y melódico, de tempo rebajado, que integra a públicos del pop y a antiguos hippies.","color":"#22d3ee","family":"Techno y derivados","link":"https://volteret4.github.io/loops_timeline/#cyberdelia"}],"book_tracks":[{"id":106179626450729,"artist":"Eat Static","artist_id":268681429640177,"title":"Implant","year":1995,"ess":0,"yt":"vtBeU5HKJyc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Ambient house e IDM","scene_id":70602249889008,"scene_link":"https://volteret4.github.io/scaruffi/#ambient-house","chapters":["Sección 6.9"],"pages":[[1,263,null]]},{"id":85823038676281,"artist":"Eat Static","artist_id":268681429640177,"title":"Epsylon","year":1995,"ess":0,"yt":"yfbc1CSa7Cg","kind":"a","book":{"id":8,"title":"A History