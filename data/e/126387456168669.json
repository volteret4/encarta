{"id":126387456168669,"type":"album","name":"Rushup Edge","artist":"The Tuss","year":2007,"weight":28,"info":{"cover":"https://dn710301.ca.archive.org/0/items/mbid-e1d2128c-436a-4584-95f5-07da18f3fba0/mbid-e1d2128c-436a-4584-95f5-07da18f3fba0-2573352078.jpg","yt":"R-5koLtMy98","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/the-tuss/rushup-edge"},"desc":"Rushup Edge is the first studio album released by electronic artist, The Tuss on June 25, 2007, released under Rephlex Records. The name of the album is an immediate reference to a mountain ridge in the British county of Derbyshire, the namesake of the album, Rushup Edge. It is speculated that Richard D. James, primarily known under the pseudonym/stage name of Aphex Twin is the true creator of this album, although it is unproven. The album is credited to the known members of The Tuss, Karen and Brian Tregaskin. Oddly enough the album Rushup Edge is available for purchase on ."},"artist_ref":{"id":266082497175835,"name":"The Tuss","info":{"img":"https://cdn-images.dzcdn.net/images/artist/6f74fbf6e77825fd280e07cca1d3cd6b/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":198176882370097,"type":"genre","name":"Techno","artist":null,"year":null,"weight":820,"yt":null,"src":"musthear,rym"},{"id":184262862830389,"type":"genre","name":"IDM","artist":null,"year":null,"weight":387,"yt":null,"src":"musthear,rym"},{"id":242119982771334,"type":"genre","name":"Electro","artist":null,"year":null,"weight":345,"yt":null,"src":"musthear"},{"id":190186564486905,"type":"genre","name":"Acid Techno","artist":null,"year":null,"weight":205,"yt":null,"src":"musthear,rym"},{"id":180679950718005,"type":"genre","name":"Breakbeat","artist":null,"year":null,"weight":281,"yt":null,"src":"rym"},{"id":65067151178508,"type":"genre","name":"Electronic Dance Music","artist":null,"year":null,"weight":244,"yt":null,"src":"rym"},{"id":205004235301098,"type":"genre","name":"Acid Breaks","artist":null,"year":null,"weight":50,"yt"