{"id":141994107210495,"type":"album","name":"Polygondwanaland","artist":"King Gizzard & The Lizard Wizard","year":2017,"weight":21,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/94615-polygondwanaland.jpg","aoty":75,"aoty_user":82,"yt":"XAdBWnp8W7Q","links":{"aoty":"https://www.albumoftheyear.org/album/94615-king-gizzard-the-lizard-wizard-polygondwanaland.php"},"desc":"Polygondwanaland is the twelfth studio album by Australian psychedelic rock band King Gizzard & the Lizard Wizard. It is entirely in the public domain - the band did not sell copies of the album, and put the master tapes online for anyone to use. It will be released on 17 November 2017. It is the fourth of five albums set to be released in 2017. On news of the album's release into the public domain, multitudes of fans and record labels decided to make their own pressings - a great contrast to the scalping of controversially limited Flightless colored vinyl ."},"artist_ref":{"id":29103150645628,"name":"King Gizzard and the Lizard Wizard","info":{"img":null}},"labels":[],"genres":[{"id":147423806094006,"type":"genre","name":"Psychedelic Rock","artist":null,"year":null,"weight":690,"yt":null,"src":"rym"},{"id":138197775829889,"type":"genre","name":"Progressive Rock","artist":null,"year":null,"weight":439,"yt":null,"src":"rym"}],"lists":[{"id":185548171992260,"name":"RYM Top — Rock — Psychedelic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":29,"year":null,"note":null,"total":200,"scaruffi":null},{"id":49373698556566,"name":"Sputnikmusic Best Albums 2017","src":"musthear","grp":"sputnikmusic","list_year":null,"rank":61,"year":null,"note":null,"total":200,"scaruffi":null},{"id":11393629798029,"name":"RYM Top — Rock — Progressive Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":71,"year":null,"note":null,"total":200,"scaruffi":null},{"id":128298934021735,"name":"RYM Top — Psychedelia","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":100,"