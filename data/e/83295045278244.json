":[],"genres":[],"album_genres":[{"id":62460266670315,"type":"genre","name":"Cuddlecore","n":16},{"id":7907596873750,"type":"genre","name":"Twee Pop","n":3},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":1},{"id":141955640672455,"type":"genre","name":"j-rock","n":1},{"id":102845406900443,"type":"genre","name":"Pop Punk","n":1},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":203478263290546,"name":"Cruces del punk: de Fugazi al punk-pop","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1986,"end":1997,"desc":"A finales de los ochenta el punk es el más vivo de los subgéneros del rock: miles de bandas ensayando en garajes, un lenguaje universal como no se veía desde los sesenta. Nueva York: Adrenalin O.D., el straight-edge de Youth Of Today y Gorilla Biscuits, el crossover punk-metal (Cro-Mags, Prong, Danzig). Washington lanza a Pussy Galore (la irrelevancia hecha relevante), Unrest y Fugazi de Ian MacKaye, que abstrae el hardcore en una forma teatral de compromiso ético y estético (Repeater, Steady Diet Of Nothing, Red Medicine), y Royal Trux (Twin Infinitives, «un Trout Mask Replica para la generación grunge»). El punk-pop de Mr T Experience, Dwarves, Henry Rollins, L7 (pioneras del «foxcore»), Lemonheads, Screeching Weasel, Goo Goo Dolls, Fastbacks, Shonen Knife; el «rogue folk» de los Pogues, Membranes y Chumbawamba.","color":"#fb7185","family":"Punk, new wave, hardcore y noise","link":"https://volteret4.github.io/scaruffi/#punk-crossover"}],"book_tracks":[{"id":219626823383755,"artist":"Shonen Knife","artist_id":83295045278244,"title":"Pretty Little Baka Guy","year":1986,"ess":0,"yt":"MiHp7TSgjIY","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cruces del punk: de Fugazi al punk-pop","scene_id":203478263290546,"scene_link":"https://volteret4.github.io/scaruffi/#punk-crossover","chapters":["Sección 5.23"],"pages":[[1,216,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":216,"text":"…reminiscent of Phil Spector and the girl-groups. Punk-pop was initially an underground phenomenon but soon spread all over the world. In Japan, Shonen Knife (1) made albums such as Pretty Little Baka Guy (1986) that could be the ultimate party music: superbly pointless, but irresistible. Rogue folk…"}],"podcast":[],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Drummer for Shonen Knife","body":"Atsuko Yamano is the drummer for Japan's legendary all-girl band Shonen Knife, often described as a \"Japanese all-girl version of the Ramones.\" Her drumming is central to their distinctive sound. \"At Sukko Yamano is the drummer for Japan's Legendary Shonen Knife.\"","year":null,"extra":{"from":"Atsuko Yamano","from_id":170287024754071,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Driven By Her: History of Female Drummers","url":"https://www.youtube.com/watch?v=9GHpC0kCgHY"}]}],"charts":[{"id":219626823383755,"type":"album","name":"Pretty Little Baka Guy","list_id":198686658475555,"list":"RYM Top — Rock — Cuddlecore","src":"musthear","rank":23,"year":1986,"note":null,"yt":"Kf0WlyvR3y8","scaruffi":7.0},{"id":219626823383755,"type":"album","name":"Pretty Little Baka Guy","list_id":251973115798518,"list":"RYM Top — Rock — Twee Pop","src":"musthear","rank":131,"year":1986,"note":null,"yt":"Kf0WlyvR3y8","scaruffi":7.0},{"id":219626823383755,"type":"album","name":"Pretty Little Baka Guy","list_id":52032266791182,"list":"Scaruffi 1980s","src":"musthear","rank":709,"year":1986,"note":null,"yt":"Kf0WlyvR3y8","scaruffi":7.0},{"id":14021342536003,"type":"album","name":"Let's Knife","list_id":198686658475555,"list":"RYM Top — Rock — Cuddlecore","src":"musthear","rank":20,"year":1993,"note":null,"yt":"GgsnX9JTQu8","scaruffi":null},{"id":140213425360