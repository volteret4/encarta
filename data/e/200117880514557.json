yt":null,"src":"ensayos"}],"album_genres":[],"labels":[{"id":154033766396652,"type":"label","name":"RCA Records","artist":null,"year":null,"weight":585,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Transition from Big Band Singer to Solo Star (1942)","body":"Perry Como was one of several big band singers who leveraged a loophole in the 1942 musicians' strike. Since singers were not bound by the union's recording ban, they were able to pursue solo careers, which transformed them into independent stars and personalities. \"And names included Bing Crosby and Frank Sinatra and Perry Como, all former big band singers.\"","year":1942,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Connections","url":"https://www.youtube.com/watch?v=V7WjNR1ujhk"}]},{"kind":"podcast","title":"Lieber & Stoller Collaboration","body":"Perry Como was one of the \"white pop stars\" with whom Jerry Lieber and Mike Stoller were contracted to work for RCA. This collaboration was noted as being \"very far from Lieber and Stoller's normal music.\" \"Not just Elvis, though he was obviously important to them, but people like Perry Como, who were very far from Lieber and Stoller's normal music.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 68: \"Yakety Yak\" by the Coasters","url":"https://www.youtube.com/watch?v=dtMHDD0-oOo"}]},{"kind":"podcast","title":"Pop Dominance (Early Domino Career)","body":"Perry Como was one of the biggest artists in pop music during the initial phase of Fats Domino's hit-making career, illustrating the significant shifts in popular music trends that Domino's long career bridged. \"When he started having hits, the biggest artist in pop music were Perry Como and the Andrew Sisters.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 45: \"Blueberry Hill\", by Fats Domino","url":"https://www.youtube.com/watch?v=VqIwZGJHgBg"}]}],"awards":[{"kind":"award","title":"Grammy Lifetime Achievement Award (2002)","body":"Won.","year":2002,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q935843"}]},{"kind":"award","title":"Equestrian Order of the Holy Sepulchre","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q836057"}]},{"kind":"award","title":"Kennedy Center Honors","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1738793"}]},{"kind":"award","title":"Peabody Awards","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q838121"}]},{"kind":"award","title":"Primetime Emmy Award","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1044427"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Transition from Big Band Singer to Solo Star (1942)","body":"Frank Sinatra, like other big band singers, benefited from the loophole in the 1942 American Federation of Musicians strike. Not being categorized as \"musicians\" by the union, these singers were free to record and embark on solo careers, becoming stars in their own right, independent of band leaders. \"And names included Bing Crosby and Frank Sinatra and Perry Como, all former big band singers.\"","year":1942,"extra":{"from":"Frank Sinatra","from_id":12263072241141,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Connections","url":"https://www.youtube.com/watch?v=V7WjNR1ujhk"}]},{"kind":"xref","title":"Work with Iconic Artists and Gold Records","body":"Throughout her career at RCA, Ethel Gabriel earned at least 15 gold records and worked on hits for legendary artists such as Elvis Presley and Perry Como. Her contributions were central to the success of many major label releases. \"And this included working on hits by people like Elvis Presley and Perry Como.\"","year":null,"extra":{"from":"Ethel Gabriel","from_id":218010986045369,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Driven By Her: Unsung Heroines","url":"https://www.youtube.com/watch?v=oRR7N-YUcRE"}]}],"charts":[{"id":2402266767568,"type":"song","name":"Prisoner of Love","work_year":1946,"list_id":253782725811816,"list":"Billboard Year-End 1946","src":"singles","rank":1,"year":1946,"note":"","yt":"lbNPg_Rp0ws","scaruffi":null},{"id":176800819936711,"type":"song","name":"Surrender","work_year":1946,"list_id":253782725811816,"list":"Billboard Year-End 1946","src":"singles","rank":11,"year":1946,"note":"","yt":"dH1c9r891oY","scaruffi":null},{"id":134164545838467,"type":"song","name":"They Say It's Wonderful","work_year":1946,"list_id":253782725811816,"list":"Billboard Year-End 1946","src":"singles","rank":25,"year":1946,"note":"","yt":"RZKIl2Vi3fQ","scaruffi":null},{"id":268233181472524,"type":"song","name":"Dig You Later (A Hubba-Hubba-Hubba)","work_year":1946,"list_id":253782725811816,"list":"Billboard Year-End 1946","src":"singles","rank":31,"year":1946,"note":"","yt":"DTaA7JJyl4M","scaruffi":null},{"id":42809219375736,"type":"song","name":"Chi-Baba, Chi-Baba (My Bambino Go to Sleep)","work_year":1947,"list_id":72801092514092,"list":"Billboard Year-End 1947","src":"singles","rank":12,"year":1947,"note":"","yt":"ChitRDolric","scaruffi":null},{"id":4356398723743,"type":"song","name":"When You Were Sweet Sixteen","work_year":1947,"list_id":72801092514092,"list":"Billboard Year-End 1947","src":"singles","rank":16,"year":1947,"note":"","yt":"ztKbgoVEXzg","scaruffi":null},{"id":142450695929859,"type":"s