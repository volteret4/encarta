{"id":105546107201550,"type":"album","name":"Floodland","artist":"The Sisters of Mercy","year":1987,"weight":20,"info":{"cover":"https://dn710604.ca.archive.org/0/items/mbid-6bf121c0-8e2f-456e-a695-c80ad469e276/mbid-6bf121c0-8e2f-456e-a695-c80ad469e276-2133623122.jpg","kind":"Album","tracks":17,"country":"XW","yt":"8rUXffWx2mE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/the-sisters-of-mercy/floodland"},"desc":"Floodland is the second studio album by English rock band The Sisters of Mercy. It was released on 13 November 1987 by Merciful Release and Warner Music Group. The recording of the album began in January 1987, roughly two years after the band disbanded following the departures of band members Craig Adams and Wayne Hussey. It was produced by Larry Alexander, band frontman Andrew Eldritch, and Jim Steinman while being recorded at Power Station Studios in Manhattan, Strawberry Studios in Manchester, The Wool Hall in Bath, and AIR Studios in London. Floodland received positive reviews from critics. Four official singles ."},"artist_ref":{"id":37952873059661,"name":"The Sisters of Mercy","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Sisters_of_Mercy_-_2019213001206_2019-07-31_Wacken_-_0165_-_5DSR2823.jpg?width=500"}},"labels":[],"genres":[{"id":93579530230421,"type":"genre","name":"Gothic Rock","artist":null,"year":null,"weight":272,"yt":null,"src":"musthear,rym"},{"id":84499211643503,"type":"genre","name":"dark wave","artist":null,"year":null,"weight":66,"yt":null,"src":"musthear"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"rym"},{"id":226054802434556,"type":"genre","name":"Post-Punk","artist":null,"year":null,"weight":755,"yt":null,"src":"rym"}],"lists":[{"id":242669898096444,"name":"RYM Top — Rock — Gothic Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":22,"year":null,"note":null,"total":200,"scaruffi":null},{"id":182218712006755,"name