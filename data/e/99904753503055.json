{"id":99904753503055,"type":"album","name":"Take Me to Your Leader","artist":"King Geedorah","year":2003,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/7935-take-me-to-your-leader-1.jpg","aoty":83,"aoty_user":82,"yt":"6u-JL-nNgJo","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/king-geedorah/take-me-to-your-leader","aoty":"https://www.albumoftheyear.org/album/7935-king-geedorah-take-me-to-your-leader.php"},"desc":"Take Me to Your Leader is the second studio album by British-American rapper MF DOOM, released under the alias King Geedorah via Big Dada on June 17, 2003. King Geedorah is the alias DOOM used as part of the underground super group Monsta Island Czars. The album features guest appearances from MF Grimm (as Jet Jaguar) as well as other MIC members. The character is based on the three-headed King Ghidorah, a fictional monster who appears as Godzilla's enemy in the Godzilla films. Mark Martelli of Pitchfork wrote that Take Me to Your Leader \"will excite you in a way ."},"artist_ref":{"id":157163944576263,"name":"King Geedorah","info":{"img":null}},"labels":[],"genres":[{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"},{"id":69149423353287,"type":"genre","name":"Abstract Hip Hop","artist":null,"year":null,"weight":224,"yt":null,"src":"rym"}],"lists":[{"id":96087554392730,"name":"RYM Top — Hip Hop — Abstract Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":13,"year":null,"note":null,"total":200,"scaruffi":null},{"id":45584128953585,"name":"RYM Top — Scenes & Movements — East Coast Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":32,"year":null,"note":null,"total":200,"scaruffi":null},{"id":43654442755664,"name":"RYM Top — Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":78,"year":null,"note":null,"total":200,"scaruffi":null},{"id":255227989163511,"name":"RYM Top — Scenes & M