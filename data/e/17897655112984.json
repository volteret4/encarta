{"id":17897655112984,"type":"album","name":"Peripheral Vision","artist":"Turnover","year":2015,"weight":13,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/2015/29366-peripheral-vision.jpg","aoty":75,"aoty_user":82,"sputnik":4.14,"yt":"8iY3g4EYV64","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/turnover/peripheral-vision","aoty":"https://www.albumoftheyear.org/album/29366-turnover-peripheral-vision.php","sputnikmusic":"https://www.sputnikmusic.com/album/187325/Turnover-Peripheral-Vision/"},"desc":"Peripheral Vision is the second studio album by American rock band Turnover. It was released on May 4, 2015 through Run for Cover Records. Following the release of their debut album Magnolia (2013), Turnover parted ways with original guitarist Kyle Kojan, replacing him with Eric Soucy. For Peripheral Vision, Turnover returned to producer Will Yip, who shares songwriting credits on the entire album. It was recorded at his studio, Studio 4, in Conshohocken, Pennsylvania. The album finds the band shifting from their pop punk origins to a more atmospheric, dream pop-type sound. Peripheral Vision peaked on at number four on ."},"artist_ref":{"id":128987197844117,"name":"Turnover","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":19761880143227,"type":"genre","name":"Dream Pop","artist":null,"year":null,"weight":343,"yt":null,"src":"rym"},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","artist":null,"year":null,"weight":266,"yt":null,"src":"rym"}],"lists":[{"id":98168090585459,"name":"Sputnikmusic Best Albums 2015","src":"musthear","grp":"sputnikmusic","list_year":null,"rank":1