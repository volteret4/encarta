ists":2}},{"id":169624929838456,"type":"song","name":"Summertime","artist":"The Sundays","year":1997,"weight":2,"yt":"QNYxj8rkiNY","src":"singles","from":{"books":[],"podcasts":[],"lists":[{"id":102275314674505,"name":"Triple J Hottest 100 · 1997","rank":35,"scaruffi":null}],"n_lists":1}}],"members":[{"id":248352652815258,"type":"artist","name":"Harriet Wheeler","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":168386698161856,"type":"artist","name":"Paul Brindley","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":163736178683455,"type":"artist","name":"David Gavurin","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":100533821310764,"type":"genre","name":"Alt-rock","artist":null,"year":null,"weight":654,"yt":null,"src":"ensayos"},{"id":243042263847970,"type":"genre","name":"Dreampop","artist":null,"year":null,"weight":184,"yt":null,"src":"ensayos"}],"album_genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":3},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":2},{"id":30277598324326,"type":"genre","name":"pop","n":2},{"id":15906669628272,"type":"genre","name":"Jangle Pop","n":2},{"id":19761880143227,"type":"genre","name":"Dream Pop","n":1},{"id":18872195504512,"type":"genre","name":"Pop Rock","n":1}],"labels":[{"id":223829938655925,"type":"label","name":"Rough Trade","artist":null,"year":null,"weight":156,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Hiatus and Disappearance (1997)","body":"After releasing several records with significant gaps between them, The Sundays ceased activity in 1997. Harriet Wheeler and David Gavurin disappeared from the public eye. Fans were intensely curious, with one instance of Harriet being spotted at a supermarket causing a stir. \"And then in 1997, they just stopped. Harriet and David disappeared. Fans grasped at any clues. There was a minor revelation when Harriet was spotted at a supermarket.\"","year":1997,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Couples in Music","url":"https://www.youtube.com/watch?v=5Dhh5_PDhd0"}]},{"kind":"podcast","title":"Focus on Family and Continued Secrecy","body":"Harriet and David, who had been married for years, decided to prioritize spending time with their children. Although they reportedly continue to make music, they are too \"paranoid\" to release anything. An intense fan once located their home address, but the couple refused to speak to them, and the other two band members also declined interviews. \"Harriet and David, who've been married for years, decided that they needed to spend more time with their kids. According to people who know them, they continue to make music but are too paranoid to release anything.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Couples in Music","url":"https://www.youtube.com/watch?v=5Dhh5_PDhd0"}]},{"kind":"podcast","title":"Formation at Bristol University","body":"The English alt-rock band The Sundays formed after singer Harriet Wheeler and guitarist David Gavurin met while attending Bristol University in the late 1980s. They began dating, formed a band, and secured a deal with Rough Trade Records. \"They met when singer Harriet Wheeler met guitarist David Gavarin while they were attending Bristol University in the middle ladies. They started dating, then a band was assembled, and they got a deal with rough trade records.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Couples in Music","url":"https://www.youtube.com/watch?v=5Dhh5_PDhd0"}]},{"kind":"podcast","title":"Paul Brindley's Music Industry Involvement","body":"Bass player Paul Brindley is the most visible member of The Sundays since their hiatus. He operates a music industry website called Music Alley. \"The most visual member of the Sundays is bass player Paul Brindley. He runs a music industry website called Music Alley, which I use every day, and is very, very good.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Couples in Music","url":"https://www.youtube.com/watch?v=5Dhh5_PDhd0"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":118267099057662,"list":"AOTY Must Hear 1990s","src":"musthear","rank":432,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":66678364571761,"list":"RYM Top — Pop","src":"musthear","rank":128,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":82075953765266,"list":"RYM Top — Pop — Indie Pop","src":"musthear","rank":21,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":84403038516466,"list":"RYM Top — Rock — Alternative Rock","src":"musthear","rank":125,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":161051722508702,"list":"RYM Top — Rock — Jangle Pop","src":"musthear","rank":7,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","list_id":209707313206254,"list":"RYM Top — Rock — Pop Rock","src":"musthear","rank":43,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":39224196377476,"type":"album","name":"Reading, Writing and Arithmetic","work_year":1990,"list_id":90391435651867,"list":"Sputnikmusic Best Albums 1990","src":"charts","rank":68,"year":1990,"note":null,"yt":"fdqNbt5gyWE","scaruffi":null},{"id":153258655212405,"type":"album","name":"Blind","list_id