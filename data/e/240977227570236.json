{"id":240977227570236,"type":"album","name":"Swordfishtrombones","artist":"Tom Waits","year":1983,"weight":24,"info":{"cover":"https://dn710204.ca.archive.org/0/items/mbid-96e3f43d-3f48-44a0-9f74-5d90d887c114/mbid-96e3f43d-3f48-44a0-9f74-5d90d887c114-35993860707.jpg","kind":"Album","tracks":15,"country":"JP","scaruffi":8.0,"aoty":95,"aoty_user":83,"yt":"vaTSQzYIR3U","links":{"spotify":"https://open.spotify.com/album/6kvSCK1lNgZokyIK4Sk73B","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_ks6Tmwa2Nu9V4Oie7s9F90-Lw4hYx2oXE","rateyourmusic":"https://rateyourmusic.com/release/album/tom-waits/swordfishtrombones","aoty":"https://www.albumoftheyear.org/album/5896-tom-waits-swordfishtrombones.php"},"desc":"Swordfishtrombones is an album by American singer-songwriter Tom Waits, released in September 1983. It was the first album that Waits produced himself and is marked as such by a sense of artistic freedom that would increasingly characterize his later work. Stylistically different from his previous LPs, Swordfishtrombones moves away from the piano and string orchestra arrangements of the late seventies replacing them instead with unusual instrumentation and a somewhat more abstract songwriting approach. Swordfishtrombones peaked at #164 on Billboard's Pop Albums and Billboard 200 albums chart. In 1989, Spin Magazine named Swordfishtrombones the second greatest album of all time. ."},"artist_ref":{"id":96611256838042,"name":"Tom Waits","info":{"img":"https://cdn-images.dzcdn.net/images/artist/8fb57c7acdbffa039c3667dbdbe21498/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"musthear"},{"id":163225726165579,"ty