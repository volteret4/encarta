{"id":225736858002240,"type":"album","name":"Schlagenheim","artist":"black midi","year":2019,"weight":16,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/153878-schlagenheim_090812.jpg","aoty":81,"aoty_user":85,"yt":"6aF7bJsYs74","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/black-midi/schlagenheim","aoty":"https://www.albumoftheyear.org/album/153878-black-midi-schlagenheim.php"},"desc":"\"Schlagenheim\" is the debut studio album by English rock band black midi, released on 21 June 2019 through Rough Trade Records. The band recorded the majority of the album over a five-day period with producer Dan Carey at his studio in South London. Throughout its recording, the band made the conscious decision not to replicate their live set, embellishing their four-piece setup with synthesizers, sequencers, drum machines, banjos and organs, whilst the music was developed organically through extensive jamming sessions. \"Schlagenheim\" received praise from music critics, being nominated for the 2019 Mercury Prize and appearing inside the top-ten of several .","sputnik":3.79},"artist_ref":{"id":86616365729783,"name":"black midi","info":{"img":null}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":55893123468232,"type":"genre","name":"Experimental Rock","artist":null,"year":null,"weight":373,"yt":null,"src":"rym"},{"id":274490571464652,"type":"genre","name":"Noise Rock","artist":null,"year":null,"weight":360,"yt":null,"src":"rym"},{"id":125057452333169,"type":"genre","name":"Math Rock","artist":null,"year":null,"weight":299,"yt":null,"src":"rym"},{"id":229359158268774,"type":"genre","name":"Windmill Scene","artist":null,"year":null,"weight":109,"yt":null,"src":"rym"}],"lists":[{"id":196018807627530,"name":"RYM Top — Rock — Math Rock","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":3,"year":null,"note":null,"total":200,"scaruffi":null},{"i