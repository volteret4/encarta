{"id":243834609763935,"type":"album","name":"Visions","artist":"Grimes","year":2012,"weight":24,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/2987-visions_204847.jpg","aoty":79,"aoty_user":80,"yt":"sRfXZr2xwsM","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/grimes/visions-8/","aoty":"https://www.albumoftheyear.org/album/2987-grimes-visions.php"},"desc":"Visions is the third studio album by Canadian musician Grimes. It was released through 4AD on February 21, 2012. Her first since signing with 4AD, the album was recorded entirely on Apple's GarageBand software in Grimes' apartment over a three-week period. It was mixed by Grimes and her manager, Sebastian Cowan, at their La Brique Studio Space in Montreal. Visions was streamed on the NPR website a week before it was released in the United States. \"Visions\" was acclaimed by music critics and was included in several year-end lists. The album's two singles, \"Oblivion\" and \"Genesis\", were named among the ."},"artist_ref":{"id":203688491118316,"name":"Grimes","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Grimes_Governors_Ball_2014_03_%28cropped%29.png?width=500"}},"labels":[],"genres":[{"id":19761880143227,"type":"genre","name":"Dream Pop","artist":null,"year":null,"weight":343,"yt":null,"src":"musthear"},{"id":260819262438325,"type":"genre","name":"synth-pop","artist":null,"year":null,"weight":325,"yt":null,"src":"musthear"},{"id":57638771788875,"type":"genre","name":"Synthpop","artist":null,"year":null,"weight":260,"yt":null,"src":"rym"},{"id":55143051280122,"type":"genre","name":"Indietronica","artist":null,"year":null,"weight":225,"yt":null,"src":"rym"},{"id":220879654471976,"type":"genre","name":"Chillwave","artist":null,"year":null,"weight":222,"yt":null,"src":"rym"}],"lists":[{"id":129368384959327,"name":"RYM Top — Electronic — Chillwave","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":5,"year":null,"note":null,"total":200,"scaruffi":null},