ype":"genre","name":"Country Rock","n":1},{"id":53681850040905,"type":"genre","name":"Rock & Roll","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":77707013048741,"name":"Los autores (1975-1990)","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1975,"end":1990,"desc":"La emancipación definitiva de la mujer en el rock (Terry Garthwaite, Joan Armatrading, Nanci Griffith y, sobre todo, Rickie Lee Jones, protegida de Tom Waits); la escuela tejana de cantautores herederos de Townes Van Zandt (Guy Clark, Butch Hancock, Joe Ely, Terry Allen, Rodney Crowell, T-Bone Burnett); el populismo melancólico de la posguerra de Vietnam (Warren Zevon, Rick Danko, Steve Forbert, John Hiatt, John Mellencamp, Don Henley, Donald Fagen, Robbie Robertson); y el puente de 1977 hacia la new wave: Peter Gabriel, poeta atormentado de las neurosis postindustriales, Marianne Faithfull y Kate Bush.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#auteurs"}],"book_tracks":[{"id":132598434556295,"artist":"John Hiatt","artist_id":274856356959420,"title":"Slug Line","year":1979,"ess":1,"yt":"owr651xJTzU","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Los autores (1975-1990)","scene_id":77707013048741,"scene_link":"https://volteret4.github.io/scaruffi/#auteurs","chapters":["Sección 4.6"],"pages":[[1,96,null]]},{"id":223546551724499,"artist":"John Hiatt","artist_id":274856356959420,"title":"Stolen Moments","year":1990,"ess":0,"yt":"16EcHP4mpWc","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Los autores (1975-1990)","scene_id":77707013048741,"scene_link":"https://volteret4.github.io/scaruffi/#auteurs","chapters":["Sección 4.6"],"pages":[[1,96,null]]},{"id":95095015890290,"artist":"John Hiatt","artist_id":274856356959420,"title":"Walk On","year":1995,"ess":0,"yt":"dnkLmRjvHK4","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Los autores (1975-1990)","scene_id":77707013048741,"scene_link":"https://volteret4.github.io/scaruffi/#auteurs","chapters":["Sección 4.6"],"pages":[[1,97,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":96,"text":"…and heralded the folk-rock revival of the 1980s, were typical of the search for the \"new Dylan\", that continued unhindered throughout the 1970s. John Hiatt (3) improved over the eclectic style of Leon Russell (country, soul, gospel, rock and blues) by adding reggae and rhythm'n'blues to Slug Line…"}],"podcast":[{"kind":"podcast","title":"Lyricist for \"Cracked Rear View\" Album Title","body":"The title of Hootie & the Blowfish's debut album, *Cracked Rear View*, was derived from a poignant lyric in a 1987 song by John Hiatt. While the band sometimes joked it was a \"perial butt joke,\" it was actually a metaphor about a car's literal rear-view mirror, underscoring a deeper meaning behind the seemingly dubious title. \"Hoody came to regard cracked rear view as a perial butt joke, but it was in fact a quote of a very poignant lyric from a 1987 John Hyatt song, a metaphor about a car's actual rear view mirror.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"A Little Love and Some Tenderness Edition Part 1","url":null}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":132598434556295,"type":"album","name":"Slug Line","work_year":1979,"list_id":65232636722211,"list":"Scaruffi 1970s","src":"charts","rank":359,"year":1979,"note":null,"yt":"owr651xJTzU","scaruffi":7.0},{"id":187469251566977,"type":"album","name":"Riding With the King","list_id":215436743643591,"list":"RYM Top — Rock — Roots Rock","src":"musthear","rank":193,"year":1983