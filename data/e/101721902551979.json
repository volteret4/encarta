rom":{"books":[],"podcasts":[],"lists":[{"id":232340494179734,"name":"RYM Top — Rock — Atmospheric Sludge Metal","rank":128,"scaruffi":null}],"n_lists":1}},{"id":147069261009898,"type":"album","name":"An Undying Love for a Burning World","artist":"Neurosis","year":2026,"weight":14,"yt":"98m4aOa-uqI","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":88928055066249,"name":"Sputnikmusic Best Albums 2026","rank":1,"scaruffi":null},{"id":175315787363075,"name":"RYM Top — Rock — Metal","rank":25,"scaruffi":null},{"id":221505587927745,"name":"RYM Top — Rock — Sludge Metal","rank":1,"scaruffi":null},{"id":232340494179734,"name":"RYM Top — Rock — Atmospheric Sludge Metal","rank":1,"scaruffi":null}],"n_lists":6}}],"members":[],"member_of":[],"genres":[{"id":171871969725315,"type":"genre","name":"Thrash Metal","artist":null,"year":null,"weight":278,"yt":null,"src":"ensayos"},{"id":226181653583833,"type":"genre","name":"Post-Metal","artist":null,"year":null,"weight":235,"yt":null,"src":"ensayos"}],"album_genres":[{"id":239115025180721,"type":"genre","name":"Atmospheric Sludge Metal","n":13},{"id":226181653583833,"type":"genre","name":"Post-Metal","n":11},{"id":67015852974648,"type":"genre","name":"Sludge Metal","n":11},{"id":255263121494129,"type":"genre","name":"Metal","n":9},{"id":245950225873330,"type":"genre","name":"Post-Rock","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":125507898131948,"type":"genre","name":"Dark Ambient","n":1},{"id":64491050809040,"type":"genre","name":"Doom Metal","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":214973503971385,"name":"La bestia ha vuelto: OzzFest y las reuniones","book":"Heavy Metal: The Music and Its Culture","author":"Deena Weinstein","start":1996,"end":1999,"desc":"A finales de siglo el metal vuelve a la corriente principal. Con el alternativo moribundo y la electrónica sin despegar, el público fiel sigue ahí: tres mil personas esperan cinco horas en un centro comercial de Chicago en 1998 a que Black Sabbath les firme discos. El detonante es el OzzFest de 1997, organizado por la mánager de Ozzy, que vende más que Lollapalooza con Pantera, Machine Head, Fear Factory, Type O Negative, Neurosis, tres cuartas partes de Black Sabbath y Marilyn Manson, cuyas provocaciones atraen protestas cristianas y titulares. Metallica vuelve a tocar su thrash en directo y en Garage Inc.; Judas Priest ficha a Tim «Ripper» Owens, cantante de una banda tributo llamada British Steel; Mötley Crüe recupera a Vince Neil, Kiss se reúne en 1998, Dickinson regresa a Iron Maiden y Black Sabbath hace en 1999 una gira de reunión con disco de oro. Weinstein ve en ese regreso el gusto «prole» de la cultura de fin de siglo, un contrapeso a la feminización del pop y la ansiedad milenarista: la bestia se niega a morir.","color":"#ef4444","family":"Heavy metal clásico y NWOBHM","link":"https://volteret4.github.io/HeavyMetal/#resurreccion-metal"},{"id":225164069558548,"name":"Metal industrial y post-industrial","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1986,"end":1999,"desc":"Uno de los logros clave de finales de los ochenta: la fusión de música industrial con hard rock y heavy metal, iniciada por los suizos Young Gods (samples de guitarras metálicas) y KMFDM. Chicago la completa: Ministry de Al Jourgensen (The Land Of Rape And Honey, «Jesus Built My Hot Rod»), Revolting Cocks, Pigface de Martin Atkins y, de ahí, Nine Inch Nails de Trent Reznor, que cambia el destino del industrial (Pretty Hate Machine, The Downward Spiral). El post-industrial: Neurosis, Steel Pole Bath Tub, Cop Shoot Cop, Missing Foundation, Pain Teens, Godflesh de Justin Broadrick, y los proyectos de Jello Biafra (Lard, Tumor Circus).","color":"#94a3b8","family":"Gótico e industrial","link":"https://volteret4.github.io/scaruffi/#industrial-metal"}],"book_tracks":[{"id":166871144515917,"artist":"Neurosis","artist_id":101721902551979,"title":"Souls At Zero","yea