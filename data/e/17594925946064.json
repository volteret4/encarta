45711678,"type":"artist","name":"Marky Walberg","artist":null,"year":null,"weight":4,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"ensayos"},{"id":273637054039964,"type":"genre","name":"Top 40 radio","artist":null,"year":null,"weight":13,"yt":null,"src":"ensayos"}],"album_genres":[{"id":64401182886525,"type":"genre","name":"Boy Band","n":7},{"id":260819262438325,"type":"genre","name":"synth-pop","n":1},{"id":249056050558872,"type":"genre","name":"Pop Rap","n":1},{"id":136937573393074,"type":"genre","name":"hip hop","n":1},{"id":100106212412601,"type":"genre","name":"Teen Pop","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Pop Dominance (1988)","body":"In 1988, the future of music appeared to belong to pop acts like New Kids on the Block, signaling a low point for rock music and prompting \"rock is dead\" cries. \"It looked especially bad through 1988 when it looked as if the future belonged to new kids on the block...\"","year":1988,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt Rock Chapter: 14","url":"https://www.youtube.com/watch?v=MK7L0eCpDHc"}]},{"kind":"podcast","title":"Aging Out of Pop Phase (1990)","body":"The generation of kids who were fans of New Kids on the Block had aged out of their pop phase by 1990, contributing to the decline of pop music. \"The generation of kids who were into new kids in the block and Tiffany and Debbie Gibson had aged out of their pop phase.\"","year":1990,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Amazing Year That Was 1991","url":"https://www.youtube.com/watch?v=Rf1tFWQg51Y"}]},{"kind":"podcast","title":"\"Terrible\" Pop Music of Late 1980s","body":"This group was named as an example of the \"absolutely terrible\" pop music prevalent at the end of the 1980s, which contributed to Generation X's dire experience as rock fans. \"New kids on the block, Debbie Gibson, Tiffany, if you were part of Generation X, the children of the baby boomers, it was a pretty dire time to be a rock fan.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 90s Part 3: Grunge","url":"https://www.youtube.com/watch?v=tFBSrKMEZxI"}]},{"kind":"podcast","title":"Mainstream Pop (Late 1980s)","body":"New Kids on the Block represented the kind of mainstream pop music that fans of alternative and non-mainstream rock actively avoided at the end of the 1980s. Their music was commonly found on Top 40 radio, which was antithetical to the alternative music scene's sensibilities. \"You want nothing to do with hair metal or classic rock or new kids on the block or anything on top 40 radio.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt-Rock: Chapter 10","url":"https://www.youtube.com/watch?v=OiqdZfxdBP0"}]},{"kind":"podcast","title":"Pop Dominance in Early 1990s","body":"New Kids on the Block were among the leading pop acts that characterized the music scene at the very beginning of the 1990s, before the cultural shift away from \"Happy-Go-Lucky Pop\" began in 1990-1991. \"At the very beginning of the decade, pop music ruled Michael Jackson, Janet Jackson, Maddon, Millie Vanilley, and new kids on the block.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 1: Rock Struggles Again","url":"https://www.youtube.com/watch?v=5Y6nHw5xx88"}]}],"awards":[{"kind":"award","title":"Boston Music Awards (1989)","body":"Won.","year":1989,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4948004"}]},{"kind":"award","title":"MTV Video Music Award for Best Choreography (1989) — You Got It (The Right Stuff)","body":"Nominated.","year":1989,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q849435"}]},{"kind":"award","title":"American Music Award for Favorite Pop/Rock Album (1990) — Hangin' Tough","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q19858080"}]},{"kind":"award","title":"American Music Award for Favorite Pop/Rock Band/Duo/Group (1990) — Hangin' Tough","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1441676"}]},{"kind":"award","title":"Billboard Music Awards (1990)","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q392565"}]},{"kind":"award","title":"Boston Music Awards (1990)","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4948004"}]},{"kind":"award","title":"Grammy Award for Best Music Film (1990) — Hangin' Tough","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4992254"}]},{"kind":"award","title":"Kids' Choice Award for Favorite Male Artist (1990)","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q125018101"}]},{"kind":"award","title":"Kids' Choice Award for Favorite Song (1990) — Hangin' Tough","body":"Won.","year":1990,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q111951297"}]},{"kind":"award","title":"Boston Music Awards (1991)","body":"Won.","year":1991,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4948004"}]},{"kind":"award","title":"Smash Hits Poll Winners Party (1992)","body":"Won.","year":1992,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q7544220"}]},{"kind":"award","title":"Boston Music Awards (2008)","body":"Won.","year":2008,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q4948004"}]},{"kind":"award","title":"star on Hollywood Walk of Fame","body":"Won.","year":null,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q17985761"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Lack of Appeal to Generation X (1990)","body":"By 1990, the generation that had aged out of pop music from artists like New Kids on the Block was not interested in moving on to artists like Whitney Houston. \"And they certainly weren't interested in moving on to Whitney Houston and Fleetwood Mac.\"","year":1990,"extra":{"from":"Whitney Houston","from_id":205709632152529,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Amazing Year That Was 1991","url":"https://www.youtube.com/watch?v=Rf1tFWQg51Y"}]},{"kind":"xref","title":"Lack of Appeal to Generation X (1990)","body":"By 1990, the generation that had aged out of pop music from artists like New Kids on the Block was not interested in moving on to artists like Fleetwood Mac. \"And they certainly weren't interested in moving on to Whitney Houston and Fleetwood Mac.\"","year":1990,"extra":{"from":"Fleetwood Mac","from_id":146498497979064,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Amazing Year That Was 1991","url":"https://www.youtube.com/watch?v=Rf1tFWQg51Y"}]},{"kind":"xref","title":"\"Terrible\" Pop Music of Late 1980s","body":"Debbie Gibson was cited as an example of the \"absolutely terrible\" pop music at the close of the 1980s, which left Generation X rock fans feeling uninspired. \"New kids on the block, Debbie Gibson, Tiffany, if you were part of Generation X, the children of the baby boomers, it was a pretty dire time to be a rock fan.\"","year":null,"extra":{"from":"Debbie Gibson","from_id":69181399478376,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The 90s Part 3: Grunge","url":"https://www.youtube.com/watch?v=tFBSrKMEZxI"}]},{"kind":"xref","title":"\"Terrible\" Pop Music of Late 1980s","body":"Tiffany was listed as one of the artists representing the \"absolutely terrible\" pop music scene at the end of the 1980s, contributing to a bleak period for Generation X rock fans. \"New kids on the block, Debbie Gibson, Tiffany, if you were part of Generation X, the children of the baby boomers, it was a pretty dire time to be a rock fan.\"","year":null,"extra":{"from":"tiffany","from_id":151253941334341,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The 90s Part 3: Grunge","url":"https://www.youtube.com/watch?v=tFBSrKMEZxI"}]},{"kind":"xref","title":"Brief Tenure in New Kids on the Block","body":"Marky Walberg, known as Marky Mark, was briefly a member of the boy band New Kids on the Block. He is the younger brother of Donnie Walberg, another member of the group, but was kicked out of the band and replaced by Joey. \"He was a new kid too, but he was kicked out and replaced by Joey.\"","year":null,"extra":{"from":"Marky Walberg","from_id":2978645711678,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Listener Email","url":"https://www.youtube.com/watch?v=Yl2poVWguu0"}]},{"kind":"xref","title":"Pop Dominance in Early 1990s","body":"Michael Jackson was one of the artists who ruled pop music at the very beginning of the 1990s, before the rise of grunge and alternative music culture changed the musical landscape. \"At the very beginning of the decade, pop music ruled Michael Jackson, Janet Jackson, Maddon, Millie Vanilley, and new kids on the block.\"","year":null,"extra":{"from":"Michael Jackson","from_id":280024189546702,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 1: Rock Struggles Again","url":"https://www.youtube.com/watch?v=5Y6nHw5xx88"}]},{"kind":"xref","title":"Pop Dominance in Early 1990s","body":"Janet Jackson was among the pop music artists who ruled the airwaves and charts at the start of the 1990s, prior to the significant shift brought about by grunge and alternative music. \"At the very beginning of the decade, pop music ruled Michael Jackson, Janet Jackson, Maddon, Millie Vanilley, and new kids on the block.\"","year":null,"extra":{"from":"Janet Jackson","from_id":106512712212410,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 1: Rock Struggles Again","url":"https://www.youtube.com/watch?v=5Y6nHw5xx88"}]},{"kind":"xref","title":"Pop Dominance in Early 1990s","body":"Madonna was a prominent figure in the pop music scene that dominated the very beginning of the 1990s, preceding the major cultural shift towards grunge and alternative music. \"At the very beginning of the decade, pop music ruled Michael Jackson, Janet Jackson, Maddon, Millie Vanilley, and new kids on the block.\"","year":null,"extra":{"from":"Madonna","from_id":120396521633899,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 1: Rock Struggles Again","url":"https://www.youtube.com/watch?v=5Y6nHw5xx88"}]},{"kind":"xref","title":"Pop Dominance in Early 1990s","body":"Milli Vanilli contributed to the pop music sound that ruled at the very beginning of the 1990s, before a series of events and the rise of Generation X ushered in the era of grunge and alternative music. \"At the very beginning of the decade, pop music ruled Michael Jackson, Janet Jackson, Maddon, Millie Vanilley, and new kids on the block.\"","year":null,"extra":{"from":"Milli Vanilli","from_id":11690099952342,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 1: Rock Struggles Again","url":"https://www.youtube.com/watch?v=5Y6nHw5xx88"}]}],"charts":[{"id":2667