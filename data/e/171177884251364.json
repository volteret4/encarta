{"id":171177884251364,"type":"artist","name":"God Is My Co-pilot","artist":null,"year":null,"weight":12,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/ad1be536aefac4f0837662b982c5d38a/1000x1000-000000-80-0-0.jpg","bio":"God Is My Co-Pilot is a queercore band from New York City that has been recording and playing since 1991. Their music has been variously described as experimental, noise rock, hardcore punk and avant jazz. Stay Free zine said of the music, \"We hear a new sound, 'free punk' we'll call it.\" The band themselves disliked that phrase, preferring not to classify their music at all.\n\nThe two main members are Sharon Topper, vocalist, and Craig Flanagin, guitar.","tags":["queercore","experimental","post-punk","noise rock","noise"]},"works":[{"id":30589811417482,"type":"album","name":"I Am Not This Body","artist":"God Is My Co-pilot","year":1992,"weight":18,"yt":"QZmms25guuo","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","rank":727,"scaruffi":7.0},{"id":110920763824306,"name":"RYM Top — Scenes & Movements — Queercore","rank":11,"scaruffi":7.0}],"n_lists":2}},{"id":123366661637864,"type":"album","name":"Speed Yr Trip","artist":"God Is My Co-Pilot","year":1992,"weight":3,"yt":"-s36S4ePPQ0","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":110920763824306,"name":"RYM Top — Scenes & Movements — Queercore","rank":9,"scaruffi":null}],"n_lists":1}},{"id":57262627140783,"type":"album","name":"Getting Out of Boring Time Biting Into Boring Pie","artist":"God Is My Co-Pilot","year":1993,"weight":3,"yt":"5KTVM57G-YA","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":110920763824306,"name":"RYM Top — Scenes & Movements — Queercore","rank":96,"scaruffi":null}],"n_lists":1}},{"id":83962309284671,"type":"album","name":"How to Be","artist":"God Is My Co-Pilot","year":1993,"weight":3,"