{"id":42662354908309,"type":"artist","name":"Charlie Rich","artist":null,"year":null,"weight":59,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Charlie_Rich_1973.JPG?width=500","bio":"Músico estadounidense (1932-1995). Tocaba de todos los estilos: Country; Rock & Roll; Blues; Soul; Gospel y Jazz, Pero la mayoría de ellos no se editaron nunca. En 1956 tras terminar el servicio militar, empieza de semiprofesional en clubes Blues de Memphis. Es contratado por Sun Records como músico de estudio. En 1960 consigue su único éxito con este sello con el tema \"Lonely Weekends\". Tras cambiar varias veces de compañía, firma con EPIC Records","tags":["country","soul","classic country","singer-songwriter","Rock and Roll"]},"works":[{"id":150142947214804,"type":"song","name":"Lonely Weekends","artist":"Charlie Rich","year":1960,"weight":4,"yt":"-1YD_Ejb450","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":132782249584307,"name":"Billboard Year-End 1960","rank":99,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":99,"scaruffi":null}],"n_lists":2}},{"id":253563926130588,"type":"work","name":"Mohair Sam","artist":"Charlie Rich","year":1965,"weight":6,"yt":"R4SvJv8TGE0","src":"books","from":{"books":[{"name":"1966","title":"1966: The Year the Decade Exploded (Jon Savage)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":224474139132280,"type":"album","name":"The Many New Sides of Charlie Rich","artist":"Charlie Rich","year":1965,"weight":3,"yt":"0U-Tnk5paMk","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":63534269289112,"name":"RYM Top — R&B — Country Soul","rank":63,"scaruffi":null}],"n_lists":1}},{"id":199076755892477,"type":"album","name":"The Best Years","artist":"Charlie Rich","year":1966,"weight":3,"yt":"GSFsAtVglH0","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":63534269289112,"name":"RYM Top — R&B — Country Soul","rank":111,"scaruffi":null}],"n_lists":1}},{"id":17235869