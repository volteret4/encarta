{"id":143799146176435,"type":"album","name":"Under My Skin","artist":"Avril Lavigne","year":2004,"weight":12,"info":{"cover":"https://ia800309.us.archive.org/1/items/mbid-fc3241dc-51f1-4866-9019-db6b2f98b053/mbid-fc3241dc-51f1-4866-9019-db6b2f98b053-13364294030.jpg","yt":"1Nlel6bsRms","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/avril-lavigne/under-my-skin"},"desc":"Under My Skin is the second studio album by Canadian singer-songwriter Avril Lavigne that was released through the RCA Records internationally throughout May 2004. Lavigne wrote most of the album with singer-songwriter Chantal Kreviazuk, who invited her to a Malibu in-house recording studio shared by Kreviazuk and her husband Raine Maida, where Lavigne recorded many of the songs. The album was produced by Maida, Don Gilmore, and Butch Walker. Under My Skin debuted at number-one on the U.S. Billboard 200 albums chart and according to Billboard magazine, was ranked number 149 on the list of top-selling albums of the 2000s. ."},"artist_ref":{"id":111077490160587,"name":"Avril Lavigne","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":102845406900443,"type":"genre","name":"Pop Punk","artist":null,"year":null,"weight":477,"yt":null,"src":"musthear"},{"id":100106212412601,"type":"genre","name":"Teen Pop","artist":null,"year":null,"weight":282,"yt":null,"src":"musthear"},{"id":158507332972835,"type":"genre","name":"Post-Grunge","artist":null,"year":null,"weight":248,"yt":null,"src":"musthear,rym"}],"lists":[{"id":100790941083842,"name":"RYM Top — Rock — Post-Grunge","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":