{"id":150431553542927,"type":"album","name":"Cobra and Phases Group Play Voltage in the Milky Night","artist":"Stereolab","year":1999,"weight":16,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/25478-cobra-and-phases-group-play-voltage-in-the-milky-night-1.jpg","aoty":60,"aoty_user":84,"yt":"ie9lGA5hUGY","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/stereolab/cobra-and-phases-group-play-voltage-in-the-milky-night","aoty":"https://www.albumoftheyear.org/album/25478-stereolab-cobra-and-phases-group-play-voltage-in-the-milky-night.php"},"desc":"Cobra and Phases Group Play Voltage in the Milky Night is the sixth studio album by English-French rock band Stereolab. It was released on 21 September 1999 and was issued by Duophonic Records and Elektra Records. The album was largely co-produced by Stereolab, John McEntire, and Jim O'Rourke. Stereolab produced Cobra and Phases Group Play Voltage in the Milky Night with John McEntire, who had co-produced the band's previous two studio albums Emperor Tomato Ketchup (1996) and Dots and Loops (1997), and Jim O'Rourke. Assisted by McEntire and O'Rourke, Stereolab recorded the bulk of Cobra and Phases Group Play Voltage ."},"artist_ref":{"id":202804497084959,"name":"Stereolab","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Stereolab_%281994%29.jpg?width=500"}},"labels":[],"genres":[{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"rym"},{"id":126030611694007,"type":"genre","name":"Art Pop","artist":null,"year":null,"weight":310,"yt":null,"src":"rym"},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","artist":null,"year":null,"weight":266,"yt":null,"src":"rym"},{"id":236061900877969,"type":"genre","name":"Chamber Pop","artist":null,"year":null,"weight":245,"yt":null,"src":"rym"},{"id":132119653572823,"type":"genre","name":"Progressive Pop","artist":null,"year":null,"weight":225,"yt":null,"src":"rym"}],"lists":