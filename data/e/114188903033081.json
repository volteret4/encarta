{"id":114188903033081,"type":"artist","name":"Premiata Forneria Marconi","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Premiata_Forner%C3%ADa_Marconi_after_a_live_show_%282007-08-25%29.jpg?width=500","bio":"La Premiata Forneria Marconi (PFM) es una banda Italiana de rock progresivo que alcanzó un alto nivel de popularidad en la década de 1970, con gran éxito en los rankings británicos y estadounidenses. A pesar de ser contemporánea de bandas como Banco del Mutuo Soccorso, Area, Perigeo y Le Orme, fueron la única banda italiana de su tipo en obtener un gran éxito fuera de su país de origen. Sus influencias musicales vienen de bandas como Genesis y los comienzos de King Crimson","tags":["Progressive rock","italian progressive rock","italian","Progressive","italian prog"]},"works":[{"id":265833194067691,"type":"album","name":"Per un amico","artist":"Premiata Forneria Marconi","year":1972,"weight":5,"yt":"hEfWXsl_EmA","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":11393629798029,"name":"RYM Top — Rock — Progressive Rock","rank":88,"scaruffi":null},{"id":229542227465836,"name":"RYM Top — Rock — Symphonic Prog","rank":15,"scaruffi":null}],"n_lists":2}},{"id":190135712881410,"type":"album","name":"Storia di un minuto","artist":"Premiata Forneria Marconi","year":1972,"weight":11,"yt":"TKF_qUBZjSg","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":11393629798029,"name":"RYM Top — Rock — Progressive Rock","rank":93,"scaruffi":null},{"id":229542227465836,"name":"RYM Top — Rock — Symphonic Prog","rank":17,"scaruffi":null}],"n_lists":2}},{"id":104400672597040,"type":"album","name":"Photos of Ghosts","artist":"Premiata Forneria Marconi","year":1973,"weight":3,"yt":"OQNfwm9mGAI","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":229542227465836,"name":"RYM Top — Rock — Symphonic Prog","rank":