{"id":187791777185302,"type":"album","name":"GOLLIWOG","artist":"billy woods","year":2025,"weight":17,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/1248537-golliwog_133319.jpg","aoty":87,"aoty_user":83,"yt":"O0HkAEwbxN4","links":{"aoty":"https://www.albumoftheyear.org/album/1248537-billy-woods-golliwog.php"},"desc":"GOLLIWOG is the thirteenth studio album by New York abstract and experimental hip-hop artist billy woods. The album was announced on March 12, 2025 with an Apple Music pre-save page indicating a May 9 release date, alongside single “Misery” with producer Kenny Segal. The album’s title takes its name from a doll-like character created by Florence Kate Upton, which is not only considered to be a stereotypical and racist image of Black people, but also the word being a slur in itself. Notably, one of these dolls appears on the cover of the album. .","sputnik":3.91},"artist_ref":{"id":235783440227489,"name":"Billy Woods","info":{"img":null}},"labels":[],"genres":[{"id":136937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"musthear"},{"id":107037851142420,"type":"genre","name":"Experimental Hip Hop","artist":null,"year":null,"weight":263,"yt":null,"src":"rym"},{"id":26869950655266,"type":"genre","name":"Conscious Hip Hop","artist":null,"year":null,"weight":252,"yt":null,"src":"rym"},{"id":39329334330192,"type":"genre","name":"East Coast Hip Hop","artist":null,"year":null,"weight":251,"yt":null,"src":"rym"},{"id":69149423353287,"type":"genre","name":"Abstract Hip Hop","artist":null,"year":null,"weight":224,"yt":null,"src":"rym"}],"lists":[{"id":96087554392730,"name":"RYM Top — Hip Hop — Abstract Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":17,"year":null,"note":null,"total":200,"scaruffi":null},{"id":182111400206179,"name":"RYM Top — Hip Hop — Experimental Hip Hop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":19,"year":null,"note":null,"total":200,"sc