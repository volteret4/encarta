{"id":5575818048027,"type":"album","name":"Walk Among Us","artist":"Misfits","year":1982,"weight":27,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/19971-walk-among-us-1.jpg","kind":"Album","tracks":13,"country":"US","scaruffi":8.0,"aoty":91,"aoty_user":80,"yt":"Zi4xKBfL3hY","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/misfits/walk-among-us/","aoty":"https://www.albumoftheyear.org/album/19971-misfits-walk-among-us.php"},"desc":"Walk Among Us is the eighth release from the American horror punk band The Misfits. The band's first full-length album to be released (although it was actually the 3rd to be recorded, after Static Age and 12 Hits from Hell), it was originally co-released by Ruby and Slash Records as JRR804 in March 1982. It was the product of a January 1982 recording session at Quad Teck in Los Angeles, California in which Glenn Danzig, for the most part, remixed previously recorded songs, overdubbing additional guitar tracks. Danzig also recorded new vocals for \"Vampira\" and mixed for the first time ."},"artist_ref":{"id":152288905359509,"name":"The Misfits","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Misfits_2012-11-08_01.JPG?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":31482837869539,"type":"genre","name":"Punk","artist":null,"year":null,"weight":2333,"yt":null,"src":"musthear"},{"id":129644386263637,"type":"genre","name":"Punk Rock","artist":null,"year":null,"weight":1272,"yt":null,"src":"musthear,rym"},{"id":165379782273035,"type":"genre","name":"Hardcore [Punk]","artist":null,"year":null,"weight":714,"yt":null,"src":"musthear,rym"},{"id":191536168200871,"type":"genre","name":"Horror Punk","artist":null,"year":null,"weight":202,"yt":null,"src":"musthear,rym"}],"lists":[{"id":47761161524614,"name":"RYM Top — Rock — Horror Punk","src":"musthear","grp":"rateyourmusic","list_year":null,