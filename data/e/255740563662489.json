{"id":255740563662489,"type":"artist","name":"Vibracathedral Orchestra","artist":null,"year":null,"weight":11,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/3c1e60e16fdafa4ffbda5c34dd820daa/1000x1000-000000-80-0-0.jpg","bio":"British avant garde collective Vibracathedral Orchestra was formed in 1998 by Julian Bradley, Neil Campbell, Bridget Hayden, Adam Davenport and Michael Flower. The groups aesthetic is based on long-form drones coming straight out of the '60s tradition of eastern inspired rock and folk music exemplified in the musings of obscure hippie collective ensembles Third Ear Band, Hapshash & the Coloured Coat and Velvet Underground. Touching bases with the early classical minimalism of Terry Riley","tags":["drone","psychedelic","experimental","ambient","post-rock"]},"works":[{"id":196708254383350,"type":"album","name":"Lino Hi","artist":"Vibracathedral Orchestra","year":2000,"weight":6,"yt":"z9Q4LhQdoeE","src":"books","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[],"n_lists":0}},{"id":269383804883443,"type":"album","name":"Versatile Arab Chord Chart","artist":"Vibracathedral Orchestra","year":2000,"weight":18,"yt":"W6tSIvIPcwg","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":76687108203,"name":"Scaruffi 2000s","rank":701,"scaruffi":7.0},{"id":269880325641109,"name":"RYM Top — Psychedelia — Free Folk","rank":68,"scaruffi":7.0}],"n_lists":2}},{"id":154844490121441,"type":"album","name":"Dabbling With Gravity","artist":"Vibracathedral Orchestra","year":2002,"weight":12,"yt":"RPfBe8OnL2o","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":76687108203,"name":"Scaruffi 2000s","rank":700,"scaruffi":7.0}],"n_lists":1}},{"id":3898679643811,"type":"album","name":"Da