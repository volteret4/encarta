dcasts":[],"lists":[{"id":56169400631168,"name":"RYM Top — Jazz — Post-Bop","rank":165,"scaruffi":null}],"n_lists":1}},{"id":23784873875500,"type":"album","name":"Dusk","artist":"Andrew Hill","year":2000,"weight":5,"yt":"6wrUp5a7b5M","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":56169400631168,"name":"RYM Top — Jazz — Post-Bop","rank":135,"scaruffi":null},{"id":271813569514477,"name":"RYM Top — Jazz — Avant-Garde Jazz","rank":143,"scaruffi":null}],"n_lists":2}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":258879214146242,"type":"genre","name":"Post-Bop","n":8},{"id":18560543527384,"type":"genre","name":"Avant-Garde Jazz","n":4},{"id":51806065918814,"type":"genre","name":"Modal Jazz","n":2},{"id":265524373450282,"type":"genre","name":"jazz","n":1},{"id":110972509927513,"type":"genre","name":"Free Jazz","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":236174035435804,"name":"Eric Dolphy y Booker Little","book":"Historia del jazz","author":"Ted Gioia","start":1958,"end":1964,"desc":"Formado en Debussy, Ravel y Webern, quería ser oboísta sinfónico; llega tarde al jazz (Chico Hamilton) y en Nueva York, en apenas cinco años, se convierte en el músico más capaz de llevar a Parker a su siguiente estadio: saltos interválicos angulosos, cuartos de tono, aullidos, del registro grave al agudo, con contralto, flauta y clarinete bajo. Acompañante perfecto (Mingus, Coltrane, Free Jazz de Coleman, Point of Departure de Andrew Hill, Blues and the Abstract Truth de Oliver Nelson, Ezz-Thetic de George Russell, incluso Density 21.5 de Varèse), deja como líder Far Cry, Out to Lunch y las sesiones del Five Spot de 1961 con Booker Little: piezas tonales y estructuradas tocadas al límite, ampliando la tradición en vez de reinventarla. Little muere en 1961 y Dolphy en 1964.","color":"#fb7185","family":"Free jazz y vanguardia","link":"https://volteret4.github.io/jazz/#eric-dolphy"},{"id":232473938305391,"name":"Hard bop: Clifford Brown, Max Roach, Art Blakey y Horace Silver","book":"Historia del jazz","author":"Ted Gioia","start":1954,"end":1975,"desc":"El bebop con las aristas redondeadas: más composición y arreglo, contrapunto en lugar de unísonos, tempos medios, temas en menor, blues y, pronto, gospel. El quinteto de Clifford Brown, trompetista de técnica clásica y vida limpia, y Max Roach («Joy Spring», «Daahoud») lo fija entre 1954 y 1956, hasta que Brown muere en la carretera. Art Blakey, con sus explosiones de batería, y Horace Silver dan con «The Preacher» (1955) la fórmula funky que imitarán todos; los Jazz Messengers, escuela de estrellas durante treinta años (Lee Morgan, Bobby Timmons y Benny Golson en Moanin'; luego Wayne Shorter, Freddie Hubbard y Cedar Walton), y el quinteto de Silver («Song for My Father», raíces caboverdianas, con Joe Henderson y Woody Shaw) dominan los sesenta. Roach se politiza junto al movimiento por los derechos civiles. El sello Blue Note demuestra que el estilo no está agotado y que puede tocar la vanguardia (Andrew Hill, Bobby Hutcherson, Jackie McLean).","color":"#a78bfa","family":"Hard bop, soul jazz y post-bop","link":"https://volteret4.github.io/jazz/#hard-bop"}],"book_tracks":[{"id":176047165201644,"artist":"Andrew Hill","artist_id":112278720020914,"title":"Point of Departure","year":1964,"ess":0,"yt":"vDq6_1yBctM","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Eric Dolphy y Booker Little","scene_id":236174035435804,"scene_link":"https://volteret4.github.io/jazz/#eric-dolphy","chapters":["Cap. 7: La fragmentación de los estilos de jazz"],"pages":[[1,336],[1,355]]},{"id":175786399412636,"artist":"Andrew Hill","artist_id":112278720020914,"title":"Refuge","year":1964,"ess":1,"yt":"AZUHjOHsu9k","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Eric Dolphy y Booker Little","scene_id":236174035435804,"scene_link":"https://volteret4.github.io/jazz/#eric-dolphy","chapters":["Discografía recomendada: Discografía recomendada"],"pages":[[1,440]]}],"mentions":[{"book":"Historia del jazz","author":"Ted Gioia","page":336,"text":"…también contribuyó en varios proyectos de alto nivel con otros líderes, como por ejemplo Free Jazz con Ornette Coleman, Point of Departure con Andrew Hill, Blues and the Abstract Truth con Oliver Nelson y Ezz-Thetic con George Russell —cuatro grabaciones fundamentales de principios de los años sesenta,…"},{"book":"Historia del jazz","author":"Ted Gioia","page":355,"text":"…de Blue Note demostraban que podía haber un punto de encuentro entre el hard bop y la vanguardia. Importantes proyectos como Point of Departure, de Andrew Hill, Dialogue, de Bobby Hutcherson, y Let Freedom Ring, de Jackie McLean,"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":157336673795406,"type":"album","name":"Black Fire","list_id":127983995863234,"list":"RYM Top — Jazz","src":"musthear","rank":183,"year":1964,"note":null,"yt":"MjojXBjg8Z0","scaruffi":null},{"id":157336673795406,"type":"album","name":"Black Fire","list_id":56169400631168,"list":"RYM Top — Jazz — Post-Bop","src":"musthear","rank":48,"year":1964,"note":null,"yt":"MjojXBjg8Z0","scaruffi":null},{"id":118817956121166,"type":"album","name":"Judgment","list_id":56169400631168,"list":"RYM Top — Jazz — Post-Bop","src":"musthear","rank":59,"year":1964,"note":null,"yt":"01EwcflVvg0","scaruffi":null},{"id":176047165201644,"type":"album","name":"Point of Departure","list_id":32093215757431,"list":"Pitchfork: The 200 Best Albums of the 1960s","src":"musthear","rank":198,"year":1965,"note":null,"yt":"eQdttifZrv4","scaruffi":null},{"id":176047165201644,"type":"album","name":"Point of Departure","list_id":127983995863234,"list":"RYM Top — Jazz","src":"musthear","rank":106,"year":1965,"note":null,"yt":"eQdttifZrv4","scaruffi":null},{"id":176047165201644,"type":"album","name":"Point of Departure","list_