{"id":189396884160517,"type":"album","name":"The Emancipation of Mimi","artist":"Mariah Carey","year":2005,"weight":22,"info":{"cover":"https://dn721800.ca.archive.org/0/items/mbid-8a2ad1ee-618c-4824-9090-39075cc41297/mbid-8a2ad1ee-618c-4824-9090-39075cc41297-39749365635.jpg","kind":"Album","tracks":20,"country":"JP","aoty":63,"aoty_user":81,"yt":"BpcORYC6jPE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/mariah-carey/the-emancipation-of-mimi","aoty":"https://www.albumoftheyear.org/album/12435-mariah-carey-the-emancipation-of-mimi.php"},"desc":"The Emancipation of Mimi is the tenth studio album by American singer Mariah Carey, released on April 12, 2005, through Island Records. Following a period of career turbulence, the album marked a major comeback, reestablishing Carey as one of the most dominant voices in R&B and pop music. With a sound rooted in R&B, hip-hop soul, and pop, The Emancipation of Mimi became the best-selling album of 2005 in the U.S. and one of the defining records of her career. Background and Creation After the mixed reception of her previous albums, Carey sought to craft a project that reflected her ."},"artist_ref":{"id":179950077316763,"name":"Mariah Carey","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Mariah_Carey_Library_of_Congress_2023_2_%28cropped%2902.jpg?width=500"}},"labels":[],"genres":[{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"musthear"},{"id":176578125596945,"type":"genre","name":"Contemporary R&B","artist":null,"year":null,"weight":327,"yt":null,"src":"musthear,rym"},{"id":223122507869858,"type":"genre","name":"Dance-Pop","artist":null,"year":null,"weight":311,"yt":null,"src":"musthear"},{"id":249056050558872,"type":"genre","name":"Pop Rap","artist":null,"year":null,"weight":262,"yt":null,"src":"musthear"},{"id":242048506390872,"type":"genre","name":"Pop Soul","artist":null,"year":null,"weight":250,"yt":null,"src":"musthear"}],"