[{"id":236061900877969,"type":"genre","name":"Chamber Pop","n":7},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":3},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":2},{"id":185670346256268,"type":"genre","name":"rock","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":193634530822272,"name":"Brit-pop y post-pop","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2001,"desc":"Como tantas veces, el fenómeno más publicitado es el menos interesante: un «brit-pop» de grupos terriblemente parecidos y tediosos, sin apenas imaginación. Lo anticipan Lightning Seeds, La's, Teenage Fanclub y Heavenly; estalla con Boo Radleys, Blur (Parklife) y Oasis (el «farol» que mejor personifica la moda). Suede y el glam-pop (Super Furry Animals, Placebo), las excepciones de High Llamas (Hawaii) y Supergrass, el revival mod (Ocean Colour Scene, Wildhearts), Elastica, Sleeper, las Spice Girls; Trembling Blue Stars, Tindersticks, Delgados. El post-pop de Radiohead, «la banda más publicitada y sobrevalorada de la década», cuyo OK Computer es una obra maestra del falso vanguardismo; Coldplay, Travis.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#britpop"}],"book_tracks":[{"id":42229580582018,"artist":"Tindersticks","artist_id":192171619743867,"title":"Tindersticks","year":1993,"ess":1,"yt":"ESowizTFDNI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Brit-pop y post-pop","scene_id":193634530822272,"scene_link":"https://volteret4.github.io/scaruffi/#britpop","chapters":["Sección 6.11"],"pages":[[1,271,null]]},{"id":192958660941622,"artist":"Tindersticks","artist_id":192171619743867,"title":"Tinderstick","year":1995,"ess":0,"yt":"ESowizTFDNI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https:/