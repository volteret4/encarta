:[],"member_of":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"ensayos"},{"id":64491050809040,"type":"genre","name":"Doom Metal","artist":null,"year":null,"weight":376,"yt":null,"src":"ensayos"},{"id":84488837319315,"type":"genre","name":"Modern Metal","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"album_genres":[{"id":77376330613218,"type":"genre","name":"Stoner Metal","n":7},{"id":64491050809040,"type":"genre","name":"Doom Metal","n":6},{"id":255263121494129,"type":"genre","name":"Metal","n":3},{"id":8601518715705,"type":"genre","name":"Stoner Rock","n":2},{"id":266148395847073,"type":"genre","name":"Synth Punk","n":1},{"id":242270330474188,"type":"genre","name":"Country Soul","n":1},{"id":219217594239320,"type":"genre","name":"Folk Metal","n":1},{"id":212257394657788,"type":"genre","name":"Gipsy Punk","n":1},{"id":207755761847598,"type":"genre","name":"Hardcore","n":1},{"id":200651337068219,"type":"genre","name":"Canzone d'autore","n":1},{"id":191043281221162,"type":"genre","name":"Brutal Prog","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":181296768148316,"type":"genre","name":"Digital Hardcore","n":1},{"id":166164464399388,"type":"genre","name":"Sa'idi","n":1},{"id":99248936442916,"type":"genre","name":"Hard Dance","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":52427769209791,"name":"Doom, super-doom y stoner rock","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1990,"end":2000,"desc":"El doom (exageración lenta, gótica y barroca de los grooves de Black Sabbath) crece en Inglaterra: Paradise Lost, Cathedral (las largas suites líricas de Forest Of Equilibrium), My Dying Bride y Electric Wizard, que infla la pesadez hasta que la música ya no fluye, solo retumba (Come My Fanatics, Dopethrone); Orange Goblin, Katatonia. El «super-doom» de los Melvins sigue en Seattle con Earth (drones colosales entre La Monte Young y monstruos extraterrestres), Karp, Sunn, y el «sludgecore» del Sur (Eyehategod, Harvey Milk). El stoner rock: Kyuss, Queens Of The Stone Age, Sleep, Fu Manchu, Monster Magnet, Wellwater Conspiracy, Boris.","color":"#f87171","family":"Hard rock, metal y grunge","link":"https://volteret4.github.io/scaruffi/#stoner-doom"}],"book_tracks":[{"id":198384727895136,"artist":"Electric Wizard","artist_id":215435477349608,"title":"Electric Wizard","year":1995,"ess":0,"yt":"CoGB8JNx1GQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Doom, super-doom y stoner rock","scene_id":52427769209791,"scene_link":"https://volteret4.github.io/scaruffi/#stoner-doom","chapters":["Sección 6.16"],"pages":[[1,288,null]]},{"id":166110236538643,"artist":"Electric Wizard","artist_id":215435477349608,"title":"Come My Fanatics","year":1997,"ess":0,"yt":"-eUVubC7ojM","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Doom, super-doom y stoner rock","scene_id":52427769209791,"scene_link":"https://volteret4.github.io/scaruffi/#stoner-doom","chapters":["Sección 6.16"],"pages":[[1,288,null]]},{"id":240614171659760,"artist":"Electric Wizard","artist_id":215435477349608,"title":"Dopethrone","year":2000,"ess":0,"yt":"eaMbKZPBruU","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Doom, super-doom y stoner rock","scene_id":52427769209791,"scene_link":"https://volteret4.github.io/scaruffi/#stoner-doom","chapters":["Sección 6.16"],"pages":[[1,288,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":288,"text":"…doom-metal had fewer and lesser adherents: Los Angeles' Obsessed stand out. The greatest heirs to the throne of doom-metal were still British. Electric Wizard (12), led by singer/guitarist Justin Osborn, inflated the heaviness of doom-metal to the point that music did not flow anymore: it just boomed, a long, dull, oppressive sound. Electric Wizard (1995) blended the holy triad of stoner-rock (Black Sabbath, Blue Cheer and Hawkwind) in a new form that was an implosion of each of them, but its…"}],"podcast":[{"kind":"podcast","title":"Expansion of Doom Atmosphere (90s-00s)","body":"In the 1990s and 2000s, as Doom Metal consolidated, Electric Wizard was among the bands that explored and expanded its atmospheric qualities. They contributed new layers of tension, desperation, and terror to the genre's proposals, pushing its boundaries and attracting an increasing global fanbase. \"Bandas como Electric Wizard, Job, Catedral, Esotedi, Coes Lip, Exploraron y expandieron la atmósfera del duro, aportando nuevas capas de tensión, desesperación y terror a sus propuestas.\"","year":null,"extra":null,"srcs":[{"source":"Central Sonora","episode":"El DOOM METAL es el DARK SOULS de la música","url":"https://www.youtube.com/watch?v=v0eaod_repg"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":198384727895136,"type":"album","name":"Electric Wizard","list_id":64803615322804,"list":"RYM Top — Rock — Stoner Metal","src":"musthear","rank":119,"year":1995,"note":null,"yt":"CoGB8JNx1GQ","scaruffi":null},{"id":166110236538643,"type":"album","name":"Come My Fanatics","list_id":118267099057662,"list":"AOTY Must Hear 1990s","src":"musthear","rank":146,"year":1997,"note":null,"yt":"-eUVubC7ojM","scaruffi":7.5},{"id":166110236538643,"type":"album","name":"Come My Fanatics","list_id":128298934021735,"list":"RYM Top — Psychedelia","src":"musthear","rank":74,"year":1997,"note":null,"yt":"-eUVubC7ojM","scaruffi":7.5},{"id":166110236538643,"type":"album","name":"Come My Fanatics","list_id":68519467142167,"list":"RYM Top — Rock — Doom Metal","src":"musthear","rank":9,"year":1997,"note":null,"yt":"-eUVubC7ojM","scaruffi":7.5},{"id