cenes":[{"id":267868162516031,"name":"Alt-country","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1988,"end":2000,"desc":"La revolución iniciada en Chicago por Souled American y Uncle Tupelo (No Depression: baladas country con la furia del hardcore) se convierte en los noventa en un género propio: sus herederos abandonan el hardcore por los sonidos más espartanos y tradicionales. Son Volt de Jay Farrar y Wilco de Jeff Tweedy (Being There, Yankee Hotel Foxtrot); Will Oldham (Palace) arranca el movimiento; Freakwater, Ida, Handsome Family, Retsin, Blue Mountain, Whiskeytown, Grant Lee Buffalo, Citizens' Utilities, Willard Grant Conspiracy. El «chamber folk» de Lambchop, Lullaby For The Working Class, Geraldine Fibbers y Pinetop Seven; el country-rock de Volebeats, Ass Ponys, Sixteen Horsepower, Old 97's y los terroristas Grifters; el folk-rock de Swell, Counting Crows, Cracker, Cake, Hootie & The Blowfish; los Black Crowes; Belle And Sebastian, Arab Strap y los polacos Atman.","color":"#f59e0b","family":"Raíces: rock'n'roll, country y roots","link":"https://volteret4.github.io/scaruffi/#alt-country"}],"book_tracks":[{"id":240805983920618,"artist":"Belle And Sebastian","artist_id":34830299925010,"title":"Tigermilk","year":1996,"ess":0,"yt":"6r1lWOelZKI","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Alt-country","scene_id":267868162516031,"scene_link":"https://volteret4.github.io/scaruffi/#alt-country","chapters":["Sección 6.14"],"pages":[[1,280,null]]},{"id":166874890748523,"artist":"Belle And Sebastian","artist_id":34830299925010,"title":"If You're Feeling Sinister","year":1997,"ess":1,"yt":"e-jnftESRJE","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Alt-country","scene_id":267868162516031,"scene_link":"https://volteret4.github.io/scaruffi/#alt-country","chapters":["Sección 6.14"],"pages":[[1,280,null]]},{"id":17822126301974,"artist":"Belle And Sebastian","artist_id":34830299925010,"title":"The Boy With The Arab Strap","year":1998,"ess":0,"yt":"9K7W6dztw-4","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Alt-country","scene_id":267868162516031,"scene_link":"https://volteret4.github.io/scaruffi/#alt-country","chapters":["Sección 6.14"],"pages":[[1,280,null]]},{"id":255190342204543,"artist":"Belle And Sebastian","artist_id":34830299925010,"title":"Fold Your Hands Child","year":2000,"ess":0,"yt":"Ub2Gk0C6Vcw","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Alt-country","scene_id":267868162516031,"scene_link":"https://volteret4.github.io/scaruffi/#alt-country","chapters":["Sección 6.14"],"pages":[[1,280,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":280,"text":"…album that relied on studio-production technique more than on traditional songwriting. Scotland boasted much more original purveyors of folk-rock. Belle And Sebastian (2), one of the leading bands of the second half of the decade, rediscovered Donovan's gently whispering vocals, and his naive blend of melodic and…"}],"podcast":[{"kind":"podcast","title":"High Fidelity Movie Appearance (2000)","body":"The band was introduced to a wider audience through a scene in the 2000 movie *High Fidelity*. In the scene, Rob, a record store owner, and his employee Dick are enjoying a new Belle and Sebastian record, only for another employee, Barry (played by Jack Black), to burst in, express strong disdain, and rip the cassette out of the machine. \"There's a scene in the 2000 movie High Fidelity that introduced a lot of people to the band Belen Sebastian.\"","year":2000,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Twee Pop: A History","url":"https://www.youtube.com/watch?v=jhgZrwtYE2g"}]},{"kind":"podcast","title":"Bass Guitar Source for Bob Hardy","body":"Alex Kapranos acquired a bass guitar from a former member of this \"Tui Scottish band,\" which he then used to teach Bob Hardy how to play bass. \"Alex taught him using a bass that he got from a former member of the Tui Scottish band, Bell and Sebastian.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Franz Ferdinand: In Their Own Words","url":"https://www.youtube.com/watch?v=RWbKqqW78yg"}]},{"kind":"podcast","title":"Collaboration with Mark Lanegan","body":"Mark Lanegan collaborated with Belle and Sebastian. \"Bell and Sebastian.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"In Memoriam of Those Lost in 2022","url":"https://www.youtube.com/watch?v=sdPeii-8Ysw"}]},{"kind":"podcast","title":"Quirky Liner Note Stories","body":"Belle and Sebastian, a Scottish indie pop band, incorporated quirky short stories written by frontman Stuart Murdoch into their album liner notes. One such story humorously recounted Murdoch mailing his jacket home from a post office after overdressing for a walk on a warm day, showcasing a creative approach to engaging with listeners beyond just lyrics or credits. \"Lead band Stuart Murdock liked to write quirky short stories. One album featured a story about how we overdressed for a walk, so we stopped into the post office, and mailed his jacket home back to his house, so we wouldn't have to carry it around with him on that warm day.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Digital Debris  Part 3: Liner Notes","url":"https://www.youtube.com/watch?v=KaIp6KVn-co"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":240805983920618,"type":"album","name":"Tigermilk","work_year":1996,"list_id":192934750972716,"list"