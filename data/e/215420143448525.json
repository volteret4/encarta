:{"books":[],"podcasts":[],"lists":[{"id":226395167427913,"name":"RYM Top — Folk — Country Gospel","rank":183,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[{"id":18106704007950,"type":"artist","name":"Country Music Association (formerly)","artist":null,"year":null,"weight":2,"yt":null,"src":"ensayos"}],"genres":[{"id":53681850040905,"type":"genre","name":"Rock & Roll","artist":null,"year":null,"weight":1066,"yt":null,"src":"ensayos"},{"id":7374429919951,"type":"genre","name":"country","artist":null,"year":null,"weight":632,"yt":null,"src":"ensayos"}],"album_genres":[{"id":112167866160385,"type":"genre","name":"Honky Tonk","n":20},{"id":50154868873855,"type":"genre","name":"Nashville Sound","n":14},{"id":207318544393773,"type":"genre","name":"Country Gospel","n":8},{"id":31379669920904,"type":"genre","name":"Traditional Country","n":4},{"id":179554264188962,"type":"genre","name":"Countrypolitan","n":2},{"id":164529051065355,"type":"genre","name":"Contemporary Country","n":1},{"id":148167434110388,"type":"genre","name":"Bakersfield Sound","n":1},{"id":7374429919951,"type":"genre","name":"country","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Protest Against Country-Pop Crossover (1974)","body":"In 1974, George Jones and Tammy Wynette famously left the Country Music Association in protest over Olivia Newton-John's success and her Grammy win, viewing her as not \"country enough\" due to the blurring lines between country and pop. \"this led to George Jones and Tammy Wynett leaving the Country Music Association in protest.\"","year":1974,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null}]},{"kind":"podcast","title":"Academy of Country Entertainers Co-Founder","body":"Following Charlie Rich's antics at the 1975 CMA Awards, George Jones and Tammy Wynette hosted a gathering of country musicians at their home to discuss how to address singers perceived as \"not country\" winning country music awards, which led to the formation of the Academy of Country Entertainers. \"George Jones and his wife Tammy Wynette, Country Music royalty, hosted a gathering of other country musicians at their house and discussed what can we do about singers who many decided were not country and they were winning country music awards.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":null}]},{"kind":"podcast","title":"Country Music Royalty Status","body":"George Jones was considered \"Country Music royalty\" alongside his wife, Tammy Wynette. \"George Jones and his wife Tammy Wynette, Country Music royalty...\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":null}]},{"kind":"podcast","title":"Irony of Criticizing \"Not Country\" Artists","body":"The transcript notes the irony of George Jones being critical of artists for \"not being country enough,\" given that his own very first hit on the country charts, \"White Lightning,\" was described as \"kind of country\" and sounded a lot like early rock and roll. \"There's more irony here in George Jones being critical of artists for not being country enough.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 2 - Countryish Music of the 1970s (Encore)","url":null}]},{"kind":"podcast","title":"Marriage to Tammy Wynette","body":"George Jones's marriage to Tammy Wynette was tumultuous and his \"drunken escapades\" were publicly known. Wynette's song \"Stand By Your Man\" could have \"easily turned into a joke\" because of their relationship. \"The most accepted image was that of faithful wife like Tammy Weinette putting up with George Jones and his drunken escapades.\"","year":null,"extra":null,"srcs":[{"source":"For the Record - The 70s","episode":"Ep. 23 - Women of Country Music in the 70s","url":null}]},{"kind":"podcast","title":"Nashville Legend and Protest Host","body":"George Jones, a Nashville legend and husband to Tammy Wynette, hosted a protest meeting at his home following Olivia Newton-John's controversial CMA win, where disgruntled country figures gathered to form the Association of Country Entertainers (ACE). \"a protest group of singers, musicians, songwriters and executives gathered at the home of married couple and Nashville legends, George Jones and Tammy Weinett.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Country Roads and Summer Nights Edition Part 1","url":null}]}],"awards":[],"concerts":[{"kind":"concert","title":"Farm Aid","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":116615894010659,"type":"album","name":"Grand Ole Opry's New Star: Country Song Hits","list_id":59502452022900,"list":"RYM Top — Folk — Traditional Country","src":"musthear","rank":99,"year":1956,"note":null,"yt":"T4zWqJsF1hY","scaruffi":null},{"id":121317173398226,"type":"album","name":"Sings White Lightning and Other Favorites","list_id":277730079687595,"list":"RYM Top — Country — Honky Tonk","src":"musthear","rank":75,"year":1959,"note":null,"yt":"3CXL_Ut4EJM","scaruffi":null},{"id":33711120336641,"type":"album","name":"Country Church Time","list_id":226395167427913,"list":"RYM Top — Folk — Country Gospel","src":"musthear","rank":25,"year":1959,"note":null,"yt":"lRyJNHziOno","scaruffi":null},{"id":33711120336641,"type":"album","name":"Country Church Time","list_id":59502452022900,"list":"RYM Top — Folk — Traditional Country","src":"musthear","rank":121,"year":1959,"note":null,"yt":"lRyJNHziOno","scaruffi":null},{"id":135762989810842,"type":"album","name":"George Jones Salutes Hank Williams","list_id":277730079687595,"list":"RYM Top — Country — Honky Tonk","src":"musthear","rank":16,"year":1960,"note":null,"yt":"QeUpYwc49js","sc