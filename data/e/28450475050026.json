{"id":28450475050026,"type":"album","name":"Electro-Shock Blues","artist":"Eels","year":1998,"weight":10,"info":{"cover":"https://dn710303.ca.archive.org/0/items/mbid-439b88b6-fe90-4f47-839f-06d337544166/mbid-439b88b6-fe90-4f47-839f-06d337544166-3780798685.jpg","kind":"Album","tracks":8,"country":"US","scaruffi":8.0,"sputnik":4.11,"yt":"7Pvn7Aj9kpA","links":{"spotify":"https://open.spotify.com/album/0WxLDRcFFjHUb5lfOt6t51","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lb1C7aRp2wdyBtnxVVMkBRI_9M_7BHbTg","rateyourmusic":"https://rateyourmusic.com/release/album/eels/electro-shock-blues","sputnikmusic":"https://www.sputnikmusic.com/album/8987/Eels-Electro-Shock-Blues/"},"desc":"Electro-Shock Blues is the second studio album by American rock band Eels. It was released in the United Kingdom on September 21, 1998 and October 20 in the United States by record label DreamWorks. Electro-Shock Blues was written largely in response to frontman Mark Oliver Everett's (more commonly known as E) sister's suicide and his mother's terminal lung cancer. The title refers to the electroconvulsive therapy received by Elizabeth Everett when she was institutionalized. Many of the songs deal with their decline, his response to loss and coming to terms with suddenly becoming the only living member of his family ."},"artist_ref":{"id":235633563871890,"name":"The Eels","info":{"img":null}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"musthear,rym"}],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","src":"charts","grp":"Scaruffi","list_year":null,"rank":57,"year":1998,"note":null,"total":1406,"scaruffi":8.0},{"id":199353246998089,"name":"Sputnikmusic Best Albums 1998","src":"charts","grp":"sputnikmusic","list_year":null,"rank":60,"year":1998,"note":null,"total"