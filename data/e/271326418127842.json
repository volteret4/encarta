id":265496132631976,"name":"RYM Top — Hip Hop — Gangstarap","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":115,"year":null,"note":null,"total":200,"scaruffi":7.5},{"id":3080531282495,"name":"AOTY Must Hear 1970s","src":"musthear","grp":null,"list_year":null,"rank":145,"year":null,"note":null,"total":256,"scaruffi":7.5},{"id":192934750972716,"name":"1001 Albums You Must Hear Before You Die","src":"charts","grp":"1001 Albums","list_year":null,"rank":277,"year":1973,"note":null,"total":999,"scaruffi":7.5}],"podcast":[{"kind":"podcast","title":null,"body":"Described as a \"breath of fresh air\" after the sonic intensity of \"Tago Mago,\" this album moved away from darker sounds to explore a more atmospheric and cosmic aesthetic. It metaphorically takes the listener on a zero-gravity journey over the sea, drifting yet generating a constant sense of momentum, with Holger Czukay's magnetic tapes projecting luminous synthesizer notes. Considered the band's most balanced album, where no member overshadowed another, Damo Suzuki's contributions were less prominent and more discreet. This work profoundly influenced Brian Eno's ambient output and, indirectly, David Bowie's Berlin phase, serving as an excellent and luminous turning point for the band that anticipated the post-rock genre of the 90s. \"Una obra excelente que aporta un giro hacia la luz a la banda y que se adelantó al por rock de los 90.\"","year":1973,"extra":null,"srcs":[{"source":"Central Sonora","episode":"CAN ｜ La Banda que (posiblemente) Inspiró a tu banda preferida","url":"https://www.youtube.com/watch?v=4qHiw2wHWAI"}]}],"book_tracks":[{"id":271326418127842,"artist":"Can","artist_id":126657727149758,"title":"Future Days","year":1973,"ess":1,"yt":"wQxMB4Wk_y8","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Kosmische Musik y krautrock","scene_id":107234531659708,"scene_link":"https://volteret