{"id":120761773825988,"type":"album","name":"Un verano sin ti","artist":"Bad Bunny","year":2022,"weight":18,"info":{"cover":"https://dn721604.ca.archive.org/0/items/mbid-aded3f90-b758-451a-aad7-711d5985b05f/mbid-aded3f90-b758-451a-aad7-711d5985b05f-32432776461.jpg","kind":"Album","tracks":23,"country":"XW","yt":"NBghhjuMNKM","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/bad-bunny/un-verano-sin-ti/lists/12"},"desc":"Un Verano Sin Ti is the fourth studio album from Puerto Rican rapper and singer Bad Bunny. Released on May 6th 2022, it features guest appearances from Chencho Corleone, Jhay Cortez, Tony Dize, Rauw Alejandro, Bomba Estéreo, The Marías and Buscabulla. Comprising twenty-three tracks, the album is primarily a reggaeton, cumbia and indie pop record, and contains guest appearances from Chencho Corleone, Jhay Cortez, Tony Dize, Rauw Alejandro, Bomba Estéreo, the Marías and Buscabulla. Un Verano Sin Ti became the first album by a Latin artist to reach 10 billion streams on Spotify. A critical and commercial success, Un Verano ."},"artist_ref":{"id":32105400568126,"name":"Bad Bunny","info":{"img":null}},"labels":[],"genres":[{"id":136937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"musthear"},{"id":10697304889908,"type":"genre","name":"Reggae","artist":null,"year":null,"weight":615,"yt":null,"src":"musthear"},{"id":260819262438325,"type":"genre","name":"synth-pop","artist":null,"year":null,"weight":325,"yt":null,"src":"musthear"},{"id":252471484867368,"type":"genre","name":"Reggaetón","artist":null,"year":null,"weight":227,"yt":null,"src":"musthear,rym"},{"id":116162141578082,"type":"genre","name":"Latin Pop","artist":null,"year":null,"weight":217,"yt":n