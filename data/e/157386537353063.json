62322471145,"name":"RYM Top — Country — Western Swing","rank":144,"scaruffi":null}],"n_lists":1}},{"id":191159801581758,"type":"album","name":"Dance Ranch","artist":"Hank Thompson","year":2095,"weight":3,"yt":"aZPDPNdbdgY","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":130762322471145,"name":"RYM Top — Country — Western Swing","rank":20,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[{"id":7374429919951,"type":"genre","name":"country","artist":null,"year":null,"weight":632,"yt":null,"src":"ensayos"},{"id":32857844513644,"type":"genre","name":"Rockabilly","artist":null,"year":null,"weight":381,"yt":null,"src":"ensayos"},{"id":234453660213087,"type":"genre","name":"Western Swing","artist":null,"year":null,"weight":226,"yt":null,"src":"ensayos"},{"id":112167866160385,"type":"genre","name":"Honky Tonk","artist":null,"year":null,"weight":220,"yt":null,"src":"ensayos"}],"album_genres":[{"id":234453660213087,"type":"genre","name":"Western Swing","n":17},{"id":112167866160385,"type":"genre","name":"Honky Tonk","n":3},{"id":179554264188962,"type":"genre","name":"Countrypolitan","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Honky Tonk Singer and Rockabilly Precursor","body":"Hank Thompson was a honky tonk singer who performed a \"paired down version\" of Bob Wills' western swing style. His music incorporated the rhythms and instrumentation of western swing but emphasized vocals and non-instrumental solos. Thompson was one of several artists whose music served as a precursor to rockabilly. He was most successful with mid-tempo ballads, such as \"The Wild Side of Life.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 43: \"I Gotta Know\" by Wanda Jackson","url":"https://www.youtube.com/watch?v=gEInec4z65Q"}]},{"kind":"podcast","title":"Mentor to Wanda Jackson","body":"Thompson discovered Wanda Jackson when she was 14 during a TV audition. Impressed by her voice, he invited her to perform with his band, even though she was inexperienced. He couldn't take her on tour due to her schooling but mentored her on stage whenever he played in Oklahoma, teaching her how to perform with other musicians. He also invited her to appear on his local TV show, which eventually led to her own TV show. Thompson later facilitated her signing with Capitol Records by informing Ken Nelson that she was no longer underage.","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 43: \"I Gotta Know\" by Wanda Jackson","url":"https://www.youtube.com/watch?v=gEInec4z65Q"}]}],"awards":[{"kind":"award","title":"Oklahoma Music Hall of Fame (2002)","body":"Won.","year":2002,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q7082270"}]}],"concerts":[],"xref":[{"kind":"xref","title":"Annual Commemoration Event","body":"Every February 22nd, an event is held at the John T. Floore Country Store outside of San Antonio. This event commemorates the day Ben Dorsi first met both Hank Thompson and Willie Nelson, two significant figures in his long career. \"Plus, there's an event every February 22nd at the John T. Floor Country Store outside of San Antonio in commemoration of the day Ben met both Hank Thompson and Willie Nelson for the first time.\"","year":null,"extra":{"from":"Ben Dorsi","from_id":37906652726267,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"We Are The Road Crew - A History of Roadies","url":"https://www.youtube.com/watch?v=ZVGnSVfed9s"}]},{"kind":"xref","title":"Extensive Work History","body":"Throughout his six-decade career, Ben Dorsi worked for numerous prominent artists, starting with Hank Thompson, then a young Elvis Presley, followed by Johnny Cash, Patsy Cline, Kris Kristofferson, Merle Haggard, and Willie Nelson. \"After working with Hank Thompson, Dorsi worked for a young Elvis Presley. Then he moved on to Johnny Cash, Patsy Klein, Chris Christopherson, Murrell Haggerd, and Willie Nelson.\"","year":null,"extra":{"from":"Ben Dorsi","from_id":37906652726267,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"We Are The Road Crew - A History of Roadies","url":"https://www.youtube.com/watch?v=ZVGnSVfed9s"}]},{"kind":"xref","title":"Start with Hank Thompson","body":"On Halloween night in 1950, Ben Dorsi began a new job traveling with honky-tonk western performer Hank Thompson to help set up his gear. This role marked the start of his dedicated career as a roadie, a gig he would continue for the next six decades. \"On Halloween night, 1950, he started a new job with Hank Thompson, a honky-tonk western performer, traveling with him to help him set up his gear.\"","year":null,"extra":{"from":"Ben Dorsi","from_id":37906652726267,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"We Are The Road Crew - A History of Roadies","url":"https://www.youtube.com/watch?v=ZVGnSVfed9s"}]}],"charts":[{"id":262885073078888,"type":"album","name":"Songs of the Brazos Valley","list_id":277730079687595,"list":"RYM Top — Country — Honky Tonk","src":"musthear","rank":137,"year":1955,"note":null,"yt":"FINtVVZNFWQ","scaruffi":null},{"id":262885073078888,"type":"album","name":"Songs of the Brazos Valley","list_id":130762322471145,"list":"RYM Top — Country — Western Swing","src":"musthear","rank":28,"year":1955,"note":null,"yt":"FINtVVZNFWQ","scaruffi":null},{"id":112318000391785,"type":"album","name":"North of the Rio Grande","list_id":130762322471145,"list":"RYM Top — Country — Western Swing","src":"musthear","rank":63,"year":1956,"note":null,"yt":"IYN9iK0XCxY","scaruffi":null},{"id":256154776970211,"type":"album","name":"New Recordings of Hank Thompson’s All Time Hits","list_id":130762322471145,"list":"RYM Top — Country — Western Swing","src":"musthear","rank":96,"year":1956