{"id":276452907176913,"type":"album","name":"Blackwater Park","artist":"Opeth","year":2001,"weight":10,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/4125-blackwater-park_183049.jpg","aoty":85,"aoty_user":89,"yt":"bl0QVeD-KJg","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/opeth/blackwater-park/","aoty":"https://www.albumoftheyear.org/album/4125-opeth-blackwater-park.php"},"desc":"Blackwater Park is the fifth full-length studio album from the Swedish progressive death metal band Opeth. It was originally released on February 27, 2001 under Music For Nations and Koch Records. The album is a further continuation of the styles explored on Still Life, incorporating and further expanding on the band's signature sound, which features the merger of death metal, progressive metal and folk music elements. The album is named after the German progressive rock band of the same name. Blackwater Park was the first Opeth album to be produced by Porcupine Tree's Steven Wilson, who also provided backing vocals ."},"artist_ref":{"id":18586207499585,"name":"Opeth","info":{"img":"https://cdn-images.dzcdn.net/images/artist/ee95a92e9a5ed5c8b905f3e61bbc26f9/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":255263121494129,"type":"genre","name":"Metal","artist":null,"year":null,"weight":3474,"yt":null,"src":"rym"},{"id":190704175116840,"type":"genre","name":"Progressive Metal","artist":null,"year":null,"weight":268,"yt":null,"src":"rym"}],"lists":[{"id":176930618582536,"name":"RYM Top — Rock — Progressive Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":2,"year":null,"note":null,"total":200,"scaruffi":null},{"id":175315787363075,"name":"RYM Top — Rock — Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":22,"year":null,"note":null,"total":200,"scaruffi":null},{"id":54706775234735,"name":"Brave New World: The Alternative RYM Canon","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":86,"year":null,"no