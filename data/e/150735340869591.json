{"id":150735340869591,"type":"artist","name":"Synergy","artist":null,"year":null,"weight":12,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/b57ab88384a226b6d85cc37475598f66/1000x1000-000000-80-0-0.jpg","bio":"There are 8 bands with the name Synergy:\n\n1. Synergy, a drum and bass (neurofunk) duo from Russia.\n\n2. Synergy, the trademarked name used by synthesist Larry Fast for his musical endeavors. The first Synergy album Electronic Realizations for Rock Orchestra was recorded February, 1975 using a Minimoog, Mellotron, Oberheim Expander and Digital Sequencer and an ARP 2600.  Control functions were state of the art, but all pre-MIDI ...and nobody played guitar.","tags":["neurofunk","electronic","trance","math rock","Czech"]},"works":[{"id":117916798533246,"type":"album","name":"Electronic Realizations For Rock Orchestra","artist":"Synergy","year":1975,"weight":11,"yt":"BXccnQsavRA","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":65232636722211,"name":"Scaruffi 1970s","rank":517,"scaruffi":7.0}],"n_lists":1}},{"id":218390682419389,"type":"album","name":"Cords","artist":"Synergy","year":1978,"weight":10,"yt":"UxYiBkJJ06s","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":65232636722211,"name":"Scaruffi 1970s","rank":516,"scaruffi":7.0}],"n_lists":1}},{"id":179463690637784,"type":"album","name":"Computer Experiments:  Volume One","artist":"Synergy","year":1981,"weight":3,"yt":"wACQ6iJlTFk","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":236867844600881,"name":"RYM Top — Experimental — Indeterminacy","rank":142,"scaruffi":null}],"n_lists":1}},{"id":139849073522451,"type":"album","name":"Metropolitan Suite","artist":"Synergy","year":1985,"weight":10,"yt":"OPeOZ5yKSdo","src":"books,charts,musthear","from":{"books":[{"name":"Scar