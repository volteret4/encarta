{"id":6879158909629,"type":"artist","name":"Feedtime","artist":null,"year":null,"weight":10,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/3862a86d3983f3d3c64e490933ae0229/1000x1000-000000-80-0-0.jpg","bio":"feedtime was an independent punk-rock trio from Sydney, Australia, formed in 1979. The name is spelled with a lowercase f. The members were credited by their first names only: Rick (guitar, vocals), Al (bass), and Tom (drums).\n\nfeedtime made four albums in the 1980s. Initially they recorded only for Aberrant Records in Australia, but their second through fourth albums were released internationally by the legendary indie label Rough Trade. The second album, Shovel, received the greatest critical acclaim.","tags":["noise rock","Garage Rock","punk","Garage Punk","post-punk"]},"works":[{"id":276958960811877,"type":"album","name":"Feedtime","artist":"Feedtime","year":1986,"weight":18,"yt":"6c-TfR8KKik","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":48,"scaruffi":8.0},{"id":51314745106268,"name":"RYM Top — Rock — Garage Rock","rank":180,"scaruffi":8.0},{"id":75200912416283,"name":"RYM Top — Rock — Pigfuck","rank":61,"scaruffi":8.0},{"id":142489294796000,"name":"RYM Top — Rock — Punk Blues","rank":40,"scaruffi":8.0}],"n_lists":4}},{"id":281357772634024,"type":"album","name":"Shovel","artist":"Feedtime","year":1986,"weight":18,"yt":"riIOsYg5yyc","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":408,"scaruffi":7.0},{"id":36355441347599,"name":"RYM Top — Rock — Garage Punk","rank":121,"scaruffi":7.0},{"id":75200912416283,"name":"RYM Top — Rock — Pigfuck","rank":95,"scaruffi":7.0},{"id":142489294796000,"name":"RYM Top — Rock — Punk Blues","rank":65,"scaru