d":238948735172501,"type":"genre","name":"Groove Metal","n":11},{"id":255263121494129,"type":"genre","name":"Metal","n":2}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Manslaughter Charge After Fan Death (2010)","body":"In 2010, during a show in Prague, a 19-year-old fan named Daniel Nosek climbed onto the stage. Singer Randy Blythe pushed him back into the audience, a common action for stage trespassers. However, Nosek fell hard, was not caught by the crowd, and hit his head, later dying from his injuries. \"At one point, someone from the audience climbed on stage. Singer Randy Blithe did what he'd done a hundred times in the past to stage trespassers. He just pushed the guy back into the audience.\"","year":2010,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Most Dangerous Artists in Rock","url":"https://www.youtube.com/watch?v=5vKSjpvVQa8"}]},{"kind":"podcast","title":"Manslaughter Charges for Singer Randy Blythe (2010)","body":"In 2010, Lamb of God's singer, Randy Blythe, was charged with manslaughter in Prague after a fan who crowd-surfed onto the stage was pushed back by Blythe. The crowd reportedly parted, causing the fan to fall and hit his head on the concrete floor, leading to his death. This resulted in a lengthy court case against Blythe. \"In 2010, the metal band Lamb of God was charged in the death of a fan in Prague, a guy surfed to the front, got up on stage, whereupon singer-ready Blife pushed him back into the audience.\"","year":2010,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Moshing","url":"https://www.youtube.com/watch?v=KMx4bmq8o2Y"}]},{"kind":"podcast","title":"Arrest and Acquittal (2012)","body":"Blythe was arrested in 2012 and went to court to face manslaughter charges. He was eventually found not criminally liable for Daniel Nosek's death. \"Blithe was eventually found not criminally liable.\"","year":2012,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Most Dangerous Artists in Rock","url":"https://www.youtube.com/watch?v=5vKSjpvVQa8"}]}],"awards":[],"concerts":[],"xref":[],"charts":[{"id":3120848040243,"type":"album","name":"New American Gospel","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":153,"year":2000,"note":null,"yt":"SXAPuVUzd1E","scaruffi":null},{"id":214148236543039,"type":"album","name":"As the Palaces Burn","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":38,"year":2003,"note":null,"yt":"eWVrdFrpXHE","scaruffi":null},{"id":232394562684516,"type":"album","name":"Ashes of the Wake","work_year":2004,"list_id":44735175437010,"list":"AOTY Must Hear 2000s","src":"charts","rank":299,"year":2004,"note":null,"yt":"BsnqTipaPN0","scaruffi":null},{"id":232394562684516,"type":"album","name":"Ashes of the Wake","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":21,"year":2004,"note":null,"yt":"BsnqTipaPN0","scaruffi":null},{"id":260315021747772,"type":"album","name":"Sacrament","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":61,"year":2006,"note":null,"yt":"ZUvQtbEUGLg","scaruffi":null},{"id":173554503964806,"type":"album","name":"Wrath","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":98,"year":2009,"note":null,"yt":"4FLvQFNxtxY","scaruffi":null},{"id":249949620018111,"type":"album","name":"Resolution","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":189,"year":2012,"note":null,"yt":"kbNVhXyEUEo","scaruffi":null},{"id":262463058573983,"type":"album","name":"VII: Sturm und Drang","list_id":60939677007180,"list":"RYM Top — Rock — Groove Metal","src":"musthear","rank":63,"year":2015,"note":null,"yt":"2CgsqjSnR3k","scaruffi":null},{"id":214232705942794,"type":"album","name":"Lam