:94920788719523,"type":"album","name":"Pile Of Skulls","artist":"Running Wild","year":1992,"weight":9,"yt":"Eob462W2eSc","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":55316938071026,"name":"Sputnikmusic Best Albums 1992","rank":112,"scaruffi":null},{"id":141736599343995,"name":"RYM Top — Rock — Power Metal","rank":22,"scaruffi":null},{"id":263887018784608,"name":"RYM Top — Rock — Heavy Metal","rank":95,"scaruffi":null}],"n_lists":3}},{"id":91875029558240,"type":"album","name":"Black Hand Inn","artist":"Running Wild","year":1994,"weight":9,"yt":"VNq3Cj0CGkE","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":1248498436761,"name":"Sputnikmusic Best Albums 1994","rank":59,"scaruffi":null},{"id":141736599343995,"name":"RYM Top — Rock — Power Metal","rank":8,"scaruffi":null},{"id":263887018784608,"name":"RYM Top — Rock — Heavy Metal","rank":56,"scaruffi":null}],"n_lists":3}},{"id":91187643152964,"type":"album","name":"Masquerade","artist":"Running Wild","year":1995,"weight":3,"yt":"rhebzT0uVMU","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":141736599343995,"name":"RYM Top — Rock — Power Metal","rank":177,"scaruffi":null}],"n_lists":1}}],"members":[],"member_of":[],"genres":[],"album_genres":[{"id":230708556350457,"type":"genre","name":"Power Metal","n":7},{"id":174164112458259,"type":"genre","name":"Heavy Metal","n":7},{"id":255263121494129,"type":"genre","name":"Metal","n":4},{"id":14730174805042,"type":"genre","name":"Speed Metal","n":4}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":37812250348840,"name":"El concierto como hierofanía","book":"Heavy Metal: The Music and Its Culture","author":"Deena Weinstein","start":1970,"end":1995,"desc":"El concierto es donde se encuentran los tres actores del metal y donde la cultura se realiza. Lo parte una gran frontera: la trastienda (backstage) es el mundo moderno de los medios, una cadena de especialistas coordinados por el horario, solidaridad orgánica y razón instrumental; la sala (frontstage) es el mundo del público, comunidad, códigos de la subcultura y emoción. El público se prepara tanto como el equipo: hace cola, elige la camiseta, viaja bebiendo cerveza y fumando, conversa sobre qué disco y qué formación son mejores, y forma una comunidad transitoria y educada (no tocar a nadie, compartir los prismáticos). Cuando se apagan las luces, el concierto consuma tres cosas: el éxtasis (volumen que dispara la adrenalina, luces rojas, escenografías de fantasía), la representación idealizada de la subcultura (músicos como obreros sudorosos que aman sus herramientas relucientes, el guitar hero, el machismo y el lenguaje soez) y el vínculo entre banda y público (cantar a coro, himnos como «Denim and Leather» o «Living After Midnight», los enemigos comunes como MTV o Tipper Gore, la gratitud mutua, los mecheros en el bis). En su forma ideal es una hierofanía en el sentido de Eliade: el tiempo se detiene y el público sale «wasted», agotado y satisfecho. El artista es el mediador entre los dos mundos, mercancía para uno y héroe cultural para el otro.","color":"#fb923c","family":"Cultura metal: público, medios y conciertos","link":"https://volteret4.github.io/HeavyMetal/#concierto-hierofania"}],"book_tracks":[{"id":71387307891166,"artist":"Running Wild","artist_id":131917099316100,"title":"Chains and Leather","year":1984,"ess":0,"yt":"l2v83jKomXw","kind":null,"book":{"id":5,"title":"Heavy Metal: The Music and Its Culture","author":"Deena Weinstein","url":"https://volteret4.github.io/HeavyMetal/"},"scene":"El concierto como hierofanía","scene_id":37812250348840,"scene_link":"https://volteret4.github.io/HeavyMetal/#concierto-hierofania","chapters":["Cap. 6: El concierto: la epifanía metal"],"pages":[[1,197]]}],"mentions":[{"book":"Heavy Metal: The Music and Its Culture","author":"Deena Weinstein","page":81,"text":"…as getting clean clothes. Such tasks have to be done by others. The press coverage of a tour stresses the wild excitement, the image of “Bad Boys Running Wild.” Photographers are backstage taking candids (or shots posed to resemble them) of the “Backstage Queens” with the band. Band members pose with…"},{"book":"Heavy Metal: The Music and Its Culture","author":"Deena Weinstein","page":196,"text":"…and praise the community of heavy metal. Each group has at least one in its repertoire, noteworthy examples being Saxon’s “Denim and Leather,” and Running Wild’s"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":54643728188130,"type":"album","name":"Gates to Purgatory","list_id":263887018784608,"list":"RYM Top — Rock — Heavy Metal","src":"musthear","rank":180,"year":1984,"note":null,"yt":"-FMe5d4GH5s","scaruffi":null},{"id":54643728188130,"type":"album","name":"Gates to Purgatory","list_id":34496703936562,"list":"RYM Top — Rock — Speed Metal","src":"musthear","rank":12,"year":1984,"note":null,"yt":"-FMe5d4GH5s","scaruffi":null},{"id":84500103849214,"type":"album","name":"Death Metal","list_id":34496703936562,"list":"RYM Top — Rock — Speed Metal","src":"musthear","rank":104,"year":1984,"note":null,"yt":"AyqReVFvUQA","scaruffi":null},{"id":218454510459095,"type":"album","name":"Branded and Exiled","list_id":34496703936562,"list":"RYM Top — Rock — Speed Metal","src":"musthear","rank":96,"year":1985,"note":null,"yt":"te1KQRa69-Q","scaruffi":null},{"id":9851002121627,"type":"album","name":"Under Jolly Roger","list_id":263887018784608,"list":"RYM Top — Rock — Heavy Metal","src":"musthear","rank":152,"year":1987,"note":null,"yt":"GIx5aXxHmtY","scaruffi":null},{"id":9851002121627,"type":"album","name":"Under Jolly Roger","list_id":141736599343995,"list":"RYM Top — Rock — Power Metal","src":"musthear","rank":43,"year":1987,"note":null,"yt":"GIx5aXxHmtY","scaruffi":null},{"id":125979140926261,"type":"album","name":"Port Royal","list_id":263887018784608,"list":"RYM Top — Rock — Heavy Metal","src":"musthear","rank":58,"year":1988,"note":null,"yt":"xzbO_IDpQAk","scaruffi