{"id":249241054167717,"type":"album","name":"Nightride","artist":"Tinashe","year":2016,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/2016/64887-nightride.jpg","aoty":71,"aoty_user":81,"yt":"yVmZmQChVj4","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/tinashe/nightride","aoty":"https://www.albumoftheyear.org/album/64887-tinashe-nightride.php"},"desc":"Nightride is the second studio album by American singer Tinashe, released on November 4, 2016, through RCA Records. Its first single, \"Company\" was released on September 16, 2016. The album also includes the promotional singles \"Ride of Your Life\" and \"Party Favors\". Unlike the single version of \"Party Favors\", the album version does not feature rapper Young Thug. Tinashe recorded the project while recording her third studio album Joyride. The album peaked at number 89 on the US Billboard 200. Tinashe confirmed in 2019 that she considers Nightride her second studio album, however her former label, RCA Records, did not ."},"artist_ref":{"id":133907268967492,"name":"Tinashe","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Tinashe_at_Coachella_2024_-_04_%28cropped%29.jpg?width=500"}},"labels":[],"genres":[{"id":31593727518281,"type":"genre","name":"Trap","artist":null,"year":null,"weight":423,"yt":null,"src":"rym"},{"id":176578125596945,"type":"genre","name":"Contemporary R&B","artist":null,"year":null,"weight":327,"yt":null,"src":"rym"},{"id":266557216269112,"type":"genre","name":"Alternative R&B","artist":null,"year":null,"weight":241,"yt":null,"src":"rym"},{"id":107014375503206,"type":"genre","name":"Trap Soul","artist":null,"year":null,"weight":110,"yt":null,"src":"rym"}],"lists":[{"id":111544177120547,"name":"RYM Top — R&B — Trap Soul","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":108,"scaruffi":null},{"id":30975222555123,"name":"RYM Top — Hip Hop — Trap","src":"musthear","grp":"rateyourmusic","li