,"genres":[],"album_genres":[{"id":251207904532640,"type":"genre","name":"Neoclassical New Age","n":7},{"id":265524373450282,"type":"genre","name":"jazz","n":2},{"id":221243548786509,"type":"genre","name":"classical","n":2},{"id":193585859679838,"type":"genre","name":"new age","n":2},{"id":261516756034660,"type":"genre","name":"Ragtime","n":1},{"id":244213887756754,"type":"genre","name":"christmas music","n":1},{"id":224054965343469,"type":"genre","name":"Classical Crossover","n":1},{"id":173049125996624,"type":"genre","name":"Stride","n":1},{"id":156823753286980,"type":"genre","name":"folk","n":1},{"id":2149040092328,"type":"genre","name":"contemporary jazz","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":135695620098166,"name":"New age y world music","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1975,"end":2001,"desc":"En 1975 William Ackerman acuña el término y funda Windham Hill: la new age nace como reacción al rock (silenciosa, melódica, adulta, sin voz, batería ni guitarra eléctrica) y es sobre todo una síntesis de culturas, estados de ánimo, géneros y estilos de vida. Sus parientes: el jazz estético de ECM, John Fahey, el minimalismo y la kosmische musik. Guitarra (Ackerman, Michael Hedges), piano (George Winston, Michael Jones), flauta (Paul Horn), arpa, cuerdas (David Darling) y percusión; conjuntos de cámara (Shadowfax, Turtle Island String Quartet); la electrónica de Los Ángeles (Michael Stearns, Kevin Braheny, Steve Roach, el más metafísico de los mensajeros cósmicos) y la sinfónica (Constance Demby, Novus Magnificat), Robert Rich. La world music de vanguardia: Jon Hassell (Dream Theory In Malaya), Paul Winter, Kitaro, Jeff Greinke, Mark Isham, Michael Brook, Forrest Fang, Jorge Reyes. En Alemania, Peter Frohmader y los herederos de la música cósmica.","color":"#2dd4bf","family":"Vanguardia, electrónica y ambient","link":"https://volteret4.github.io/scaruffi/#new-age"}],"book_tracks":[{"id":34869131531349,"artist":"George Winston","artist_id":15217043068950,"title":"Autumn","year":1980,"ess":0,"yt":"JKmqyQUDehs","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"New age y world music","scene_id":135695620098166,"scene_link":"https://volteret4.github.io/scaruffi/#new-age","chapters":["Sección 5.19"],"pages":[[1,202,null]]}],"mentions":[{"book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","page":202,"text":"…(1), and Paul Speer's Spectral Voyages (1984) improved over Ackerman's model. The piano became the main new-age instrument thanks to the success of George Winston and his first suite of free-form melodic piano solos, Autumn (1980). At that point, a highly chromatic fusion of folk, jazz and classical was forged…"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":157611251012677,"type":"album","name":"Piano Solos","list_id":265238898886802,"list":"RYM Top — Jazz — Stride","src":"musthear","rank":29,"year":1973,"note":null,"yt":"riJE9HCqn88","scaruffi":null},{"id":157611251012677,"type":"album","name":"Piano Solos","list_id":280702155250789,"list":"RYM Top — Regional Music — Ragtime","src":"musthear","rank":41,"year":1973,"note":null,"yt":"riJE9HCqn88","scaruffi":null},{"id":34869131531349,"type":"album","name":"Autumn","list_id":273501579136396,"list":"RYM Top — New Age","src":"musthear","rank":136,"year":1980,"note":null,"yt":"JKmqyQUDehs","scaruffi":7.0},{"id":34869131531349,"type":"album","name":"Autumn","list_id":71379285302548,"list":"RYM Top — New Age — Neoclassical New Age","src":"musthear","rank":36,"year":1980,"note":null,"yt":"JKmqyQUDehs","scaruffi":7.0},{"id":34869131531349,"type":"album","name":"Autumn","list_id":52032266791182,"list":"Scaruffi 1980s","src":"musthear","rank":438,"year":1980,"note":null,"yt":"JKmqyQUDehs","scaruffi":7.0},{"id":12011036639724,"type":"album","name":"December","list_id":4389278164509,"li