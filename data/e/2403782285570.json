{"id":2403782285570,"type":"album","name":"Born To Run","artist":"Bruce Springsteen","year":1975,"weight":33,"info":{"cover":"https://dn711005.ca.archive.org/0/items/mbid-2d462be4-450b-4404-bfb2-fc39dca8065d/mbid-2d462be4-450b-4404-bfb2-fc39dca8065d-37009026871.jpg","scaruffi":7.0,"yt":"jSB1m9dRrec","links":{"spotify":"https://open.spotify.com/album/43YIoHKSrEw2GJsWmhZIpu","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_mSOhVYfA4mGwMGSRP_OIh3B7yQXu8I0b0","rateyourmusic":"https://rateyourmusic.com/release/album/bruce-springsteen/born-to-run"},"desc":"Born to Run is the third album by the American rock singer-songwriter Bruce Springsteen. It was released on August 25, 1975 through Columbia Records. It captured the heaviness of Springsteen's earlier releases while displaying a more diverse range of influences. Born to Run was a critical and commercial success and became Springsteen's breakthrough album. It peaked at number three on the Billboard 200 and reached high positions on charts worldwide. Two singles were released from the album: \"Born to Run\" and \"Tenth Avenue Freeze-Out\", the first helped Springsteen to reach mainstream popularity. The tracks \"Thunder Road\" and \"Jungleland\" became staples .","kind":"Album","tracks":8,"country":"JP","aoty":97,"aoty_user":85},"artist_ref":{"id":168754358908938,"name":"Bruce Springsteen","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Bruce_Springsteen_2025.jpg?width=500"}},"labels":[],"genres":[{"id":53681850040905,"type":"genre","name":"Rock & Roll","artist":null,"year":null,"weight":1066,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":186201380116213,"type":"genre","name":"classic rock","artist":null,"year":null,"weight":268,"yt":null,"src":"musthear"},{"id":1063