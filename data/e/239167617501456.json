cambian el hardcore para siempre; en Chicago, Naked Raygun y Big Black de Steve Albini; en Europa, The Ex y los italianos CCCP.","color":"#fb7185","family":"Punk, new wave, hardcore y noise","link":"https://volteret4.github.io/scaruffi/#hardcore"}],"book_tracks":[{"id":252504644811529,"artist":"Ex","artist_id":239167617501456,"title":"Blueprints For A Blackout","year":1983,"ess":0,"yt":"yAN2UxJO9S0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore","scene_id":207755761847598,"scene_link":"https://volteret4.github.io/scaruffi/#hardcore","chapters":["Sección 5.9"],"pages":[[1,149,null]]},{"id":180460498487477,"artist":"Ex","artist_id":239167617501456,"title":"Joggers & Smoggers","year":1989,"ess":0,"yt":"61Z1hUU6J5k","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore","scene_id":207755761847598,"scene_link":"https://volteret4.github.io/scaruffi/#hardcore","chapters":["Sección 5.9"],"pages":[[1,149,null]]},{"id":44677237901192,"artist":"Ex","artist_id":239167617501456,"title":"Instant","year":1995,"ess":0,"yt":"ijJQ7dWLtHs","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore","scene_id":207755761847598,"scene_link":"https://volteret4.github.io/scaruffi/#hardcore","chapters":["Sección 5.9"],"pages":[[1,149,null]]},{"id":96613168696012,"artist":"Ex","artist_id":239167617501456,"title":"Starters Alternators","year":1998,"ess":0,"yt":"7otcalwfIag","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Hardcore","scene_id":207755761847598,"scene_link":"https://volteret4.github.io/scaruffi/#hardcore","chapters":["Sección 5.9"],"pages":[[1,149,null]]}],"me