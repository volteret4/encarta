{"id":255046613067570,"type":"album","name":"Specials","artist":"The Specials","year":1979,"weight":25,"info":{"cover":"https://dn721604.ca.archive.org/0/items/mbid-b3e8b3fc-4ada-39a9-bd88-9dcfe3d1ceaa/mbid-b3e8b3fc-4ada-39a9-bd88-9dcfe3d1ceaa-5761424758.jpg","kind":"Album","tracks":15,"country":"US","yt":"D6ONesFHXWE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/the-specials/specials/"},"desc":"Specials is the debut album by British ska revival band The Specials. Released in 1979 on Jerry Dammers' 2Tone label, the album is seen by some as the defining moment in the UK ska scene. Produced by Elvis Costello, the album captures the disaffection and anger felt by the youth of the UK's \"concrete jungle\" - a phrase borrowed from Bob Marley's 1972 album Catch A Fire but equally apposite used here to describe the grim, violent inner cities of 1970s Britain. Musically, the album encapsulates the wave of British ska, greatly reworking the original sound of 1960s Jamaican ska. ."},"artist_ref":{"id":233041092305283,"name":"The Specials","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/The_Specials.JPG?width=500"}},"labels":[],"genres":[{"id":253717746650249,"type":"genre","name":"Ska","artist":null,"year":null,"weight":703,"yt":null,"src":"musthear,rym"},{"id":10697304889908,"type":"genre","name":"Reggae","artist":null,"year":null,"weight":615,"yt":null,"src":"musthear"},{"id":3637126013943,"type":"genre","name":"Rocksteady","artist":null,"year":null,"weight":166,"yt":null,"src":"musthear"},{"id":13951889004721,"type":"genre","name":"2 Tone","artist":null,"year":null,"weight":108,"yt":null,"src":"musthear,rym"},{"id":220327530487024,"type":"genre","name":"New Wave","artist":null,"year":null,"weight":1514,"yt":null,"src":"rym"}],"lists":[{"id":198433558933938,"name":"This album is the BEST in its GENRE @Frenchblues","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":730,"scaruffi":null},{"id