t Is","artist":"Thundercat","year":2020,"weight":18,"yt":"golqr78Q0OY","src":"charts,ensayos,musthear","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":3}],"lists":[{"id":55158258843870,"name":"AOTY Must Hear 2020s","rank":664,"scaruffi":null},{"id":147465301620623,"name":"RYM Top — Psychedelia — Psychedelic Soul","rank":90,"scaruffi":null},{"id":156194853339605,"name":"RYM Top — R&B — Neo-Soul","rank":129,"scaruffi":null}],"n_lists":3}},{"id":65890935502490,"type":"song","name":"Cracker Island","artist":"Thundercat","year":null,"weight":4,"yt":null,"src":"ensayos","from":{"books":[],"podcasts":[{"name":"The Ongoing History of New Music","n":1}],"lists":[],"n_lists":0}}],"members":[{"id":112887913494023,"type":"artist","name":"Stephen Lee Bruner","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"member_of":[{"id":271937282943228,"type":"artist","name":"Suicidal Tendencies","artist":null,"year":1982,"weight":41,"yt":null,"src":"ensayos"},{"id":238973132922301,"type":"artist","name":"Kendrick Lamar (collaborator)","artist":null,"year":null,"weight":10,"yt":null,"src":"ensayos"}],"genres":[{"id":265524373450282,"type":"genre","name":"jazz","artist":null,"year":null,"weight":1461,"yt":null,"src":"ensayos"},{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"ensayos"},{"id":30122583811636,"type":"genre","name":"Soul","artist":null,"year":null,"weight":645,"yt":null,"src":"ensayos"},{"id":20619342488979,"type":"genre","name":"Funk","artist":null,"year":null,"weight":643,"yt":null,"src":"ensayos"}],"album_genres":[{"id":98720889157055,"type":"genre","name":"Neo-Soul","n":3},{"id":227648310502632,"type":"genre","name":"Nu Jazz","n":2},{"id":177675787102726,"type":"genre","name":"Psychedelic Soul","n":2},{"id":105716567934857,"type":"genre","name":"LA Beat Scene","n":2},{"id":218950588157556,"type":"genre","name":"Progressive Soul","n":1},{"id":99836972798693,"type":"genre","name":"Funktronica","n":1},{"id":43001458719353,"type":"genre","name":"Afrofuturism","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Amazement with *To Pimp a Butterfly* Project","body":"Thundercat expressed deep admiration and astonishment for the *To Pimp a Butterfly* project, having worked on it. His reactions reflect the profound impact and unique artistic vision that Kendrick Lamar brought to the album. \"tenemos muchas entrevistas de mucha gente que trabajó en este disco como Flying Lotus, como el propio Thundercat.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Kendrick Lamar:  To pimp a butterfly","url":"https://www.youtube.com/watch?v=ENmSJbhbGeo"}]},{"kind":"podcast","title":"Collaboration on *To Pimp a Butterfly*","body":"Thundercat was one of the credited artists who contributed to Kendrick Lamar's *To Pimp a Butterfly*. He, along with other collaborators like Flying Lotus, expressed amazement and positive reactions while working on the album, highlighting its unique and groundbreaking nature. \"entre esos 65 artistas está Doctor Dree, está Snow Dog, está Farrell Williams, está Thundercat.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Kendrick Lamar:  To pimp a butterfly","url":"https://www.youtube.com/watch?v=ENmSJbhbGeo"}]},{"kind":"podcast","title":"Early Career Start","body":"Thundercat has been actively involved in the music business since the age of 16, quickly establishing himself as a versatile musician, singer, producer, and songwriter. \"He's a bass player, singer, producer and songwriter who has been in the business since he was 16.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Black History Month 2023","url":"https://www.youtube.com/watch?v=_1NNvxgx8uA"}]},{"kind":"podcast","title":"Extensive Collaborations","body":"Thundercat is highly sought after for collaborations, having worked with a wide range of artists including Kenny Loggins, Michael McDonald, Herbie Hancock, Flying Lotus, and the Red Hot Chili Peppers. \"People love to collaborate with this guy, ranging from Kenny Loggins and Michael McDonald to Herbie Hancock to Flying Lotus to the Red Hot Chili Peppers.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Black History Month 2023","url":"https://www.youtube.com/watch?v=_1NNvxgx8uA"}]},{"kind":"podcast","title":"Living Legend","body":"Thundercat is recognized as one of the great names in music history and remains actively creating music. \"Thundercat es uno de los grandísimos nombres de la historia de la música sigue en activo gracias a Dios.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"Mejores discos del 2017","url":"https://www.youtube.com/watch?v=T34CwsFmXpI"}]},{"kind":"podcast","title":"Musical Family Background","body":"Thundercat, whose real name is Stephen Lee Bruner, hails from a highly musical family. His father was a professional drummer who played for iconic Motown acts such as The Supremes, Gladys Knight, and The Temptations, while his mother was a professional musician who played the flute and percussion. \"Thundercat comes from a very musical family. His dad played drums for the Supremes and Gladys Knight and the Temptations and other Motown acts. His mother was also a professional musician, playing the flute in percussion.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Black History Month 2023","url":"https://www.youtube.com/watch?v=_1NNvxgx8uA"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best Melodic Rap Performance (2016) — These Walls","body":"Won.","year":2016,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1542172"}]},{"kind":"award","title":"Grammy Award for Best Progressive R&B Album (2021) — It Is What It Is","body":"Won.","year":2021,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q5593896"}]}],"concerts":[],"xref":[],"charts":[{"id":271140450888293,"type":"album","name":"The Golden Age of Apocalypse","list_id":144205334146988,"list":"RYM Top — Electronic — Nu Jazz","src":"musthear","rank":164,"year":2011,"note":null,"yt":"46jVKGGDPa0","scaruffi":null},{"id":271140450888293,"type":"album","name":"The Golden Age of Apocalypse","list_id":123837933923638,"list":"RYM Top — Scenes & Movements — LA Beat Scene","src":"musthear","rank":19,"year":2011,"note":null,"yt":"46jVKGGDPa0","scaruffi":null},{"id":68007362544525,"type":"album","name":"Apocalypse","list_id":143888190701389,"list":"RYM Top — Electronic — Funktronica","src":"musthear","rank":3,"year":2013,"note":null,"yt":"c7rYg0B5xAk","scaruffi":null},{"id":68007362544525,"type":"album","name":"Apocalypse","list_id":144205334146988,"list":"RYM Top — Electronic — Nu Jazz","src":"musthear","rank":155,"year":2013,"note":null,"yt":"c7rYg0B5xAk","scaruffi":null},{"id":68007362544525,"type":"album","name":"Apocalypse","list_id":156194853339605,"list":"RYM Top — R&B — Neo-Soul","src":"musthear","rank":181,"year":2013,"note":null,"yt":"c7rYg0B5xAk","scaruffi":null},{"id":68007362544525,"type":"album","name":"Apocalypse","list_id":10505573532856,"list":"RYM Top — Scenes & Movements — Afrofuturism","src":"musthear","rank":149,"year":2013,"note":null,"yt":"c7rYg0B5xAk","scaruffi":null},{"id":68007362544525,"type":"album","name":"Apocalypse","list_id":123837933923638,"list":"RYM Top — Scenes & Movements — LA Beat Scene","src":"musthear","rank":16,"year":2013,"note":null,"yt":"c7rYg0B5xAk","scaruffi":null},{"id":5131185017618,"type":"album","name":"Drunk","list_id":84472050122582,"list":"AOTY Must Hear 2010s","src":"musthear","rank":336,"year":2017,"note":null,"yt":"PVnGDwdom7c","scaruffi":null},{"id":5131185017618,"type":"album","name":"Drunk","list_id":147465301620623,"list":"RYM Top