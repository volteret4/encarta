{"id":150322057997252,"type":"album","name":"The Sensual World","artist":"Kate Bush","year":1989,"weight":15,"info":{"cover":"https://dn710008.ca.archive.org/0/items/mbid-6e25c81b-bd8b-4863-b49b-8353674d60a1/mbid-6e25c81b-bd8b-4863-b49b-8353674d60a1-24370784931.jpg","kind":"Album","tracks":10,"country":"US","aoty":86,"aoty_user":86,"yt":"BW3RQiXLhKE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/kate-bush/the-sensual-world","aoty":"https://www.albumoftheyear.org/album/19414-kate-bush-the-sensual-world.php"},"desc":"The Sensual World is the sixth studio album by the English singer-songwriter Kate Bush, released on 16 October 1989 by EMI Records. Bush drew inspiration for the title track from the modernist novel Ulysses by James Joyce. Bush realised that Molly Bloom's soliloquy, the closing passage of the novel, fitted the music she had created. When the Joyce estate refused to release the text, Bush wrote original lyrics that echo the original passage, as Molly steps from the pages of the book and revels in the real world. She also alluded to \"Jerusalem\" by William Blake in a reference to ."},"artist_ref":{"id":159942841705747,"name":"Kate Bush","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Kate_Bush_Hounds_of_Love_%281985_EMI_publicity_photo%29_02_%28cropped%29.jpg?width=500"}},"labels":[],"genres":[{"id":185670346256268,"type":"genre","name":"rock","artist":null,"year":null,"weight":3782,"yt":null,"src":"musthear"},{"id":30277598324326,"type":"genre","name":"pop","artist":null,"year":null,"weight":1523,"yt":null,"src":"musthear"},{"id":126030611694007,"type":"genre","name":"Art Pop","artist":null,"year":null,"weight":310,"yt":null,"src":"musthear,rym"},{"id":132119653572823,"type":"genre","name":"Progressive Pop","artist":null,"year":null,"weight":225,"yt":null,"src":"musthear"}],"lists":[{"id":215424088090262,"name":"AOTY Must Hear 1980s","src":"charts","grp":"AOTY","list_year":null,"rank":4,"year":1989,"note":null,"total