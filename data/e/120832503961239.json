{"id":120832503961239,"type":"artist","name":"The High Llamas","artist":null,"year":null,"weight":12,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/The_High_Llamas_%283014877069%29.jpg?width=500","bio":"The High Llamas es un grupo inglés de música rock, liderado por el cantante y guitarrista Sean O'Hagan (ex-integrante de Microdisney y Stereolab). El estilo del grupo ha sido comparado por los críticos con el pop de The Beach Boys, en especial debido a su producción detallada, sus armonías, su sonido melódico y su uso de teclado y orquestación. Otras influencias importantes del grupo incluyen a Burt Bacharach, y música brasilera como la tropicalia y la samba.","tags":["indie pop","chamber pop","indie","pop","alternative"]},"works":[{"id":8824085396818,"type":"album","name":"Santa Barbara","artist":"The High Llamas","year":1992,"weight":5,"yt":"0638G_g4tfg","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":82958032046503,"name":"RYM Top — Rock — Soft Rock","rank":119,"scaruffi":null},{"id":212407470817145,"name":"RYM Top — Pop — Sophisti-Pop","rank":167,"scaruffi":null}],"n_lists":2}},{"id":161028061741986,"type":"album","name":"Gideon Gaye","artist":"The High Llamas","year":1994,"weight":11,"yt":"CJmTbV0CKIg","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":28572826268451,"name":"RYM Top — Pop — Chamber Pop","rank":123,"scaruffi":null},{"id":213382009109123,"name":"RYM Top — Pop — Sunshine Pop","rank":14,"scaruffi":null}],"n_lists":2}},{"id":136780087842548,"type":"album","name":"Hawaii","artist":"High Llamas","year":1996,"weight":15,"yt":"YekklReDLPI","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","rank":759,"scaruffi":7.0},{"id":28572826268451,"name":"RYM Top — Pop — Chamber Pop","ra