s":[],"podcasts":[],"lists":[{"id":25948482630979,"name":"John Peel's Record Box","rank":96,"scaruffi":null}],"n_lists":1}}],"members":[{"id":185228270576838,"type":"artist","name":"Rick Parfitt","artist":null,"year":null,"weight":11,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[],"album_genres":[{"id":98435208382294,"type":"genre","name":"Boogie Rock","n":19},{"id":163225726165579,"type":"genre","name":"Blues Rock","n":3},{"id":186201380116213,"type":"genre","name":"classic rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"British Punk Favorite - 1975","body":"By 1975, Bowie had become a favorite among British punks, who admired not only his music but also his non-status quo fashion sense and his defiant attitude. His influence was so strong that it was difficult to find a punk enthusiast in London who wasn't also a Bowie fan. \"By 1975, he'd become a favorite among British punks.\"","year":1975,"extra":{"from":"David Bowie","from_id":131837656417857,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Why Bowie Still Matters - Part 2","url":"https://www.youtube.com/watch?v=rw0uXf5UJvo"}]},{"kind":"xref","title":"Death (December 24, 2016)","body":"Rick Parfitt, a member of Status Quo, died on December 24, 2016, due to blood poisoning. \"December 24th, Rick Parford of Status Quote, Blood Poisoning...\"","year":2016,"extra":{"from":"Rick Parfitt","from_id":185228270576838,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of the 2010s Part 2: The Role of Indie Rock","url":"https://www.youtube.com/watch?v=sOU54d8mr5k"}]},{"kind":"xref","title":"Anti-Establishment Stance","body":"The Clash were known for their strong anti-establishment stance, actively \"sticking it to the establishment, kicking against the class system and railing against the status quo.\" Their politically charged music resonated with anti-capitalist sentiments and paralleled the aims of certain leftist and nationalist organizations that the KGB might have sought to encourage. \"Things like the sex festivals and the clash were all about sticking it to the establishment, kicking against the class system and railing against the status quo.\"","year":null,"extra":{"from":"The Clash","from_id":3465415090538,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Great KGB Punk Conspiracy","url":"https://www.youtube.com/watch?v=NyKvAhO7MHE"}]},{"kind":"xref","title":"Challenged the Status Quo","body":"Bob Dylan emerged in the wake of the folk movement pioneered by Woody Guthrie and Pete Seeger. He was notable for his willingness to directly challenge and critique the prevailing social and political conditions of his time. \"The folk movement that came in their wake gave us people like Bob Dylan, who had no trouble poking the status quo in the eye.\"","year":null,"extra":{"from":"Bob Dylan","from_id":190672525319846,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Songs of Protest","url":"https://www.youtube.com/watch?v=0ARYt4sYT90"}]},{"kind":"xref","title":"Destroying the Status Quo","body":"The band's philosophy was centered on challenging and destroying the status quo, which heavily influenced their music and public actions. Their refusal to conform to label demands underscored this commitment. \"The decays were all about destroying the status quo.\"","year":null,"extra":{"from":"The Dead Kennedys","from_id":1967764436832,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Alt-Rock: Chapter 8","url":"https://www.youtube.com/watch?v=XjTWcy8RHEs"}]},{"kind":"xref","title":"UK Punk's Anti-Establishment Stance","body":"The Sex Pistols, along with bands like The Clash, were instrumental in shaping the UK punk scene's focus on confronting the establishment, challenging the class system, and railing against the status quo, distinguishing it from the less political North American punk. \"Bands like the Sex Pistols and the clash were all about sticking it to the establishment, kicking against the class system and railing against the status quo.\"","year":null,"extra":{"from":"The Sex Pistols","from_id":6889843679183,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Great KGB Punk Rock Conspiracy","url":"https://www.youtube.com/watch?v=YeNWDtN_sHE"}]},{"kind":"xref","title":"UK Punk's Anti-Establishment Stance","body":"The Clash, alongside bands like the Sex Pistols, epitomized the UK punk scene's commitment to challenging the establishment, critiquing the class system, and opposing the status quo, in contrast to the more artistic North American punk. \"Bands like the Sex Pistols and the clash were all about sticking it to the establishment, kicking against the class system and railing against the status quo.\"","year":null,"extra":{"from":"The Clash","from_id":3465415090538,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Great KGB Punk Rock Conspiracy","url":"https://www.youtube.com/watch?v=YeNWDtN_sHE"}]}],"charts":[{"id":88190375750043,"type":"song","name":"Pictures of Matchstick Men","work_year":1968,"list_id":69206598009354,"list":"Billboard Year-End 1968","src":"singles","rank":55,"year":1968,"note":"","yt":"VqCTb8RFMHg","scaruffi":null},{"id":88190375750043,"type":"song","name":"Pictures of Matchstick Men","work_year":1968,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":55,"year":1968,"note":null,"yt":"VqCTb8RFMHg","scaruffi":null},{"id":51311993143142,"type":"album","name":"Ma Kelly's Greasy Spoon","list_id":142360283712364,"list":"RYM Top — Rock — Boogie Rock","src":"musthear","rank":17,"year":1970,"note":null,"yt":"l0cOwoRvqPo","scaruffi":null},{"id":26323764739753,"type":"album","name":"Dog of Tw