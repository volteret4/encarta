{"id":72682092171881,"type":"artist","name":"The Kingston Trio","artist":null,"year":null,"weight":26,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Kingston_Trio.jpg?width=500","bio":"The Kingston Trio es un grupo popular estadounidense y el grupo de música pop que ayudó a lanzar el renacimiento del folk de la década de 1950 a finales de 1960. El grupo se originó en un acto de una discoteca de San Francisco Bay Area  con una formación original de Dave Guard, Bob Shane, y Nick Reynolds. Se elevó a la popularidad internacional, impulsada por las ventas sin precedentes de 33 1 / 3 rpm larga duración álbumes de discos, y han contribuido a modificar la dirección de la música popular en los EE.UU.","tags":["folk","60s","country","acoustic","oldies"]},"works":[{"id":90583743931499,"type":"song","name":"Tom Dooley","artist":"The Kingston Trio","year":1958,"weight":12,"yt":"S3zdE8bliGI","src":"books,charts,singles","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":158051727660304,"name":"Billboard Year-End 1958","rank":28,"scaruffi":null},{"id":157497903047680,"name":"Billboard Hot 100 nº1 · 1960s","rank":6,"scaruffi":null},{"id":167954413065108,"name":"UK Singles Chart","rank":7,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":28,"scaruffi":null}],"n_lists":4}},{"id":196983911159121,"type":"song","name":"The Tijuana Jail","artist":"The Kingston Trio","year":1959,"weight":4,"yt":"FueL6yMnoYo","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[{"id":245563783135764,"name":"Billboard Year-End 1959","rank":77,"scaruffi":null},{"id":132335824845498,"name":"Billboard Year-End Hot 100","rank":77,"scaruffi":null}],"n_lists":2}},{"id":180288480827024,"type":"song","name":"Where Have All the Flowers Gone?","artist":"The Kingston Trio","year":1962,"weight":4,"yt":"LkTXcwc3zvk","src":"charts,singles","from":{"books":[],"podcasts":[],"lists":[