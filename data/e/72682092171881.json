":[],"podcast":[{"kind":"podcast","title":"\"Wimoweh\" in Repertoire","body":"The song \"Wimoweh\" was a staple in the repertoire of almost every folk group in the early 1960s, including The Kingston Trio. \"And in the early 60s, it was in the repertoire of almost every folk group being recorded by groups like the Kingston trio.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 92: \"The Lion Sleeps Tonight\" by the Tokens","url":"https://www.youtube.com/watch?v=QMP_DFyktMg"}]},{"kind":"podcast","title":"Popular Folk Group","body":"The Kingston Trio succeeded The Weavers as the most popular folk group in the United States. \"The Kingston trio, who had taken the weave as place as the most popular folk group in the country.\"","year":null,"extra":null,"srcs":[{"source":"A History of Rock Music in 500 Songs","episode":"Episode 92: \"The Lion Sleeps Tonight\" by the Tokens","url":"https://www.youtube.com/watch?v=QMP_DFyktMg"}]}],"awards":[{"kind":"award","title":"Grammy Lifetime Achievement Award (2011)","body":"Won.","year":2011,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q935843"}]}],"concerts":[],"xref":[],"charts":[{"id":90583743931499,"type":"song","name":"Tom Dooley","work_year":1958,"list_id":157497903047680,"list":"Billboard Hot 100 nº1 · 1960s","src":"singles","rank":6,"year":1958,"note":"1 semanas","yt":"S3zdE8bliGI","scaruffi":null},{"id":90583743931499,"type":"song","name":"Tom Dooley","work_year":1958,"list_id":158051727660304,"list":"Billboard Year-End 1958","src":"singles","rank":28,"year":1958,"note":"","yt":"S3zdE8bliGI","scaruffi":null},{"id":90583743931499,"type":"song","name":"Tom Dooley","work_year":1958,"list_id":132335824845498,"list":"Billboard Year-End Hot 100","src":"charts","rank":28,"year":1958,"note":null,"yt":"S3zdE8bliGI","scaruffi":null},{"id":196983911159121,"type":"song","name":"The Tijuana Jail","work_year":1959,"list_id":24556378313