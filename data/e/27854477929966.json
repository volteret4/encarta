"start":1994,"end":2003,"desc":"La música experimental descubre las primeras computadoras y explota el error como fuente de una expresión bromista y provocadora.","color":"#8b7cf6","family":"Vanguardia y experimental","link":"https://volteret4.github.io/loops_timeline/#errorismo"},{"id":154078539123768,"name":"Aislacionismo","book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","start":1993,"end":1997,"desc":"La rama más fría del ambient noventero: placer en la oscuridad, la opresión y el lado oscuro del alma.","color":"#38bdf8","family":"Ambient y escucha","link":"https://volteret4.github.io/loops_timeline/#aislacionismo"}],"book_tracks":[{"id":211730996790387,"artist":"Jim O'Rourke","artist_id":27854477929966,"title":"Remove the Need","year":1989,"ess":0,"yt":"AO56_j52F8E","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Post-rock","scene_id":245950225873330,"scene_link":"https://volteret4.github.io/scaruffi/#post-rock","chapters":["Sección 6.21"],"pages":[[1,294,null]]},{"id":203429826974097,"artist":"Jim O'Rourke","artist_id":27854477929966,"title":"The Ground Below Above Our Heads","year":1991,"ess":0,"yt":"srkl87E_4H4","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Post-rock","scene_id":245950225873330,"scene_link":"https://volteret4.github.io/scaruffi/#post-rock","chapters":["Sección 6.21"],"pages":[[1,294,null]]},{"id":160607100655411,"artist":"Jim O'Rourke","artist_id":27854477929966,"title":"Tamper","year":1991,"ess":0,"yt":"G2g6L8Xg-ic","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Post-rock","scene_id":245950225873330,"scene_link":"https://volteret4.github.io/scaruffi/#post-rock","chapters":["Sección 6.21"],