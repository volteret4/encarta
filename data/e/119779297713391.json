{"id":119779297713391,"type":"artist","name":"The Olivia Tremor Control","artist":null,"year":null,"weight":10,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Olivia_Tremor_Control_2005.jpg?width=500","bio":"The Olivia Tremor Control fué otra de las bandas que conformaron la Elephant 6 Collective. Formada en el año 1992 por Jeff Mangum, Bill Doss y Will Curren Hart. Como trío graban su primer EP llamado California Demise en 1994,luego del cual Jeff Mangum decide abandonar la banda para enfocarse en su propia grupo Neutral Milk Hotel.Se incorporan luego John Fernandes (bajo, violín y clarinete) con el cual graban su segundo EP Giant Day en 1996 , y finalmente Eric Harris (batería","tags":["psychedelic","experimental","Lo-Fi","indie","Elephant 6"]},"works":[{"id":105927139936099,"type":"album","name":"Dusk at Cubist Castle","artist":"Olivia Tremor Control","year":1996,"weight":13,"yt":"0B8DSC-1MmY","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":187561999930396,"name":"Sputnikmusic Best Albums 1996","rank":116,"scaruffi":7.5},{"id":13018320481353,"name":"Scaruffi 1990s","rank":283,"scaruffi":7.5}],"n_lists":2}},{"id":135589667436094,"type":"album","name":"Music From the Unrealized Film Script, Dusk at Cubist Castle","artist":"The Olivia Tremor Control","year":1996,"weight":7,"yt":"TtQyyvPU9Zo","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","rank":36,"scaruffi":null},{"id":114554236241704,"name":"RYM Top — Psychedelia — Neo-Psychedelia","rank":111,"scaruffi":null},{"id":185548171992260,"name":"RYM Top — Rock — Psychedelic Rock","rank":85,"scaruffi":null}],"n_lists":3}},{"id":19846311916994,"type":"album","name":"Explanation II: Instrumental Themes and Dream Sequences","artist":"The Olivia Tremor Control","year":1998,"weight":2,"yt":"VuSQs_rrHYQ","src":"musthear