st_year":null,"rank":148,"year":null,"note":null,"total":200,"scaruffi":9.0},{"id":265496132631976,"name":"RYM Top — Hip Hop — Gangstarap","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":148,"year":null,"note":null,"total":200,"scaruffi":9.0},{"id":36565743209502,"name":"Rolling Stone 500 Greatest Albums Of All Time 2023 Edition","src":"musthear","grp":null,"list_year":null,"rank":272,"year":null,"note":null,"total":500,"scaruffi":9.0}],"podcast":[{"kind":"podcast","title":null,"body":"This album provides a notable example of extreme channel separation in early stereo mixing, where instruments and vocals were panned hard left and hard right, with little to no sound in the center. This mixing approach, exemplified by the track \"The Gift,\" was an experimental and often distracting use of early stereo technology. \"In 1967, the Velvet Underground released the white light white heat album.\"","year":1967,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Story of Stereo: Part 1","url":"https://www.youtube.com/watch?v=cbSmBrhNACg"}]},{"kind":"podcast","title":null,"body":"Released after the departure of Nico and Andy Warhol, this album was described as much more intimate, measured, and poetic. It offered a more realistic portrayal of the band's original vision, uninfluenced by external actors. \"sería mucho más intimista, mucho más pausado, mucho más poético y que nos da una visión mucho más realista de lo que realmente era la banda.\"","year":1968,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"The Velvet Underground: Una vision más humana que musical","url":"https://www.youtube.com/watch?v=_TMMVFTuyC4"}]},{"kind":"podcast","title":null,"body":"The second album by The Velvet Underground, released in 1968, exemplifies their raw and distorted sound. The track \"Sister Ray\" from this album was recorded in one take with no overdubs. Ron Kale contributed to the distorted sound by tuning an electric keyboard as low as it could go and then turning the volume as high as possible. Live performances of this track could extend for up to three-quarters of an hour, pushing every amp and instrument to its limits to create distortion and feedback. \"Ron Kale uses an electric keyboard tuned down as low as it will go. And then, he turned up the volume as high as possible, which is how he got that distorted sound.\"","year":1968,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Distortion and Feedback","url":"https://www.youtube.com/watch?v=iGav9uJwA_w"}]}],"book_tracks":[{"id":269109706839583,"artist":"Velvet Underground","artist_id":132878248289584,"title":"White Light White Heat","year":1967,"ess":1,"yt":"B2YTtZme9jg","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Nueva York: la nueva bohemia","scene_id":133457835590045,"scene_link":"https://volteret4.github.io/scaruffi/#velvet","chapters":["Sección 3.1"],"pages":[[1,41,null]]},{"id":269109706839583,"artist":"The Velvet Underground","artist_id":132878248289584,"title":"White Light/White Heat","year":1968,"ess":0,"yt":"5dbEF-YyEnw","kind":null,"book":{"id":7,"title":"Postpunk. Romper todo y empezar de nuevo","author":"Simon Reynolds","url":"https://volteret4.github.io/Postpunk/"},"scene":"The Velvet Underground y sus herederos","scene_id":187314516147781,"scene_link":"https://volteret4.github.io/Postpunk/#velvet","chapters":["Prólogo: La revolución inconclusa"],"pages":[]},{"id":269109706839583,"artist":"Velvet Underground","artist_id":132878248289584,"title":"White Light White Heat","year":null,"ess":0,"yt":"B2YTtZme9jg","kind":"s","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Feedback-pop y shoegazing","scene_id":179044137490777,"scene_link":"https://volteret4.github.io/scaruffi/#shoegaze","chapte