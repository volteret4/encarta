{"id":132607972670093,"type":"album","name":"WLFGRL","artist":"Machine Girl","year":2014,"weight":17,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/23194-wlfgrl_131351.jpg","aoty":81,"yt":"oWzzNvcxY4w","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/machine-girl/wlfgrl","aoty":"https://www.albumoftheyear.org/album/23194-machine-girl-wlfgrl.php"},"desc":"WLFGRL is the debut studio album by American electronic duo Machine Girl, released on February 16, 2014, via Dred Collective. The project is notable for its unique fusion of musical genres, including punk, breakcore, electronica and noise elements. The use of film samples, such as The Machine Girl, adds texture to the tracks, and the album is known for its intense energy. With a DIY approach, the album challenges musical conventions, expanding the boundaries of electronic and hardcore. It received critical recognition for its originality. ."},"artist_ref":{"id":212754595954753,"name":"Machine Girl","info":{"img":null}},"labels":[],"genres":[{"id":180679950718005,"type":"genre","name":"Breakbeat","artist":null,"year":null,"weight":281,"yt":null,"src":"rym"},{"id":65067151178508,"type":"genre","name":"Electronic Dance Music","artist":null,"year":null,"weight":244,"yt":null,"src":"rym"},{"id":177745529390130,"type":"genre","name":"Footwork","artist":null,"year":null,"weight":228,"yt":null,"src":"rym"},{"id":259678490474724,"type":"genre","name":"Breakbeat Hardcore","artist":null,"year":null,"weight":206,"yt":null,"src":"rym"},{"id":243893531672131,"type":"genre","name":"Hardcore Breaks","artist":null,"year":null,"weight":201,"yt":null,"src":"rym"},{"id":168922019740546,"type":"genre","name":"Hardcore [EDM]","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"}],"lists":[{"id":128299104800616,"name":"RYM Top — Dance — Breakbeat Hardcore","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":200,"scaruffi":null},{"id":221783646796060,"name"