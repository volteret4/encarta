 Explodes, Bevis Frond, Legendary Pink Dots, The The y Love And Rockets.","color":"#c084fc","family":"Psicodelia, garage y shoegaze","link":"https://volteret4.github.io/scaruffi/#psych-revival"}],"book_tracks":[{"id":176648334516961,"artist":"Legendary Pink Dots","artist_id":112985241378484,"title":"Brighter Now","year":1982,"ess":0,"yt":"4C9OgXWt0Ag","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Revival psicodélico y garage de los ochenta","scene_id":246547991277401,"scene_link":"https://volteret4.github.io/scaruffi/#psych-revival","chapters":["Sección 5.14"],"pages":[[1,174,null]]},{"id":33476610998746,"artist":"Legendary Pink Dots","artist_id":112985241378484,"title":"Asylum","year":1985,"ess":0,"yt":"arWw_HR7Oa0","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Revival psicodélico y garage de los ochenta","scene_id":246547991277401,"scene_link":"https://volteret4.github.io/scaruffi/#psych-revival","chapters":["Sección 5.14"],"pages":[[1,174,null]]},{"id":128643090655734,"artist":"Legendary Pink Dots","artist_id":112985241378484,"title":"Any Day Now","year":1987,"ess":0,"yt":"T1bM-8btMRA","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Revival psicodélico y garage de los ochenta","scene_id":246547991277401,"scene_link":"https://volteret4.github.io/scaruffi/#psych-revival","chapters":["Sección 5.14"],"pages":[[1,174,null]]},{"id":139869046240400,"artist":"Legendary Pink Dots","artist_id":112985241378484,"title":"The Maria Dimension","year":1991,"ess":0,"yt":"NrNi4OyRIxE","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Revival psicodélico y garage de los o