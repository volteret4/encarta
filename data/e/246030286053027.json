caruffi":null}],"n_lists":1}}],"members":[{"id":201212848263950,"type":"artist","name":"Matt Skiba","artist":null,"year":null,"weight":29,"yt":null,"src":"ensayos"},{"id":61849921248849,"type":"artist","name":"Max Schieber","artist":null,"year":null,"weight":5,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[],"album_genres":[{"id":102845406900443,"type":"genre","name":"Pop Punk","n":5},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":2},{"id":31482837869539,"type":"genre","name":"Punk","n":2},{"id":114850286715687,"type":"genre","name":"Acoustic Rock","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[],"awards":[],"concerts":[],"xref":[{"kind":"xref","title":"Matt Skiba's Recruitment and First Performance (2015)","body":"After Tom DeLonge's second departure, Mark Hoppus and Travis Barker decided against disbanding Blink 182 and recruited Matt Skiba from Alkaline Trio. Their first performance with Skiba on March 18, 2015, marked the first time Mark Hoppus played in Blink without Tom DeLonge, after which Skiba was made an official member. \"Mark and Travis had no plans to kill Blink so they brought in Matt Skiba from Alkaline Trio.\"","year":2015,"extra":{"from":"blink‐182","from_id":214386792607367,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Catching Up with Blink 182","url":"https://www.youtube.com/watch?v=EaGUC4av1R4"}]},{"kind":"xref","title":"Max Schieber Joins (2015)","body":"In March 2015, following Tom Delonge's second departure, Blink-182 played two club shows with Max Schieber (likely Matt Skiba) of Alkaline Trio filling in as guitarist. Lawyers worked to formalize Tom's exit and Max's integration into the band. \"In March 2015, Blink played two club shows without Tom. Max Schieber, the guitarist for a band called Alkaline Trio filled in.\"","year":2015,"extra":{"from":"blink‐182","from_id":214386792607367,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 3","url":"https://www.youtube.com/watch?v=Q-QP7ePxkQE"}]},{"kind":"xref","title":"Replaced Tom DeLonge in Blink 182 (2015)","body":"In March 2015, Matt Skiba was brought in from Alkaline Trio to replace Tom DeLonge in Blink 182. After performing three initial gigs, starting March 18, 2015, he was made an official member of the band. \"Mark and Travis had no plans to kill Blink so they brought in Matt Skiba from Alkaline Trio.\"","year":2015,"extra":{"from":"Matt Skiba","from_id":201212848263950,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"Catching Up with Blink 182","url":"https://www.youtube.com/watch?v=EaGUC4av1R4"}]},{"kind":"xref","title":"Filling In for Tom DeLonge","body":"In March 2015, Max Schieber (guitarist for Alkaline Trio) stepped in to play with Blink-182 for two club shows following Tom DeLonge's second departure. Lawyers subsequently worked to formalize Tom's exit and Max's position within the band. \"Max Schieber, the guitarist for a band called Alkaline Trio filled in.\"","year":null,"extra":{"from":"Max Schieber","from_id":61849921248849,"type":"curiosity"},"srcs":[{"source":"The Ongoing History of New Music","episode":"The Rise and Fall and Rise of Blink 182 Part 3","url":"https://www.youtube.com/watch?v=Q-QP7ePxkQE"}]}],"charts":[{"id":4309116060088,"type":"album","name":"Goddamnit","list_id":277152704196686,"list":"RYM Top — Rock — Pop Punk","src":"musthear","rank":91,"year":1998,"note":null,"yt":"7nEmxguBey8","scaruffi":null},{"id":4309116060088,"type":"album","name":"Goddamnit","work_year":1998,"list_id":199353246998089,"list":"Sputnikmusic Best Albums 1998","src":"charts","rank":80,"year":1998,"note":null,"yt":"7nEmxguBey8","scaruffi":null},{"id":5143715116940,"type":"album","name":"Maybe I'll Catch Fire","list_id":277152704196686,"list":"RYM Top — Rock — Pop Punk","src":"musthear","rank":86,"year":2000,"note