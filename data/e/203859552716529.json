1mMGhgyKsk","src":"charts,musthear","from":{"books":[],"podcasts":[],"lists":[{"id":84472050122582,"name":"AOTY Must Hear 2010s","rank":927,"scaruffi":null},{"id":114383129677180,"name":"RYM Top — Psychedelia — Psychedelic Pop","rank":31,"scaruffi":null},{"id":114554236241704,"name":"RYM Top — Psychedelia — Neo-Psychedelia","rank":90,"scaruffi":null}],"n_lists":3}},{"id":30643419650215,"type":"album","name":"Little Dark Age","artist":"MGMT","year":2018,"weight":21,"yt":"rtL5oMyBHPs","src":"charts,ensayos,musthear","from":{"books":[],"podcasts":[{"name":"Music Radar Clan","n":2}],"lists":[{"id":177232549654988,"name":"Favorite Electronic Pop Albums @alin","rank":297,"scaruffi":null},{"id":84472050122582,"name":"AOTY Must Hear 2010s","rank":223,"scaruffi":null},{"id":15302027328081,"name":"RYM Top — Electronic","rank":112,"scaruffi":null},{"id":66678364571761,"name":"RYM Top — Pop","rank":193,"scaruffi":null}],"n_lists":8}}],"members":[{"id":240968153330284,"type":"artist","name":"Ben Goldwasser","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":212692954734324,"type":"artist","name":"Andrew VanWyngarden","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"},{"id":141519270474455,"type":"artist","name":"Andrew VanWingarten","artist":null,"year":null,"weight":1,"yt":null,"src":"ensayos"}],"member_of":[],"genres":[{"id":87625349211221,"type":"genre","name":"electronic","artist":null,"year":null,"weight":1332,"yt":null,"src":"ensayos"},{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"ensayos"},{"id":166905196183001,"type":"genre","name":"psychedelic","artist":null,"year":null,"weight":138,"yt":null,"src":"ensayos"},{"id":215164552688996,"type":"genre","name":"Psychedelia","artist":null,"year":null,"weight":104,"yt":null,"src":"ensayos"}],"album_genres":[{"id":141164231500862,"type":"genre","name":"Psychedelic Pop","n":3},{"id":42039639412310,"type":"genre","name":"Neo-Psychedelia","n":3},{"id":210192360016800,"type":"genre","name":"Alternative Rock","n":1},{"id":185670346256268,"type":"genre","name":"rock","n":1},{"id":135494496540693,"type":"genre","name":"Indie Pop","n":1},{"id":87625349211221,"type":"genre","name":"electronic","n":1},{"id":57638771788875,"type":"genre","name":"Synthpop","n":1},{"id":55143051280122,"type":"genre","name":"Indietronica","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"Digital A/B Side Releases","body":"MGMT is among the artists noted for releasing two digital tracks concurrently, implicitly designating one as more significant than the other, thereby carrying on the metaphorical concept of A-sides and B-sides into the digital realm. This practice reflects a lingering momentum from traditional single formats despite the absence of physical sides. \"For example, acts like the Smash and Pumpkins and MGMT and others have been on to release two digital tracks at the same time, with some kind of subtle hint that one of them is slightly more important than the other.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"Digital Debris Part 1: B-Sides and Bonus Tracks","url":"https://www.youtube.com/watch?v=QBCEmZ4Jheo"}]},{"kind":"podcast","title":"Eclectic Influences and Modern Sound","body":"MGMT's music incorporated influences from artists like David Bowie, The Beatles, The Beach Boys, and Pink Floyd, yet it managed to avoid sounding retro due to its alignment with contemporary indie rock trends. This blend resulted in a sound that was both new and comforting. \"There were bits of bowie and the beetles in what they did. You could also hear elements of the beach boys and pink Floyd.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 00s Part 4: Variety Returns","url":"https://www.youtube.com/watch?v=_yslM5oanRo"}]},{"kind":"podcast","title":"Formation and Sound","body":"Formed in 2002 in Middletown, Connecticut, by Andrew VanWingarten and Ben Goldwasser, MGMT cultivated an indie pop sound infused with psychedelic elements. Their music was perceived as experimental, echoing the attitude of some alt-rock bands from two decades prior. \"They were formed in 2002 in Middletown, Connecticut by Andrew VanWingarten and Ben Goldwasser.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The 00s Part 4: Variety Returns","url":"https://www.youtube.com/watch?v=_yslM5oanRo"}]},{"kind":"podcast","title":"Insistence on Vinyl Releases","body":"MGMT was noted as one of the bands, alongside the Foo Fighters, Gaslight Anthem, Radiohead, Nine-inch Nails, and U2, that started requiring their new music to be released on vinyl. \"Bands from the Foo Fighters to MGMT, to Gaslight Anthem, to Radiohead, to Nine-inch Nails, to YouTube began insisting that their new releases be made available on vinyl.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The History of Vinyl: Part 2","url":"https://www.youtube.com/watch?v=GES0Ms_kaCI"}]},{"kind":"podcast","title":"Musical Comparison","body":"The sound of the Australian band The Holidays is compared to MGMT, placing them among groups with a retro electronic and synthesizer-driven style. \"te recuerda un poco a MGMT o a estos grupos de poco entre electrónicos y desintitizadores.\"","year":null,"extra":null,"srcs":[{"source":"Music Radar Clan","episode":"The Holidays - El perfecto ejemplo de buena banda australiana","url":"https://www.youtube.com/watch?v=89RG5lHTyOU"}]},{"kind":"podcast","title":"Synth-Heavy Band Example","body":"Listed as one of the new synth-heavy bands that emerged, indicating a contemporary interest in synthesizer-driven music. \"There's MGMT, there's Owl City, there's Empire of the Sun, Caribou, Phoenix, Beck has been turned onto these sounds, and Moby, check it out.\"","year":null,"extra":null,"srcs":[{"source":"The Ongoing History of New Music","episode":"The Roots of New Wave through Techno-Pop","url":"https://www.youtube.com/watch?v=1KF5MwJVYng"}]}],"awards":[{"kind":"award","title":"Grammy Award for Best New Artist (2010)","body":"Nominated.","year":2010,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q1453643"}]}],"concerts":[],"xref":[],"charts":[{"id":275803359337108,"type":"album","name":"Oracular Spectacular","list_id":177232549654988,"list":"Favorite Electronic Pop Albums @alin","src":"musthear","rank":140,"year":2008,"note":null,"yt":"dRrBhwVY2aA","scaruffi":null},{"id":275803359337108,"type":"album","name":"Oracular Spectacular","list_id":267579339058353,"list":"RYM Top — Electronic — Indietronica","src":"musthear","rank":85,"year":2008,"note":null,"yt":"dRrBhwVY2aA","scaruffi":null},{"id":275803359337108,"type":"album","name":"Oracular Spectacular","list_id":82075953765266,"list":"RYM Top — Pop — Indie Pop","src":"musthear","rank":154,"year":2008,"note":null,"yt":"dRrBhwVY2aA","scaruffi":null},{"id":275803359337108,"type":"album","name":"Oracular Spectacular","list_id":114554236241704,"list":"RYM Top — Psychedelia — Neo-Psychedelia","src":"musthear","rank":193,"year":2008,"note":null,"yt":"dRrBhwVY2aA","scaruffi":null},{"id":275803359337108,"type":"album","name":"Oracular Spectacular","list_id":114383129677180,"list":"RYM Top — Psychedelia — Psychedelic Pop","src":"musthear","rank":58,"year":2008,"note":null,"yt":"dRrBhwVY2aA","scaruffi":null},{"id":172694551783997,"type":"album","name":"Metanoia","list_id":200867050536406,"list":"Sputnikmusic Best Albums 2008","src":"musthear","rank":145,"year":2008,"note":null,"yt":"e1BnEdnzLEA","scaruffi":null},{"id":85580744193571,"type":"song","name":"Electric Feel","work_year":2008,"list_id":487936226743,"list":"Triple J Hottest 100 · 2008","src":"singles","rank":2,"year":2008,"note":"United States","yt":"MmZexg8sxyk","scaruffi":null},{"id":138145331204