":[],"scenes":[],"book_tracks":[],"mentions":[],"podcast":[{"kind":"podcast","title":"First American Idol Winner","body":"Kelly Clarkson was the first and most celebrated winner of \"American Idol\" in October 2002. Ironically, she was the only finalist from the first five seasons who did not debut at number one, as her song \"A Moment Like This\" charted first on radio airplay before leaping to the top. \"the show's first and most celebrated winner, Kelly Clarkson.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4ef60c30a1408dc29358"}]},{"kind":"podcast","title":"Legitimate Music Star","body":"Kelly Clarkson went on to become a \"legitimate music star\" after her \"American Idol\" victory. However, her subsequent hits, unlike those from the Idol-driven number one debut wave, had to climb the charts \"the old fashioned way,\" rather than debuting instantly at the top. \"Kelly Clarkson and Carrie Underwood went on to become legitimate music stars.\"","year":null,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":null},{"source":"Hit Parade Music History and Music Trivia","episode":"Toppermost of the Poppermost Edition Part 1","url":"https://shows.acast.com/hit-parade/episodes/695d4ef60c30a1408dc29358"}]}],"awards":[{"kind":"award","title":"American Music Award for Artist of the Year (2003)","body":"Won.","year":2003,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https://www.wikidata.org/wiki/Q19858055"}]},{"kind":"award","title":"Radio Disney Music Award for Best Music Video (2003) — Miss Independent","body":"Won.","year":2003,"extra":null,"srcs":[{"source":"Wikidata","episode":null,"url":"https: