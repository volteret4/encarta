ht":1461,"yt":null,"src":"ensayos"},{"id":44294165522841,"type":"genre","name":"r&b","artist":null,"year":null,"weight":908,"yt":null,"src":"ensayos"}],"album_genres":[{"id":12781382915871,"type":"genre","name":"Soul Jazz","n":8},{"id":19904352098817,"type":"genre","name":"Smooth Jazz","n":6},{"id":7248838886199,"type":"genre","name":"Jazz-Funk","n":5},{"id":58867391113657,"type":"genre","name":"Jazz Pop","n":4},{"id":265524373450282,"type":"genre","name":"jazz","n":1},{"id":88565796698220,"type":"genre","name":"crossover jazz","n":1},{"id":50337978407967,"type":"genre","name":"Smooth Soul","n":1},{"id":20619342488979,"type":"genre","name":"Funk","n":1},{"id":2149040092328,"type":"genre","name":"contemporary jazz","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":70279236005425,"name":"Fusión jazz-rock","book":"Historia del jazz","author":"Ted Gioia","start":1967,"end":1995,"desc":"El jazz siempre fue fusión («nada de lo que venga de Nueva Orleans es puro»), pero desde Bitches Brew (400.000 copias el primer año) la palabra significa jazz con rock, y amplía la base económica de todo el jazz en los setenta. Miles sigue con discos crudos montados por Teo Macero (Jack Johnson, Live-Evil, On the Corner) y acaba de telonero de los Headhunters de Herbie Hancock. Sus antiguos músicos fundan los grupos clave: Return to Forever de Chick Corea (sabor latino, «Spain»), la Mahavishnu Orchestra de John McLaughlin (rock a lo Hendrix, música india) y Weather Report de Zawinul y Shorter, una estética de Ellington aplicada al pop electrónico, con el bajo de Jaco Pastorius («Birdland»). Del lado del rock: Blood, Sweat & Tears, Chase, Hendrix, Sly Stone y Frank Zappa. Luego llegan el jazz pulido para la radio, Spyro Gyra y Kenny G, el M-Base de Steve Coleman y Cassandra Wilson, el acid jazz de Londres y US3, y el último Miles con el hip hop de doo-bop. Pat Metheny es el guitarrista más visionario del estilo.","color":"#a3e635","family":"Fusión: jazz-rock, ECM y músicas del mundo","link":"https://volteret4.github.io/jazz/#fusion-jazz-rock"}],"book_tracks":[{"id":143067009409019,"artist":"George Benson","artist_id":243263904844152,"title":"This Masquerade","year":1976,"ess":0,"yt":"j9W0g3NGSj4","kind":null,"book":{"id":6,"title":"Historia del jazz","author":"Ted Gioia","url":"https://volteret4.github.io/jazz/"},"scene":"Fusión jazz-rock","scene_id":70279236005425,"scene_link":"https://volteret4.github.io/jazz/#fusion-jazz-rock","chapters":["Cap. 8: El free jazz y el jazz posmoderno"],"pages":[[1,402]]}],"mentions":[{"book":"Historia del jazz","author":"Ted Gioia","page":366,"text":"…Las sesiones de finales de 1967 y principios de 1968 muestran a Davis experimentando con la adición de una guitarra eléctrica (tocada por George Benson o Joe Beck). Durante este mismo período, Hancock comenzó a utilizar un piano eléctrico en algunos temas. Para la época en que se gestó Filles de…"},{"book":"Historia del jazz","author":"Ted Gioia","page":402,"text":"…la banda VSOP, básicamente una reedición de un quinteto de Davis de mediados de los sesenta (con Freddie Hubbard ocupando ahora el lugar de Miles). George Benson, cuya guitarra aparecía en el disco de Davis Miles in the Sky, dio un paso exitoso en forma de obra vocal. Su versión de mediados de los setenta de This Masquerade, de Leon Russell, inició una serie de éxitos pop de Benson —un éxito que amenazaba con oscurecer su talento como solista al más puro estilo de Wes Montgomery—. La banda de Tony Williams Lifetime, que contaba con el organista Larry Young y el guitarrista John McLaughlin, no obtuvo el éxito comercial que obtuvieron Hancock o Benson con sus trabajos de fusión, pero proporcionó una combinación más sofisticada de la energía del rock con las proezas instrumentales del jazz. Chick…"}],"podcast":[],"awards":[],"concerts":[{"kind":"concert","title":"Wild Cherry (opened for)","body":null,"year":null,"extra":null,"srcs":[]}],"xref":[],"charts":[{"id":152281448003571,"type":"album