{"id":268796350766106,"type":"album","name":"Da lama ao caos","artist":"Chico Science & Nação Zumbi","year":1994,"weight":16,"info":{"cover":"https://e.snmc.io/i/600/w/445a81246ab793d2083906eb96b8001d/12247749","yt":"f4Ptgb2HaXU","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/chico-science-and-nacao-zumbi/da-lama-ao-caos/"},"desc":"Da Lama ao Caos é o primeiro álbum de estúdio da banda pernambucana Chico Science & Nação Zumbi, lançado em 1994. Considerado um verdadeiro clássico da música brasileira, apresentou um som revolucionário, com canções energéticas, muito bem elaboradas, mesclando funk rock com maracatu, embolada, psicodelia e música Afro. Além disso, foi o disco que inaugurou a cena Manguebeat e foi também um dos responsáveis pela \"abertura de portas\" para o rock dos anos 90 exercendo uma influencia muito forte para o que surgiria depois. O álbum está na lista dos 100 melhores discos da música brasileira da Rolling Stone na ."},"artist_ref":{"id":150099575097508,"name":"Chico Science & Nação Zumbi","info":{"img":null}},"labels":[],"genres":[{"id":197081568021679,"type":"genre","name":"Northeastern Brazilian Music","artist":null,"year":null,"weight":198,"yt":null,"src":"rym"},{"id":263735374044965,"type":"genre","name":"South American Music","artist":null,"year":null,"weight":194,"yt":null,"src":"rym"},{"id":118839479112132,"type":"genre","name":"Brazilian Music","artist":null,"year":null,"weight":193,"yt":null,"src":"rym"},{"id":192715986965156,"type":"genre","name":"Manguebeat","artist":null,"year":null,"weight":66,"yt":null,"src":"rym"}],"lists":[{"id":160738996909111,"name":"RYM Top — Rock — Manguebeat","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":67,"scaruffi":null},{"id":242780459212195,"name":"RYM Top — Regional Music — Northeastern Brazilian Music","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":1,"year":null,"note":null,"total":200,"scaruffi":null},{"id":30263152