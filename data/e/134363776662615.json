9666201561039,"type":"genre","name":"American Folk Music","n":1},{"id":90510611927654,"type":"genre","name":"Country Rock","n":1},{"id":63006998354228,"type":"genre","name":"Outlaw Country","n":1}],"labels":[],"album_labels":[],"own_scenes":[],"scenes":[{"id":13391632264459,"name":"Cantautores de los ochenta","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1981,"end":2003,"desc":"Absorbida la new wave, el mundo de los cantautores no vuelve a ser el mismo: los referentes pasan a ser Dylan, Neil Young, Cohen, Tim Buckley y Joni Mitchell. Las mujeres recuperan su estatus de seres filosóficos: Phranc, Suzanne Vega, Tracy Chapman, Melissa Etheridge, Michelle Shocked, Barbara Manning, Lucinda y Victoria Williams, Indigo Girls y, en Canadá, Jane Siberry, Mary Margaret O'Hara y Sarah McLachlan. Excéntricos: Jandek, Daniel Johnston, David Thomas, Alejandro Escovedo; en California, Stan Ridgway, Chris Isaak y Smog. En Gran Bretaña, Billy Bragg, Robyn Hitchcock, Julian Cope y, la voz más importante de la década, Nick Cave, predicador del apocalipsis moral (From Her To Eternity, The Good Son). Sinéad O'Connor, Sting, Morrissey, Momus; el pop celta de Enya y Loreena McKennitt; al cambiar la década, Joe Henry, Daniel Lanois y Bob Mould.","color":"#a3e635","family":"Folk y cantautores","link":"https://volteret4.github.io/scaruffi/#songwriters-80s"}],"book_tracks":[{"id":59836277815109,"artist":"Lucinda Williams","artist_id":134363776662615,"title":"Lucinda Williams","year":1989,"ess":0,"yt":"UlL2nd9D9FE","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Cantautores de los ochenta","scene_id":13391632264459,"scene_link":"https://volteret4.github.io/scaruffi/#songwriters-80s","chapters":["Sección 5.16"],"pages":[[1,184,null]]},{"id":104561536545381,"artist":"Lucinda Williams","artist_id":134363776662615,"title":"Sweet Old World","year":1993,"ess":0,"yt":