{"id":124553801602231,"type":"artist","name":"The Hellacopters","artist":null,"year":null,"weight":11,"info":{"img":"https://cdn-images.dzcdn.net/images/artist/de8669458de28f4302c327693ed94070/1000x1000-000000-80-0-0.jpg","bio":"Procedentes de Suecia,  Hellacopters son una banda de Garage rock y Hard rock formada en sus inicios por Nick Royale, Kenny Håkansson, Robert Eriksson y Dregen, actual guitarrista de Backyard Babies. \n\nSe formaron en 1994 cuando el grupo se junto para grabar un sencillo de tres cortes con Psychout, el sello de Royale. El disco puede llegar a alcanzar actualmente los 150 dolares. Más tarde firmaron un contrato con White Jazz y con esta lanzaron su album debut","tags":["hard rock","rock","Garage Rock","swedish","rock n roll"]},"works":[{"id":18112463310582,"type":"album","name":"Supershitty To The Max","artist":"Hellacopters","year":1996,"weight":13,"yt":"g3GRoUDf5yY","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":13018320481353,"name":"Scaruffi 1990s","rank":755,"scaruffi":7.0},{"id":36355441347599,"name":"RYM Top — Rock — Garage Punk","rank":98,"scaruffi":7.0}],"n_lists":2}},{"id":233941073794971,"type":"album","name":"Payin' the Dues","artist":"The Hellacopters","year":1997,"weight":16,"yt":"PhoACGoknis","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":14239102054361,"name":"Sputnikmusic Best Albums 1997","rank":171,"scaruffi":null},{"id":36355441347599,"name":"RYM Top — Rock — Garage Punk","rank":20,"scaruffi":null},{"id":51314745106268,"name":"RYM Top — Rock — Garage Rock","rank":69,"scaruffi":null}],"n_lists":3}},{"id":66449164871994,"type":"album","name":"Grande Rock","artist":"The Hellacopters","year":1999,"weight":3,"yt":"EaysSE-fYuo","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":240735758437916,"n