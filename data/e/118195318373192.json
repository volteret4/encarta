"id":135494496540693,"type":"genre","name":"Indie Pop","n":1}],"labels":[{"id":52479781601579,"type":"label","name":"Virgin","artist":null,"year":null,"weight":196,"yt":null,"src":"ensayos"}],"album_labels":[],"own_scenes":[],"scenes":[{"id":111254626610700,"name":"Modernismo británico: de Ultravox a U2","book":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","start":1977,"end":1987,"desc":"Los puentes entre punk y pop sofisticado: Ultravox funde punk, el pop robótico de Kraftwerk y Roxy Music (Vienna, uno de los discos que alumbran el synth-pop); XTC perfeccionan el arte de la canción pop como nadie (Drums And Wires, English Settlement, Skylarking); Magazine, Monochrome Set, Squeeze; Japan y su dance-pop decadente; Simple Minds; y U2, el fenómeno más sensacional de las islas desde los Beatles, que unen la vehemencia del punk con el atractivo masivo del pop.","color":"#f472b6","family":"Pop, power-pop y synth-pop","link":"https://volteret4.github.io/scaruffi/#uk-modernism"}],"book_tracks":[{"id":234411559887875,"artist":"XTC","artist_id":118195318373192,"title":"White Music","year":1978,"ess":1,"yt":"ifNHvG5uMVQ","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Modernismo británico: de Ultravox a U2","scene_id":111254626610700,"scene_link":"https://volteret4.github.io/scaruffi/#uk-modernism","chapters":["Sección 5.5"],"pages":[[1,132,null]]},{"id":228150338452210,"artist":"XTC","artist_id":118195318373192,"title":"Drums And Wires","year":1979,"ess":0,"yt":"N66oJVIjk2M","kind":"a","book":{"id":8,"title":"A History of Rock Music 1951-2000","author":"Piero Scaruffi","url":"https://volteret4.github.io/scaruffi/"},"scene":"Modernismo británico: de Ultravox a U2","scene_id":111254626610700,"scene_link":"https://volteret4.github.io/scaruffi/#uk-modernism","chapters":["Sección 5.5"],"pages":[[1,132,null]]},{"id":280447170265245,"artist":"XTC","artist_id":11819