{"id":2479560342320,"type":"album","name":"S.C.I.E.N.C.E.","artist":"Incubus","year":1997,"weight":12,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/15512-science.jpg","aoty":69,"aoty_user":82,"yt":"O3GRldZkRxg","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/incubus/s_c_i_e_n_c_e","aoty":"https://www.albumoftheyear.org/album/15512-incubus-science.php"},"desc":"S.C.I.E.N.C.E. is the second studio album by American rock band Incubus. It was released on September 9th, 1997, by Epic and Immortal Records. The album was certified gold by the RIAA, and is the second and final release to feature Gavin Koppel (known as DJ Lyfe), who first appeared on the 1997 Enjoy Incubus EP. It has been occasionally considered the band's proper debut album, due to the nature of their independent release Fungus Amongus. After recording their independent debut album Fungus Amongus (1995), Incubus signed a seven-record deal with Epic/Sony-affiliated Immortal Records in 1996. An EP titled Enjoy Incubus ."},"artist_ref":{"id":145264067026848,"name":"Incubus","info":{"img":null}},"labels":[],"genres":[{"id":270478598006331,"type":"genre","name":"Alternative Metal","artist":null,"year":null,"weight":293,"yt":null,"src":"rym"},{"id":18640217511367,"type":"genre","name":"Nu Metal","artist":null,"year":null,"weight":254,"yt":null,"src":"rym"},{"id":229186194430618,"type":"genre","name":"Funk Metal","artist":null,"year":null,"weight":238,"yt":null,"src":"rym"},{"id":271533815298354,"type":"genre","name":"Funk Rock","artist":null,"year":null,"weight":226,"yt":null,"src":"rym"}],"lists":[{"id":221108802372907,"name":"RYM Top — Rock — Funk Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":7,"year":null,"note":null,"total":200,"scaruffi":null},{"id":110107781706095,"name":"RYM Top — Rock — Nu Metal","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":16,"year":null,"note":null,"total":200,"scaruffi":null},{"id":200600589539543,"name":"RYM To