{"id":58118528761879,"type":"album","name":"Minas","artist":"Milton Nascimento","year":1975,"weight":19,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/81497-minas_183700.jpg","aoty":85,"aoty_user":87,"yt":"hIGh4S3_JgE","links":{"rateyourmusic":"https://rateyourmusic.com/release/album/milton-nascimento/minas","aoty":"https://www.albumoftheyear.org/album/81497-milton-nascimento-minas.php"},"desc":"Minas é o sétimo álbum de estúdio do cantor, violonista e compositor brasileiro Milton Nascimento lançado pela gravadora EMI-Odeon em 1975. A origem do título do disco Minas, deve-se a um garoto chamado Rúbio que juntou as primeiras sílabas do nome e sobrenome do cantor e sugeriu como título para o próximo trabalho do artista. O disco segue a trazer a mesma fórmula dos discos anteriores: produção de Ronaldo Bastos, com direção musical e arranjos de Wagner Tiso. Minas apresenta músicas como \"Fé Cega, Faca Amolada\", \"Paula e Bebeto\" feita com Caetano Veloso, \"Ponta de Areia\", \"Idolatrada\", \"Saudade dos Aviões ."},"artist_ref":{"id":121773481549377,"name":"Milton Nascimento","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Milton_do_Nascimento_%281972%29.tif?width=500"}},"labels":[],"genres":[{"id":223327500886715,"type":"genre","name":"Contemporary Folk","artist":null,"year":null,"weight":247,"yt":null,"src":"rym"},{"id":117566163487916,"type":"genre","name":"Progressive Folk","artist":null,"year":null,"weight":206,"yt":null,"src":"rym"},{"id":216934986234007,"type":"genre","name":"MPB","artist":null,"year":null,"weight":201,"yt":null,"src":"rym"},{"id":263735374044965,"type":"genre","name":"South American Music","artist":null,"year":null,"weight":194,"yt":null,"src":"rym"},{"id":118839479112132,"type":"genre","name":"Brazilian Music","artist":null,"year":null,"weight":193,"yt":null,"src":"rym"},{"id":86753305970373,"type":"genre","name":"Clube da esquina","artist":null,"year":null,"weight":51,"yt":null,"src":"rym"}],"lists":[{"id":5279