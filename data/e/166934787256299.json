{"id":166934787256299,"type":"song","name":"Cross-Eyed and Painless","artist":"Talking Heads","year":1980,"weight":10,"info":{"img":null},"artist_ref":{"id":30375256435126,"name":"The Talking Heads","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Talking_Heads_Remain_In_Light_%281980_Sire_publicity_photo%29_%285-4_cropped%29.jpg?width=500"}},"labels":[],"genres":[],"lists":[],"podcast":[{"kind":"podcast","title":null,"body":"This 1980 single from *Remain in Light* was a number 20 dance hit, escalating their sonic explorations after \"I Zimbra.\" The song's bridge featured a rhythmic chant by David Byrne that was essentially a \"proto-rap,\" which Byrne later stated was inspired by Curtis Blow's 1980 hit \"The Breaks.\" \"The bridge of Cross-eyed and Painless, a rhythmic chant by David Byrne, was essentially a proto-rap...\"","year":1980,"extra":null,"srcs":[{"source":"Hit Parade Music History and Music Trivia","episode":"This Ain’t No Party! Edition Part 2","url":"https://shows.acast.com/hit-parade/episodes/695d4f6b39d31c85883dc9de"},{"source":"Hit Parade Music History and Music Trivia","episode":"This Ain’t No Party! Edition Part 2","url":null}]}],"book_tracks":[],"others":[{"id":8528732591624,"type":"album","name":"Remain in Light","year":1980,"weight":84},{"id":70952201310265,"type":"album","name":"Fear of Music","year":1979,"weight":74},{"id":49068603079062,"type":"album","name":"Stop Making Sense","year":1984,"weight":54},{"id":118567423828257,"type":"album","name":"Talking Heads: 77","year":1977,"weight":51},{"id":195053116978492,"type":"album","name":"More Songs About Buildings and Food","year":1978,"weight":45},{"id":137913851639426,"type":"song","name":"Life During Wartime","year":1979,"weight":40},{"id":235086554104387,"type":"song","name":"Psycho Killer","year":1977,"weight":37},{"id":116974517587606,"type":"album","name":"Speaking in Tongues","year":1983,"weight":28},{"id":172540084674576,"type":"album","name":"True Stories","year":198