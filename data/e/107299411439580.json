cionados: hauntology, vaporwave, nuevos analógicos y otras músicas perseguidas por sus recuerdos"],"pages":[[2,242],[2,429]]},{"id":236218431603291,"artist":"Oneohtrix Point Never","artist_id":107299411439580,"title":"Returnal","year":2010,"ess":0,"yt":"nGj5N9Ll9pI","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Nuevos analógicos","scene_id":239896985011514,"scene_link":"https://volteret4.github.io/loops_timeline/#nuevos-analogicos","chapters":["Loops 2 · Cap. 7: Futuros traicionados: hauntology, vaporwave, nuevos analógicos y otras músicas perseguidas por sus recuerdos"],"pages":[[2,224],[2,242]]},{"id":192137596723402,"artist":"Oneohtrix Point Never","artist_id":107299411439580,"title":"R Plus Seven","year":2013,"ess":1,"yt":"R7XcAaVumgc","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Nuevos analógicos","scene_id":239896985011514,"scene_link":"https://volteret4.github.io/loops_timeline/#nuevos-analogicos","chapters":["Loops 2 · Cap. 7: Futuros traicionados: hauntology, vaporwave, nuevos analógicos y otras músicas perseguidas por sus recuerdos"],"pages":[[2,242],[2,429]]},{"id":242654544987956,"artist":"Oneohtrix Point Never","artist_id":107299411439580,"title":"Garden of Delete","year":2015,"ess":0,"yt":"s7pGHr227aU","kind":null,"book":{"id":10,"title":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","url":"https://volteret4.github.io/loops_timeline/"},"scene":"Nuevos analógicos","scene_id":239896985011514,"scene_link":"https://volteret4.github.io/loops_timeline/#nuevos-analogicos","chapters":["Loops 2 · Cap. 7: Futuros traicionados: hauntology, vaporwave, nuevos analógicos y otras músicas perseguidas por sus recuerdos"],"pages":[[2,242]]}],"mentions":[{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":224,"text":"…centro de la pupila— en la antología Celestial Soul Portrait (2013). «Hay discos new age que me gustan», contaba Daniel Lopatin —más conocido como Oneohtrix Point Never— en un encuentro en Madrid con alumnos de Red Bull Music Academy. «Luego hay muchísimos discos que no los soporto, son horribles. Pero algunas…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":242,"text":"alias Oneohtrix Point Never, está elaborada a partir de sacarle el máximo partido a un sintetizador Juno 60, «un instrumento muy básico que permite pocas opciones, y que me…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":242,"text":"…ficción, aunque fuera tomando distancia y sin excesiva solemnidad. De hecho, pese a que su música pueda parecer una evocación subconsciente, hay en Oneohtrix Point Never algo que Simon Reynolds señaló con acierto, y que es una vocación de historiador o de crítico musical: antes que productor, Daniel Lopatin es un…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":242,"text":"…vaporwave —su casete Eccojams vol. 1, firmada como Chuck Person, es un clásico del género— o quebrando las convenciones de la escena analógica. Oneohtrix Point Never siempre ha ido por delante del resto, y en Returnal (2010), el álbum que marcó su fichaje por Editions Mego, ya empezaba a darle la vuelta al sonido…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":412,"text":"…Antony Hegarty y que tras el cambio oficial de sexo ha emprendido una carrera como vocalista dance a tiempo completo en compañía de productores como Oneohtrix Point Never o Hudson Mohawke—, Elysia Crampton o la alemana Ziúr, fichaje del sello Planet Mu en la estela de la IDM abrasiva de Arca, en su caso con un extra…"},{"book":"Loops 1 y 2. Una historia de la música electrónica","author":"Javier Blánquez (ed.)","page":447,"text":"…en sonidos oníricos y estados de conciencia inestables. Una forma psicodélica de música planeadora, pop y new age en el nuevo siglo. James Ferraro Oneohtrix Point Never"}],"podcast":[],"awards":[],"concerts":[],"xref":[],"charts":[{"id":131725391631561,"type":"album","name":"A Pact Between Strangers","list_id":106284046011718,"list":"RYM Top — Electronic — Progressive Electronic","src":"musthear","rank":74,"year":2008,"note":null,"yt":"JTdl3yFCHY4","scaruffi":null},{"id":131725391631561,"type":"album","name":"A Pact Between Strangers","list_id":100525930599399,"list":"RYM Top — Electronic — Space Ambient","src":"musthear","rank":20,"year":2008,"note":null,"yt":"JTdl3yFCHY4","scaruffi":null},{"id":131725391631561,"type":"album","name":"A Pact Between Strangers","list_id":17350863471177,"list":"RYM Top — Experimental — Drone","src":"musthear","rank":159,"year":2008,"note":null,"yt":"JTdl3yFCHY4","scaruffi":null},{"id":59482868068315,"type":"album","name":"Rifts","work_year":2009,"list_id":8725275226094,"list":"Pitchfork: The 50 Best Ambient Albums of All Time","src":"charts","rank":27,"year":2009,"note":null,"yt":"UxuABHgaORU","scaruffi":null},{"id":206644238033114,"type":"album","name":"Russian Mind","list_id":106284046011718,"list":"RYM Top — Electronic — Progressive Electronic","src":"musthear","rank":51,"year":2009,"note":null,"yt":"Cwrcn4hXZSY","scaruffi":null},{"id":183275702527970,"type":"album","name":"Zones Without People","list_id":106284046011718,"list":"RYM Top — Electronic — Progressive Electronic","src":"musthear","rank":135,"year":2009,"note":null,"yt":"F7Ppsuqlcbc","scaruffi":null},{"id":236218431603291,"type":"album","name":"Returnal","list_id":106284046011718,"list":"RYM Top — Electronic — Progressive Electronic","src":"musthear","rank":55,"year":2010,"note":null,"yt":"nGj5N9Ll9pI","scaruffi":null},{"id":151928760441083,"type":