{"id":70493291773376,"type":"album","name":"Our Time In Eden","artist":"10,000 Maniacs","year":1992,"weight":16,"info":{"cover":"https://dn721809.ca.archive.org/0/items/mbid-b6e6d4cf-2301-4941-b99c-1a34025fbd89/mbid-b6e6d4cf-2301-4941-b99c-1a34025fbd89-33903777664.jpg","scaruffi":7.0,"yt":"OB0C2g7851U","links":{"spotify":"https://open.spotify.com/album/0jtmYtkmyrMDpo7M2FTzZ2","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lccq2u2fDbv6ub4q-uDPM7NQAq3zPc2oA","rateyourmusic":"https://rateyourmusic.com/release/album/10_000-maniacs/our-time-in-eden-12"},"desc":"Our Time in Eden is the fifth studio album by American alternative rock band 10,000 Maniacs. It was released in 1992 on Elektra Records. The release is 10,000 Maniacs' last studio album with original lead singer Natalie Merchant. The album included her future replacement Mary Ramsey on violin and viola on such tracks as \"Stockton Gala Days\" and \"How You've Grown\". Singles released from the album were \"These Are Days\", \"Candy Everybody Wants\" and \"Few and Far Between\". The brass and woodwind section is covered by the J.B.'s, or James Brown's band. The album had the working title African Violet ."},"artist_ref":{"id":42799595969859,"name":"10,000 Maniacs","info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/10%2C000_Maniacs.jpg?width=500"}},"labels":[],"genres":[{"id":210192360016800,"type":"genre","name":"Alternative Rock","artist":null,"year":null,"weight":2664,"yt":null,"src":"musthear"},{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"musthear"},{"id":194427380844280,"type":"genre","name":"Folk Rock","artist":null,"year":null,"weight":621,"yt":null,"src":"musthear"},{"id":251671925246370,"type":"genre","name":"Soft Rock","artist":null,"year":null,"weight":418,"yt":null,"src":"musthear"},{"id":190318565344926,"type":"genre","name":"Folk Pop","artist":null,"year":null,"weight":248,"yt":null,"src":"musthear"},{"id":1590