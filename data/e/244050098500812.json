{"id":244050098500812,"type":"artist","name":"Egberto Gismonti","artist":null,"year":null,"weight":17,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/EgbertoGismontiBA.jpg?width=500","bio":"Egberto Gismonti es un compositor y multiinstrumentista brasileño. Nació en Carmo, Estado de Río de Janeiro, Brasil el 5 de diciembre de 1947, hijo de un siciliano y una libanesa. Comenzó su estudio formal de piano a la edad de seis años. Después de estudiar música erudita durante 15 años, se fue a vivir a París, donde estudió con la compositora y directora de orquesta Nadia Boulanger (con quien aprendió orquestación y análisis) y con el compositor Jean Barraqué (alumno de Arnold Schönberg y de Anton Webern).","tags":["jazz","brazilian","instrumental","guitar","mpb"]},"works":[{"id":87555292339924,"type":"album","name":"Orfeo novo","artist":"Egberto Gismonti","year":1970,"weight":3,"yt":"7H1YhGm9k5U","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":172599918463469,"name":"RYM Top — Regional Music — Brazilian Classical Music","rank":13,"scaruffi":null}],"n_lists":1}},{"id":77125942971484,"type":"album","name":"Água & vinho","artist":"Egberto Gismonti","year":1972,"weight":7,"yt":"sZ0Tt7Qs0NI","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":45090916084136,"name":"RYM Top — Jazz — Latin Jazz","rank":75,"scaruffi":null},{"id":197815003252031,"name":"RYM Top — Jazz — Samba-jazz","rank":44,"scaruffi":null},{"id":279980947929933,"name":"RYM Top — Regional Music — Samba","rank":187,"scaruffi":null}],"n_lists":3}},{"id":136446060431862,"type":"album","name":"Egberto Gismonti","artist":"Egberto Gismonti","year":1973,"weight":11,"yt":"zk1XwjoptuE","src":"musthear","from":{"books":[],"podcasts":[],"lists":[{"id":45090916084136,"name":"RYM Top — Jazz — Latin Jazz","rank":50,"scaruffi":null},{"id":155667979741742,"name":"RYM Top — Regional Music — MPB","rank":162,"scaruffi":null},{"id":197815003252031,"name":"RYM Top — Jazz — Samba-jazz","ran