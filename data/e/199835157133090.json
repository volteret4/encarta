{"id":199835157133090,"type":"album","name":"Electric Circus","artist":"Common","year":2002,"weight":12,"info":{"cover":"https://dn711006.ca.archive.org/0/items/mbid-c4ae0f48-1c28-422d-8c6d-1d6a120efd5d/mbid-c4ae0f48-1c28-422d-8c6d-1d6a120efd5d-4402674809.jpg","scaruffi":7.5,"yt":"GTRm6_4PL4Y","links":{"spotify":"https://open.spotify.com/album/4eD2SoySMPRl0SBv7rqk1X","youtube":"https://music.youtube.com/playlist?list=OLAK5uy_lmqX3458Msi2UlFwl3HdNCi5KXlcN7ikA","rateyourmusic":"https://rateyourmusic.com/release/album/common/electric-circus"},"desc":"Electric Circus is the fifth studio album by rapper Common, released December 10, 2002 on the now-defunct MCA Records. The album was highly anticipated and praised by many critics for its ambitious vision. However, it was not as commercially successful as his previous album, Like Water for Chocolate, selling under 300,000 copies. An eclectic album, Electric Circus featured fusions of several genres such as hip hop, pop, rock, electronic, and neo soul. This was Common's second and last album for MCA, released prior to the label's absorption under Geffen Records. Common worked with a large (and eclectic) number of musicians ."},"artist_ref":{"id":177052777249237,"name":"Common","info":{"img":null}},"labels":[],"genres":[{"id":136937573393074,"type":"genre","name":"hip hop","artist":null,"year":null,"weight":1554,"yt":null,"src":"musthear"},{"id":26869950655266,"type":"genre","name":"Conscious Hip Hop","artist":null,"year":null,"weight":252,"yt":null,"src":"musthear"},{"id":145450397810410,"type":"genre","name":"Jazz Rap","artist":null,"year":null,"weight":238,"yt":null,"src":"musthear"},{"id":196943961983090,"type":"genre","name":"alternative hip hop","artist":null,"year":null,"weight":48,"yt":null,"src":"musthear"},{"id":143900538497362,"type":"genre","name":"Midwest Hip Hop","artist":null,"year":null,"weight":200,"yt":null,"src":"rym"},{"id":43001458719353,"type":"genre","name":"Afrofuturism","artist":null,"year":null,"wei