{"id":100574051805518,"type":"artist","name":"Green On Red","artist":null,"year":null,"weight":11,"info":{"img":"https://commons.wikimedia.org/wiki/Special:FilePath/Green_On_Red_at_King_Tuts.jpg?width=500","bio":"Green on Red es una banda que tiene sus orígenes en Phoenix, Arizona (Estados Unidos).\n\nTodo comenzó a finales de los setenta, para derivar posteriormente a un EP titulado a secas \"Green on Red\", del año 1981. El disco venia de super edición, el vinilo era de color rojo (la edición americana).Fue una pequeña auto-realización (media casera), en la que estaba compuesto por cinco temas en donde en todos se siente una fuerte influencia de rock sesentoso","tags":["Paisley Underground","americana","rock","80s","Alt-country"]},"works":[{"id":167481259551482,"type":"album","name":"Gravity Talks","artist":"Green On Red","year":1983,"weight":15,"yt":"3PUgnFLdjo4","src":"books,charts,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":52032266791182,"name":"Scaruffi 1980s","rank":451,"scaruffi":7.0},{"id":206252946483818,"name":"RYM Top — Rock — Paisley Underground","rank":17,"scaruffi":7.0},{"id":161051722508702,"name":"RYM Top — Rock — Jangle Pop","rank":174,"scaruffi":7.0}],"n_lists":3}},{"id":193742432588260,"type":"album","name":"Gas Food Lodging","artist":"Green on Red","year":1985,"weight":15,"yt":"hrUMD2FirYk","src":"books,musthear","from":{"books":[{"name":"Scaruffi","title":"A History of Rock Music 1951-2000 (Piero Scaruffi)"}],"podcasts":[],"lists":[{"id":206252946483818,"name":"RYM Top — Rock — Paisley Underground","rank":16,"scaruffi":null},{"id":22099031234954,"name":"RYM Top — Rock — Power Pop","rank":166,"scaruffi":null},{"id":161051722508702,"name":"RYM Top — Rock — Jangle Pop","rank":152,"scaruffi":null},{"id":215436743643591,"name":"RYM Top — Rock — Roots Rock","rank":82,"scaruffi":null}],"n_lists":4}},{"id":260791668383849,"type":"album","name":"The Killer Ins