{"id":17822126301974,"type":"album","name":"The Boy with the Arab Strap","artist":"Belle and Sebastian","year":1998,"weight":25,"info":{"cover":"https://cdn2.albumoftheyear.org/600x0/album/10778-the-boy-with-the-arab-strap.jpg","aoty":84,"aoty_user":81,"yt":"YcgqJDEBC-o","links":{"aoty":"https://www.albumoftheyear.org/album/10778-belle-sebastian-the-boy-with-the-arab-strap.php"},"desc":"The Boy with the Arab Strap is the third album from the Scottish band Belle & Sebastian. The inspiration for the album's name came from the band Arab Strap, who are also from Scotland and briefly toured with Belle & Sebastian. An Arab strap is a sexual device for retaining an erection. Arab Strap were reportedly less than pleased with their inclusion in the title of the album. When questioned about it, Arab Strap's leader/singer, Aiden, said \"They have a sense of humor.\" Malcolm, the band's instrumentalist, added, \"Because Arab Strap is quite an interesting name. The words go well ."},"artist_ref":{"id":34830299925010,"name":"Belle and Sebastian","info":{"img":"https://cdn-images.dzcdn.net/images/artist/6332ef7b8f1f939b5acf23e5d4967d1a/1000x1000-000000-80-0-0.jpg"}},"labels":[],"genres":[{"id":18872195504512,"type":"genre","name":"Pop Rock","artist":null,"year":null,"weight":740,"yt":null,"src":"rym"},{"id":135494496540693,"type":"genre","name":"Indie Pop","artist":null,"year":null,"weight":340,"yt":null,"src":"rym"},{"id":236061900877969,"type":"genre","name":"Chamber Pop","artist":null,"year":null,"weight":245,"yt":null,"src":"rym"},{"id":7907596873750,"type":"genre","name":"Twee Pop","artist":null,"year":null,"weight":204,"yt":null,"src":"rym"}],"lists":[{"id":251973115798518,"name":"RYM Top — Rock — Twee Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":10,"year":null,"note":null,"total":200,"scaruffi":null},{"id":28572826268451,"name":"RYM Top — Pop — Chamber Pop","src":"musthear","grp":"rateyourmusic","list_year":null,"rank":28,"year":null,"note":null,"tota